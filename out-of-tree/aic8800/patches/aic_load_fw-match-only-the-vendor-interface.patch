Assisted-by: Claude

diff --git a/src/USB/driver_fw/drivers/aic8800/aic_load_fw/aicwf_usb.c b/src/USB/driver_fw/drivers/aic8800/aic_load_fw/aicwf_usb.c
index bd6c6a5..794b5fd 100644
--- a/src/USB/driver_fw/drivers/aic8800/aic_load_fw/aicwf_usb.c
+++ b/src/USB/driver_fw/drivers/aic8800/aic_load_fw/aicwf_usb.c
@@ -1688,7 +1688,13 @@ static int aicwf_usb_probe(struct usb_interface *intf, const struct usb_device_i
 	    id->idProduct == USB_DEVICE_ID_AIC_8800D41 ||
 	    id->idProduct == USB_DEVICE_ID_AIC_8800D81X2 ||
 	    id->idProduct == USB_DEVICE_ID_AIC_8800D89X2)){
-		return -1;
+		/* Firmware is up and the part re-enumerated under its loaded id;
+		 * this interface belongs to aic8800_fdrv now. -ENODEV is the
+		 * kernel's word for "matched but not mine": drivers/base/dd.c
+		 * logs it as dev_dbg "rejects match", where a bare -1 (= -EPERM)
+		 * falls into the default arm and is shouted as a dev_err.
+		 */
+		return -ENODEV;
 	}
 
     usb_dev = kzalloc(sizeof(struct aic_usb_dev), GFP_ATOMIC);
@@ -1840,17 +1846,25 @@ static int aicwf_usb_reset_resume(struct usb_interface *intf)
     return aicwf_usb_resume(intf);
 }
 #endif
+/* aic_load_fw drives exactly one interface: the vendor-specific one. Its own
+ * aicwf_parse_usb() says so -- it rejects anything that is not ff/ff/ff with
+ * "non WLAN interface". Matching the whole device therefore buys nothing and
+ * costs a probe call per interface the loader can only refuse: the D81 (and
+ * every other post-download identity) exposes two Bluetooth interfaces at
+ * e0/01/01 that belong to btusb. Narrowing the match is what aic8800_fdrv
+ * already does for the same part ids.
+ */
 static struct usb_device_id aicwf_usb_id_table[] = {
-    {USB_DEVICE(USB_VENDOR_ID_AIC, USB_DEVICE_ID_AIC)},
-    {USB_DEVICE(USB_VENDOR_ID_AIC, USB_DEVICE_ID_AIC_8801)},
-    {USB_DEVICE(USB_VENDOR_ID_AIC, USB_DEVICE_ID_AIC_8800D80)},
-    {USB_DEVICE(USB_VENDOR_ID_AIC, USB_DEVICE_ID_AIC_8800D81)},
-    {USB_DEVICE(USB_VENDOR_ID_AIC, USB_DEVICE_ID_AIC_8800D40)},
-    {USB_DEVICE(USB_VENDOR_ID_AIC, USB_DEVICE_ID_AIC_8800D41)},
-    {USB_DEVICE(USB_VENDOR_ID_AIC_V2, USB_DEVICE_ID_AIC_8800D80X2)},
-    {USB_DEVICE(USB_VENDOR_ID_AIC_V2, USB_DEVICE_ID_AIC_8800D81X2)},
-    {USB_DEVICE(USB_VENDOR_ID_AIC_V2, USB_DEVICE_ID_AIC_8800D89X2)},
-    {USB_DEVICE(USB_VENDOR_ID_AIC_V2, USB_DEVICE_ID_AIC_8800D40X2)},
+    {USB_DEVICE_AND_INTERFACE_INFO(USB_VENDOR_ID_AIC, USB_DEVICE_ID_AIC, 0xff, 0xff, 0xff)},
+    {USB_DEVICE_AND_INTERFACE_INFO(USB_VENDOR_ID_AIC, USB_DEVICE_ID_AIC_8801, 0xff, 0xff, 0xff)},
+    {USB_DEVICE_AND_INTERFACE_INFO(USB_VENDOR_ID_AIC, USB_DEVICE_ID_AIC_8800D80, 0xff, 0xff, 0xff)},
+    {USB_DEVICE_AND_INTERFACE_INFO(USB_VENDOR_ID_AIC, USB_DEVICE_ID_AIC_8800D81, 0xff, 0xff, 0xff)},
+    {USB_DEVICE_AND_INTERFACE_INFO(USB_VENDOR_ID_AIC, USB_DEVICE_ID_AIC_8800D40, 0xff, 0xff, 0xff)},
+    {USB_DEVICE_AND_INTERFACE_INFO(USB_VENDOR_ID_AIC, USB_DEVICE_ID_AIC_8800D41, 0xff, 0xff, 0xff)},
+    {USB_DEVICE_AND_INTERFACE_INFO(USB_VENDOR_ID_AIC_V2, USB_DEVICE_ID_AIC_8800D80X2, 0xff, 0xff, 0xff)},
+    {USB_DEVICE_AND_INTERFACE_INFO(USB_VENDOR_ID_AIC_V2, USB_DEVICE_ID_AIC_8800D81X2, 0xff, 0xff, 0xff)},
+    {USB_DEVICE_AND_INTERFACE_INFO(USB_VENDOR_ID_AIC_V2, USB_DEVICE_ID_AIC_8800D89X2, 0xff, 0xff, 0xff)},
+    {USB_DEVICE_AND_INTERFACE_INFO(USB_VENDOR_ID_AIC_V2, USB_DEVICE_ID_AIC_8800D40X2, 0xff, 0xff, 0xff)},
     {}
 };
 
