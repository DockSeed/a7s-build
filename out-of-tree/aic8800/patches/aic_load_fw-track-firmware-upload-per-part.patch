diff --git a/src/USB/driver_fw/drivers/aic8800/aic_load_fw/aicwf_usb.c b/src/USB/driver_fw/drivers/aic8800/aic_load_fw/aicwf_usb.c
index 794b5fd..d0b7f75 100644
--- a/src/USB/driver_fw/drivers/aic8800/aic_load_fw/aicwf_usb.c
+++ b/src/USB/driver_fw/drivers/aic8800/aic_load_fw/aicwf_usb.c
@@ -20,6 +20,8 @@
 #include <linux/usb.h>
 #include <linux/kthread.h>
 #include <linux/version.h>
+#include <linux/mutex.h>
+#include <linux/string.h>
 #include "aic_txrxif.h"
 #include "aicwf_usb.h"
 #include "aicbluetooth.h"
@@ -39,7 +41,82 @@ extern uint32_t gpio_dft_lvl;//0:defalut pull down,  1:default pull up
 u8 chip_id = 0;
 u8 chip_sub_id = 0;
 u8 chip_mcu_id = 0;
-int fw_loaded = 0;
+
+/* Which physical parts this module has already uploaded firmware to.
+ *
+ * The question the probe has to answer is per part -- "is the post-download
+ * part in front of me one that I made?" -- and it has to be answerable ACROSS
+ * the download re-enumeration, because that is exactly the gap it spans: the
+ * part disconnects under its download id and comes back under its loaded id as
+ * a NEW struct usb_device with a new device number. Measured on the vendor
+ * board, one boot of the delivery image:
+ *
+ *   usb 2-1.1: new high-speed USB device number 3      <- a69c:8d80
+ *   usb 2-1.1: USB disconnect, device number 3
+ *   usb 2-1.1: new high-speed USB device number 4      <- a69c:8d81
+ *
+ * So nothing hung off the usb_device or its interfaces lives long enough, and
+ * the product id cannot answer it either: 8d81 is byte-identical whether we
+ * produced it 750 ms ago or a previous boot did. What does not change is the
+ * USB topology path -- both enumerations above are "2-1.1" -- so that is the
+ * key. dev_name(&udev->dev) is "<busnum>-<devpath>"; devpath is char[16]
+ * (include/linux/usb.h:663), so 32 bytes cannot truncate.
+ *
+ * usb.c:686-690 warns that the busnum half is not stable across HCD modprobe
+ * order. That does not reach this state, which only has to live from one probe
+ * to the next inside a single download cycle -- no HCD is registered in that
+ * window.
+ *
+ * A fixed array rather than a list, because this driver serves one soldered
+ * part plus at most a stray dongle. Full table means "treat as already loaded",
+ * and that direction is deliberate: the opposite answer would reboot a part we
+ * cannot record, which comes back under its loaded id, is not recorded again,
+ * and loops forever. Refusing is what the old global did for every part anyway.
+ */
+#define AICWF_FW_PART_MAX 4
+static DEFINE_MUTEX(aicwf_fw_part_lock);
+static char aicwf_fw_part[AICWF_FW_PART_MAX][32];
+static int  aicwf_fw_part_n;
+
+static bool aicwf_fw_part_loaded(struct usb_device *udev)
+{
+	const char *path = dev_name(&udev->dev);
+	bool found = false;
+	int i;
+
+	mutex_lock(&aicwf_fw_part_lock);
+	if (aicwf_fw_part_n >= AICWF_FW_PART_MAX) {
+		found = true;
+	} else {
+		for (i = 0; i < aicwf_fw_part_n; i++) {
+			if (!strcmp(aicwf_fw_part[i], path)) {
+				found = true;
+				break;
+			}
+		}
+	}
+	mutex_unlock(&aicwf_fw_part_lock);
+
+	return found;
+}
+
+static void aicwf_fw_part_mark(struct usb_device *udev)
+{
+	const char *path = dev_name(&udev->dev);
+	int i;
+
+	mutex_lock(&aicwf_fw_part_lock);
+	for (i = 0; i < aicwf_fw_part_n; i++)
+		if (!strcmp(aicwf_fw_part[i], path))
+			goto out;
+	if (aicwf_fw_part_n < AICWF_FW_PART_MAX)
+		strscpy(aicwf_fw_part[aicwf_fw_part_n++], path,
+			sizeof(aicwf_fw_part[0]));
+	else
+		usb_err("firmware-loaded table full, %s not recorded\n", path);
+out:
+	mutex_unlock(&aicwf_fw_part_lock);
+}
 
 void aicwf_usb_tx_flowctrl(struct aic_usb_dev *usb_dev, bool state)
 {
@@ -1682,8 +1759,8 @@ static int aicwf_usb_probe(struct usb_interface *intf, const struct usb_device_i
 		id->bInterfaceSubClass,
 		id->bInterfaceProtocol);
 
-	if(fw_loaded == 1 && 
-        (id->idProduct == USB_DEVICE_ID_AIC_8801 || 
+	if(aicwf_fw_part_loaded(usb) &&
+        (id->idProduct == USB_DEVICE_ID_AIC_8801 ||
         id->idProduct == USB_DEVICE_ID_AIC_8800D81 ||
 	    id->idProduct == USB_DEVICE_ID_AIC_8800D41 ||
 	    id->idProduct == USB_DEVICE_ID_AIC_8800D81X2 ||
@@ -1766,7 +1843,7 @@ static int aicwf_usb_probe(struct usb_interface *intf, const struct usb_device_i
         goto out_free_bus;
     }
 
-	if(fw_loaded == 0 && 
+	if(!aicwf_fw_part_loaded(usb) &&
         (usb_dev->chipid == PRODUCT_ID_AIC8801 ||
         usb_dev->chipid == PRODUCT_ID_AIC8800D81||
         usb_dev->chipid == PRODUCT_ID_AIC8800D81X2 ||
@@ -1784,7 +1861,7 @@ static int aicwf_usb_probe(struct usb_interface *intf, const struct usb_device_i
     }
     
     usb_dev->app_cmp = true;
-	fw_loaded = 1;
+	aicwf_fw_part_mark(usb);
 
     return 0;
 
