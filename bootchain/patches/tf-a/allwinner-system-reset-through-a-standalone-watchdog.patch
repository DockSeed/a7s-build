From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DockSeed <dockseed@proton.me>
Date: Sat, 3 Oct 2026 17:09:25 +0200
Subject: [PATCH] feat(allwinner): system reset through a standalone watchdog

Newer Allwinner SoCs (the A733) have standalone watchdog blocks, WDT_CPUS
(SUNXI_R_WDOG_BASE) and WDT0 (SUNXI_WDOG_BASE), with their own register
layout (A733 UM V1.00 8.3.5/8.3.6: SRST 0x08, CFG 0x10, MODE 0x14, key
0x16AA in [31:16]) and a direct soft reset. A platform selects them with
SUNXI_STANDALONE_WATCHDOG := 1; SYSTEM_RESET then:

- does nothing before the reset but the reset. PSCI SYSTEM_RESET is also
  the panic path of a kernel whose other cores may be wedged, so no step
  may wait on state they hold: a GIC quiesce polls
  GICR_WAKER.ChildrenAsleep without a bound, and a system reset makes it
  pointless. Interrupts are masked at EL3;
- stops the WDT_CPUS timer first (UM 8.3.6.3 asks for the watchdog timer
  to be off when SRST resets the system; Linux keeps that timer running)
  and writes SRST;
- if the soft reset has not taken after 100 ms, arms the timers of both
  watchdogs for 0.5 s, whole system, and waits twice that before the
  panic. A warm reset keeps DRAM, and with it a pstore record; a power
  cycle loses it.

Every other platform keeps the old watchdog sequence.

Measured on the A733 (8 GiB board, 2026-09-24): reboot and a panic reset
end in a warm boot with the pstore record kept.

Co-developed-by: Jernej Skrabec <jernej.skrabec@gmail.com>
Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
Link: https://github.com/dlan17/trusted-firmware-a/commit/13c7a3b5554899ab018d55fa3b995277dfda2f8c
Assisted-by: Claude
---
 plat/allwinner/common/allwinner-common.mk |  6 +++
 plat/allwinner/common/sunxi_native_pm.c   | 56 +++++++++++++++++++++++
 plat/allwinner/sun60i_a733/platform.mk    |  3 ++
 3 files changed, 65 insertions(+)

diff --git a/plat/allwinner/common/allwinner-common.mk b/plat/allwinner/common/allwinner-common.mk
index 1ca26b6aa..248933332 100644
--- a/plat/allwinner/common/allwinner-common.mk
+++ b/plat/allwinner/common/allwinner-common.mk
@@ -71,6 +71,12 @@ BL31_SOURCES		+=	drivers/allwinner/sunxi_msgbox.c	\
 				${AW_PLAT}/common/sunxi_scpi_pm.c
 endif
 
+# Newer SoCs (the A733) have standalone watchdogs, with their own register
+# layout and a soft reset; SYSTEM_RESET then uses those (sunxi_native_pm.c).
+SUNXI_STANDALONE_WATCHDOG	?=	0
+$(call assert_boolean,SUNXI_STANDALONE_WATCHDOG)
+$(eval $(call add_define,SUNXI_STANDALONE_WATCHDOG))
+
 SUNXI_SETUP_REGULATORS	?=	1
 $(call assert_boolean,SUNXI_SETUP_REGULATORS)
 $(eval $(call add_define,SUNXI_SETUP_REGULATORS))
diff --git a/plat/allwinner/common/sunxi_native_pm.c b/plat/allwinner/common/sunxi_native_pm.c
index 8aded84ce..4c2a97a76 100644
--- a/plat/allwinner/common/sunxi_native_pm.c
+++ b/plat/allwinner/common/sunxi_native_pm.c
@@ -60,8 +60,63 @@ static void sunxi_system_off(void)
 	sunxi_cpu_power_off_self();
 }
 
+#if SUNXI_STANDALONE_WATCHDOG
+/*
+ * The standalone watchdog (A733 UM V1.00 8.3.5/8.3.6), same layout in
+ * WDT_CPUS (SUNXI_R_WDOG_BASE) and WDT0 (SUNXI_WDOG_BASE): SRST 0x08,
+ * CFG 0x10, MODE 0x14, and every write to them takes the key 0x16AA in
+ * [31:16]. The offsets of the older watchdog above do not apply.
+ */
+#define SUNXI_WDT_KEY			(U(0x16AA) << 16)
+#define SUNXI_WDT_SRST			U(0x08)
+#define SUNXI_WDT_CFG			U(0x10)
+#define SUNXI_WDT_MODE			U(0x14)
+#define SUNXI_WDT_CFG_CLK_SEL		BIT_32(8)	/* kept as found */
+#define SUNXI_WDT_CFG_WHOLE_SYSTEM	U(0x1)		/* [1:0] = 01 */
+#define SUNXI_WDT_MODE_EN_500MS		U(0x1)		/* [7:4] = 0: 0.5 s, [0] enable */
+
+/* Timer mode, shortest interval, reset of the whole system. */
+static void sunxi_wdt_arm_shortest(uintptr_t base)
+{
+	uint32_t clk = mmio_read_32(base + SUNXI_WDT_CFG) &
+		       SUNXI_WDT_CFG_CLK_SEL;
+
+	mmio_write_32(base + SUNXI_WDT_CFG,
+		      SUNXI_WDT_KEY | clk | SUNXI_WDT_CFG_WHOLE_SYSTEM);
+	mmio_write_32(base + SUNXI_WDT_MODE,
+		      SUNXI_WDT_KEY | SUNXI_WDT_MODE_EN_500MS);
+}
+#endif
+
 static void __dead2 sunxi_system_reset(void)
 {
+#if SUNXI_STANDALONE_WATCHDOG
+	/*
+	 * Nothing before the reset but the reset. This is also the panic path
+	 * of a kernel whose other cores may be wedged, so no step may wait on
+	 * state they hold (a GIC quiesce polls GICR_WAKER.ChildrenAsleep
+	 * without a bound), and a system reset makes a quiesce pointless.
+	 * Interrupts are masked at EL3 here.
+	 *
+	 * UM 8.3.6.3 asks for the watchdog timer to be off when SRST resets
+	 * the system -- the OS may keep the WDT_CPUS
+	 * timer running, so stop it first.
+	 */
+	mmio_write_32(SUNXI_R_WDOG_BASE + SUNXI_WDT_MODE, SUNXI_WDT_KEY);
+	mmio_write_32(SUNXI_R_WDOG_BASE + SUNXI_WDT_SRST, SUNXI_WDT_KEY | 1U);
+	mdelay(100);
+
+	/*
+	 * Still running: the soft reset had no effect. Fall back to the
+	 * timers of both watchdogs, independent blocks, and wait for twice
+	 * the interval. A warm reset keeps DRAM (and a pstore record in it);
+	 * a panic here needs a power cycle.
+	 */
+	mmio_write_32(SUNXI_R_WDOG_BASE + SUNXI_WDT_SRST, SUNXI_WDT_KEY);
+	sunxi_wdt_arm_shortest(SUNXI_R_WDOG_BASE);
+	sunxi_wdt_arm_shortest(SUNXI_WDOG_BASE);
+	mdelay(1000);
+#else
 #if !USE_GIC_DRIVER
 	gicv2_cpuif_disable();
 #endif
@@ -72,6 +127,7 @@ static void __dead2 sunxi_system_reset(void)
 	mmio_write_32(SUNXI_WDOG0_MODE_REG, (0 << 4) | 1);
 	/* Wait for twice the watchdog timeout before panicking */
 	mdelay(1000);
+#endif
 
 	ERROR("PSCI: System reset failed\n");
 	panic();
diff --git a/plat/allwinner/sun60i_a733/platform.mk b/plat/allwinner/sun60i_a733/platform.mk
index 277832e0f..f70de3ad2 100644
--- a/plat/allwinner/sun60i_a733/platform.mk
+++ b/plat/allwinner/sun60i_a733/platform.mk
@@ -16,6 +16,9 @@ PLATFORM_MAX_CPUS_PER_CLUSTER := 8
 # three, set read-modify-write so the other bits stay as found (`|= 7`).
 SUNXI_R_PRCM_SEC_SWITCH_NS := 0x7
 
+# Standalone watchdogs (WDT_CPUS, WDT0); SYSTEM_RESET uses their soft reset.
+SUNXI_STANDALONE_WATCHDOG := 1
+
 # DynamIQ MPIDR layout; the cores are powered through Arm PPUs
 # (sunxi_cpu_new_ops.c).
 SUNXI_NEW_MPIDR_FMT := 1
