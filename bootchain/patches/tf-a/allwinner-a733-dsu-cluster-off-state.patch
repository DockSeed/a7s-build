  */
 
+#include <assert.h>
 #include <stdbool.h>
 #include <stdint.h>
+#include <string.h>
 
 #include <arch.h>
 #include <arch_helpers.h>
@@ -94,6 +96,194 @@ void sunxi_dsu_cluster_core_up(void)
 	}
 }
 
+#if SUNXI_DSU_CLUSTER_OFF
+/*
+ * The cluster OFF state. With every core's advisory at 1 (above), the
+ * DSU PPU policy floor comes down to OFF once, here: PWR_POLICY [3:0] = OFF
+ * (0), PWR_DYN_EN (bit 8) and OP_POLICY left as found (DEN0051E 5.2.1, a
+ * read-modify-write of the policy nibble only). From then on the cluster
+ * powers down when all eight cores are down AND every core's CLUSTERPWRDN
+ * bit 0 is 0 (DSU TRM B1.14/B1.15), and only a core that asked for the
+ * cluster state (PSCI power level 1) or went through CPU_OFF clears its bit.
+ *
+ * What a cluster power-down takes with it, measured on this SoC: every
+ * core's GIC-600
+ * redistributor SGI/PPI configuration is reset (UM V1.00 5.1.9.17,
+ * C0_RST_CTRL bit 4 GIC_RST, the cluster's internal GIC reset), while GICR_PWRR still reads
+ * it powered. Writing the frame back is not enough -- PPI 26 then stays
+ * pending and enabled and never reaches the core, and Linux loses its tick
+ * on the first cluster power-down. What makes it work is a GICR_PWRR power
+ * transition around the loss, and the one taken here is the GIC-600 TRM
+ * (100336 r1p6) order: a core that asks for the cluster state powers its
+ * redistributor down through GICR_PWRR before it goes (3.6.1; RDPD = 1 is
+ * only accepted with GICR_WAKER.ProcessorSleep = 1, Table 4-26, which the
+ * 3.6.2 core power-down sequence in gicv3_cpuif_disable() has set), and
+ * powers it up at wake before the CPU interface is re-enabled; then the
+ * frame, saved before the power-down, is written back if it reads different
+ * (TF-A's gicv3_rdistif_init_restore() order: SGIs/PPIs disabled, RWP,
+ * configuration, enables). Measured: 3235 cluster power-downs in 120 s with
+ * cpu0 alone, and the same power-off with the cluster held ON keeps the
+ * frame and wakes normally.
+ * The L3 is written back by the DSU on the way down (DSU TRM A4.9/A5.1;
+ * measured: 512 KiB of dirty lines read back complete through a
+ * non-cacheable alias after a cluster power-down).
+ */
+#include <drivers/arm/gicv3.h>
+
+#define PPU_PWR_POLICY_MASK		U(0xF)
+#define PPU_PWR_POLICY_OFF		U(0x0)
+#define PPU_PWR_DYN_EN			BIT_32(8)
+
+/*
+ * The redistributor frames as the GIC-600 lays them out (TRM 100336 r1p6,
+ * Table 4-1): 64 KiB pages counted from GICD, the RD_base page of
+ * redistributor n at 4 + 2 * ITScount + 2 * n, SGI_base right after it. At
+ * SUNXI_GICR_BASE = GICD + 6 pages (one ITS) frame n is SUNXI_GICR_BASE +
+ * n * 128 KiB, inside the UM V1.00 GIC window 0x03400000-0x0358FFFF. The
+ * code below uses the frame the generic GIC driver found (it walks
+ * GICR_TYPER), and every core checks once that the two agree for it.
+ */
+#define A733_GICR_STRIDE		U(0x20000)
+
+struct rd_frame {
+	uint32_t igroupr0, igrpmodr0, isenabler0, icfgr1, nsacr;
+	uint32_t ipriorityr[8];
+};
+
+static struct rd_frame rd_saved[PLATFORM_CORE_COUNT];
+static bool rd_down[PLATFORM_CORE_COUNT];
+
+static void rd_read(uintptr_t b, struct rd_frame *f)
+{
+	unsigned int i;
+
+	f->igroupr0 = mmio_read_32(b + GICR_IGROUPR0);
+	f->igrpmodr0 = mmio_read_32(b + GICR_IGRPMODR0);
+	f->isenabler0 = mmio_read_32(b + GICR_ISENABLER0);
+	f->icfgr1 = mmio_read_32(b + GICR_ICFGR1);
+	f->nsacr = mmio_read_32(b + GICR_NSACR);
+	for (i = 0U; i < 8U; ++i) {
+		f->ipriorityr[i] = mmio_read_32(b + GICR_IPRIORITYR + 4U * i);
+	}
+}
+
+/*
+ * Unbounded, as the GIC driver's own gicr_wait_for_pending_write(): the
+ * architecture gives GICR_CTLR.RWP no time bound (IHI 0069H.b 12.11.2), and
+ * a bound here could not be timed anyway. This runs on the suspend wake
+ * path, inside pwr_domain_suspend_finish: the core's power-down reset
+ * CNTFRQ_EL0, the PSCI library programs it again only after this hook
+ * (lib/psci/psci_suspend.c), and timeout_init_us() derives its deadline
+ * from it.
+ */
+static void rd_wait_rwp(uintptr_t b)
+{
+	while ((mmio_read_32(b + GICR_CTLR) & GICR_CTLR_RWP_BIT) != 0U) {
+	}
+}
+
+/* This core's redistributor frame, as the GIC driver found it. */
+static uintptr_t rd_base(unsigned int core)
+{
+	uintptr_t b = gicv3_rdistif_get_base(core);
+
+	assert(b != 0U);
+	return b;
+}
+
+/*
+ * Once the GIC driver has found this core's frame: the boot core at cold
+ * boot, every other core after its CPU_ON. A frame that is not where the
+ * layout above puts it means the A733 is not the SoC this file describes.
+ */
+void sunxi_dsu_cluster_gicr_check(void)
+{
+	unsigned int core = plat_my_core_pos();
+	uintptr_t found = gicv3_rdistif_get_base(core);
+	uintptr_t expected = SUNXI_GICR_BASE + core * A733_GICR_STRIDE;
+
+	if (found != expected) {
+		ERROR("DSU: cpu%u redistributor found at 0x%lx, the A733 layout puts it at 0x%lx\n",
+		      core, found, expected);
+		panic();
+	}
+}
+
+bool sunxi_dsu_cluster_state_ok(void)
+{
+	uint32_t pwpr = mmio_read_32(A733_PPU_DSU + PPU_PWPR);
+
+	return ((pwpr & PPU_PWR_POLICY_MASK) == PPU_PWR_POLICY_OFF) &&
+	       ((pwpr & PPU_PWR_DYN_EN) != 0U);
+}
+
+/* CPU_OFF: the core's redistributor is powered off and re-initialised on
+ * CPU_ON (sunxi_gic_cpu_disable/enable), so it only withdraws its bit. */
+void sunxi_dsu_cluster_core_off(void)
+{
+	write_clusterpwrdn_el1(DSU_CLUSTER_PWR_OFF);
+	isb();
+}
+
+/* CPU_SUSPEND, after gicv3_cpuif_disable(): cluster = level 1 requested. */
+void sunxi_dsu_cluster_core_down(bool cluster)
+{
+	unsigned int core = plat_my_core_pos();
+
+	if (!cluster) {
+		return;
+	}
+	rd_read(rd_base(core), &rd_saved[core]);
+	rd_down[core] = true;
+	gicv3_rdistif_off(core);
+	write_clusterpwrdn_el1(DSU_CLUSTER_PWR_OFF);
+	isb();
+}
+
+/* CPU_SUSPEND return, after core_up and before the CPU interface. */
+void sunxi_dsu_cluster_core_resume(void)
+{
+	unsigned int core = plat_my_core_pos();
+	const struct rd_frame *s = &rd_saved[core];
+	struct rd_frame now;
+	uintptr_t b;
+	unsigned int i;
+
+	if (!rd_down[core]) {
+		return;
+	}
+	rd_down[core] = false;
+	gicv3_rdistif_on(core);
+	b = rd_base(core);
+	rd_read(b, &now);
+	if (memcmp(&now, s, sizeof(now)) == 0) {
+		return;
+	}
+	mmio_write_32(b + GICR_ICENABLER0, ~U(0));
+	rd_wait_rwp(b);
+	mmio_write_32(b + GICR_IGROUPR0, s->igroupr0);
+	mmio_write_32(b + GICR_IGRPMODR0, s->igrpmodr0);
+	for (i = 0U; i < 8U; ++i) {
+		mmio_write_32(b + GICR_IPRIORITYR + 4U * i, s->ipriorityr[i]);
+	}
+	mmio_write_32(b + GICR_ICFGR1, s->icfgr1);
+	mmio_write_32(b + GICR_NSACR, s->nsacr);
+	rd_wait_rwp(b);
+	mmio_write_32(b + GICR_ISENABLER0, s->isenabler0);
+	rd_wait_rwp(b);
+}
+
+static void policy_off(void)
+{
+	uint32_t pwpr = mmio_read_32(A733_PPU_DSU + PPU_PWPR);
+
+	mmio_write_32(A733_PPU_DSU + PPU_PWPR,
+		      (pwpr & ~PPU_PWR_POLICY_MASK) | PPU_PWR_POLICY_OFF);
+	NOTICE("DSU: PPU PWPR %08x -> %08x, cluster OFF state %s\n", pwpr,
+	       mmio_read_32(A733_PPU_DSU + PPU_PWPR),
+	       sunxi_dsu_cluster_state_ok() ? "offered" : "REFUSED");
+}
+#endif
 
 /* Boot core, once, at cold boot, before any other core is released. */
 void sunxi_dsu_cluster_setup(void)
@@ -113,4 +303,8 @@ void sunxi_dsu_cluster_setup(void)
 	       mmio_read_32(A733_CLU_DSU_STATUS),
 	       (unsigned long long)pwrdn, (unsigned long long)stat,
