allwinner-system-reset-through-a-standalone-watchdog.patch
allwinner-a733-native-psci-cpu-suspend.patch
allwinner-a733-enable-cpu-back-pll.patch
allwinner-a733-apply-a76-errata.patch
allwinner-a733-apply-a76-erratum-3888013.patch
allwinner-a733-el2-access-to-the-dsu-cluster-pmu.patch
allwinner-a733-dsu-cluster-power-required.patch
gicv3-let-a-platform-read-a-cores-redistributor-base.patch
allwinner-a733-dsu-cluster-off-state.patch
allwinner-a733-runtime-console-at-error-level.patch
