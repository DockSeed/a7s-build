+		sunxi_cpu_back_pll_setup();
+
 	sunxi_pmic_setup(soc_id, fdt);
 
 	INFO("BL31: Platform setup done\n");
diff --git a/plat/allwinner/sun60i_a733/include/sunxi_mmap.h b/plat/allwinner/sun60i_a733/include/sunxi_mmap.h
index 481bef870..e2e330b81 100644
--- a/plat/allwinner/sun60i_a733/include/sunxi_mmap.h
+++ b/plat/allwinner/sun60i_a733/include/sunxi_mmap.h
@@ -42,5 +42,6 @@
 #define SUNXI_R_I2C_BASE		0x07083000
 #define SUNXI_CPUCFG_BASE		0x08000000
 #define SUNXI_CLUSTERCFG_BASE		0x08860000
+#define SUNXI_CPU_PLL_CFG_BASE		0x08870000
 
 #endif /* SUNXI_MMAP_H */
diff --git a/plat/allwinner/sun60i_a733/platform.mk b/plat/allwinner/sun60i_a733/platform.mk
index 3b9e6e367..f57854e34 100644
--- a/plat/allwinner/sun60i_a733/platform.mk
