+ */
+#pragma weak sunxi_cpu_back_pll_setup
+void sunxi_cpu_back_pll_setup(void)
+{
+}
+
 #if !USE_GIC_DRIVER
 static const gicv2_driver_data_t sunxi_gic_data = {
 	.gicd_base = SUNXI_GICD_BASE,
@@ -208,6 +217,14 @@ void bl31_platform_setup(void)
 	if (soc_id == SUNXI_SOC_A64 || soc_id == SUNXI_SOC_H5)
 		mmio_write_32(SUNXI_CCU_BASE + 0x5c, 0x1);
 
+	/*
+	 * A733: the CPU clusters' relock parking target. Needs the delay timer
+	 * (initialised above); runs once, before BL33 and so before anything
