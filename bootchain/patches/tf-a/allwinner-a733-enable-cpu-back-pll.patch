diff --git a/plat/allwinner/sun60i_a733/sunxi_cpu_back_pll.c b/plat/allwinner/sun60i_a733/sunxi_cpu_back_pll.c
new file mode 100644
index 000000000..af1f062d4
--- /dev/null
+++ b/plat/allwinner/sun60i_a733/sunxi_cpu_back_pll.c
@@ -0,0 +1,163 @@
+/*
+ * Copyright (c) 2026, DockSeed. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+/*
+ * A733 (sun60iw2): enable CPU_BACK_PLL once at cold boot, at its reset rate.
+ *
+ * WHY. The kernel relocks a CPU cluster PLL by moving the cluster's clock mux
+ * off that PLL and back. UM V1.00 5.1.4.1 "PLL Distribution" (printed p.243 /
+ * PDF p.264) names the backup sources of every core and of the cluster as
+ * "26MHz, CPU_BACK_PLL" and a fixed peripheral rate; a park on the 26 MHz DCXO
+ * runs the cores at 26 MHz for the whole relock. CPU_BACK_PLL resets with
+ * PLL_EN = 0 and no earlier stage of this chain (boot0, BL31, U-Boot) turns it
+ * on, so it is not there to park on. This file turns it on.
+ *
+ * REGISTER. CPU_PLL_CFG base 0x08870000 (UM V1.00 5.1.5.x module list,
+ * printed p.249 / PDF p.270), CPU_BACK_PLL_CTRL_REG at +0x0000 (UM V1.00
+ * 5.1.10.1, printed p.284-285 / PDF p.305-306, default 0x4010_4A00):
+ *
+ *   31 PLL_EN  30 PLL_LDO_EN  29 LOCK_ENABLE  28 LOCK (RO)
+ *   27 PLL_OUTPUT_GATE  22:20 PLL_OUTPUT_DIV (P0 = field + 1)
+ *   15:8 PLL_N (N = field + 1)  1 PLL_INPUT_DIV (M1 = field + 1)
+ *   rate = InputFreq * N / M1 / P0
+ *
+ * The factors are never written. At reset they read N = 75, M1 = 1, P0 = 2:
+ * 26 MHz * 75 / 2 = 975 MHz on this board's DCXO (the UM's own default of
+ * 900 MHz is the same formula at 24 MHz). Measured on silicon at
+ * 974.6 MHz. If an earlier stage has changed any
+ * factor, the rate is no longer the one that was measured, and the PLL is left
+ * off rather than enabled at an unverified rate.
+ *
+ * SEQUENCE. UM V1.00 5.1.4.3, the first of its two PLL enable methods, the
+ * one the UM names for the startup phase (printed p.246 / PDF p.267), in
+ * short:
+ *
+ *   1. PLL_LDO_EN = 1.
+ *   2. PLL_OUTPUT_GATE = 1.
+ *   3. Program the factors N, M1, M0 and P.
+ *   4. PLL_EN = 1.
+ *   5. LOCK_ENABLE = 1.
+ *   6. Poll LOCK until it reads 1; the UM asks for that judgement three
+ *      times.
+ *   7. Wait 20 us before anything uses the PLL.
+ *
+ * Step 3 keeps the reset factors (see above). Step 6's three reads follow
+ * the UM's rule for judging PLL lock (UM V1.00 4.1.4.2, printed p.27 /
+ * PDF p.48): LOCK is read 3 us apart, and a PLL whose LOCK has read 1 three
+ * times counts as stable. So LOCK is sampled every 3 us and must read 1 three
+ * times in a row.
+ *
+ * LOCK is not cleared by PLL_EN = 0: after a run-time disable it read
+ * 0x50104A00 on silicon, PLL_EN 0 with LOCK still 1.
+ * Step 1 therefore also clears LOCK_ENABLE, so step 5 is always a 0 -> 1 edge
+ * of the lock detector -- the same "write 0 to LOCK_ENABLE, and then write 1"
+ * the UM asks for on a factor change (4.1.4.1, printed p.27 / PDF p.48). A
+ * cold boot reads LOCK = 0 (reset value), so this only matters if the PLL was
+ * ever enabled and disabled before this code runs.
+ *
+ * Nothing can be clocked from this PLL yet -- every cluster mux still selects
+ * its own PLL -- so Method 1's glitch window at gate-before-enable is not seen
+ * by anything.
+ *
+ * FAILURE. The poll is bounded. On timeout the PLL is taken back down in the
+ * order of the UM's "Disable PLLs" steps (gate, LOCK_ENABLE, PLL_EN) and
+ * PLL_LDO_EN is restored to what it read before; one NOTICE line says so and
+ * the boot goes on. The kernel then finds PLL_EN = 0 and falls back to the
+ * DCXO park, which is what it does today.
+ */
+
+#include <stdint.h>
+
+#include <common/debug.h>
+#include <drivers/delay_timer.h>
+#include <lib/mmio.h>
+#include <lib/utils_def.h>
+
+#include <sunxi_mmap.h>
+#include <sunxi_private.h>
+
+#define CPU_BACK_PLL_CTRL_REG		(SUNXI_CPU_PLL_CFG_BASE + 0x0000)
+
+#define CPU_BACK_PLL_EN			BIT_32(31)
+#define CPU_BACK_PLL_LDO_EN		BIT_32(30)
+#define CPU_BACK_PLL_LOCK_ENABLE	BIT_32(29)
+#define CPU_BACK_PLL_LOCK		BIT_32(28)
+#define CPU_BACK_PLL_OUTPUT_GATE	BIT_32(27)
+
+/* PLL_OUTPUT_DIV 22:20, PLL_N 15:8, PLL_INPUT_DIV 1, and their reset values. */
+#define CPU_BACK_PLL_FACTORS_MASK	U(0x0070FF02)
+#define CPU_BACK_PLL_FACTORS_RESET	U(0x00104A00)
+
+#define CPU_BACK_PLL_LOCK_READS		3	/* UM 4.1.4.2 */
+#define CPU_BACK_PLL_LOCK_STEP_US	3	/* UM 4.1.4.2 */
+#define CPU_BACK_PLL_LOCK_POLLS		20000	/* >= 60 ms, then give up */
+#define CPU_BACK_PLL_SETTLE_US		20	/* UM 5.1.4.3 Method 1 step 7 */
+
+void sunxi_cpu_back_pll_setup(void)
+{
+	uint32_t before = mmio_read_32(CPU_BACK_PLL_CTRL_REG);
+	uint32_t val = before;
+	unsigned int i, reads = 0;
+
+	if ((before & CPU_BACK_PLL_EN) != 0U) {
+		NOTICE("BL31: CPU_BACK_PLL 0x%08x, already enabled, left as is\n",
+		       before);
+		return;
+	}
+
+	if ((before & CPU_BACK_PLL_FACTORS_MASK) != CPU_BACK_PLL_FACTORS_RESET) {
+		NOTICE("BL31: CPU_BACK_PLL 0x%08x, factors not at reset, left off\n",
+		       before);
+		return;
+	}
+
+	/* Method 1 step 1; LOCK_ENABLE cleared so step 5 is a 0 -> 1 edge. */
+	val = (val | CPU_BACK_PLL_LDO_EN) & ~CPU_BACK_PLL_LOCK_ENABLE;
+	mmio_write_32(CPU_BACK_PLL_CTRL_REG, val);
+	/* Method 1 step 2 */
+	val |= CPU_BACK_PLL_OUTPUT_GATE;
+	mmio_write_32(CPU_BACK_PLL_CTRL_REG, val);
+	/* Method 1 step 3: N, M1, P0 stay at their reset values. */
+	/* Method 1 step 4 */
+	val |= CPU_BACK_PLL_EN;
+	mmio_write_32(CPU_BACK_PLL_CTRL_REG, val);
+	/* Method 1 step 5 */
+	val |= CPU_BACK_PLL_LOCK_ENABLE;
+	mmio_write_32(CPU_BACK_PLL_CTRL_REG, val);
+
+	/* Method 1 step 6, lock judged per UM 4.1.4.2: three reads, 3 us apart. */
+	for (i = 0U; (i < CPU_BACK_PLL_LOCK_POLLS) &&
+		     (reads < CPU_BACK_PLL_LOCK_READS); i++) {
+		udelay(CPU_BACK_PLL_LOCK_STEP_US);
+		if ((mmio_read_32(CPU_BACK_PLL_CTRL_REG) &
+		     CPU_BACK_PLL_LOCK) != 0U)
+			reads++;
+		else
+			reads = 0U;
+	}
+
+	if (reads < CPU_BACK_PLL_LOCK_READS) {
+		/* UM 5.1.4.3 "Disable PLLs" steps 1-3, then LDO as found. */
+		val &= ~CPU_BACK_PLL_OUTPUT_GATE;
+		mmio_write_32(CPU_BACK_PLL_CTRL_REG, val);
+		val &= ~CPU_BACK_PLL_LOCK_ENABLE;
+		mmio_write_32(CPU_BACK_PLL_CTRL_REG, val);
+		val &= ~CPU_BACK_PLL_EN;
+		mmio_write_32(CPU_BACK_PLL_CTRL_REG, val);
+		val = (val & ~CPU_BACK_PLL_LDO_EN) |
+		      (before & CPU_BACK_PLL_LDO_EN);
+		mmio_write_32(CPU_BACK_PLL_CTRL_REG, val);
+		NOTICE("BL31: CPU_BACK_PLL 0x%08x -> 0x%08x, no lock, left off\n",
+		       before, mmio_read_32(CPU_BACK_PLL_CTRL_REG));
+		return;
+	}
+
+	/* Method 1 step 7 */
+	udelay(CPU_BACK_PLL_SETTLE_US);
+
+	NOTICE("BL31: CPU_BACK_PLL 0x%08x -> 0x%08x, enabled at reset factors\n",
+	       before, mmio_read_32(CPU_BACK_PLL_CTRL_REG));
+}
