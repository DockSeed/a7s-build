diff --git a/plat/allwinner/sun60i_a733/platform.mk b/plat/allwinner/sun60i_a733/platform.mk
new file mode 100644
index 000000000..dc0b2097d
--- /dev/null
+++ b/plat/allwinner/sun60i_a733/platform.mk
@@ -0,0 +1,47 @@
+#
+# SPDX-License-Identifier: BSD-3-Clause
+#
+
+# Allwinner A733: two Cortex-A76 and six Cortex-A55 cores in one DynamIQ
+# cluster, and a GIC-600. Armv8.2.
+ARM_ARCH_MAJOR := 8
+ARM_ARCH_MINOR := 2
+
+# There are 8 cores in 1 cluster
+PLATFORM_MAX_CPUS_PER_CLUSTER := 8
+
+# DynamIQ MPIDR layout; the cores are powered through Arm PPUs
+# (sunxi_cpu_new_ops.c).
+SUNXI_NEW_MPIDR_FMT := 1
+
+# PSCI ops: native only, as on A133, H616 and R329. Mainline's SCPI path
+# is built for an OpenRISC SCP behind the A31 msgbox and matches nothing on
+# the A733: the SCP is a RISC-V E902 (UM V1.00 5.2), the msgbox is the split
+# one-way pair with a different register map (UM 6.1.6), and the write that
+# would release the SCP, bit 0 at SUNXI_R_CPUCFG_BASE, lands in the CPUIDLE
+# block below the DSU PPU, on a register no A733 document describes.
+SUNXI_PSCI_USE_SCPI := 0
+SUNXI_PSCI_USE_NATIVE := 1
+
+# GIC-600, driven by the generic GICv3 driver.
+USE_GIC_DRIVER := 3
+GICV3_SUPPORT_GIC600 := 1
+
+# The differences between the platforms are covered by the include files.
+include plat/allwinner/common/allwinner-common.mk
+
+BL31_SOURCES		+=	lib/cpus/${ARCH}/cortex_a55.S		\
+				lib/cpus/${ARCH}/cortex_a76.S
+
+# Cortex-A55 r2p0
+ERRATA_A55_1530923	:=	1
+
+USE_COHERENT_MEM		:=	0
+WARMBOOT_ENABLE_DCACHE_EARLY	:=	1
+HW_ASSISTED_COHERENCY		:=	1
+
+# The A76 is AArch64 only at EL1 and above
+CTX_INCLUDE_AARCH32_REGS	:=	0
+
+# Put NOBITS memory in SRAM A1, overwriting U-Boot's SPL.
+SEPARATE_NOBITS_REGION	:=	1
