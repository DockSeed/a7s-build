new file mode 100644
index 000000000..7c60009fe
--- /dev/null
+++ b/plat/allwinner/common/include/sunxi_cpucfg_ncat3.h
@@ -0,0 +1,32 @@
+/*
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#ifndef SUNXI_CPUCFG_H
+#define SUNXI_CPUCFG_H
+
+#include <stdbool.h>
+
+#include <lib/utils_def.h>
+
+#include <sunxi_mmap.h>
+
+/*
+ * One block of registers per core at SUNXI_CPUCFG_BASE + (n + 1) * 0x1000
+ * (A733 UM V1.00 5.1.6.6-5.1.6.9, CLU0_CPUn_CTRL_REG and
+ * CLU0_RVBARADDRn_L/H). RVBARADDR is the reset vector for AArch64
+ * execution only. CLU0_CPUn_CTRL_REG bit 0 AA64NAA32 (0: AArch32,
+ * 1: AArch64, reset value 0) is read by the core only when it comes
+ * out of reset: a core whose bit is 0 resets into AArch32 at the BROM.
+ */
+#define SUNXI_CPUCFG_CPU_CTRL_REG(n)	(SUNXI_CPUCFG_BASE + ((n) + 1) * 0x1000)
+#define SUNXI_CPUCFG_CPU_CTRL_AA64	BIT(0)
+#define SUNXI_CPUCFG_RVBAR_LO_REG(n)	(SUNXI_CPUCFG_BASE + 0x4 + ((n) + 1) * 0x1000)
+#define SUNXI_CPUCFG_RVBAR_HI_REG(n)	(SUNXI_CPUCFG_BASE + 0x8 + ((n) + 1) * 0x1000)
+
+static inline bool sunxi_cpucfg_has_per_cluster_regs(void)
+{
+	return true;
+}
+
+#endif /* SUNXI_CPUCFG_H */
