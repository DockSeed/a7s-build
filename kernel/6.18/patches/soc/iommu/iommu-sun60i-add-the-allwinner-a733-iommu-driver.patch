@@ -0,0 +1,90 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/iommu/allwinner,sun60i-a733-iommu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A733 IOMMU
+
+maintainers:
+  - DockSeed <dockseed@proton.me>
+
+description:
+  The Allwinner A733 has two IOMMU instances. Each has its own register
+  block, interrupt, clocks and reset, and one page table shared by all of
+  its bus masters. IOMMU0 serves USB0_USB1, CSI, ISP and VE_ENC (masters
+  0-3), IOMMU1 serves VE_MBUS0, VE_MBUS1, DE0, DI, G2D and EINK (masters
+  0-5). The register layout and the page table format differ from the
+  IOMMU described in allwinner,sun50i-h6-iommu.yaml.
+
+properties:
+  compatible:
+    const: allwinner,sun60i-a733-iommu
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    minItems: 4
+    maxItems: 19
+    description:
+      The IOMMU's own gates -- SYS_MCLK, SYS_PCLK, SYS_HCLK and its MBUS
+      master gate -- followed, optionally, by the MBUS matrix port gate of
+      each master whose port can be gated while the IOMMU runs. A master's
+      register block inside the IOMMU does not answer while that master's
+      port is gated, so the IOMMU holds the port gate for as long as the
+      master translates.
+
+  clock-names:
+    allOf:
+      - minItems: 4
+        maxItems: 19
+        additionalItems: true
+        items:
+          - const: mclk
+          - const: pclk
+          - const: hclk
+          - const: mbus
+      - items:
+          pattern: '^(mclk|pclk|hclk|mbus|master([0-9]|1[0-4]))$'
+
+  resets:
+    maxItems: 1
+
+  "#iommu-cells":
+    const: 1
+    description:
+      The index of the bus master within this IOMMU.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+  - "#iommu-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    iommu@3910000 {
+        compatible = "allwinner,sun60i-a733-iommu";
+        reg = <0x03910000 0x10000>;
+        interrupts = <GIC_SPI 171 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&ccu 90>, <&ccu 91>, <&ccu 92>, <&ccu 93>,
+                 <&ccu 108>, <&ccu 108>;
+        clock-names = "mclk", "pclk", "hclk", "mbus",
+                      "master0", "master1";
+        resets = <&ccu 33>;
+        #iommu-cells = <1>;
+    };
+
+...
