+/*
+ * One group for the masters of both instances, so that they share one
+ * domain: one IOVA space and one page table, which both TTBs point at
+ * (sun60i_iommu_attach_paging()). The video engine's closed user space maps
+ * every buffer through the decoder's device (IOMMU1) and hands the address
+ * to the encoder (IOMMU0) as well; with a domain per instance the encoder
+ * walks a table that does not map it. The reference taken here is held for
+ * the life of the driver, as generic_single_device_group() holds its
+ * singleton.
+ */
+static struct iommu_group *sun60i_iommu_device_group(struct device *dev)
+{
+	struct iommu_group *group;
+
+	mutex_lock(&sun60i_iommu_group_lock);
+	if (!sun60i_iommu_group) {
+		group = iommu_group_alloc();
+		if (IS_ERR(group))
+			goto out;
+		sun60i_iommu_group = group;
+	}
+	group = iommu_group_ref_get(sun60i_iommu_group);
+out:
+	mutex_unlock(&sun60i_iommu_group_lock);
+	return group;
+}
