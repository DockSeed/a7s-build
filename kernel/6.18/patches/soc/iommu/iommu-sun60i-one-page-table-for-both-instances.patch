 struct sun60i_iommu_domain {
 	struct iommu_domain domain;
 	u32 *l1;
 	/*
-	 * The IOMMU of the device the domain was allocated for. Tables of one
-	 * IOMMU are never handed to the other (attach refuses it).
+	 * The IOMMU of the device the domain was allocated for: its device is
+	 * the one the tables are DMA-mapped against. Both instances walk the
+	 * same tables; neither is DMA-coherent, and both have the same mask.
 	 */
 	struct sun60i_iommu *iommu;
 };
 
+/*
+ * Every probed instance, for the invalidations of a domain whose table more
+ * than one of them walks. Instances are added before they register and never
+ * removed once registered. Taken before any instance's lock.
+ */
+static LIST_HEAD(sun60i_iommu_list);
+static DEFINE_SPINLOCK(sun60i_iommu_list_lock);
+
+/* The one group of both instances' masters, see sun60i_iommu_device_group(). */
+static struct iommu_group *sun60i_iommu_group;
+static DEFINE_MUTEX(sun60i_iommu_group_lock);
+
 /* One per client device, dev_iommu_priv. */
 struct sun60i_iommu_client {
 	struct sun60i_iommu *iommu;
@@ -392,6 +411,30 @@
 	sun60i_iommu_flush_all(iommu);
 }
 
+/*
+ * Invalidate [first, last] of @dom on every instance whose TTB points at its
+ * table, i.e. every instance on which a master of the domain has a user,
+ * each in the order above. Nothing else is touched: an instance's own clocks
+ * are on from before it joins the list and never gated, and flush_all()
+ * reaches only the blocks of masters whose port gate is held.
+ */
+static void sun60i_iommu_domain_invalidate(struct sun60i_iommu_domain *dom,
+					   unsigned long first,
+					   unsigned long last)
+{
+	struct sun60i_iommu *iommu;
+	unsigned long flags;
+
+	spin_lock_irqsave(&sun60i_iommu_list_lock, flags);
+	list_for_each_entry(iommu, &sun60i_iommu_list, node) {
+		spin_lock(&iommu->lock);
+		if (iommu->domain == dom)
+			sun60i_iommu_invalidate(iommu, first, last);
+		spin_unlock(&iommu->lock);
+	}
+	spin_unlock_irqrestore(&sun60i_iommu_list_lock, flags);
+}
