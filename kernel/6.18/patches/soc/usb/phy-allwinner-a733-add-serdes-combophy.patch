+/* combo0_usb_phy_reset(true): reset pulse, DP-lane conv, PLL enable, the
+ * POWER_STATE handshake, and the PMA_CMN_READY wait (+ one PMA nudge).
+ */
+static int a733_combophy_reset_seq(struct a733_combophy *cp)
+{
+	u32 v;
+	u16 w;
+	int ret;
+
+	/* pulse PHY0_RESET_N low->high */
+	a733_rmw(cp->link, COMB0_LINK_CTRL0, PHY0_RESET_N, 0);
+	mdelay(1);
+	a733_rmw(cp->link, COMB0_LINK_CTRL0, 0, PHY0_RESET_N);
+
+	/* DP raw-serdes lane conversion: data + lane enable + lane reset-n */
+	a733_rmw(cp->top2, DP_RAWS_TXDW_CONV_CTRL, 0,
+		 DP_PHY_CFG_DATA_EN | DP_PHY_CFG_LN_EN | DP_PHY_CFG_LN_RSTN);
+
+	ret = readl_poll_timeout(cp->link + COMB0_LINK_CTRL0, v,
+				 v & PHY0_RESET_N, 1, PHY_LOCK_TIMEOUT_US);
+	if (ret)
+		dev_warn(cp->dev, "PHY reset deassert timeout\n");
+	mdelay(1);
+
+	a733_rmw(cp->link, COMB0_LINK_CTRL0, 0, PHY0_PIPE_LINK_RESET_N_SOFT);
+
+	a733_rmw(cp->link, COMB0_LINK_CTRL3, 0, PHY0_PMA_XCVR_PLLCLK_EN_LN);
+	ret = readl_poll_timeout(cp->link + COMB0_LINK_CTRL3, v,
+				 v & PHY0_PMA_XCVR_PLLCLK_EN_LN, 1,
+				 PHY_LOCK_TIMEOUT_US);
+	if (ret)
+		dev_warn(cp->dev, "PHY PLL enable timeout\n");
+
+	/* XCVR power state request A0 (one-hot), then DP link reset-n */
+	a733_rmw(cp->link, COMB0_LINK_CTRL3, 0,
+		 PHY0_PMA_XCVR_POWER_STATE_REQ_LN(1));
+	a733_rmw(cp->link, COMB0_LINK_CTRL0, 0, PHY0_DP_LINK_RESET_N_SOFT);
+
+	/* The PHY answers the two requests above in LINK_STUS0 (bit4 CLOCK_EN_ACK,
+	 * bits [13:8] POWER_STATE_ACK). dwc3's CSFTRST cannot
+	 * clear until the PIPE clock runs, so a stall here is the -110 we chase --
+	 * report the raw status rather than leaving it to a debug patch.
+	 */
+	ret = readl_poll_timeout(cp->link + COMB0_LINK_STUS0, v,
+				 (v & PHY0_PMA_XCVR_CLK_EN_ACK) &&
+				 (v & PHY0_PMA_XCVR_POWER_STATE_ACK), 10,
+				 PMA_READY_TIMEOUT_US);
+	if (ret)
+		dev_warn(cp->dev,
+			 "PIPE handshake stalled, LINK_STUS0 = 0x%08x (want bit4 + bits[13:8])\n",
+			 v);
+
+	v = readl(cp->link + COMB0_LINK_STUS0);
+	if (v & PHY0_PMA_CMN_READY)
+		return 0;
+
+	/* stalled: one PMA nudge (vendor clears index 0xC008 bits [11:8]) */
+	mdelay(10);
+	w = readw(cp->pma + PMA_NUDGE_OFF);
+	w &= ~PMA_NUDGE_CLR;
+	writew(w, cp->pma + PMA_NUDGE_OFF);
+
+	ret = readl_poll_timeout(cp->link + COMB0_LINK_STUS0, v,
+				 v & PHY0_PMA_CMN_READY, 5, PMA_READY_TIMEOUT_US);
+	if (ret)
+		dev_warn(cp->dev, "PMA_CMN_READY timeout — core is up, SS link may not train\n");
+	return 0;
+}
+
+static void a733_combophy_assert_reset(void *data)
+{
+	reset_control_assert(data);
+}
+
+/* Undo a733_combophy_prepare(). Only reachable from the probe error paths, so
+ * it must not touch the clocks -- those belong to phy_ops.init/exit. The reset
+ * is not asserted here: since it is balanced by a devres action, doing it in
+ * both places would decrement the shared count twice.
+ */
+static void a733_combophy_teardown(struct a733_combophy *cp)
+{
+	if (cp->avdd_c)
+		regulator_disable(cp->avdd_c);
+	if (cp->avdd_d)
+		regulator_disable(cp->avdd_d);
+	if (cp->avdd_h)
+		regulator_disable(cp->avdd_h);
+}
+
+/*
+ * Vendor phase P (sunxi_cadence_phy_serdes_init, probe context): supplies, then
+ * the SERDES block reset. The wrapper AHB/AXI gates that used to follow here are
+ * the serdes-ccu's clocks now, because the dwc3 core needs them before any PHY
+ * op runs. Nothing that touches the PIPE link happens here -- see
+ * a733_combophy_init() for why that matters.
+ */
+static int a733_combophy_prepare(struct a733_combophy *cp)
+{
+	int ret;
+
+	if (cp->avdd_h) {
+		ret = regulator_enable(cp->avdd_h);
+		if (ret)
+			return ret;
+	}
+	if (cp->avdd_d) {
+		ret = regulator_enable(cp->avdd_d);
+		if (ret)
+			goto err_d;
+	}
+	if (cp->avdd_c) {
+		ret = regulator_enable(cp->avdd_c);
+		if (ret)
+			goto err_c;
+	}
+
+	ret = reset_control_deassert(cp->reset);
+	if (ret)
+		goto err_reset;
+
+	/*
+	 * Balance it on unbind. Without this the shared deassert_count only ever
+	 * grows, and the serdes-ccu that shares this line could never assert it
+	 * again -- which makes "shared, and therefore balanced" false for every
+	 * rmmod even though the boot path never notices.
+	 */
+	ret = devm_add_action_or_reset(cp->dev, a733_combophy_assert_reset,
+				       cp->reset);
+	if (ret)
+		goto err_reset;
+
+	return 0;
+
+err_reset:
+	if (cp->avdd_c)
+		regulator_disable(cp->avdd_c);
+err_c:
+	if (cp->avdd_d)
+		regulator_disable(cp->avdd_d);
+err_d:
+	if (cp->avdd_h)
+		regulator_disable(cp->avdd_h);
+	return ret;
+}
+
+/*
+ * Vendor phase I (combo0_usb_phy_init) -- and it runs from phy_ops.init, not
+ * from probe, on purpose. dwc3 calls phy_init() four lines before its own
+ * CSFTRST (core.c: dwc3_phy_setup -> dwc3_phy_init -> dwc3_core_soft_reset),
+ * i.e. after it has deasserted RST_USB_2 and written GUSB3PIPECTL. Running the
+ * PIPE handshake earlier, from probe, means the controller side of the PIPE
+ * interface is re-toggled underneath us afterwards and nothing ever re-runs it.
+ */
+static int a733_combophy_bringup(struct a733_combophy *cp)
+{
+	int ret;
+
+	ret = clk_set_rate(cp->serdes_clk, SERDES_REFCLK_RATE);
+	if (ret) {
+		dev_err(cp->dev, "set serdes clk 100MHz failed: %d\n", ret);
+		return ret;
+	}
+	ret = clk_prepare_enable(cp->serdes_clk);
+	if (ret)
+		return ret;
+	ret = clk_prepare_enable(cp->dcxo_clk);
+	if (ret)
+		goto err_dcxo;
+
+	a733_combophy_power_up(cp);
+	a733_combophy_clk_route(cp);
+	a733_combophy_param_config(cp);
+	ret = a733_combophy_reset_seq(cp);
+	if (ret)
+		goto err_seq;
+
+	return 0;
+
+err_seq:
+	clk_disable_unprepare(cp->dcxo_clk);
+err_dcxo:
+	clk_disable_unprepare(cp->serdes_clk);
+	return ret;
+}
+
+static int a733_combophy_init(struct phy *phy)
+{
+	struct a733_combophy *cp = phy_get_drvdata(phy);
+	int ret;
+
+	mutex_lock(&cp->lock);
+	ret = a733_combophy_bringup(cp);
+	if (!ret)
+		cp->inited = true;
+	mutex_unlock(&cp->lock);
+
+	return ret;
+}
+
+static int a733_combophy_exit(struct phy *phy)
+{
+	struct a733_combophy *cp = phy_get_drvdata(phy);
+
+	mutex_lock(&cp->lock);
+	cp->inited = false;
+	a733_rmw(cp->link, COMB0_LINK_CTRL2, 0,
+		 PHY0_IDDQ_EN_SEL | PHY0_IDDQ_EN_SOFT);	/* IDDQ = power down */
+	clk_disable_unprepare(cp->dcxo_clk);
+	clk_disable_unprepare(cp->serdes_clk);
+	mutex_unlock(&cp->lock);
+
+	return 0;
+}
+
+/*
+ * TCPM hands us the plug orientation through the Type-C switch framework. The
+ * ordering is fixed and awkward: combophy0 probes, dwc3 probes and calls
+ * phy_init(), and only then does the TCPC attach and report which way round the
+ * cable is. dwc3 never re-inits the PHY, so caching the value is not enough --
+ * a port that is already up has to be reprogrammed in place.
+ *
+ * That is safe here: the vendor does exactly this on an orientation change and
+ * nothing more -- combo0_usb_param_config() alone, no reset pulse, no clock
+ * cycle (sunxi-cadence-combophy.c:3197).
+ */
+static int a733_combophy_typec_set(struct typec_switch_dev *sw,
+				   enum typec_orientation orientation)
+{
+	struct a733_combophy *cp = typec_switch_get_drvdata(sw);
+
+	/* typec_set_orientation() has no changed-value filter, so this also
+	 * fires on unplug and on hard reset / error recovery / DR_SWAP with an
+	 * unchanged value. Re-running the lane config for those would glitch a
+	 * live link for nothing.
+	 */
+	if (orientation == TYPEC_ORIENTATION_NONE ||
+	    orientation == cp->orientation)
+		return 0;
+
+	mutex_lock(&cp->lock);
+	cp->orientation = orientation;
+	if (cp->inited)
+		a733_combophy_param_config(cp);
+	mutex_unlock(&cp->lock);
+
+	/* A non-zero return here aborts TCPM's attach, so failures are logged,
+	 * not propagated.
+	 */
+	return 0;
+}
+
+static void a733_combophy_sw_unregister(void *data)
+{
+	typec_switch_unregister(data);
+}
+
+static const struct phy_ops a733_combophy_ops = {
+	.init	= a733_combophy_init,
+	.exit	= a733_combophy_exit,
+	.owner	= THIS_MODULE,
+};
+
+static struct regulator *a733_get_opt_supply(struct device *dev, const char *id)
+{
+	struct regulator *r = devm_regulator_get_optional(dev, id);
+
+	if (IS_ERR(r)) {
+		if (PTR_ERR(r) == -ENODEV)
+			return NULL;
+		return r;
+	}
+	return r;
+}
+
+static int a733_combophy_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct a733_combophy *cp;
+	struct phy_provider *provider;
+	struct phy *phy;
+	int ret;
+
+	cp = devm_kzalloc(dev, sizeof(*cp), GFP_KERNEL);
+	if (!cp)
+		return -ENOMEM;
+	cp->dev = dev;
+	mutex_init(&cp->lock);
+	cp->orientation = TYPEC_ORIENTATION_NORMAL;
+
+	cp->link = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(cp->link))
+		return PTR_ERR(cp->link);
+	cp->top2 = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(cp->top2))
+		return PTR_ERR(cp->top2);
+	cp->pma = devm_platform_ioremap_resource(pdev, 2);
+	if (IS_ERR(cp->pma))
+		return PTR_ERR(cp->pma);
+
+	cp->serdes_clk = devm_clk_get(dev, "serdes");
+	if (IS_ERR(cp->serdes_clk))
+		return dev_err_probe(dev, PTR_ERR(cp->serdes_clk), "serdes clk\n");
+	cp->dcxo_clk = devm_clk_get(dev, "dcxo-serdes0");
+	if (IS_ERR(cp->dcxo_clk))
+		return dev_err_probe(dev, PTR_ERR(cp->dcxo_clk), "dcxo clk\n");
+
+	cp->reset = devm_reset_control_get_shared(dev, NULL);
+	if (IS_ERR(cp->reset))
+		return dev_err_probe(dev, PTR_ERR(cp->reset), "serdes reset\n");
+
+	cp->avdd_h = a733_get_opt_supply(dev, "avdd-h");
+	if (IS_ERR(cp->avdd_h))
+		return PTR_ERR(cp->avdd_h);
+	cp->avdd_c = a733_get_opt_supply(dev, "avdd-c");
+	if (IS_ERR(cp->avdd_c))
+		return PTR_ERR(cp->avdd_c);
+	cp->avdd_d = a733_get_opt_supply(dev, "avdd-d");
+	if (IS_ERR(cp->avdd_d))
+		return PTR_ERR(cp->avdd_d);
+
+	/* Supplies, reset and wrapper gates only. The PIPE bring-up runs from
+	 * phy_ops.init, which dwc3 calls immediately before its core soft reset.
+	 */
+	ret = a733_combophy_prepare(cp);
+	if (ret)
+		return dev_err_probe(dev, ret, "combo-PHY prepare failed\n");
+
+	phy = devm_phy_create(dev, NULL, &a733_combophy_ops);
+	if (IS_ERR(phy)) {
+		a733_combophy_teardown(cp);
+		return PTR_ERR(phy);
+	}
+	phy_set_drvdata(phy, cp);
+
+	provider = devm_of_phy_provider_register(dev, of_phy_simple_xlate);
+	if (IS_ERR(provider)) {
+		a733_combophy_teardown(cp);
+		return PTR_ERR(provider);
+	}
+
+	/* Register as a Type-C orientation switch so TCPM can tell us which way
+	 * the plug went in. The framework matches on the *device* fwnode of the
+	 * endpoint's remote parent, so this must be dev_fwnode(dev) and the
+	 * "orientation-switch" property must sit on this node, not on a port
+	 * subnode. A mis-wired graph fails silently -- typec_switch_match()
+	 * returns NULL rather than an error and typec_switch_set() then no-ops --
+	 * so if orientation never arrives, suspect the DT graph first.
+	 */
+	if (IS_ENABLED(CONFIG_TYPEC) &&
+	    device_property_present(dev, "orientation-switch")) {
+		struct typec_switch_desc sw_desc = {
+			.fwnode  = dev_fwnode(dev),
+			.set     = a733_combophy_typec_set,
+			.drvdata = cp,
+		};
+
+		cp->sw = typec_switch_register(dev, &sw_desc);
+		if (IS_ERR(cp->sw)) {
+			a733_combophy_teardown(cp);
+			return dev_err_probe(dev, PTR_ERR(cp->sw),
+					     "typec switch register\n");
+		}
+		ret = devm_add_action_or_reset(dev, a733_combophy_sw_unregister,
+					       cp->sw);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static const struct of_device_id a733_combophy_of_match[] = {
+	{ .compatible = "allwinner,sun60i-a733-usb3-combophy" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, a733_combophy_of_match);
+
+static struct platform_driver a733_combophy_driver = {
+	.probe	= a733_combophy_probe,
+	.driver	= {
+		.name		= "sun60i-a733-combophy",
+		.of_match_table	= a733_combophy_of_match,
+	},
+};
+module_platform_driver(a733_combophy_driver);
+
+MODULE_DESCRIPTION("Allwinner A733 COMB0 combo-PHY (USB3 SuperSpeed)");
+MODULE_LICENSE("GPL");
