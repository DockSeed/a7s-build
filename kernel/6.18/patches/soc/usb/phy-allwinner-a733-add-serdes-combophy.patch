+/*
+ * A flipped Type-C plug mirrors the four COMB0 lanes n -> 3-n. The lane stride in
+ * the PMA index space is 0x200, so three lanes is 0x600 and the mirror is a plain
+ * XOR on the index -- lane0 (SSTX1, pins A2/A3) swaps with lane3 (SSTX2, B2/B3)
+ * and lane1 (SSRX1, B10/B11) with lane2 (SSRX2, A10/A11), exactly what rotating
+ * the plug does to the receptacle.
+ *
+ * The vendor writes the mirrored values out as a second literal table; the XOR
+ * reproduces it. Verified mechanically against both branches of
+ * combo0_configure_usb_dp(): in all four orientation forks the mirrored NORMAL
+ * table equals the vendor's REVERSE table as a multiset, 136 of 231 writes
+ * differing. Only the fork blocks are mirrored -- applying it to the common
+ * blocks would corrupt them (0xE005 would become 0xE605).
+ */
+#define PMA_LANE_MIRROR		0x0600
+
+static void a733_pma_write_all(struct a733_combophy *cp,
+			       const struct a733_pma_write *tbl, size_t n,
+			       u16 mirror)
+{
+	size_t i;
+
+	for (i = 0; i < n; i++)
+		writew(tbl[i].val, cp->pma + ((tbl[i].idx ^ mirror) << 1));
+}
+
+/*
+ * combo0_usb_param_config() -> combo0_configure_usb_dp(), orientation NORMAL,
+ * ssc_en = 0. The three PMA blocks are split by the two non-PMA writes the
+ * vendor performs in the middle of the sequence, and the order is load-bearing:
+ * LINK_CTRL1 is written as an absolute value after the CMN/lane-0-1 block, and
+ * TYPEC_CONN_DIR is cleared before the lane-2/3 block, not at the end.
+ */
+static void a733_combophy_param_config(struct a733_combophy *cp)
+{
+	bool flip = cp->orientation == TYPEC_ORIENTATION_REVERSE;
+	u16 m = flip ? PMA_LANE_MIRROR : 0;
+
+	a733_pma_write_all(cp, a733_pma_a_common, ARRAY_SIZE(a733_pma_a_common), 0);
+	a733_pma_write_all(cp, a733_pma_fork1, ARRAY_SIZE(a733_pma_fork1), m);
+
+	/* vendor writes LINK_CTRL1 absolutely here (= our clk_route bits) */
+	writel(COMB0_LINK_CTRL1_USB3, cp->link + COMB0_LINK_CTRL1);
+
+	a733_pma_write_all(cp, a733_pma_b_pre, ARRAY_SIZE(a733_pma_b_pre), 0);
+	a733_pma_write_all(cp, a733_pma_fork2, ARRAY_SIZE(a733_pma_fork2), m);
+	a733_pma_write_all(cp, a733_pma_b_post, ARRAY_SIZE(a733_pma_b_post), 0);
+
+	/* LINK_CTRL0 bit12 TYPEC_CONN_DIR: 1 = flipped plug. UM-derived field,
+	 * (A733 user manual).
+	 */
+	a733_rmw(cp->link, COMB0_LINK_CTRL0, PHY0_TYPEC_CONN_DIR,
+		 flip ? PHY0_TYPEC_CONN_DIR : 0);
+
+	a733_pma_write_all(cp, a733_pma_c_pre, ARRAY_SIZE(a733_pma_c_pre), 0);
+	a733_pma_write_all(cp, a733_pma_fork3, ARRAY_SIZE(a733_pma_fork3), m);
+	a733_pma_write_all(cp, a733_pma_c_mid, ARRAY_SIZE(a733_pma_c_mid), 0);
+	a733_pma_write_all(cp, a733_pma_fork4, ARRAY_SIZE(a733_pma_fork4), m);
+	a733_pma_write_all(cp, a733_pma_c_post, ARRAY_SIZE(a733_pma_c_post), 0);
+}
