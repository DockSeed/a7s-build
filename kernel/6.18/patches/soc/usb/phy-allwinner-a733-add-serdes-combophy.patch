diff --git a/drivers/phy/allwinner/Kconfig b/drivers/phy/allwinner/Kconfig
index fb584518b..35e8e1d54 100644
--- a/drivers/phy/allwinner/Kconfig
+++ b/drivers/phy/allwinner/Kconfig
@@ -57,3 +57,18 @@ config PHY_SUN50I_USB3
 	  part of Allwinner H6 SoC.
 
 	  This driver controls each individual USB 2+3 host PHY combo.
+
+config PHY_SUN60I_A733_COMBO
+	tristate "Allwinner A733 SERDES combo-PHY (USB3 SuperSpeed) driver"
+	depends on ARCH_SUNXI || COMPILE_TEST
+	depends on HAS_IOMEM && OF
+	depends on RESET_CONTROLLER
+	# The driver registers a Type-C orientation switch. IS_ENABLED() is true
+	# for TYPEC=m as well, so a built-in PHY with a modular TYPEC would fail
+	# to link -- same guard the qualcomm and freescale PHYs use.
+	depends on TYPEC || TYPEC=n
+	select GENERIC_PHY
+	help
+	  Enable this to bring up the COMB0 SERDES combo-PHY on the Allwinner
+	  A733 (sun60iw2) in USB3.1 SuperSpeed mode. DP-alt and PCIe modes of
+	  the same PHY are not handled by this driver.
