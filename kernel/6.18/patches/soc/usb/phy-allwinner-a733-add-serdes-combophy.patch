diff --git a/drivers/phy/allwinner/phy-sun60i-a733-combophy.c b/drivers/phy/allwinner/phy-sun60i-a733-combophy.c
new file mode 100644
--- a/drivers/phy/allwinner/phy-sun60i-a733-combophy.c
+++ b/drivers/phy/allwinner/phy-sun60i-a733-combophy.c
@@ -0,0 +1,873 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Allwinner A733 (sun60iw2) COMB0 combo-PHY — USB3.1 SuperSpeed mode.
+ *
+ * The A733 SERDES block is an Allwinner-wrapped Cadence combo PHY that carries
+ * USB3.1-SS / DP-alt / PCIe on COMB0 (Type-C J4). This driver brings up the
+ * USB3-SS personality on COMB0 only; DP-alt and PCIe are out of scope.
+ *
+ * Bring-up = the vendor combo0_usb_phy_init + combo0_usb_phy_reset sequence
+ * (drivers/phy/sunxi-cadence-combophy.c in radxa/allwinner-bsp), USB3 subset:
+ * regulators -> serdes/dcxo clocks -> IDDQ clear
+ * -> refclk/PIPE route -> param_config -> reset handshake. The param_config step
+ * writes the Cadence PMA/CMN-PLL config (divider/charge-pump/VCO); WITHOUT it the
+ * Common PLL never locks and PMA_CMN_READY stays 0 — the DP-guarded PMA block is a
+ * separate, larger set. HW basis: the 8 GiB board wakes the DWC3 core with the wrapper
+ * alone (xHCI CAPLENGTH 0x01200030) but the PMA only locks once param_config runs.
+ *
+ * What this driver does NOT own: the SERDES subsystem page at 0x06C00000. Its two USB3 bus gates
+ * and the companion-PHY reset-n used to be written from here, which made the dwc3 core's ability
+ * to identify itself depend on this driver probing first. They are a clock and a reset, now in
+ * the sun60i-a733-serdes-ccu provider; the page is shared with PCIe, so claiming all 4 KiB of it
+ * from a PHY driver was a latent conflict too. The block reset is shared for the same reason:
+ * that provider holds it deasserted, and asserting it here would take its registers away.
+ *
+ * Copyright (c) 2026 DockSeed. PMA tables and init sequence from sunxi-cadence-combophy.c,
+ * Copyright(c) 2020 - 2023 Allwinner Technology Co.,Ltd., (C) 2024 Allwinner Electronics Co., Ltd.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_device.h>
+#include <linux/mutex.h>
+#include <linux/regulator/consumer.h>
+#include <linux/usb/typec_mux.h>
+#include <linux/reset.h>
+
+/* --- serdes top part-2 (reg[1], base 0x06c06000) --- */
+#define DP_RAWS_TXDW_CONV_CTRL		0x0004
+#define  DP_PHY_CFG_DATA_EN		BIT(0)
+#define  DP_PHY_CFG_LN_EN		GENMASK(7, 4)
+#define  DP_PHY_CFG_LN_RSTN		GENMASK(11, 8)
+#define USB3P1_PIPE_CLK_MAP_CTRL	0x0100
+#define USB3P1_PIPE_RXD_MAP_CTRL	0x0104
+#define  USB3P1_PIPE_MAP_MASK		GENMASK(3, 0)
+#define  USB3P1_PIPE_MAP_COMB0		0x0	/* 0 = PHY0 (COMB0) */
+
+/* --- combophy0 top (reg[0], base 0x06c01000) --- */
+#define COMB0_LINK_CTRL0		0x0000
+#define  PHY0_TYPEC_CONN_DIR		BIT(12)
+#define  PHY0_DP_LINK_RESET_N_SOFT	BIT(8)
+#define  PHY0_PIPE_LINK_RESET_N_SOFT	BIT(4)
+#define  PHY0_RESET_N			BIT(0)
+#define COMB0_LINK_CTRL1		0x0004
+#define  PHY0_PMA_CMN_PLL1_REFCLK_SEL	BIT(24)
+#define  PHY0_PMA_CMN_PLL0_REFCLK_SEL	BIT(20)
+#define  PHY0_PMA_CMN_REFCLK_DIG_SEL	BIT(0)
+/* = 0x01100001, the value read live on the 8 GiB board with SS up.
+ * The vendor sets these bits with a read-modify-write in clk_set and then writes
+ * the same value absolutely, mid-config; both are reproduced.
+ */
+#define  COMB0_LINK_CTRL1_USB3		(PHY0_PMA_CMN_PLL1_REFCLK_SEL | \
+					 PHY0_PMA_CMN_PLL0_REFCLK_SEL | \
+					 PHY0_PMA_CMN_REFCLK_DIG_SEL)
+#define COMB0_LINK_CTRL2		0x0008
+#define  PHY0_IDDQ_EN_SEL		BIT(1)
+#define  PHY0_IDDQ_EN_SOFT		BIT(0)
+#define COMB0_LINK_CTRL3		0x000C
+#define  PHY0_PMA_XCVR_POWER_STATE_REQ_LN(n)	(((n) & 0x3f) << 4)
+#define  PHY0_PMA_XCVR_PLLCLK_EN_LN	BIT(0)
+#define COMB0_LINK_STUS0		0x0900
+#define  PHY0_PMA_CMN_READY		BIT(0)
+#define  PHY0_PMA_XCVR_CLK_EN_ACK	BIT(4)
+#define  PHY0_PMA_XCVR_POWER_STATE_ACK	GENMASK(13, 8)
+
+/*
+ * PMA nudge (reg[2], base 0x06c80000). The Cadence PMA is word-indexed: byte
+ * offset = index << 1. Vendor clears bits [11:8] of index 0xC008 when the link
+ * status stalls with PMA_CMN_READY=0. 0xC008<<1 = 0x18010 > 64K, so the PMA
+ * window must be mapped at least 0x20000.
+ */
+#define PMA_NUDGE_OFF			(0xC008 << 1)
+#define  PMA_NUDGE_CLR			(0xF << 8)
+
+#define SERDES_REFCLK_RATE		100000000	/* serdes-phy-cfg = 100 MHz */
+#define PHY_LOCK_TIMEOUT_US		2000
+#define PMA_READY_TIMEOUT_US		10000
+
+struct a733_combophy {
+	struct device		*dev;
+	void __iomem		*link;	/* combophy0 top   0x06c01000 */
+	void __iomem		*top2;	/* serdes top part-2 0x06c06000 */
+	void __iomem		*pma;	/* combophy0 PMA   0x06c80000 */
+	struct clk		*serdes_clk;
+	struct clk		*dcxo_clk;
+	struct reset_control	*reset;
+	struct regulator	*avdd_h;
+	struct regulator	*avdd_c;
+	struct regulator	*avdd_d;
+
+	/* Orientation arrives from TCPM long after dwc3 has called phy_init(),
+	 * so it has to be both cached (for the next init) and applied live (for
+	 * the port that is already up). The lock serialises the two paths.
+	 */
+	struct mutex		lock;
+	struct typec_switch_dev	*sw;
+	enum typec_orientation	orientation;
+	bool			inited;
+};
+
+static void a733_rmw(void __iomem *base, u32 off, u32 clr, u32 set)
+{
+	u32 v = readl(base + off);
+
+	v &= ~clr;
+	v |= set;
+	writel(v, base + off);
+}
+
+/* combo0_usb_clk_set(true): refclk sel + PIPE clk/rxd map -> COMB0.
+ * Produces LINK_CTRL1 = 0x01100001, the value read live on the 8 GiB board with SS up.
+ */
+static void a733_combophy_clk_route(struct a733_combophy *cp)
+{
+	a733_rmw(cp->link, COMB0_LINK_CTRL1, 0,
+		 PHY0_PMA_CMN_PLL1_REFCLK_SEL | PHY0_PMA_CMN_PLL0_REFCLK_SEL |
+		 PHY0_PMA_CMN_REFCLK_DIG_SEL);
+
+	a733_rmw(cp->top2, USB3P1_PIPE_CLK_MAP_CTRL,
+		 USB3P1_PIPE_MAP_MASK, USB3P1_PIPE_MAP_COMB0);
+	a733_rmw(cp->top2, USB3P1_PIPE_RXD_MAP_CTRL,
+		 USB3P1_PIPE_MAP_MASK, USB3P1_PIPE_MAP_COMB0);
+}
+
+/* combo0_usb_pwr_set(false): clear IDDQ -> power the PHY up */
+static void a733_combophy_power_up(struct a733_combophy *cp)
+{
+	a733_rmw(cp->link, COMB0_LINK_CTRL2, PHY0_IDDQ_EN_SEL, 0);
+	a733_rmw(cp->link, COMB0_LINK_CTRL2, PHY0_IDDQ_EN_SOFT, 0);
+}
+
+struct a733_pma_write { u16 idx; u16 val; };
+
