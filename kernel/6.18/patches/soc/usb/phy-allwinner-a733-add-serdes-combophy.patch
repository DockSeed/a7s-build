+ * from vendor sunxi-cadence-combophy.c. The CMN-PLL divider/lock + PMA config
+ * that makes PMA_CMN_READY lock. Fixed driver config (ref-clock dependent, not
+ * per-die). idx = Cadence PMA word index; byte offset = idx << 1.
+ */
+/* a_common: 2 writes */
+static const struct a733_pma_write a733_pma_a_common[] = {
+	{ 0xE005, 0x0003 },
+	{ 0xE006, 0x1124 },
+};
