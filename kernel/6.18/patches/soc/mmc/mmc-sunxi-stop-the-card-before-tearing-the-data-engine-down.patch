+/*
+ * The stop did not take. Put the controller's state machines back to idle.
+ *
+ * Nothing else in this driver does that on an error. SMHC_CTRL SOFT_RST --
+ * the controller reset, UM 11.3.8.1 -- is written exactly once, by
+ * sunxi_mmc_init_host(); the error path resets the DMA path and the FIFO and
+ * leaves the data state machine alone. So a failed stop leaves SMHC_STATUS
+ * FSM_BUSY standing with the card still sending, and every later command waits
+ * behind it: measured on the 8 GiB board as a task in D state for more than ten minutes
+ * while the controller still answered register reads, with a power cycle the
+ * only way out.
+ *
+ * Both mainline drivers this controller is related to reset at exactly this
+ * point: dw_mmc calls dw_mci_reset() in STATE_SENDING_STOP when the data
+ * command errored, mtk-sd calls msdc_reset_hw() on every data error.
+ *
+ * sunxi_mmc_reset_host() is not usable here: it writes SMHC_CTRL whole, which
+ * is only safe at init where everything is programmed afterwards. Here the
+ * register is saved and written back, because the UM does say elsewhere that a
+ * soft reset takes register state with it (11.3.8.34: SMHC_EXT_CMD's
+ * AUTO_CMD23_EN is cleared by SOFT_RST) without ever
+ * listing what else. So everything sunxi_mmc_init_host() programs after its
+ * reset is programmed again, and the CIU's clock -- which a controller reset
+ * loses -- is updated again, the same way dw_mmc follows its reset with
+ * SDMMC_CMD_UPD_CLK.
+ */
+static void sunxi_mmc_reset_after_failed_stop(struct sunxi_mmc_host *host)
+{
+	unsigned long expire = jiffies + msecs_to_jiffies(250);
+	u32 gctrl, rval;
+
+	gctrl = mmc_readl(host, REG_GCTRL);
+	mmc_writel(host, REG_GCTRL, gctrl | SDXC_HARDWARE_RESET);
+	do {
+		rval = mmc_readl(host, REG_GCTRL);
+	} while (time_before(jiffies, expire) && (rval & SDXC_HARDWARE_RESET));
+
+	if (rval & SDXC_HARDWARE_RESET) {
+		dev_err(mmc_dev(host->mmc),
+			"stop recovery: controller reset did not complete, ctrl %08x\n",
+			rval);
+		return;
+	}
+
+	/*
+	 * The three reset bits are auto-cleared; the mode bits in the same
+	 * register are not ours to drop. Write back what it held.
+	 */
+	mmc_writel(host, REG_GCTRL, gctrl & ~SDXC_HARDWARE_RESET);
+	sunxi_mmc_program_host(host);
+
+	if (sunxi_mmc_oclk_onoff(host, 1))
+		return;
+
+	dev_err(mmc_dev(host->mmc),
+		"stop recovery: controller reset, status %08x\n",
+		mmc_readl(host, REG_STAS));
 }
 
