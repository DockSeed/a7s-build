+ * the data path instead of DMA. Clearing it routes the data path to AHB, and
+ * this driver has no PIO path to read it with; the card goes on sending, and
+ * the FIFO reset only makes room for it to fill again. Ending the data phase
+ * is the stop command's job, so on the error path this runs after it.
+ */
+static void sunxi_mmc_release_data_engine(struct sunxi_mmc_host *host,
+					  struct mmc_data *data)
+{
