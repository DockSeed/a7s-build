+		sunxi_mmc_request_done(host, busy_mrq);
 
 	if (sdio_int)
 		mmc_signal_sdio_irq(host->mmc);
@@ -1213,7 +1259,7 @@
 	host->manual_stop_mrq = NULL;
 	spin_unlock_irqrestore(&host->lock, iflags);
 
-	mmc_request_done(host->mmc, mrq);
+	sunxi_mmc_request_done(host, mrq);
 
 	return IRQ_HANDLED;
 }
@@ -1818,7 +1864,7 @@
 	/* Check for set_ios errors (should never happen) */
 	if (host->ferror) {
 		mrq->cmd->error = host->ferror;
-		mmc_request_done(mmc, mrq);
+		sunxi_mmc_request_done(host, mrq);
 		return;
 	}
 
@@ -1828,7 +1874,7 @@
 			dev_err(mmc_dev(mmc), "map DMA failed\n");
 			cmd->error = ret;
 			data->error = ret;
-			mmc_request_done(mmc, mrq);
+			sunxi_mmc_request_done(host, mrq);
 			return;
 		}
 	}
@@ -1890,7 +1936,7 @@
 
 		dev_err(mmc_dev(mmc), "request already pending\n");
 		mrq->cmd->error = -EBUSY;
-		mmc_request_done(mmc, mrq);
+		sunxi_mmc_request_done(host, mrq);
 		return;
 	}
 
@@ -2196,6 +2242,7 @@
 	.can_hs400 = true,
 	.can_auto_cmd23 = true,
 	.can_wait_busy = true,
+	.can_hsq = true,
 	/* UM 11.3.8.17 recommends BSIZE_OF_TRANS = 3 (MSize 16), TX_TL = 240
 	 * and RX_TL = 15, and 11.3.6.2 writes 0x300F00F0 verbatim.
 	 * Vendor silicon on the 8 GiB board reads exactly this while writing this eMMC
@@ -2535,6 +2582,25 @@
 		mmc->max_busy_timeout = SDXC_MAX_BUSY_TIMEOUT_MS;
 	}
 
+	/*
+	 * The core turns the queue on when it attaches an eMMC without
+	 * command queueing (mmc.c, "Host Software Queue enabled"); it needs
+	 * the host's busy wait above, see cfg->can_hsq.
+	 */
+	if (host->cfg->can_hsq && host->cfg->can_wait_busy) {
+		struct mmc_hsq *hsq;
+
+		hsq = devm_kzalloc(&pdev->dev, sizeof(*hsq), GFP_KERNEL);
+		if (!hsq) {
+			ret = -ENOMEM;
+			goto error_free_dma;
+		}
+
+		ret = mmc_hsq_init(hsq, mmc);
+		if (ret)
+			goto error_free_dma;
+	}
+
 	ret = mmc_of_parse(mmc);
 	if (ret)
 		goto error_free_dma;
@@ -2618,6 +2684,17 @@
 	sunxi_mmc_set_clk(host, &mmc->ios);
 	enable_irq(host->irq);
 
+	/*
+	 * Only while the core has the queue on: resuming it earlier would
+	 * make the core's own cqe_enable fail with -EBUSY at attach, and the
+	 * queue would stay unused without a word. cqe_enabled, not
+	 * hsq_enabled: the core clears the first when it removes the card
+	 * (bus.c mmc_remove_card) and never clears the second. On this host
+	 * mmc_hsq is the only cqe_ops, so both mean the queue.
+	 */
+	if (host->cfg->can_hsq && mmc->cqe_enabled)
+		mmc_hsq_resume(mmc);
+
 	return 0;
 }
 
@@ -2626,6 +2703,9 @@
 	struct mmc_host	*mmc = dev_get_drvdata(dev);
 	struct sunxi_mmc_host *host = mmc_priv(mmc);
 
+	if (host->cfg->can_hsq && mmc->cqe_enabled)
+		mmc_hsq_suspend(mmc);
+
 	/*
 	 * When clocks are off, it's possible receiving
 	 * fake interrupts, which will stall the system.
