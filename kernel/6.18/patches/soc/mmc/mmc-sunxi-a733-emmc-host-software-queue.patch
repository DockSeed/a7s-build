 	depends on ARCH_SUNXI || COMPILE_TEST
 	depends on SUNXI_CCU
+	select MMC_HSQ
 	help
 	  This selects support for the SD/MMC Host Controller on
 	  Allwinner sunxi SoCs.
--- a/drivers/mmc/host/sunxi-mmc.c
+++ b/drivers/mmc/host/sunxi-mmc.c
@@ -41,6 +41,8 @@
 #include <linux/spinlock.h>
 #include <linux/workqueue.h>
 
+#include "mmc_hsq.h"
+
 /* register offset definitions */
 #define SDXC_REG_GCTRL	(0x00) /* SMC Global Control Register */
 #define SDXC_REG_CLKCR	(0x04) /* SMC Clock Control Register */
@@ -134,6 +136,16 @@
  */
 #define SDXC_WRITE_BUSY_TIMEOUT_MS	1000
 /*
+ * The same wait on a host running the software queue (cfg->can_hsq). There
+ * the block layer sends no CMD13 after a write (block.c
+ * mmc_blk_hsq_req_done() has no mmc_blk_card_busy()), so nothing behind the
+ * host would notice a card that is still busy. The host therefore holds the
+ * write for as long as the core's own poll would have waited,
+ * MMC_BLK_TIMEOUT_MS (10 s, block.c:78), and then fails it, which starts
+ * the block layer's recovery.
+ */
+#define SDXC_HSQ_WRITE_BUSY_TIMEOUT_MS	10000
+/*
  * A write whose busy clear came in without DTC/ACD. The UM does not say that
  * both arrive; without a bound such a request would never complete.
  */
@@ -371,6 +383,14 @@
 	 * SMHC_THLD BCIG busy-clear interrupt and SMHC_STATUS CARD_BUSY.
 	 */
 	bool can_wait_busy;
+
+	/*
+	 * The block layer issues requests through mmc_hsq, the host software
+	 * queue: no CMD13 after a write, and the next request is started from
+	 * the completion of the one before. Only with can_wait_busy, because
+	 * the host is then the only thing that waits for the card's busy.
+	 */
+	bool can_hsq;
 };
 
 struct sunxi_mmc_host {
@@ -440,6 +460,24 @@
 	struct delayed_work done_work;
 };
 
+/*
+ * Complete a request. With the software queue (cfg->can_hsq) a request the
+ * queue issued goes back to the queue, which completes it and starts the next
+ * one from here -- the hard IRQ, busy_work/done_work or the manual-stop thread.
+ * sunxi_mmc_request() does not sleep (dma_map_sg, the host spinlock, register
+ * writes), and no caller holds host->lock. Requests the core sends outside the
+ * queue (card init, CMD6, the cache flush, tuning, recovery) are not the
+ * queue's; mmc_hsq_finalize_request() says so and they take the usual path.
+ */
+static void sunxi_mmc_request_done(struct sunxi_mmc_host *host,
+				   struct mmc_request *mrq)
+{
+	if (host->cfg->can_hsq && mmc_hsq_finalize_request(host->mmc, mrq))
+		return;
+
+	mmc_request_done(host->mmc, mrq);
+}
+
 static int sunxi_mmc_reset_host(struct sunxi_mmc_host *host)
 {
 	unsigned long expire = jiffies + msecs_to_jiffies(250);
@@ -895,7 +933,9 @@
 	unsigned long delay = 0;
 
 	if (mrq->data)
-		timeout_ms = SDXC_WRITE_BUSY_TIMEOUT_MS;
+		timeout_ms = host->mmc->cqe_enabled ?
+			     SDXC_HSQ_WRITE_BUSY_TIMEOUT_MS :
+			     SDXC_WRITE_BUSY_TIMEOUT_MS;
 	else if (mrq->cmd->busy_timeout)
 		timeout_ms = mrq->cmd->busy_timeout;
 
@@ -940,7 +980,11 @@
 			mrq->cmd->opcode, rint);
 
 	if (still_busy) {
-		if (mrq->data)
+		if (mrq->data && host->mmc->cqe_enabled)
+			dev_err(mmc_dev(host->mmc),
+				"write: card still busy after %lld us, failed for block-layer recovery\n",
+				us);
+		else if (mrq->data)
 			dev_warn(mmc_dev(host->mmc),
 				 "write: card still busy after %lld us, left to the core's status poll\n",
 				 us);
@@ -959,6 +1003,8 @@
 
 	if (still_busy && !mrq->data)
 		mrq->cmd->error = -ETIMEDOUT;
+	else if (still_busy && host->mmc->cqe_enabled)
+		mrq->data->error = -ETIMEDOUT;
 
 	return mrq;
 }
@@ -973,7 +1019,7 @@
 	if (ret == IRQ_WAKE_THREAD)
 		sunxi_mmc_handle_manual_stop(host->irq, host);
 	else
-		mmc_request_done(host->mmc, mrq);
+		sunxi_mmc_request_done(host, mrq);
 }
 
