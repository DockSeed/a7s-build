+		/*
+		 * Disarm the busy-clear interrupt with the request it was armed
+		 * for, so that bit 13 on a later command without data keeps its
+		 * error meaning.
+		 */
+		if (host->cfg->can_wait_busy) {
+			rval = mmc_readl(host, REG_THLD);
+			mmc_writel(host, REG_THLD, rval & ~SDXC_CARD_BCIG);
+		}
+
 		mmc_writel(host, REG_IDST, 0x337);
 		mmc_writel(host, REG_DMAC, 0);
 		rval = mmc_readl(host, REG_GCTRL);
@@ -703,6 +853,18 @@
 
 	mmc_writel(host, REG_RINTR, 0xffff);
 
+	/*
+	 * Whether it ended on DAT0 or on an error, a pending busy_work is
+	 * stale now. Not the _sync variant: this runs in interrupt context,
+	 * and a running busy_work rechecks busy_wait under the lock.
+	 */
+	if (host->busy_wait) {
+		host->busy_wait = false;
+		cancel_delayed_work(&host->busy_work);
+	}
+	if (host->cfg->can_wait_busy)
+		cancel_delayed_work(&host->done_work);
+
 	host->mrq = NULL;
 	host->int_sum = 0;
 	host->wait_dma = false;
@@ -710,12 +872,234 @@
 	return host->manual_stop_mrq ? IRQ_WAKE_THREAD : IRQ_HANDLED;
 }
 
+/*
+ * The bus side of a busy-waiting request is done and DAT0 still reads busy.
+ * Keep the request open. A write expects the busy-clear interrupt and gets a
+ * grace period before busy_work looks at DAT0 itself; an R1b command has no
+ * interrupt of its own here, and neither has a write whose busy clear already
+ * came in before the done bit, so busy_work starts at once.
+ *
+ * The deadline is the command's busy_timeout, which the core has already
+ * checked against max_busy_timeout. A write carries none and gets
+ * SDXC_WRITE_BUSY_TIMEOUT_MS.
+ *
+ * The 10 ms grace is deliberate: polling at once would find DAT0 idle before
+ * the interrupt is serviced, and the test boot could no longer tell whether
+ * BCIG works. If it does not, every busy write costs the grace, which the
+ * throughput numbers show at once.
+ */
+static void sunxi_mmc_start_busy_wait(struct sunxi_mmc_host *host)
+{
+	struct mmc_request *mrq = host->mrq;
+	unsigned int timeout_ms = host->mmc->max_busy_timeout;
+	unsigned long delay = 0;
+
+	if (mrq->data)
+		timeout_ms = SDXC_WRITE_BUSY_TIMEOUT_MS;
+	else if (mrq->cmd->busy_timeout)
+		timeout_ms = mrq->cmd->busy_timeout;
+
+	host->busy_clear_first = host->int_sum & SDXC_WRITE_BUSY_CLEAR;
+	if (mrq->data && !host->busy_clear_first)
+		delay = msecs_to_jiffies(SDXC_BUSY_IRQ_GRACE_MS);
+
+	host->busy_wait = true;
+	host->busy_seq++;
+	host->busy_start = ktime_get();
+	host->busy_deadline = jiffies + msecs_to_jiffies(timeout_ms) + 1;
+
+	mod_delayed_work(system_long_wq, &host->busy_work, delay);
+}
+
+/*
+ * Finish a busy wait: DAT0 is idle, or the deadline has passed with the card
+ * still busy. Called with host->lock held; returns the request for the caller
+ * to complete after dropping the lock.
+ *
+ * A busy that outlasts the deadline fails an R1b command with -ETIMEDOUT, as
+ * the capability requires. A write is completed without an error instead,
+ * after at most SDXC_WRITE_BUSY_TIMEOUT_MS: the core's CMD13 poll follows
+ * every write and waits up to MMC_BLK_TIMEOUT_MS (10 s, block.c) before
+ * recovery, as it did without this patch -- now that much later.
+ */
+static struct mmc_request *sunxi_mmc_end_busy_wait(struct sunxi_mmc_host *host,
+						   bool still_busy,
+						   const char *how)
+{
+	struct mmc_request *mrq = host->mrq;
+	s64 us = ktime_us_delta(ktime_get(), host->busy_start);
+	u32 rint = mmc_readl(host, REG_RINTR);
+
+	/*
+	 * SMHC_WR_BUSY_TMOUT has no unit in the UM and is never programmed;
+	 * whether its timeout fires under BCIG is unmeasured. Report it.
+	 */
+	if (rint & SDXC_DATA_WR_BUSY_TIMEOUT)
+		dev_dbg(mmc_dev(host->mmc),
+			"cmd %d: write busy timeout bit set, rint %08x\n",
+			mrq->cmd->opcode, rint);
+
+	if (still_busy) {
+		if (mrq->data)
+			dev_warn(mmc_dev(host->mmc),
+				 "write: card still busy after %lld us, left to the core's status poll\n",
+				 us);
+		else
+			dev_err(mmc_dev(host->mmc),
+				"cmd %d: card still busy after %lld us (busy_timeout %u ms)\n",
+				mrq->cmd->opcode, us, mrq->cmd->busy_timeout);
+	} else {
+		dev_dbg(mmc_dev(host->mmc),
+			"cmd %d%s: busy end by %s after %lld us%s\n",
+			mrq->cmd->opcode, mrq->data ? " WR" : "", how, us,
+			host->busy_clear_first ? " (busy clear before done)" : "");
+	}
+
+	sunxi_mmc_finalize_request(host);
+
+	if (still_busy && !mrq->data)
+		mrq->cmd->error = -ETIMEDOUT;
+
+	return mrq;
+}
