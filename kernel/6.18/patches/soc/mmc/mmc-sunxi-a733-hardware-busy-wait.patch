 #define SDXC_REG_GCTRL	(0x00) /* SMC Global Control Register */
@@ -107,6 +110,43 @@
 #define SDXC_CARD_WR_THLD_ENB		BIT(2)
 #define SDXC_CARD_RD_THLD_ENB		BIT(0)
 
+/*
+ * SMHC_THLD BCIG, UM 11.3.8.29 (p. 458): busy clear interrupt generation,
+ * 0 = disabled, 1 = enabled. Reset
+ * value 0, so the interrupt below does not exist until a driver asks for it.
+ */
+#define SDXC_CARD_BCIG			BIT(1)
+
+/*
+ * Hardware busy wait: how long a write waits for the busy-clear interrupt
+ * before it looks at DAT0 itself, and the pacing of that look. The pacing is
+ * the core's own (__mmc_poll_for_busy: 32 us, doubling, capped at 32768 us),
+ * applied to a register read instead of a CMD13 on the bus.
+ */
+#define SDXC_BUSY_IRQ_GRACE_MS		10
+#define SDXC_BUSY_POLL_MIN_US		32
+#define SDXC_BUSY_POLL_MAX_US		32768
+/*
+ * How long the host holds a write whose card stays busy. Short on purpose:
+ * block.c polls with CMD13 after every write anyway and gives the card
+ * MMC_BLK_TIMEOUT_MS (10 s) before recovery, so a longer host wait only
+ * delays that recovery.
+ */
+#define SDXC_WRITE_BUSY_TIMEOUT_MS	1000
+/*
+ * A write whose busy clear came in without DTC/ACD. The UM does not say that
+ * both arrive; without a bound such a request would never complete.
+ */
+#define SDXC_BUSY_CLEAR_DONE_MS		1000
+/*
+ * max_busy_timeout. The wait is timed in software, so no register sets this
+ * ceiling; what it decides is which R1B commands the core hands to the host
+ * and how large a discard the core builds (mmc_do_calc_max_discard). 60 s is
+ * the core's own MMC_ERASE_TIMEOUT_MS, the value the discard sizing already
+ * used while max_busy_timeout was 0, so discard geometry does not change.
+ */
+#define SDXC_MAX_BUSY_TIMEOUT_MS	60000
+
 /* FIFO geometry, UM 11.3.8.17: FIFO_DEPTH = 256 words = 1 KiB. */
 #define SDXC_FIFO_BYTES			1024
 /* Burst 8, RX trigger level 7, TX trigger level 8 -- the value this driver has
@@ -180,6 +220,15 @@
 #define SDXC_FIFO_RUN_ERROR		BIT(11)
 #define SDXC_HARD_WARE_LOCKED		BIT(12)
 #define SDXC_START_BIT_ERROR		BIT(13)
+/*
+ * The same bit, read on a write. SMHC_RINTSTS DSE_BC, UM 11.3.8.15 (p. 446):
+ * On a read: the host saw a bad start bit. On a write: the card has dropped
+ * busy after the final block.
+ * Enabled by SDXC_CARD_BCIG.
+ */
+#define SDXC_WRITE_BUSY_CLEAR		BIT(13)
+/* SMHC_RINTSTS bit 18, UM 11.3.8.15; read for diagnostics only, never unmasked */
+#define SDXC_DATA_WR_BUSY_TIMEOUT	BIT(18)
 #define SDXC_AUTO_COMMAND_DONE		BIT(14)
 #define SDXC_END_BIT_ERROR		BIT(15)
 #define SDXC_SDIO_INTERRUPT		BIT(16)
@@ -315,6 +364,13 @@
 
 	/* HS400 data-strobe delay line value (0..63) */
