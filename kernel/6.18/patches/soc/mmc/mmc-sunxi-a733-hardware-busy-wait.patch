-/* Called in interrupt context! */
+/*
+ * Hardware busy wait -- what MMC_CAP_WAIT_WHILE_BUSY promises the core.
+ *
+ * With the capability set the core stops polling after an R1b command whose
+ * busy_timeout fits max_busy_timeout (mmc_ops.c __mmc_switch, core.c
+ * mmc_do_erase, mmc.c mmc_sleep): the host must not complete such a command
+ * while the card still signals busy on DAT0. For a write the core polls
+ * anyway -- block.c mmc_blk_card_busy() sends CMD13 until READY_FOR_DATA after
+ * every write request -- and what the host changes is only whether the first
+ * of those finds the card ready. Measured before this change (Cubie A7S,
+ * 2026-09-17, mmc_request_start trace): 1.1-2.0 CMD13 per eMMC write request
+ * and 4.1-6.4 per SD write request, against 0 and 1 on the vendor stack.
+ *
+ * Two SMHC facts carry it, both from the A733 UM:
+ *  - SMHC_THLD BCIG (11.3.8.29) turns on the busy-clear interrupt, and
+ *    SMHC_RINTSTS bit 13 (11.3.8.15) reports it on a write (the card has
+ *    dropped busy after the final block).
+ *  - SMHC_STATUS CARD_BUSY (11.3.8.16) is the inverted DATA[0] line, the
+ *    level itself; ->card_busy already reads it.
+ *
+ * The rule here is: complete when the bus side is done AND DAT0 reads idle.
+ * The interrupt only says when to look. That keeps the result right whatever
+ * order the controller raises DTC/ACD and busy-clear in, which the UM does
+ * not state -- in particular for an open-ended SD write, where the auto CMD12
+ * carries an R1b busy of its own after the last block.
+ */
+static bool sunxi_mmc_wants_busy_wait(struct sunxi_mmc_host *host,
+				      struct mmc_request *mrq)
+{
+	if (!host->cfg->can_wait_busy)
+		return false;
+
+	if (mrq->data)
+		return mrq->data->flags & MMC_DATA_WRITE;
+
+	return mrq->cmd->flags & MMC_RSP_BUSY;
+}
+
+/*
+ * Bit 13 is a start-bit error only while receiving data (UM 11.3.8.15). On a
+ * write with BCIG armed it is the busy clear, and on a command without data
+ * it can only be a busy clear that latched after the previous write -- a
+ * start bit on data that does not exist cannot fail. On these controllers it
+ * counts as an error on reads alone.
+ */
+static u32 sunxi_mmc_error_bits(struct sunxi_mmc_host *host,
+				struct mmc_request *mrq)
+{
+	if (host->cfg->can_wait_busy &&
+	    (!mrq->data || (mrq->data->flags & MMC_DATA_WRITE)))
+		return SDXC_INTERRUPT_ERROR_BIT & ~SDXC_WRITE_BUSY_CLEAR;
+
+	return SDXC_INTERRUPT_ERROR_BIT;
+}
+
+/* Called in interrupt context, or from busy_work/done_work under host->lock */
 static irqreturn_t sunxi_mmc_finalize_request(struct sunxi_mmc_host *host)
 {
 	struct mmc_request *mrq = host->mrq;
@@ -652,7 +792,7 @@
 	mmc_writel(host, REG_IMASK, host->sdio_imask);
 	mmc_writel(host, REG_IDIE, 0);
 
-	if (host->int_sum & SDXC_INTERRUPT_ERROR_BIT) {
+	if (host->int_sum & sunxi_mmc_error_bits(host, mrq)) {
 		sunxi_mmc_dump_errinfo(host);
 		mrq->cmd->error = -ETIMEDOUT;
 
@@ -688,6 +828,16 @@
 	}
 
