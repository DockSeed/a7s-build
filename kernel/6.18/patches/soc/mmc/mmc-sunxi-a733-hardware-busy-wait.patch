+	 * request has finished on the bus and the card still holds DAT0;
+	 * busy_seq tells busy_work which wait it was started for, because the
+	 * block layer reuses the same mmc_request for the next transfer.
+	 */
+	bool		busy_wait;
+	bool		busy_clear_first;	/* bit 13 came before DTC/ACD */
+	u32		busy_seq;
+	unsigned long	busy_deadline;
+	ktime_t		busy_start;
