+/*
+ * The video engine: a decoder and an encoder, each with its own PLL,
+ * module clock, bus gate and three bus-matrix gates. Fourteen clocks, each
+ * naming one register field:
+ *
+ *   PLL_VE0_CTRL 0x0220, PLL_VE1_CTRL 0x0240 -- the VCO (N, M1) and its single
+ *     output tap "VE0PLL"/"VE1PLL" ([22:20] P0 + output gate bit 27)
+ *   VE_ENC0_CLK 0x0A80, VE_DEC_CLK 0x0A88 -- the module clocks
+ *   VE_BGR 0x0A8C bit 0 (ENC0) and bit 2 (DEC) -- the blocks' own bus gates
+ *   AHB_MAT_CLK_GATING 0x05C0 bit 1 (ENC) and bit 0 (DEC)
+ *   MBUS_MAT_CLK_GATING 0x05E0 bit 12 (ENC0) and bit 14 (DEC)
+ *   MBUS_GATE_EN 0x05E4 bit 1 (ENC0) and bit 18 (DEC) -- the MBUS clocks
+ *
+ * 97-110 are the next free ids on main; 94-96 are PCIe's.
+ */
+#define CLK_PLL_VE0		97
+#define CLK_VE0PLL		98
+#define CLK_PLL_VE1		99
+#define CLK_VE1PLL		100
+#define CLK_VE_ENC0		101
+#define CLK_VE_DEC		102
+#define CLK_BUS_VE_ENC0		103
+#define CLK_BUS_VE_DEC		104
+#define CLK_AHB_VE_ENC0		105
+#define CLK_AHB_VE_DEC		106
+#define CLK_MBUS_VE_ENC0	107
+#define CLK_MBUS_VE_DEC		108
+#define CLK_MCLK_VE_ENC0	109
+#define CLK_MCLK_VE_DEC		110
+
