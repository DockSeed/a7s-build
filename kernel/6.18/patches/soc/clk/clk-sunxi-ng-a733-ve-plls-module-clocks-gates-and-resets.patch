+	 * PLL comment above lists the readings). LOCK_ENABLE resets to 0 on both (A733 user
+	 * manual), and without it ccu_nm_set_rate() polls a LOCK bit that never
+	 * asserts -- `clk-sunxi-ng-a733-pll-gpu0-lock-detector-must-be-enabled`'s measured finding on PLL_GPU0. Neither bit is a gate
+	 * and neither changes a rate.
+	 */
+	for (i = 0; i < ARRAY_SIZE(ve_pll_regs); i++) {
+		val = readl(reg + ve_pll_regs[i]);
+		val |= SUN60IW2_PLL_VE_LDO_EN | SUN60IW2_PLL_VE_LOCK_ENABLE;
+		writel(val, reg + ve_pll_regs[i]);
+	}
+
 	return devm_sunxi_ccu_probe(&pdev->dev, reg, &sun60iw2_ccu_desc);
 }
 
