+
+  clocks:
+    items:
+      - description: Digitally Controlled Crystal Oscillator (26 MHz on the A733)
+
+  clock-names:
+    items:
+      - const: dcxo
+
+required:
+  - "#clock-cells"
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+
