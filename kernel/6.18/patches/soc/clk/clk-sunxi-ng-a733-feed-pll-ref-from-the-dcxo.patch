diff --git a/Documentation/devicetree/bindings/clock/allwinner,sun60i-a733-ccu.yaml b/Documentation/devicetree/bindings/clock/allwinner,sun60i-a733-ccu.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/allwinner,sun60i-a733-ccu.yaml
@@ -0,0 +1,70 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/allwinner,sun60i-a733-ccu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A733 Clock Control Unit
+
+maintainers:
+  - DockSeed <dockseed@proton.me>
+
+description: >
+  The A733 (sun60iw2) main CCU takes two physically different high-frequency
+  references, and they are not interchangeable. SYS_CLK24M ("hosc") is the
+  SoC-internal 24 MHz net that feeds the AHB/APB/SMHC/SERDES source muxes; it
+  is fixed at 24 MHz whatever crystal is fitted. The DCXO ("dcxo") is the
+  crystal oscillator itself, 26 MHz on the boards seen so far, and inside this
+  controller it clocks PLL_REF alone. A733 User Manual V0.92 section 7.1.4
+  names both nets and both rates; Table 4-3 gives REF_PLL as DCXO 26 MHz,
+  N 96, VCO 2496 MHz, output 24 MHz.
+
+properties:
+  "#clock-cells":
+    const: 1
+
+  "#reset-cells":
+    const: 1
+
+  compatible:
+    const: allwinner,sun60i-a733-ccu
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: High Frequency Oscillator (SYS_CLK24M, 24 MHz)
+      - description: Low Frequency Oscillator (usually at 32 kHz)
+      - description: Internal Oscillator
+      - description: Crystal oscillator (DCXO, 26 MHz on the Radxa Cubie A7S)
+
+  clock-names:
+    items:
+      - const: hosc
+      - const: losc
+      - const: iosc
+      - const: dcxo
+
+required:
+  - "#clock-cells"
+  - "#reset-cells"
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+
+additionalProperties: false
+
+examples:
+  - |
+    clock-controller@2002000 {
+        compatible = "allwinner,sun60i-a733-ccu";
+        reg = <0x02002000 0x2000>;
+        clocks = <&osc24M>, <&osc32k>, <&iosc>, <&dcxo26M>;
+        clock-names = "hosc", "losc", "iosc", "dcxo";
+        #clock-cells = <1>;
+        #reset-cells = <1>;
+    };
+
+...
diff --git a/drivers/clk/sunxi-ng/ccu-sun60iw2.c b/drivers/clk/sunxi-ng/ccu-sun60iw2.c
--- a/drivers/clk/sunxi-ng/ccu-sun60iw2.c
+++ b/drivers/clk/sunxi-ng/ccu-sun60iw2.c
@@ -32,8 +32,23 @@
 #include "ccu_nm.h"
 
 /*
- * The 24 MHz oscillator ("hosc") is provided from the device tree. The
- * low-speed 32 kHz ("losc") and internal RC ("iosc") references are mux
+ * TWO different physical reference nets reach this controller, and which one a
+ * given clock hangs off is not a detail — they differ by 26/24, so mixing them
+ * up mis-scales everything below by 7.7 %:
+ *
+ *   "hosc" = SYS_CLK24M, the SoC-internal 24 MHz net. Fixed at 24 MHz whatever
+ *     crystal is fitted: the UM describes it as the output of a multiplexer
+ *     between DCXO and PLL_REF, fixed at 24 MHz (A733 UM
+ *     7.1.4). This is the "000" input of the AHB/APB/SMHC/SERDES muxes and the
+ *     parent of the 24 MHz USB gates.
+ *
+ *   "dcxo" = the crystal oscillator itself, 26 MHz on this board. The UM
+ *     lists it as the off-chip crystal oscillator, 26 MHz
+ *     (same table), and names the 26 MHz reference clock among the CCU's
+ *     input signals (UM 4.1.1). Inside this controller
+ *     exactly one clock is on it: PLL_REF.
+ *
+ * The low-speed 32 kHz ("losc") and internal RC ("iosc") references are mux
  * inputs only and, for milestone 0, are never selected — they are listed to
  * keep the hardware mux indices honest.
  */
@@ -41,11 +56,26 @@
 	{ .fw_name = "hosc" }
 };
 
+static const struct clk_parent_data dcxo[] = {
+	{ .fw_name = "dcxo" }
+};
+
 /*
- * PLL_REF: the root PLL feeding the peripheral PLLs. The BSP models extra
- * output/ldo/lock-enable bits that mainline ccu_nm_ops does not; as in the
- * A523 driver those bits are forced in probe() instead. We present the output
- * gate (bit 27) as the enable bit.
+ * PLL_REF: the root PLL feeding the peripheral PLLs. It is what makes
+ * SYS_CLK24M 24 MHz on a 26 MHz board, so its input is the DCXO and NOT the
+ * "hosc"/SYS_CLK24M net it helps produce — parenting it to "hosc" (as this
+ * driver did until now) computed 24 x 96 / 104 = 22.15 MHz where the silicon
+ * makes 24.000000, and every rate under pll-peri0/1 inherited the error.
+ *
+ * UM Table 4-3 "PLL Typical Configuration", REF_PLL row: DCXO 26, N(INT) 96,
+ * VCO 2496 MHz, OUT 24 MHz — i.e. 26 x 96 = 2496, 2496 / 104 = 24 exactly. The
+ * register agrees: CCU+0x0000 = 0xF8675F00 on the 6 GiB board and a second 6 GiB board (2026-07-22) ->
+ * N field 0x5F -> 96, M field 0x67 -> 104. Those are the numbers the fields
+ * below already decode; only the parent was wrong.
+ *
+ * The BSP models extra output/ldo/lock-enable bits that mainline ccu_nm_ops
+ * does not; as in the A523 driver those bits are forced in probe() instead. We
+ * present the output gate (bit 27) as the enable bit.
