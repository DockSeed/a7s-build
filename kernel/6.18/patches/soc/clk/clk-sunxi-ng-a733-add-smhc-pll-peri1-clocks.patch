From: DockSeed <dockseed@proton.me>
Subject: [PATCH] clk: sunxi-ng: A733 (sun60iw2) add PLL_PERI1 and the SMHC clocks

Storage prerequisite: the SD/eMMC controllers need module
clocks. Adds PLL_PERI1 (+ the same divider taps PLL_PERI0 has, one register
up at 0x00C0 — the UM lists PLL_PERI1_CTRL field-for-field identical to
PLL_PERI0_CTRL) and the SMHC0/1/2 module clocks with their bus resets.

PLL_PERI1 is required, not optional: read off silicon on two boards
(the 6 GiB board SD, the 8 GiB board eMMC) the vendor clocks SD off PERI1_400M and eMMC off
PERI1_800M (SMHC0_CLK=0x83000000 src=3, SMHC2_CLK src=3).

The SMHC rate is the clock source divided by M and N, with BOTH M (bits 4:0)
and N (bits 12:8) linear (N = FACTOR_N+1, A733 UM) and NO
fixed post-divider. It therefore uses SUNXI_CCU_DUALDIV_MUX_GATE
(CCU_FEATURE_DUAL_DIV, no fixed post-div) — NOT a plain ccu_mp (whose
second divider is a power-of-2) and NOT the A523's *_POSTDIV_DUALDIV, which
bakes in a fixed /2 the A733 does not have. Silicon confirms no post-div:
the 6 GiB board SMHC0 src=PERI1_400M (400 MHz) with M=N=0 reads back 400 MHz, not 200.
The DUALDIV macro lives in ccu_mp.h, which `clk-sunxi-ng-add-A733-sun60iw2-minimal-ccu` did not include; added here.

Register offsets (SMHC0 0x0D00, SMHC2 0x0D20), the mux source lists (SMHC0/1:
400M/300M; SMHC2: 800M/600M — not interchangeable) and the per-instance BGR
(reset bit 16, gate bit 0 at 0x0D0C/0x0D1C/0x0D2C) are from the A733 UM,
cross-checked against raw sunxi_dump reads on live silicon.

Based on drivers/clk/sunxi-ng/ccu-sun55i-a523.c, Copyright (C) 2023 Arm Ltd.

Assisted-by: Claude
---
--- a/include/dt-bindings/clock/sun60i-a733-ccu.h
+++ b/include/dt-bindings/clock/sun60i-a733-ccu.h
@@ -35,4 +35,23 @@
 #define CLK_UART5		20
 #define CLK_UART6		21
 
+#define CLK_PLL_PERI1		22
+#define CLK_PLL_PERI1_2X	23
+#define CLK_PLL_PERI1_800M	24
+#define CLK_PLL_PERI1_480M	25
+#define CLK_PLL_PERI1_600M	26
+#define CLK_PLL_PERI1_400M	27
+#define CLK_PLL_PERI1_300M	28
+#define CLK_PLL_PERI1_200M	29
+#define CLK_PLL_PERI1_160M	30
+#define CLK_PLL_PERI1_150M	31
+
+#define CLK_SMHC0		32
+#define CLK_SMHC1		33
+#define CLK_SMHC2		34
+
+#define CLK_BUS_SMHC0		35
+#define CLK_BUS_SMHC1		36
+#define CLK_BUS_SMHC2		37
+
 #endif /* _DT_BINDINGS_CLK_SUN60I_A733_CCU_H_ */
--- a/include/dt-bindings/reset/sun60i-a733-ccu.h
+++ b/include/dt-bindings/reset/sun60i-a733-ccu.h
@@ -15,4 +15,8 @@
 #define RST_BUS_UART5		5
 #define RST_BUS_UART6		6
 
+#define RST_BUS_SMHC0		7
+#define RST_BUS_SMHC1		8
+#define RST_BUS_SMHC2		9
+
 #endif /* _DT_BINDINGS_RST_SUN60I_A733_CCU_H_ */
--- a/drivers/clk/sunxi-ng/ccu-sun60iw2.c
+++ b/drivers/clk/sunxi-ng/ccu-sun60iw2.c
@@ -28,6 +28,7 @@
 
 #include "ccu_div.h"
 #include "ccu_gate.h"
+#include "ccu_mp.h"
 #include "ccu_mult.h"
 #include "ccu_nm.h"
 
@@ -99,6 +100,7 @@
  * (25..27); we present bit 27 as the enable and force 25/26 in probe().
  */
 #define SUN60IW2_PLL_PERI0_REG		0x00A0
+#define SUN60IW2_PLL_PERI1_REG		0x00C0
 static struct ccu_nm pll_peri0_clk = {
 	.enable		= BIT(27),
 	.lock		= BIT(28),
@@ -150,6 +152,64 @@
 			    pll_peri0_300m_hws, 2, 1, 0);
 
 /*
+ * PLL_PERI1 and its divider taps. Same register layout as PLL_PERI0 (the UM
+ * lists PLL_PERI1_CTRL field-for-field identical to PLL_PERI0_CTRL, only the
+ * names differ), one register up at 0x00C0. Three output-enable bits (25..27);
+ * bit 27 is the enable, 25/26 are forced in probe(). The vendor clocks the SD
+ * controller off PERI1_400M and eMMC off PERI1_800M, so PERI1 is required for
+ * storage, not optional.
+ */
+static struct ccu_nm pll_peri1_clk = {
+	.enable		= BIT(27),
+	.lock		= BIT(28),
+	.n		= _SUNXI_CCU_MULT_OFFSET_MIN_MAX(8, 8, 1, 53, 105),
+	.min_rate	= 1272000000U,
+	.max_rate	= 2520000000U,
+	.common		= {
+		.reg		= SUN60IW2_PLL_PERI1_REG,
+		.hw.init	= CLK_HW_INIT_PARENTS_HW("pll-peri1",
+				pll_ref_hws, &ccu_nm_ops,
+				CLK_SET_RATE_UNGATE | CLK_IS_CRITICAL),
+	},
+};
+static const struct clk_hw *pll_peri1_hws[] = { &pll_peri1_clk.common.hw };
+
+static SUNXI_CCU_M_HWS(pll_peri1_2x_clk, "pll-peri1-2x", pll_peri1_hws,
+		       0x00C0, 20, 3, 0);
+static const struct clk_hw *pll_peri1_2x_hws[] = {
+	&pll_peri1_2x_clk.common.hw
+};
+static SUNXI_CCU_M_HWS(pll_peri1_800m_clk, "pll-peri1-800m", pll_peri1_hws,
+		       0x00C0, 16, 3, 0);
+static SUNXI_CCU_M_HWS(pll_peri1_480m_clk, "pll-peri1-480m", pll_peri1_hws,
+		       0x00C0, 2, 3, 0);
+static const struct clk_hw *pll_peri1_480m_hws[] = {
+	&pll_peri1_480m_clk.common.hw
+};
+
+static CLK_FIXED_FACTOR_HWS(pll_peri1_600m_clk, "pll-peri1-600m",
+			    pll_peri1_2x_hws, 2, 1, 0);
+static const struct clk_hw *pll_peri1_600m_hws[] = {
+	&pll_peri1_600m_clk.hw
+};
+static CLK_FIXED_FACTOR_HWS(pll_peri1_400m_clk, "pll-peri1-400m",
+			    pll_peri1_2x_hws, 3, 1, 0);
+static const struct clk_hw *pll_peri1_400m_hws[] = {
+	&pll_peri1_400m_clk.hw
+};
+static CLK_FIXED_FACTOR_HWS(pll_peri1_300m_clk, "pll-peri1-300m",
+			    pll_peri1_600m_hws, 2, 1, 0);
+static const struct clk_hw *pll_peri1_300m_hws[] = {
+	&pll_peri1_300m_clk.hw
+};
+static CLK_FIXED_FACTOR_HWS(pll_peri1_200m_clk, "pll-peri1-200m",
+			    pll_peri1_400m_hws, 2, 1, 0);
+static CLK_FIXED_FACTOR_HWS(pll_peri1_160m_clk, "pll-peri1-160m",
+			    pll_peri1_480m_hws, 3, 1, 0);
+static CLK_FIXED_FACTOR_HWS(pll_peri1_150m_clk, "pll-peri1-150m",
+			    pll_peri1_300m_hws, 2, 1, 0);
+
+/*
  * Bus clocks. Mux order matches hardware: index 0 = 24 MHz, so the bus stays
  * alive on whatever U-Boot left selected. peri0-600m is the fast option.
  */
@@ -162,6 +222,7 @@
 
 static SUNXI_CCU_M_DATA_WITH_MUX(ahb_clk, "ahb", ahb_apb_parents, 0x0500,
 				 0, 5, 24, 2, CLK_SET_RATE_PARENT);
+static const struct clk_hw *ahb_hws[] = { &ahb_clk.common.hw };
 static SUNXI_CCU_M_DATA_WITH_MUX(apb0_clk, "apb0", ahb_apb_parents, 0x0510,
 				 0, 5, 24, 2, CLK_SET_RATE_PARENT);
 static SUNXI_CCU_M_DATA_WITH_MUX(apb1_clk, "apb1", ahb_apb_parents, 0x0518,
@@ -188,6 +249,59 @@
 static SUNXI_CCU_GATE_HWS(uart5_clk, "uart5", apb_uart_hws, 0x0E14, BIT(0), 0);
 static SUNXI_CCU_GATE_HWS(uart6_clk, "uart6", apb_uart_hws, 0x0E18, BIT(0), 0);
 
+/*
+ * SMHC (SD/MMC) module clocks. The rate is the clock source divided by M and N, with
+ * both M (bits 4:0) and N (bits 12:8) LINEAR (N = FACTOR_N+1, per the A733 user
+ * manual) and NO fixed post-divider (unlike the A523, which has /2).
+ * SUNXI_CCU_DUALDIV_MUX_GATE models both dividers as linear (CCU_FEATURE_DUAL_DIV,
+ * no fixed post-divider) -- do NOT use a plain ccu_mp (second divider is a
+ * power-of-2) nor the A523's *_POSTDIV_DUALDIV (adds a fixed /2 the A733 lacks). SMHC0/1 select among the
+ * 400M/300M peripheral taps, SMHC2 among 800M/600M; the mux lists are not
+ * interchangeable (UM).
+ */
+static const struct clk_parent_data smhc0_parents[] = {
+	{ .fw_name = "hosc" },			/* sys24M */
+	{ .hw = &pll_peri0_400m_clk.hw },	/* pll-peri0-400m */
+	{ .hw = &pll_peri0_300m_clk.hw },	/* pll-peri0-300m */
+	{ .hw = &pll_peri1_400m_clk.hw },	/* pll-peri1-400m */
+	{ .hw = &pll_peri1_300m_clk.hw },	/* pll-peri1-300m */
+};
+
+static const struct clk_parent_data smhc2_parents[] = {
+	{ .fw_name = "hosc" },			/* sys24M */
+	{ .hw = &pll_peri0_800m_clk.common.hw },/* pll-peri0-800m */
+	{ .hw = &pll_peri0_600m_clk.hw },	/* pll-peri0-600m */
+	{ .hw = &pll_peri1_800m_clk.common.hw },/* pll-peri1-800m */
+	{ .hw = &pll_peri1_600m_clk.hw },	/* pll-peri1-600m */
+};
+
+static SUNXI_CCU_DUALDIV_MUX_GATE(smhc0_clk, "smhc0", smhc0_parents,
+					     0x0D00,
+					     0, 5,	/* M */
+					     8, 5,	/* N */
+					     24, 3,	/* mux */
+					     BIT(31),	/* gate */
+					     CLK_SET_RATE_PARENT);
+static SUNXI_CCU_DUALDIV_MUX_GATE(smhc1_clk, "smhc1", smhc0_parents,
+					     0x0D10,
+					     0, 5,	/* M */
+					     8, 5,	/* N */
+					     24, 3,	/* mux */
+					     BIT(31),	/* gate */
+					     CLK_SET_RATE_PARENT);
+static SUNXI_CCU_DUALDIV_MUX_GATE(smhc2_clk, "smhc2", smhc2_parents,
+					     0x0D20,
+					     0, 5,	/* M */
+					     8, 5,	/* N */
+					     24, 3,	/* mux */
+					     BIT(31),	/* gate */
+					     CLK_SET_RATE_PARENT);
+
+/* SMHC bus gates: the gate bit (0) of each per-instance BGR register. */
+static SUNXI_CCU_GATE_HWS(bus_smhc0_clk, "bus-smhc0", ahb_hws, 0x0D0C, BIT(0), 0);
+static SUNXI_CCU_GATE_HWS(bus_smhc1_clk, "bus-smhc1", ahb_hws, 0x0D1C, BIT(0), 0);
+static SUNXI_CCU_GATE_HWS(bus_smhc2_clk, "bus-smhc2", ahb_hws, 0x0D2C, BIT(0), 0);
+
 /* ccu_common-based clocks (registered and reset-mapped by the core). */
 static struct ccu_common *sun60iw2_ccu_clks[] = {
 	&pll_ref_clk.common,
@@ -195,6 +309,10 @@
 	&pll_peri0_2x_clk.common,
 	&pll_peri0_800m_clk.common,
 	&pll_peri0_480m_clk.common,
+	&pll_peri1_clk.common,
+	&pll_peri1_2x_clk.common,
+	&pll_peri1_800m_clk.common,
+	&pll_peri1_480m_clk.common,
 	&ahb_clk.common,
 	&apb0_clk.common,
 	&apb1_clk.common,
@@ -206,6 +324,12 @@
 	&uart4_clk.common,
 	&uart5_clk.common,
 	&uart6_clk.common,
+	&smhc0_clk.common,
+	&smhc1_clk.common,
+	&smhc2_clk.common,
+	&bus_smhc0_clk.common,
+	&bus_smhc1_clk.common,
+	&bus_smhc2_clk.common,
 };
 
 static struct clk_hw_onecell_data sun60iw2_hw_clks = {
@@ -221,6 +345,16 @@
 		[CLK_PLL_PERI0_200M]	= &pll_peri0_200m_clk.hw,
 		[CLK_PLL_PERI0_160M]	= &pll_peri0_160m_clk.hw,
 		[CLK_PLL_PERI0_150M]	= &pll_peri0_150m_clk.hw,
+		[CLK_PLL_PERI1]		= &pll_peri1_clk.common.hw,
+		[CLK_PLL_PERI1_2X]	= &pll_peri1_2x_clk.common.hw,
+		[CLK_PLL_PERI1_800M]	= &pll_peri1_800m_clk.common.hw,
+		[CLK_PLL_PERI1_480M]	= &pll_peri1_480m_clk.common.hw,
+		[CLK_PLL_PERI1_600M]	= &pll_peri1_600m_clk.hw,
+		[CLK_PLL_PERI1_400M]	= &pll_peri1_400m_clk.hw,
+		[CLK_PLL_PERI1_300M]	= &pll_peri1_300m_clk.hw,
+		[CLK_PLL_PERI1_200M]	= &pll_peri1_200m_clk.hw,
+		[CLK_PLL_PERI1_160M]	= &pll_peri1_160m_clk.hw,
+		[CLK_PLL_PERI1_150M]	= &pll_peri1_150m_clk.hw,
 		[CLK_AHB]		= &ahb_clk.common.hw,
 		[CLK_APB0]		= &apb0_clk.common.hw,
 		[CLK_APB1]		= &apb1_clk.common.hw,
@@ -232,8 +366,14 @@
 		[CLK_UART4]		= &uart4_clk.common.hw,
 		[CLK_UART5]		= &uart5_clk.common.hw,
 		[CLK_UART6]		= &uart6_clk.common.hw,
+		[CLK_SMHC0]		= &smhc0_clk.common.hw,
+		[CLK_SMHC1]		= &smhc1_clk.common.hw,
+		[CLK_SMHC2]		= &smhc2_clk.common.hw,
+		[CLK_BUS_SMHC0]		= &bus_smhc0_clk.common.hw,
+		[CLK_BUS_SMHC1]		= &bus_smhc1_clk.common.hw,
+		[CLK_BUS_SMHC2]		= &bus_smhc2_clk.common.hw,
 	},
-	.num	= CLK_UART6 + 1,
+	.num	= CLK_BUS_SMHC2 + 1,
 };
 
 static struct ccu_reset_map sun60iw2_ccu_resets[] = {
@@ -244,6 +384,9 @@
 	[RST_BUS_UART4]		= { 0x0E10, BIT(16) },
 	[RST_BUS_UART5]		= { 0x0E14, BIT(16) },
 	[RST_BUS_UART6]		= { 0x0E18, BIT(16) },
+	[RST_BUS_SMHC0]		= { 0x0D0C, BIT(16) },
+	[RST_BUS_SMHC1]		= { 0x0D1C, BIT(16) },
+	[RST_BUS_SMHC2]		= { 0x0D2C, BIT(16) },
 };
 
 static const struct sunxi_ccu_desc sun60iw2_ccu_desc = {
@@ -259,6 +402,7 @@
 static const u32 pll_regs[] = {
 	SUN60IW2_PLL_REF_REG,
 	SUN60IW2_PLL_PERI0_REG,
+	SUN60IW2_PLL_PERI1_REG,
 };
 
 static int sun60iw2_ccu_probe(struct platform_device *pdev)
@@ -287,6 +431,11 @@
 	val |= BIT(27) | BIT(26) | BIT(25);
 	writel(val, reg + SUN60IW2_PLL_PERI0_REG);
 
+	/* PLL_PERI1 likewise has three output gates (25..27). */
+	val = readl(reg + SUN60IW2_PLL_PERI1_REG);
+	val |= BIT(27) | BIT(26) | BIT(25);
+	writel(val, reg + SUN60IW2_PLL_PERI1_REG);
+
 	return devm_sunxi_ccu_probe(&pdev->dev, reg, &sun60iw2_ccu_desc);
 }
 
