 static SUNXI_CCU_GATE_HWS(bus_dpss_top1_clk, "bus-dpss-top1", ahb_hws, 0x16CC, BIT(0), 0);
 
+/*
+ * The display engine: DE0_CLK_REG 0x0A00 (abs 0x02002A00), DE0_BGR_REG 0x0A04
+ * (abs 0x02002A04) and PLL_DE 0x02E0 (abs 0x020022E0) with both its output
+ * taps -- the PLL that drives this block and, on this silicon, nothing else.
+ *
+ *   pll-ref 24 MHz -> PLL_DE (VCO) -+-> DEPLL4X --+
+ *                                   +-> DEPLL3X --+
+ *   pll-peri0-480m/400m/300m --------------------+-> DE0_CLK -> display engine
+ *   video0-pll4x, video2-pll4x ------------------+
+ *
+ * DE0_CLK_REG, offset 0x0A00, abs 0x02002A00, reset 0x0000_0000 (A733 UM V0.92,
+ * the A733 user manual; field table of DE0_CLK_REG):
+ *
+ *   31      DE0_CLK_GATING   0=Clock is OFF 1=Clock is ON
+ *   26:24   CLK_SRC_SEL      000 DEPLL3X     001 DEPLL4X    010 PERI0_480M
+ *                            011 PERI0_400M  100 PERI0_300M 101 VIDEO0PLL4X
+ *                            110 VIDEO2PLL4X
+ *   4:0     FACTOR_M         M = FACTOR_M + 1, field 0..31
+ *                            (A733 user manual)
+ *   DE0_CLK = Clock Source / M
+ *
+ * ⚠ FACTOR_M IS THE FIELD, M IS THE DIVISOR, AND THEY ARE NEVER THE SAME
+ * NUMBER. The UM writes the relation out -- M = FACTOR_M + 1 -- so the vendor's
+ * live DE0_CLK word 0x80000000 has FACTOR_M = 0 and therefore DIVISOR M = 1,
+ * i.e. the engine runs at the full source rate. M = 0 cannot occur: the UM's own
+ * formula divides by M. This is the same field-versus-value distinction the UM
+ * makes for PLL_N (N = PLL_N + 1) and it has already caused one misread of this
+ * register, so every mention below says which of the two it means.
+ *
+ * ⚠ FACTOR_M is also LINEAR, and the UM states it rather than leaving it to be
+ * inferred: a 5-bit field with an arithmetic range of 0..31 and "M = FACTOR_M
+ * + 1" cannot be a shift. There is only ONE divider here -- unlike EDP_TV_CLK
+ * above, which has both an M and an N and needs SUNXI_CCU_DUALDIV_MUX_GATE.
+ *
+ * DE0_BGR_REG, offset 0x0A04, abs 0x02002A04, reset 0x0000_0000:
+ *   16      DE0_RST     0=Assert 1=De-assert
+ *   0       DE0_GATING  0=Mask   1=Pass
+ *
+ * The bus parent is ahb, and as for the VIDEO_OUT1 gates above that is the UM's
+ * own name rather than an inference: AHB_MAT_CLK_GATING_REG 0x05C0 (abs
+ * 0x020025C0) bit 5 is DE_AHB_GATE_SW_CFG (register list and field table
+ * of the A733 user manual). Its reset value 0x110103FF already
+ * has that bit set, so nothing here writes it.
+ *
+ * ⚠ Reset first, then the gate -- UM 4.1.4.4: deassert a module's reset
+ * before opening its bus clock gate, because the reset is released
+ * asynchronously, so the order matters.
+ * That ordering is the
+ * consumer's to honour (reset_control_deassert() before clk_prepare_enable()),
+ * and it is not cosmetic: `clk-sunxi-ng-a733-add-edp-bus-gate-and-reset` measured the neighbouring eDP block reading
+ * 0x00000000 across its whole 4 KiB window with the gate set and the reset
+ * still asserted -- indistinguishable from a dead block.
+ *
+ * WHAT THE DE NEEDS FROM THE CCU AND IS NOT HERE, each already in its working
+ * state at power-on. Absolute addresses given, because an offset read against
+ * the wrong base returns a plausible number rather than an error:
+ *   DE_SYS_BGR_REG   0x0A74 / abs 0x02002A74  reset 0x00010000 -- bit 16
+ *                    DE_SYS_RST only, NO gate bit in this register, de-asserted
+ *                    at POR. The 6 GiB board read exactly 0x00010000.
+ *   AHB_MAT_CLK_GATING_REG  0x05C0 / abs 0x020025C0  bit 5, reset 1
+ *                    (A733 user manual). The 6 GiB board read 0x110103ff, bit 5 set.
+ *   MBUS_MAT_CLK_GATING_REG 0x05E0 / abs 0x020025E0  bit 11
+ *                    DESYS_MBUS_GATE_SW_CFG, reset 1 -- the path
+ *                    both the scanout fetch and the RCQ descriptor fetch take,
+ *                    absent because it is already open.
+ *   CM_DESYS_CFG_REG 0x1B04 / abs 0x02003B04  reset 0x00020000 = STATUS
+ *                    "Power ON", MODULE_MODE 0. The 6 GiB board read that
+ *                    with its display path up: on this SoC MODULE_MODE is not
+ *                    the effective gate for a running block, as for CM_VO1 and
+ *                    CM_USB2. No power domain is wired, here or in the DT.
+ *
+ * DEPLL_GATE_EN_REG 0x1928 / abs 0x02003928 -- a SECOND gate stage in series
+ * with the PLL's own OUTPUT0/1_GATE: bit 17 DEPLL3X_GATE_SW_CFG, bit 16
+ * DEPLL4X_GATE_SW_CFG, bits 1/0 the matching AUTO_GATE_EN, reset 0x00030003
+ * (A733 user manual). Not modelled,
+ * and the reason is narrower than "nothing writes it" -- because something
+ * does. On the vendor system with its DE live this register reads 0x00030000:
+ * the two SW gates still at their permissive reset value, and both AUTO_GATE_EN
+ * bits CLEARED, i.e. switched from the reset "No-Auto" to "Auto". The vendor
+ * does the same thing one register along for the video PLLs -- the 6 GiB board read
+ * VIDEOPLL_GATE_EN_REG abs 0x02003910 = 0x00770000. So
+ * the SW gates need no write, which is why this driver has none; the
+ * auto-gating is a power feature this tree does not implement.
+ */
+#define SUN60IW2_PLL_DE_REG		0x02E0
+
+/*
+ * UM Table 4-2, PLL_DE row: VCO 1.26 GHz .. 2.52 GHz, input pre-divider 1/2,
+ * P0 1..8, P1 1..8, default VCO 2.088 GHz. The floor is
+ * 1272 and not 1260 for the reason the video PLLs above give in full: 1272 =
+ * 24 * 53 is the lowest VCO that is both inside the documented window and
+ * exactly reachable from the 24 MHz reference, so ccu_nm_determine_rate()'s
+ * clamp lands on a rate ccu_nm_set_rate() can actually produce.
+ */
+#define SUN60IW2_PLL_DE_MIN_VCO		1272000000U
+#define SUN60IW2_PLL_DE_MAX_VCO		2520000000U
+
+/*
+ * PLL_DE_CTRL bits that are not modelled as clock gates. Same positions as the
+ * video PLLs above, named separately because they belong to a different PLL.
+ */
+#define SUN60IW2_PLL_DE_LDO_EN		BIT(30)
+#define SUN60IW2_PLL_DE_LOCK_ENABLE	BIT(29)
+
+/*
+ * PLL_DE IS THE DISPLAY ENGINE'S PLL, AND ON THIS SILICON IT IS ITS ONLY USER.
+ * That sentence is measured, not assumed, and an earlier version of this file
+ * assumed the opposite loudly enough that the correction belongs here.
+ *
+ * The UM's PLL distribution table lists six consumers -- "NSI, DE0, VE, NPU,
+ * DRAM0, CSI". That is a map of what MAY be sourced from
+ * this PLL, not of what is: every one of them reaches DEPLL3X through a
+ * selectable mux with other inputs, and DE0 is the only one whose mux RESETS to
+ * it. All of them were then read on the vendor system with its display engine
+ * genuinely live -- DE version word 0x05008014 = 0x03520100, VI channel 0
+ * scanout address 0x05101018 = 0xFC000000, picture on the monitor:
+ *
+ *   block    register (abs)  value        [26:24]  DEPLL3X idx  on DEPLL3X?
+ *   NSI      0x02002580      0xC3000000   011      101          no (PERI0_600M)
+ *   DRAM0    0x02002C00      0x80000003   000      011          no (DDRPLL)
+ *   VE_ENC0  0x02002A80      0x01000000   001      101          no (VE1PLL)
+ *   VE_DEC   0x02002A88      0x01000000   001      101          no (VE0PLL)
+ *   NPU      0x02002B00      0x00000000   000      110          no (NPUPLL)
+ *   DE0      0x02002A00      0x80000000   000      000          YES
+ *
+ * NSI was then read again at the U-Boot prompt on a cold power-cycle of OUR own
+ * boot chain and answers the same: 0xC3000000, CLK_SEL 011 = PERI0_600M. So the
+ * interconnect is off DEPLL3X in both states, and the answer does not depend on
+ * whose operating system is running.
+ *
+ * (Mux enums: the A733 user manual, NSI_CLK_REG, VE_ENC0,
+ * VE_DEC, NPU and DRAM0 clock registers.) NSI -- the SoC interconnect, the one
+ * that would have made this PLL untouchable -- is on PERI0_600M. The UM's
+ * sentence about it is conditional: DEPLL3X is recommended as the NSI source only
+ * when NSI_CLK runs at 700 MHz, and this board
+ * does not take that option.
+ *
+ * ⚠ The one row not read is CSI. This tree has no CSI driver and no CSI node,
+ * so nothing here can be disturbed through it; whoever adds one inherits this
+ * PLL exactly as `clk-sunxi-ng-a733-video-plls-and-edp-tv-pixel-clock`'s PLL_VIDEO1 comment says CSI_MASTER inherits that one.
+ *
+ * AND WHAT OUR OWN CHAIN HANDS LINUX, read at the U-Boot prompt on a cold
+ * power-cycle -- nothing had run:
+ *
+ *   PLL_DE_CTRL   abs 0x020022E0 = 0x41125600   PLL_EN 0 -> the PLL is OFF
+ *   DE0_CLK       abs 0x02002A00 = 0x00000000   gate off, mux 000 = DEPLL3X
+ *   DE0_BGR       abs 0x02002A04 = 0x00000000   bus gate off, reset asserted
+ *   DEPLL_GATE_EN abs 0x02003928 = 0x00030003   exactly the UM default
+ *
+ * That is the state this driver has to work from, and it is the argument for
+ * everything below. The mux ALREADY points at DEPLL3X, and DEPLL3X is OFF. So a
+ * display driver that ungates DE0 and leaves the clock tree alone gets a
+ * stopped clock and reads 0x00000000 out of the whole 4 MiB aperture with its
+ * gate and its reset both correct -- which is indistinguishable from the
+ * reset-ordering bug `clk-sunxi-ng-a733-add-edp-bus-gate-and-reset` measured on eDP, and would send the next session
+ * looking in the wrong place.
+ *
+ * There are exactly two ways out of that, and no third: move the mux to a
+ * peripheral tap and never own the PLL, or keep the mux where the silicon puts
+ * it and own the PLL properly. This file does the second.
+ *
+ * ⇒ So this block is modelled the way `clk-sunxi-ng-a733-video-plls-and-edp-tv-pixel-clock` models the video PLLs, and for the
+ * same reasons: real clk_ops, rate propagation on, and the enable under the
+ * framework rather than hidden. An unclaimed clock is an off clock, and a
+ * refcount bug shows up as a dark screen instead of hiding.
+ *
+ * ⚠ WHAT THAT MEANS ON A BOARD WITH NO DE DRIVER: clk_disable_unused() will
+ * clear PLL_EN. That is a behaviour change from this patch's first cut, which
+ * modelled the PLL with no enable bit at all and therefore could not switch it
+ * off. It is safe exactly to the extent of the table above -- five of the six
+ * documented consumers measured off DEPLL3X, the sixth (CSI) absent from this
+ * tree -- and PLL_EN is 0 at reset anyway. No CLK_IGNORE_UNUSED
+ * anywhere, as everywhere else in this file.
+ *
+ * THE LOCK SEQUENCE IS HONOURED, AND THIS IS THE PART THAT NEEDED CHECKING.
+ * UM 4.1.4.1 Method 2 wants: set the factors, set PLL_EN and LOCK_ENABLE, wait
+ * for LOCK, wait 20 us, THEN open the output gate.
+ * ccu_nm_ops calls ccu_helper_wait_for_lock() from ccu_nm_set_rate() and from
+ * nowhere else, so a PLL that is enabled but never set_rate never waits. Three
+ * things make the sequence come out right here, and all three are checkable:
+ *   - CLK_SET_RATE_UNGATE on pll-de. clk_change_rate() prepares and ENABLES the
+ *     clock before calling ->set_rate and drops it afterwards (clk.c:2418,
+ *     :2452), so the lock poll inside ccu_nm_set_rate() runs on a PLL that is
+ *     actually on. This is the same flag the video PLLs above carry.
+ *   - the output gate is a separate clock (the tap below), enabled by the
+ *     consumer after the rate is set -- which is the UM's ordering.
+ *   - the consumer sets the rate before enabling. mainline's sun8i_mixer_probe()
+ *     does exactly that: clk_set_rate(mod_clk, cfg->mod_rate) and only then
+ *     clk_prepare_enable(mod_clk) (drivers/gpu/drm/sun4i/sun8i_mixer.c:618-625).
+ *     A DE driver that enables first would skip the lock wait -- stated here
+ *     because it is a constraint on the consumer, not on this file.
+ */
+static struct ccu_nm pll_de_clk = {
+	.enable		= BIT(31),
+	.lock		= BIT(28),
+	.n		= _SUNXI_CCU_MULT_OFFSET_MIN_MAX(8, 8, 1, 12, 255),
+	.m		= _SUNXI_CCU_DIV(1, 1),
+	.min_rate	= SUN60IW2_PLL_DE_MIN_VCO,
+	.max_rate	= SUN60IW2_PLL_DE_MAX_VCO,
+	.common		= {
+		.reg		= SUN60IW2_PLL_DE_REG,
+		.hw.init	= CLK_HW_INIT_PARENTS_HW("pll-de",
+				pll_ref_hws, &ccu_nm_ops,
+				CLK_SET_RATE_UNGATE),
+	},
+};
+
+static const struct clk_hw *pll_de_hws[] = { &pll_de_clk.common.hw };
+
+/*
+ * The two output taps: PLL_OUTPUT0_DIV [22:20] carries "DEPLL4X" gated by
+ * PLL_OUTPUT0_GATE (bit 27), PLL_OUTPUT1_DIV [18:16] carries "DEPLL3X" gated by
+ * PLL_OUTPUT1_GATE (bit 26). Each P = field + 1 over a field range of 0..7
+ * (A733 user manual); the register's own formulas are
+ * DEPLL4X = InputFreq * N/M1/P0 and DEPLL3X = InputFreq * N/M1/P1
+ * (A733 user manual).
+ *
+ * ⚠ "4X" and "3X" are names, not factors -- the same warning the video PLLs
+ * above carry. And this PLL is found at TWO DIFFERENT RATES depending on what
+ * ran before, which is the whole case against a fixed-rate model:
+ *
+ *   state                              PLL_DE_CTRL   N    VCO     DEPLL3X
+ *   cold, our chain, U-Boot prompt     0x41125600    87   2088    696 MHz
+ *   vendor Linux, both boards          0x*5124A00    75   1800    600 MHz
+ *
+ * The cold word is the UM's documented reset value 0x40125600
+ * plus the reserved bit 24, which the 2026-08-19 U-Boot session already found
+ * set on PLL_VIDEO1 and concluded is a power-on value. So OUR boot chain does
+ * not touch PLL_DE at all -- the 600 MHz state is the vendor's Linux, not the
+ * firmware. A clk_fixed_rate would therefore be wrong in one of the two states
+ * whichever number it hardcoded. ccu_nm reads the register.
+ *
+ * Both taps are modelled even though only DEPLL3X has a consumer, because
+ * DE0_CLK's mux names both and ccu_mux_helper_get_parent() hands the raw field
+ * back as an index. CLK_SET_RATE_PARENT on each, so one clk_set_rate() on the
+ * engine configures divider, tap and PLL -- the idiom every mainline sunxi
+ * display driver uses, and the one `clk-sunxi-ng-a733-video-plls-and-edp-tv-pixel-clock` already proved on this SoC.
+ */
+static SUNXI_CCU_M_HWS_WITH_GATE(de_pll4x_clk, "de-pll4x", pll_de_hws,
+				 SUN60IW2_PLL_DE_REG, 20, 3, BIT(27),
+				 CLK_SET_RATE_PARENT);
+static SUNXI_CCU_M_HWS_WITH_GATE(de_pll3x_clk, "de-pll3x", pll_de_hws,
+				 SUN60IW2_PLL_DE_REG, 16, 3, BIT(26),
+				 CLK_SET_RATE_PARENT);
+
+/*
+ * DE0_CLK -- the display engine's module clock. All seven documented mux inputs
+ * are modelled: ccu_mux_helper_get_parent() returns the raw register field as a
+ * parent index, so a partially populated mux does not fail loudly -- it reports
+ * the wrong parent, or orphans the clock when the index exceeds num_parents.
+ * Here that is not hypothetical: index 0 is the mux's RESET value and it is
+ * where the vendor's live board sits, so a model missing a parent at index 0
+ * would mis-describe the state this hardware is actually found in. Index 111 is
+ * undocumented and nothing writes it.
+ *
+ * CLK_SET_RATE_PARENT | CLK_SET_RATE_NO_REPARENT -- the same pair `clk-sunxi-ng-a733-video-plls-and-edp-tv-pixel-clock` gives
+ * edp-tv, for the same two reasons. Propagation, because one clk_set_rate() on
+ * the module clock should configure the whole chain rather than have a driver
+ * poke CCU registers behind the framework. NO_REPARENT, because which of the
+ * seven sources drives the engine is a pipeline decision that belongs in the
+ * device tree: without it ccu_mux_helper_determine_rate() walks all seven
+ * parents on every rate request, and ccu_nm_recalc_rate() reports a rate from
+ * the register fields whether or not PLL_EN is set, so an off PLL_VIDEO0 or
+ * PLL_VIDEO2 advertises a rate it cannot deliver.
+ *
+ * Worked through for the one mode this path drives, 1920x1200, because "it
+ * propagates" is not a claim anyone can check. A DE driver asking for
+ * mainline's DE33 mod_rate of 600 MHz with the device tree's parent pinned to
+ * DEPLL3X: ccu_div_round_rate() tries divisor 1 and asks de-pll3x for 600 MHz;
+ * de-pll3x tries P1 = 3 and asks pll-de for 1800 MHz; ccu_nm_find_best()
+ * returns N = 75, M1 = 1 exactly (24 * 75 = 1800). Fields programmed:
+ *   PLL_DE_CTRL [15:8] = 0x4A, [1] = 0, [18:16] = 2
+ *   DE0_CLK     [4:0]  = 0  (FACTOR_M = 0, i.e. DIVISOR M = 1)
