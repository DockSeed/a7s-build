+static const struct clk_parent_data npu_parents[] = {
+	{ .hw = &npupll_clk.common.hw },		/* 000 NPUPLL     */
+	{ .hw = &pll_peri0_800m_clk.common.hw },	/* 001 PERI0_800M */
+	{ .hw = &pll_peri0_600m_clk.hw },		/* 010 PERI0_600M */
+	{ .hw = &pll_peri0_480m_clk.common.hw },	/* 011 PERI0_480M */
+	{ .index = -1, .name = "pll-ve0" },		/* 100 VE0PLL     */
+	{ .index = -1, .name = "pll-ve1" },		/* 101 VE1PLL     */
+	{ .hw = &de_pll3x_clk.common.hw },		/* 110 DEPLL3X    */
