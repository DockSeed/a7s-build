--- a/include/dt-bindings/clock/sun60i-a733-ccu.h
+++ b/include/dt-bindings/clock/sun60i-a733-ccu.h
@@ -110,4 +110,19 @@
 #define CLK_DE0			72
 #define CLK_BUS_DE0		73
 
+/*
+ * The NPU. Six clocks, each naming one register field: PLL_NPU's VCO
+ * (PLL_NPU_CTRL 0x02A0, N and M1) and its single output tap "NPUPLL"
+ * ([22:20] P0 + output gate), the module clock NPU_CLK 0x0B00, the block's
+ * own bus gate NPU_BGR 0x0B04 bit 0, and the two bus-matrix master gates the
+ * NPU needs as an AHB/MBUS master -- AHB_MAT_CLK_GATING 0x05C0 bit 6 and
+ * MBUS_MAT_CLK_GATING 0x05E0 bit 18.
+ */
+#define CLK_PLL_NPU		74
+#define CLK_NPUPLL		75
+#define CLK_NPU			76
+#define CLK_BUS_NPU		77
+#define CLK_AHB_NPU		78
+#define CLK_MBUS_NPU		79
+
 #endif /* _DT_BINDINGS_CLK_SUN60I_A733_CCU_H_ */
--- a/include/dt-bindings/reset/sun60i-a733-ccu.h
+++ b/include/dt-bindings/reset/sun60i-a733-ccu.h
@@ -47,4 +47,15 @@
 /* Display engine -- DE0_BGR_REG 0x0A04 bit16. There is no DE1 on this SoC. */
 #define RST_BUS_DE0		27
 
+/*
+ * NPU -- NPU_BGR_REG 0x0B04, bit16 CORE, bit17 AXI, bit18 AHB (0 = Assert,
+ * 1 = De-assert). The register's fourth reset, bit19 NPU_SRAM_RST, is NOT
+ * here: it is the only one of the four that resets DE-asserted, no consumer
+ * in this tree asks for it, and an id nothing references is dead code. It is
+ * named so it is not mistaken for a gap.
+ */
+#define RST_BUS_NPU		28
+#define RST_BUS_NPU_AXI		29
+#define RST_BUS_NPU_AHB		30
+
 #endif /* _DT_BINDINGS_RST_SUN60I_A733_CCU_H_ */
--- a/drivers/clk/sunxi-ng/ccu-sun60iw2.c
+++ b/drivers/clk/sunxi-ng/ccu-sun60iw2.c
@@ -1097,6 +1097,410 @@
  */
 static SUNXI_CCU_GATE_HWS(bus_de0_clk, "bus-de0", ahb_hws, 0x0A04, BIT(0), 0);
 
+/*
+ * The NPU -- a VeriSilicon VIP ("3 Tops NPU"; model 0x9000,
+ * revision 0x9202 read off silicon).
+ *
+ * Six clocks, and every one of them names one register field. The addresses
+ * are given absolute as well as by offset throughout, because an offset read
+ * against the wrong base returns a plausible number instead of an error --
+ * the A523-base mix-up that already cost this tree a session.
+ *
+ *   pll-npu   PLL_NPU_CTRL 0x02A0 / abs 0x020022A0, [15:8] N and [1] M1,
+ *             enable bit 31, lock bit 28
+ *   npupll    the same register's single output tap, [22:20] P0 gated by
+ *             PLL_OUTPUT_GATE bit 27
+ *   npu       NPU_CLK 0x0B00 / abs 0x02002B00 -- mux [26:24], divider [4:0],
+ *             gate bit 31
+ *   bus-npu   NPU_BGR 0x0B04 / abs 0x02002B04 bit 0 NPU_GATING; its three
+ *             resets are in the reset map below
+ *   ahb-npu   AHB_MAT_CLK_GATING  0x05C0 / abs 0x020025C0 bit 6,  reset 1
+ *
+ *   mbus-npu  MBUS_MAT_CLK_GATING 0x05E0 / abs 0x020025E0 bit 18, reset 1
+ *
+ *
+ * Field tables: A733 user manual, section 4.1.6.
+ *
+ *
+ * WHY THE PLL IS TWO CLOCKS. The register's own formula is
+ * "The NPUPLL = 24MHz*N/M1/P0" and ccu_nm models only N and
+ * M1 -- it has no configurable post-divider. So the VCO is the ccu_nm and P0
+ * is a separate divider clock, exactly as pll-video0/video0-pll4x and
+ * pll-de/de-pll3x above. That split is also what makes the reset default
+ * readable as a frequency: 0x4010_4500 is N = 0x45 + 1 = 70, M1 = 0 + 1 = 1,
+ * P0 = 1 + 1 = 2, i.e. a 1680 MHz VCO and an 840 MHz output -- the row the
+ * UM's own typical-configuration table carries (24 / N 70 / VCO 1680 /
+ * OUT 840). PLL_EN is 0 at reset, so that is the frequency
+ * the reset FIELDS encode, not an output present at reset.
+ *
+ * AND THE PLL IS FOUND AT TWO DIFFERENT N VALUES, which is the whole case
+ * against a clk_fixed_rate here:
+ *
+ *   state                                 PLL_NPU_CTRL   N    VCO     OUT
+ *   the 6 GiB board, mainline etnaviv, idle          0x01104500     70   1680    840 MHz
+ *   the 6 GiB board, mainline etnaviv, resumed       0xf9104500     70   1680    840 MHz
+ *   vendor-kernel board, vendor 6.6 vipcore, idle   0x01105300     84   2016   1008 MHz
+ *
+ * ⚠ All three have BIT 24 SET, which lands inside the 26:23 field the UM calls
+ * reserved. It is decoded here rather than passed over
+ * because a reader checking these words against the field table will find it:
+ * the same bit was found set on PLL_VIDEO1 and PLL_DE at a cold U-Boot prompt
+ * on 2026-08-19 and concluded to be a power-on value. Nothing here writes it
+ * -- probe() and ccu_nm_set_rate() both read-modify-write -- so it survives.
+ *
+ * A clk_fixed_rate would be wrong at one of those two rates whichever number
+ * it hardcoded. ccu_nm reads the register. The boards and readings are in
+ * the table above.
+ * The vendor-kernel board was only read; nothing was written.
+ *
+ * ⚠ THE PLL IS SHARED, AND THAT HAD TO BE SWEPT BEFORE ITS ENABLE WAS MODELLED.
+ * UM figure 4-2 "PLL Distribution" lists PLL_NPU as feeding MBUS, VE, NPU and
+ * DRAM0 -- and two of those would take the SoC down with
+ * them. Modelling PLL_EN as this clock's own enable means clk_disable_unused()
+ * can clear it on a kernel with no NPU driver, so the question is not
+ * academic. It is the same question `clk-sunxi-ng-a733-display-engine-clock-gate-reset` had to answer for PLL_DE, and the
+ * answer has the same shape: an exhaustive register sweep, not an argument.
+ *
+ * Exactly FIVE CCU registers name NPUPLL in a source mux at all -- every
+ * register in the A733 user manual whose field enum contains the
+ * string, which is the figure's list with VE counted twice. All five read on
+ * a board on the vendor kernel while it was up and running, 2026-08-25:
+ *
+ *   register           abs          value        mux -> source
+ *   MBUS_CLK_REG       0x02002588   0x81000000   001 PERI0_600M
+ *   VE_ENC0_CLK_REG    0x02002a80   0x01000000   001 VE1PLL   (gate off)
+ *   VE_DEC_CLK_REG     0x02002a88   0x01000000   001 VE0PLL   (gate off)
+ *   DRAM0_CLK_REG      0x02002c00   0x80000003   000 DDRPLL
+ *   NPU_CLK_REG        0x02002b00   0x00000000   000 NPUPLL   (gate off)
