+static SUNXI_CCU_M_HWS_WITH_GATE(npupll_clk, "npupll", pll_npu_hws,
+				 SUN60IW2_PLL_NPU_REG, 20, 3, BIT(27),
+				 CLK_SET_RATE_PARENT);
