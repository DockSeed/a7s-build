+	 * stays the clock's own enable, under the framework.
+	 *
+	 * ⚠ HERE THE RESET DEFAULT IS NOT WHAT THE BOARD IS FOUND IN, which
+	 * is exactly why this write is not optional. The UM gives PLL_LDO_EN
+	 * a default of 0x1, but an idle board reads
+	 * PLL_NPU_CTRL = 0x01104500 -- bit 30 CLEAR (measured on the 6 GiB board,
+	 * 2026-08-25). Something in
+	 * the boot chain or a previous power-down leaves it off, and a PLL
+	 * whose LDO is off cannot lock however long ccu_helper_wait_for_lock()
+	 * polls. With the block resumed the same register reads 0xf9104500,
+	 * i.e. LDO_EN, LOCK_ENABLE, LOCK, PLL_EN and OUTPUT_GATE all set at
+	 * the untouched N = 70 -- the 840 MHz the reset fields encode.
+	 */
+	val = readl(reg + SUN60IW2_PLL_NPU_REG);
+	val |= SUN60IW2_PLL_NPU_LDO_EN | SUN60IW2_PLL_NPU_LOCK_ENABLE;
+	writel(val, reg + SUN60IW2_PLL_NPU_REG);
+
 	return devm_sunxi_ccu_probe(&pdev->dev, reg, &sun60iw2_ccu_desc);
 }
 
