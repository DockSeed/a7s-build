+/* See the VCO-window paragraph above for why the floor is 1272 and not 1260. */
+#define SUN60IW2_PLL_NPU_MIN_VCO	1272000000U
+#define SUN60IW2_PLL_NPU_MAX_VCO	2520000000U
+
+/* PLL_NPU_CTRL bits that are not modelled as clock gates; forced in probe(). */
+#define SUN60IW2_PLL_NPU_LDO_EN		BIT(30)
+#define SUN60IW2_PLL_NPU_LOCK_ENABLE	BIT(29)
+
+/*
+ * n: PLL_N [15:8], N = field + 1, and the minimum is the UM's own floor --
+ * the UM floor of 11 for PLL_N is a constraint on the
+ * FIELD, so N >= 12. m: PLL_INPUT_DIV [1], one bit, M1 = field + 1 (1 or 2).
+ * Spelled out rather than macro'd, which is what this file already does for
+ * every other PLL in it.
+ */
+static struct ccu_nm pll_npu_clk = {
+	.enable		= BIT(31),
+	.lock		= BIT(28),
+	.n		= _SUNXI_CCU_MULT_OFFSET_MIN_MAX(8, 8, 1, 12, 255),
+	.m		= _SUNXI_CCU_DIV(1, 1),
+	.min_rate	= SUN60IW2_PLL_NPU_MIN_VCO,
+	.max_rate	= SUN60IW2_PLL_NPU_MAX_VCO,
+	.common		= {
+		.reg		= SUN60IW2_PLL_NPU_REG,
+		.hw.init	= CLK_HW_INIT_PARENTS_HW("pll-npu",
+				pll_ref_hws, &ccu_nm_ops,
+				CLK_SET_RATE_UNGATE),
+	},
+};
