+/*
+ * EDP_TV_CLK_REG 0x1640 -- this register IS the DisplayPort
+ * pixel clock. There is no TCONTVx_CLK register on this part: the TV TCONs take
+ * their pixel clock from EDP_TV_CLK (eDP/DP path) or HDMI_TV_CLK (HDMI path).
+ *
+ *   31      EDP_TV_CLK_GATING  0=OFF 1=ON
+ *   26:24   CLK_SRC_SEL        000 VIDEO0PLL4X, 001 VIDEO1PLL4X,
+ *                              010 VIDEO2PLL4X, 011 PERI0PLL2X
