+ *
+ * ⚠ Both dividers are LINEAR, not power-of-two, and that is stated twice in the
+ * UM rather than inferred: N = FACTOR_N + 1 with FACTOR_N 0..31
+ * (A733 user manual) and the same for M -- a
+ * 5-bit field with an arithmetic range of 0..31 can only be linear -- and 4.1.4.4
+ * describes ordinary working clocks as divided by a plain counter, with
+ * FACTOR_M as the division coefficient,
+ * with the power-of-two/mask behaviour called out there as the GPU's exception.
+ * SUNXI_CCU_DUALDIV_MUX_GATE (CCU_FEATURE_DUAL_DIV) is the mainline primitive
+ * for exactly that shape and is what `clk-sunxi-ng-a733-add-smhc-pll-peri1-clocks` already uses for the SMHC clocks; a
+ * plain ccu_mp would treat [12:8] as a shift and produce 308/2/2^1 = 77 MHz.
+ *
+ * All four mux inputs are modelled, which is why PLL_VIDEO0 and PLL_VIDEO2 are
+ * here at all: with parents missing, ccu_mux_helper_get_parent() returns the raw
+ * register field as a parent index, so a partially modelled mux does not fail --
+ * it silently reports the wrong parent, or orphans the clock. PERI0PLL2X is the
+ * pll-peri0-2x this driver already has.
+ *
+ * CLK_SET_RATE_NO_REPARENT: which of the four sources drives the panel is a
+ * pipeline decision, not something a rate request may make. Without the flag
+ * ccu_mux_helper_determine_rate() walks all four parents and can pick one whose
+ * PLL is switched off -- ccu_nm_recalc_rate() reports a rate from the register
+ * fields whether or not PLL_EN is set, so an off PLL looks like a 1188 MHz
+ * source. The mux is selected from the device tree instead
+ * (assigned-clock-parents on the TCON node) and never by the rate machinery.
+ */
+static const struct clk_parent_data edp_tv_parents[] = {
+	{ .hw = &video0_pll4x_clk.common.hw },	/* 000 VIDEO0PLL4X */
+	{ .hw = &video1_pll4x_clk.common.hw },	/* 001 VIDEO1PLL4X */
+	{ .hw = &video2_pll4x_clk.common.hw },	/* 010 VIDEO2PLL4X */
+	{ .hw = &pll_peri0_2x_clk.common.hw },	/* 011 PERI0PLL2X   */
+};
+
+static SUNXI_CCU_DUALDIV_MUX_GATE(edp_tv_clk, "edp-tv", edp_tv_parents,
+				  0x1640,
+				  0, 5,		/* M */
+				  8, 5,		/* N */
+				  24, 3,	/* mux */
+				  BIT(31),	/* gate */
+				  CLK_SET_RATE_PARENT |
+				  CLK_SET_RATE_NO_REPARENT);
+
+/*
+ * The two VIDEO_OUT1 bus gates the pixel path needs besides the eDP one `clk-sunxi-ng-a733-add-edp-bus-gate-and-reset`
+ * added, both bit0 gate / bit16 reset, both reset 0:
+ *
+ *   TCONTV1_BGR_REG   0x160C  TCON_TV1, the timing controller that scans the
+ *                             mode and feeds eDP0
+ *   DPSS_TOP1_BGR_REG 0x16CC  the VO1 top block, DISPLAY1_TOP @0x05510000,
+ *                             which carries TV_CLK_EDP_I2S1_SRC -- the bit that
+ *                             routes TCON_TV1's output to eDP rather than HDMI
+ *                             (identified during bring-up)
+ *
+ * ⚠ Gate AND reset, both, for each. That is `clk-sunxi-ng-a733-add-edp-bus-gate-and-reset`'s measured rule, not a
+ * convention: on the 8 GiB board on 2026-08-18 the eDP window read 0x00000000 across its
+ * whole 4 KiB with the gate set and the reset still asserted, and answered its
+ * core id the moment bit 16 was released. TCONTV1_BGR and DPSS_TOP1_BGR have
+ * the identical two-bit layout and the by-hand bring-up writes 0x00010000 then
+ * 0x00010001 to each, in that order -- reset de-asserted first, then the gate,
+ * per UM 4.1.4.4.
+ *
+ * ⚠ A523 rejected, and this is the PWM trap again. ccu-sun55i-a523.c:1014-1017
+ * puts bus-tcon-tv0 and bus-tcon-tv1 in ONE register, 0xb9c, as bits 0 and 1 --
+ * exactly the shape that made `clk-sunxi-ng-a733-add-pwm0-pwm1-gates-and-resets` dangerous, where the A523 has PWM0/PWM1 in
+ * one word and the A733 has two. Here too the A733 has two registers, 0x1604
+ * and 0x160C, each with its own bit0/bit16 pair: carried over unchanged, the
+ * TCON_TV1 gate would land on TCONTV0_BGR's reserved bit 1 and the write would
+ * look like it had succeeded. The A523 has no DPSS gate at all, and its eDP
+ * gate sits at 0xbbc, an address absent from the A733's register list
+ * (`clk-sunxi-ng-a733-add-edp-bus-gate-and-reset`'s header has that one in full).
+ *
+ * The bus parent is ahb, and unlike the other BGR gates in this file that is
+ * not an inference any more. The UM names the bus itself: AHB_MAT_CLK_GATING_REG
+ * 0x05C0 bit 4 is VID_OUT1_AHB_GATE_SW_CFG, the gate of the Video Out1 AHB clock
+ * (A733 user manual), i.e. the whole VIDEO_OUT1 domain these two gates live
+ * in hangs off AHB -- one bit away from the SERDES_AHB gate at bit 8 this driver
+ * already models. The rate follows: UM 4.1.4.3 gives AHB a typical
+ * frequency of 200 MHz, with the maximum also 200 MHz, and
+ * the 8 GiB board reads AHB_CLK_REG 0x02002500 = 0x03000002 -> src 3 = pll-peri0-600m,
+ * M = /3 -> 200 MHz exactly.
+ * Nothing derives a rate from a BGR gate, but the name is now cited rather than
+ * assumed.
+ */
+static SUNXI_CCU_GATE_HWS(bus_tcon_tv1_clk,  "bus-tcon-tv1",  ahb_hws, 0x160C, BIT(0), 0);
+static SUNXI_CCU_GATE_HWS(bus_dpss_top1_clk, "bus-dpss-top1", ahb_hws, 0x16CC, BIT(0), 0);
+
