+	.min_rate	= SUN60IW2_PLL_VIDEO_MIN_VCO,
+	.max_rate	= SUN60IW2_PLL_VIDEO_MAX_VCO,
+	.common		= {
+		.reg		= SUN60IW2_PLL_VIDEO1_REG,
+		.hw.init	= CLK_HW_INIT_PARENTS_HW("pll-video1",
+				pll_ref_hws, &ccu_nm_ops,
+				CLK_SET_RATE_UNGATE),
+	},
+};
+
+static const struct clk_hw *pll_video1_hws[] = { &pll_video1_clk.common.hw };
+
+static struct ccu_nm pll_video2_clk = {
+	.enable		= BIT(31),
+	.lock		= BIT(28),
+	.n		= _SUNXI_CCU_MULT_OFFSET_MIN_MAX(8, 8, 1, 12, 255),
+	.m		= _SUNXI_CCU_DIV(1, 1),
+	.min_rate	= SUN60IW2_PLL_VIDEO_MIN_VCO,
+	.max_rate	= SUN60IW2_PLL_VIDEO_MAX_VCO,
+	.common		= {
+		.reg		= SUN60IW2_PLL_VIDEO2_REG,
+		.hw.init	= CLK_HW_INIT_PARENTS_HW("pll-video2",
+				pll_ref_hws, &ccu_nm_ops,
+				CLK_SET_RATE_UNGATE),
+	},
+};
+
+static const struct clk_hw *pll_video2_hws[] = { &pll_video2_clk.common.hw };
+
+/*
+ * The 4X taps: divider PLL_OUTPUT0_DIV [22:20] (linear, P0 = field + 1) gated
+ * by PLL_OUTPUT0_GATE (bit 27), both inside the PLL's own control register.
+ *
+ * CLK_SET_RATE_PARENT here and on edp-tv below is deliberate, and it is the
+ * opposite of what the SMHC block above does -- for a reason that is in that
+ * block's own comment. There the parents are FIXED taps of a shared peripheral
+ * PLL: the request walks up, cannot be honoured, and the framework then divides
+ * against a parent rate that was never programmed (measured, 2026-07-25, an
+ * eMMC bus that ran at twice its reported rate). Here every stage is genuinely
+ * settable and owned by this one consumer, so the request IS honoured, and a
+ * single clk_set_rate() on the pixel clock configures PLL, tap and divider --
+ * the idiom every mainline sunxi display driver uses.
+ *
+ * Worked through for the mode that has run on silicon, 1920x1200 at 154 MHz,
+ * because "it propagates" is not a claim anyone can check:
+ *   ccu_mp_find_best_with_parent_adj() tries m*p = 2 -> asks the tap for
+ *   308 MHz -> clk_divider_bestdiv() tries div 6 -> asks the PLL for 1848 MHz
+ *   -> ccu_nm_find_best() returns N = 77, M1 = 1 exactly (24 * 77 = 1848, and
+ *   n ascending makes 77/1 win over the equally exact 154/2).
+ *   Registers that come out: PLL_VIDEO1_CTRL [15:8] = 0x4C, bit 1 = 0,
+ *   [22:20] = 5 (P0 = 6), EDP_TV_CLK [12:8] = 0 (N = 1), [4:0] = 1 (M = 2).
+ *   Those are the values written by hand for the picture of 2026-08-18.
+ */
+static SUNXI_CCU_M_HWS_WITH_GATE(video0_pll4x_clk, "video0-pll4x",
+				 pll_video0_hws, SUN60IW2_PLL_VIDEO0_REG,
+				 20, 3, BIT(27), CLK_SET_RATE_PARENT);
+static SUNXI_CCU_M_HWS_WITH_GATE(video1_pll4x_clk, "video1-pll4x",
+				 pll_video1_hws, SUN60IW2_PLL_VIDEO1_REG,
+				 20, 3, BIT(27), CLK_SET_RATE_PARENT);
+static SUNXI_CCU_M_HWS_WITH_GATE(video2_pll4x_clk, "video2-pll4x",
+				 pll_video2_hws, SUN60IW2_PLL_VIDEO2_REG,
+				 20, 3, BIT(27), CLK_SET_RATE_PARENT);
