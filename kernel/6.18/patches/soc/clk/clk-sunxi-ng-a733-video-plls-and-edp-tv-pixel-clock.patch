--- a/drivers/clk/sunxi-ng/ccu-sun60iw2.c
+++ b/drivers/clk/sunxi-ng/ccu-sun60iw2.c
@@ -504,6 +504,296 @@
  */
 static SUNXI_CCU_GATE_HWS(bus_edp_clk,    "bus-edp",    ahb_hws, 0x164C, BIT(0),  0);
 
+/*
+ * The video PLLs and the eDP/TV pixel clock -- the chain that carries a
+ * DisplayPort mode:
+ *
+ *   pll-ref 24 MHz -> PLL_VIDEOx (VCO) -> VIDEOxPLL4X -> EDP_TV_CLK -> TCON_TV1
+ *
+ * Nothing in this tree modelled a video PLL before this; `clk-sunxi-ng-a733-add-edp-bus-gate-and-reset` added only the
+ * eDP *bus* gate and said in its own header why it left EDP_TV_CLK out -- "its
+ * mux cannot be expressed by this tree yet [...] this CCU models none of the
+ * three video PLLs". That is what this block closes.
+ *
+ * PLL_VIDEO0/1/2_CTRL_REG, 0x0120 / 0x0140 / 0x0160, reset 0x40126200, one
+ * layout for all three (A733 UM V0.92; field tables
+ * in section 4.1.6):
+ *
+ *   31      PLL_EN             0=Disable 1=Enable          (reset 0)
+ *   30      PLL_LDO_EN                                     (reset 1)
+ *   29      LOCK_ENABLE                                    (reset 0)
+ *   28      LOCK               read-only
+ *   27      PLL_OUTPUT0_GATE   gates the "4X" tap          (reset 0)
+ *   26      PLL_OUTPUT1_GATE   gates the "3X" tap          (reset 0)
+ *   22:20   PLL_OUTPUT0_DIV    P0 = field + 1, 0..7
+ *   18:16   PLL_OUTPUT1_DIV    P1 = field + 1, 0..7
+ *   15:8    PLL_N              N  = field + 1, field >= 11
+ *   1       PLL_INPUT_DIV      M1 = field + 1, 0..1
+ *
+ *   VIDEOxPLL4X = InputFreq * N / M1 / P0
+ *   VIDEOxPLL3X = InputFreq * N / M1 / P1
+ *
+ * VCO range 1.26 GHz .. 2.52 GHz, input pre-divider 1/2, P0/P1 each 1..8 --
+ * UM Table 4-2 "PLL Specifications", PLL_VIDEO0/1/2 rows.
+ *
+ * ⚠ InputFreq is 24 MHz, and the parent below is pll-ref, NOT the 26 MHz DCXO.
+ * UM 4.1.4.1 says some PLLs take their input from either the DCXO or the
+ * REFPLL, and that the REFPLL is fixed at 24 MHz; Table 4-3's
+ * VIDEO0~1_PLL row reads DCXO 24 / REF_SEL 0 / N 99 / VCO 2376 / 4x 1188 /
+ * 3x 792 -- the same REF_SEL 0 column as
+ * PLL_PERI0/1, which this driver already parents to pll-ref. The register's own
+ * note about the 26 MHz DCXO case (1188 MHz default for VIDEO1PLL4X)
+ * means "on a 26 MHz board", not "put 26 in the formula": 24 * 99 / 1 / 2 = 1188
+ * closes, 26 * 99 / 1 / 2 = 1287 appears nowhere. Mixing up 24 and 26 is a defect
+ * class that has already cost this tree three bugs.
+ *
+ * ⚠ "4X" and "3X" are names, not factors. The UM never defines them
+ * numerically and they are inconsistent across PLLs (for PERI0 "2x" is /2; for
+ * VIDEO "4x" is also /2 at the default P0 = 2). Both taps are plain linear
+ * dividers and are modelled as such -- never infer a factor from the name.
+ *
+ * Only the 4X tap is modelled. The 3X tap (bit 26 / [18:16]) has no consumer in
+ * this tree, so a clock for it would be dead code; it is named here instead
+ * because retuning a video PLL moves it, and the UM's PLL distribution figure
+ * puts CSI_MASTER on PLL_VIDEO1's outputs. Consequence for
+ * anyone reading a register dump: after this driver has configured the pixel
+ * clock, PLL_VIDEO1_CTRL bit 26 is 0 where a vendor capture has it 1. That is
+ * deliberate and the UM asks for it: with several outputs on a PLL, the
+ * output gate of each output actually used is to be set
+ * (A733 user manual). We use one.
+ *
+ * Enable/disable is split the way the hardware splits it, and the way UM
+ * 4.1.4.1 recommends: PLL_EN (bit 31) is the ccu_nm's own enable, and the tap's
+ * enable is PLL_OUTPUT0_GATE (bit 27), so a consumer can drop the output
+ * without stopping the PLL -- the UM advises against enabling or
+ * disabling the PLLs while in use, and says to clear the PLL_OUTPUT_GATE bit in
+ * the PLLx_CTRL_REG when the clock is not needed.
+ * PLL_LDO_EN and LOCK_ENABLE are not clock gates and are forced in probe().
+ *
+ * ⚠ What ccu_nm_ops does NOT do: wait for LOCK on the enable path.
+ * ccu_helper_wait_for_lock() runs at the end of ccu_nm_set_rate() only, so the
+ * UM's "wait LOCK, then 20 us, then open the output gate" (Method 2)
+ * is honoured when the rate is set and not when the clock is merely
+ * enabled. A consumer must therefore clk_set_rate() the PLL before it relies on
+ * the output, which is what a modeset does anyway. Stated so it is not
+ * rediscovered on a board.
+ */
+#define SUN60IW2_PLL_VIDEO0_REG		0x0120
+#define SUN60IW2_PLL_VIDEO1_REG		0x0140
+#define SUN60IW2_PLL_VIDEO2_REG		0x0160
+
+/*
+ * UM Table 4-2, PLL_VIDEO0/1/2 rows: VCO 1.26 GHz .. 2.52 GHz.
+ * The floor here is 1272 MHz and not 1260, and the 12 MHz matter:
+ * ccu_nm_determine_rate() CLAMPS a too-low request to min_rate and returns,
+ * but ccu_nm_set_rate() does not clamp at all -- it calls ccu_nm_find_best(),
+ * which returns the largest reachable rate <= its target. With min_rate at the
+ * spec figure the pair would agree on 1260 MHz and then program 24 * 52 =
+ * 1248 MHz, below the documented window. 1272 = 24 * 53 is the lowest VCO that
+ * is both inside the window and exactly reachable from a 24 MHz reference, so
+ * the clamp lands on a value set_rate can actually produce. 2520 = 24 * 105 is
+ * exact at the top. (The vendor uses the same 1272000000, and this is the
+ * reasoning that says it is right rather than a rounding accident.)
+ */
+#define SUN60IW2_PLL_VIDEO_MIN_VCO	1272000000U
+#define SUN60IW2_PLL_VIDEO_MAX_VCO	2520000000U
+
+/* PLL_VIDEOx_CTRL bits that are not modelled as clock gates. */
+#define SUN60IW2_PLL_VIDEO_LDO_EN	BIT(30)
+#define SUN60IW2_PLL_VIDEO_LOCK_ENABLE	BIT(29)
+
+/*
+ * Written out three times rather than through a local macro, because that is
+ * what this file already does for the two identical peripheral PLLs and what
+ * every mainline sunxi CCU does: the SUNXI_CCU_* macros live in headers, driver
+ * files spell their PLLs out.
+ *
+ * n: PLL_N [15:8], N = field + 1, and the minimum is the UM's own floor --
+ * the UM floor of 11 for PLL_N is a constraint on the
+ * FIELD, so N >= 12. m: PLL_INPUT_DIV [1], one bit, M1 = field + 1 (1 or 2).
+ */
+static struct ccu_nm pll_video0_clk = {
+	.enable		= BIT(31),
+	.lock		= BIT(28),
+	.n		= _SUNXI_CCU_MULT_OFFSET_MIN_MAX(8, 8, 1, 12, 255),
+	.m		= _SUNXI_CCU_DIV(1, 1),
+	.min_rate	= SUN60IW2_PLL_VIDEO_MIN_VCO,
+	.max_rate	= SUN60IW2_PLL_VIDEO_MAX_VCO,
