+
+		/*
+		 * CPU-PLL controller. CPU_PLL_CFG lives inside the CPU_SYS block
+		 * at 0x08870000, NOT in the main CCU at 0x02002000: UM chapter 2
+		 * memory map gives the window
+		 * 0x08870000-0x0887FFFF.
+		 *
+		 * It holds four PLLs and three CPU clock muxes (UM 5.1.5.5
+		 * "CPU_PLL_CFG Register List"):
+		 *   0x0000 CPU_BACK_PLL_CTRL   0x1000 CPU_L_PLL_CTRL
+		 *   0x2000 CPU_B_PLL_CTRL      0x3000 CPU_DSU_PLL_CTRL
+		 *   0x101C / 0x201C / 0x301C   CPU_L/B/DSU clock register
+		 *                              (source mux + EXT_DIVP)
+		 *   0x3034                     CPU_SLOW_CLK_SEL
+		 *
+		 * Parent is the 26 MHz DCXO, not the osc24M this DT still models
+		 * for the main CCU. Silicon: XO_CTRL0 @0x07090160 reads
+		 * 0x983FB0F7 byte-identical on the 6 GiB board and the 8 GiB board, DCXO_ST[15:14] =
+		 * 0b10 = 26 MHz, the 26M oscillator of UM 9.1.5.4. The UM's
+		 * CPU_BACK_PLL default note is no cross-check: V0.92 names
+		 * 975 MHz at 26 MHz, V1.00 900 MHz at 24 MHz, same fields.
+		 * The gate itself is CLK_RTC_DCXO in the RTC-CCU (patch `clk-sunxi-ng-a733-rtc-ccu-add-dcxo`).
+		 *
+		 * reg size 0x3038 also maps CPU_SLOW_CLK_SEL_REG at 0x3034,
+		 * which patch `clk-sunxi-ng-a733-add-cpu-pll-ccu` reads; the vendor's 0x3034
+		 * stops one register short;
+		 * see this patch's description.
+		 */
+		cpupll_ccu: clock-controller@8870000 {
+			compatible = "allwinner,sun60i-a733-cpu-ccu";
+			reg = <0x0 0x08870000 0x0 0x3038>;
+			clocks = <&rtc_ccu CLK_RTC_DCXO>;
+			clock-names = "dcxo";
+			#clock-cells = <1>;
+		};
 	};
