---
 .../boot/dts/allwinner/sun60i-a733-cubie-a7s-minimal.dts | 40 ++++++++++++++++--
 1 file changed, 38 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7s-minimal.dts b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7s-minimal.dts
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7s-minimal.dts
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7s-minimal.dts
@@ -389,11 +389,47 @@
 		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_HIGH>;
 	};

-	osc24M: osc24M-clk {
+	/*
+	 * SYS_CLK24M -- the SoC-internal 24 MHz that every peripheral block
+	 * calls "hosc". It is NOT the crystal on this board and it does not
+	 * follow it:
+	 *
+	 *   XTAL -> DCXO --+-> PLL_REF (x96 /104) --+
+	 *                  |                        v
+	 *                  +---------------------> mux -> SYS_CLK24M (24 MHz)
+	 *                  +-> CPU_BACK/L/B/DSU_PLL, CPU_SLOW_CLK
+	 *                  +-> PLL_DIS0/DIS1/HDMI
+	 *                  +-> UFS / COMBOPHY0+1 + HDMI PHY reference gates
+	 *
+	 * A733 UM 7.1.4 names both nets and both rates: SYS_CLK24M is a
+	 * fixed 24 MHz net, muxed from either DCXO or PLL_REF; DCXO is the
+	 * board's external crystal, 26 MHz.
+	 * PLL_REF exists to make
+	 * this net 24 MHz on a 26 MHz board, and silicon says it does exactly
+	 * that: CCU+0x0000 reads 0xF8675F00 on the 6 GiB board and a second 6 GiB board -> N = 96,
+	 * P0 = 104, 26 MHz x 96 / 104 = 24.000000 MHz.
+	 *
+	 * So 24 MHz is the right number here and must not be "corrected" to
+	 * the crystal's 26 MHz -- only the name was wrong. Every consumer of
+	 * this node wants SYS_CLK24M: the main CCU's SYS_CLK24M mux inputs
+	 * (AHB/APB0/APB1/APB_UART src 000, UM 4.1.6), and the PIO/S_GPIO
+	 * debounce clock (PB_INT_DEB/PL_INT_DEB bit0: 0 = RTC_32K,
+	 * 1 = SYS_CLK24M).
+	 *
+	 * The 26 MHz DCXO is deliberately NOT modelled here as a second
+	 * fixed-clock: it is owned by the RTC-CCU, which decodes the
+	 * DCXO_ST0/ST1 strap out of XO_CTRL0[15:14] on the running silicon and
+	 * exports it as CLK_RTC_DCXO. A DT literal would be a second, weaker
+	 * source for the same net.
+	 *
+	 * The "osc24M" label is kept as an alias so the rest of the series
+	 * keeps resolving; new nodes should use &sys24M.
+	 */
+	sys24M: osc24M: sys24M-clk {
 		#clock-cells = <0>;
 		compatible = "fixed-clock";
 		clock-frequency = <24000000>;
-		clock-output-names = "osc24M";
+		clock-output-names = "sys24M";
 	};

 	osc32k: osc32k-clk {
--
