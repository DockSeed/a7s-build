From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DockSeed <dockseed@proton.me>
Date: Tue, 6 Oct 2026 08:54:00 +0200
Subject: [PATCH] arm64: dts: a733: add the LEDs of the Cubie A7S

The Cubie A7S has a green power LED and a blue status LED. The blue LED
is on PJ26 and lights when the pin is high. The green LED is lit
whenever the board has power; PM2 switches it off when low. Describe
both as GPIO LEDs, the green one as the power LED that stays on.

Assisted-by: Claude
---
diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7s.dts b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7s.dts
index 497319cb3..50586e414 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7s.dts
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7s.dts
@@ -22,6 +22,7 @@
 #include <dt-bindings/clock/sun60i-a733-serdes-ccu.h>
 #include <dt-bindings/clock/sun6i-rtc.h>
 #include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
 #include <dt-bindings/thermal/thermal.h>
 #include <dt-bindings/reset/sun60i-a733-ccu.h>
 #include <dt-bindings/reset/sun60i-a733-r-ccu.h>
@@ -533,6 +534,23 @@
 		clock-output-names = "ext_osc32k";
 	};
 
+	leds {
+		compatible = "gpio-leds";
+
+		power-led {
+			function = LED_FUNCTION_POWER;
+			color = <LED_COLOR_ID_GREEN>;
+			gpios = <&r_pio 1 2 GPIO_ACTIVE_HIGH>; /* PM2 */
+			default-state = "on";
+		};
+
+		status-led {
+			function = LED_FUNCTION_STATUS;
+			color = <LED_COLOR_ID_BLUE>;
+			gpios = <&pio 9 26 GPIO_ACTIVE_HIGH>; /* PJ26 */
+		};
+	};
+
 	/*
 	 * The DCXO -- the crystal oscillator itself, and a physically
 	 * different net from the 24 MHz "osc24M"/SYS_CLK24M node above. The
