+++ b/drivers/gpu/drm/sun60i/Kconfig
@@ -0,0 +1,17 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config DRM_SUN60I_DP
+	tristate "Allwinner A733 (sun60iw2) DisplayPort AUX"
+	depends on DRM && OF
+	depends on ARCH_SUNXI || COMPILE_TEST
+	select DRM_DISPLAY_HELPER
+	select DRM_DISPLAY_DP_HELPER
+	select GENERIC_PHY
+	help
+	  Enable this for the DisplayPort transmitter of the Allwinner A733
+	  (sun60iw2). At present this driver implements the AUX channel only --
+	  the path that carries DPCD and EDID -- and no link training, no video
+	  and no mode setting. It is the first piece of that block whose result
+	  can be checked against what the sink says about itself.
+
+	  Say M here if you want DisplayPort alternate mode over the Type-C
+	  port to be able to identify the attached sink.
