@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * The seam between the KMS half of this display pipe and the two device
+ * drivers underneath it.
+ *
+ * WHY A SEAM AT ALL, AND WHY IT IS EXPORTED SYMBOLS RATHER THAN ONE MODULE.
+ * The display engine and TCON_TV1 are separate devices on separate register
+ * windows with separate device-tree nodes, separate clocks and separate resets,
+ * and each is independently useful without a drm_device above it: the TCON can
+ * raster its own VDBIST pattern and the engine can scan its own framebuffer,
+ * which is how both were proven on silicon before any of this existed. They are
+ * therefore separate modules, and a caller in a third module reaches them
+ * through exported symbols.
+ *
+ * ⚠ THE DEPENDENCY POINTS ONE WAY ONLY, AND IT HAS TO. sun60i-kms.ko calls into
+ * sun60i-de.ko and sun60i-tcon-tv.ko; neither of them calls back. A callback in
+ * the other direction would be a circular module dependency, which the module
+ * loader cannot resolve at all -- so the KMS half PULLS the two driver-private
+ * pointers out of their platform devices after component_bind_all(), instead of
+ * the components PUSHING themselves into a registry.
+ *
+ * The DisplayPort transmitter is deliberately NOT in this header. It publishes
+ * a drm_bridge with drm_bridge_add() and is found through the device-tree graph
+ * by of_drm_find_bridge(), so the KMS half references no symbol of its own --
+ * that is the shape `drm-a733-dp-register-a-drm-bridge` chose and it is why sun60i-dp.ko is absent here.
+ *
+ * Copyright (c) 2026 DockSeed
+ */
+
+#ifndef _SUN60I_KMS_H_
+#define _SUN60I_KMS_H_
+
+#include <linux/types.h>
+
+struct drm_display_mode;
+struct sun60i_de;
+struct sun60i_tcon_tv;
+
+/*
+ * The display engine -- implemented in sun60i-de.c.
+ *
+ * Ownership is exclusive and it is checked rather than assumed: the same
+ * registers are reachable through that driver's debugfs verbs, and two writers
+ * on one datapath is a corruption nobody would see in a review. A component
+ * bound to a KMS master refuses the debugfs verbs; a driver with no master
+ * bound refuses these. The A/B arm survives either way -- a kernel booted with
+ * no display-engine node in its device tree, or a master unbound by hand, still
+ * has the verbs.
+ */
+int sun60i_de_kms_enable(struct sun60i_de *de,
+			 const struct drm_display_mode *mode,
+			 dma_addr_t scanout, u32 pitch);
+void sun60i_de_kms_disable(struct sun60i_de *de);
+int sun60i_de_kms_scanout(struct sun60i_de *de, dma_addr_t scanout, u32 pitch);
+void sun60i_de_kms_layer_off(struct sun60i_de *de);
+
+/* TCON_TV1 -- implemented in sun60i-tcon-tv.c, same ownership rule. */
+int sun60i_tcon_tv_kms_check(struct sun60i_tcon_tv *tcon,
+			     const struct drm_display_mode *mode);
+int sun60i_tcon_tv_kms_enable(struct sun60i_tcon_tv *tcon,
+			      const struct drm_display_mode *mode, u8 bpc);
+void sun60i_tcon_tv_kms_disable(struct sun60i_tcon_tv *tcon);
+
+#endif /* _SUN60I_KMS_H_ */
