-	return 0;
+	/*
+	 * Last, because from here a KMS master may bind this device at any
+	 * moment and every resource it will touch has to exist first.
+	 */
+	ret = component_add(dev, &sun60i_de_component_ops);
+	if (ret)
+		return dev_err_probe(dev, ret, "component_add\n");
+
+	return devm_add_action_or_reset(dev, sun60i_de_component_remove, dev);
