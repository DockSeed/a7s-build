+ *     a board. Advertising a format the layer would program wrong is worse than
+ *     advertising one.
+ *   - LINEAR ONLY. TFBD (tiled-framebuffer decode) is left at reset by `drm-a733-display-engine-dram-into-tcon-tv1` and
+ *     read back rather than written, so there is no compressed source to
+ *     describe. DRM_FORMAT_MOD_LINEAR is therefore the complete list.
+ *   - FULL SCREEN, NO SCALING, NO POSITIONING. The VSU8 scaler sits in the
+ *     channel datapath unconditionally on this DE generation -- it filters
+ *     every pixel and there is no bypass by omission -- and `drm-a733-display-engine-dram-into-tcon-tv1` stages it at
+ *     unity. A scaled or offset plane would need real VSU coefficients and a
+ *     step, which is stage 4 work, so the check refuses rather than programs
+ *     something plausible.
+ */
+static const u32 sun60i_kms_plane_formats[] = {
+	DRM_FORMAT_XRGB8888,
+};
+
+static const u64 sun60i_kms_plane_modifiers[] = {
+	DRM_FORMAT_MOD_LINEAR,
+	DRM_FORMAT_MOD_INVALID,
+};
+
+static int sun60i_kms_plane_atomic_check(struct drm_plane *plane,
+					 struct drm_atomic_state *state)
+{
+	struct drm_plane_state *new_state =
+		drm_atomic_get_new_plane_state(state, plane);
+	struct drm_crtc_state *crtc_state;
+	dma_addr_t addr;
+	int ret;
+
+	if (!new_state->crtc)
+		return 0;
+
+	crtc_state = drm_atomic_get_new_crtc_state(state, new_state->crtc);
+	if (!crtc_state)
+		return -EINVAL;
+
+	ret = drm_atomic_helper_check_plane_state(new_state, crtc_state,
+						  DRM_PLANE_NO_SCALING,
+						  DRM_PLANE_NO_SCALING,
+						  false, true);
+	if (ret)
+		return ret;
+
+	if (!new_state->visible)
+		return 0;
+
+	if (new_state->dst.x1 || new_state->dst.y1 ||
+	    drm_rect_width(&new_state->dst) != crtc_state->mode.hdisplay ||
+	    drm_rect_height(&new_state->dst) != crtc_state->mode.vdisplay) {
+		drm_dbg_atomic(plane->dev,
+			       "plane must cover the whole mode: the layer geometry and the blender input size are both programmed from the mode, and the scaler is staged at unity\n");
+		return -EINVAL;
+	}
+
+	/*
+	 * Refused HERE rather than at commit time, where the only symptom would
+	 * be a screen that stays black while every register reads back
+	 * correctly -- the failure shape this pipe already paid a session for
+	 * on 2026-08-19.
+	 */
+	addr = drm_fb_dma_get_gem_addr(new_state->fb, new_state, 0);
+	if (upper_32_bits(addr)) {
+		drm_dbg_atomic(plane->dev,
+			       "framebuffer at %pad is above 4 GiB and the layer address register is 32 bits\n",
+			       &addr);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static void sun60i_kms_plane_atomic_update(struct drm_plane *plane,
+					   struct drm_atomic_state *state)
+{
+	struct drm_plane_state *new_state =
+		drm_atomic_get_new_plane_state(state, plane);
+	struct sun60i_kms *kms = to_kms_plane(plane)->kms;
+	dma_addr_t addr;
+	int ret;
+
+	if (!new_state->visible)
+		return;
+
+	addr = drm_fb_dma_get_gem_addr(new_state->fb, new_state, 0);
+
+	ret = sun60i_de_kms_scanout(kms->de, addr, new_state->fb->pitches[0]);
+	if (ret)
+		drm_err(plane->dev, "scanout from %pad: %d\n", &addr, ret);
+}
+
+static void sun60i_kms_plane_atomic_disable(struct drm_plane *plane,
+					    struct drm_atomic_state *state)
+{
+	struct sun60i_kms *kms = to_kms_plane(plane)->kms;
+
+	/*
+	 * Reachable only while the engine is already down: the CRTC refuses a
+	 * state that is active without a primary plane, and
+	 * drm_atomic_helper_commit_tail_rpm() disables CRTCs before planes. The
+	 * call is here anyway and no-ops on a disabled engine, because "cannot
+	 * happen" is not a thing a driver should rely on for correctness.
+	 */
+	sun60i_de_kms_layer_off(kms->de);
+}
+
+static const struct drm_plane_helper_funcs sun60i_kms_plane_helper_funcs = {
+	.atomic_check	= sun60i_kms_plane_atomic_check,
+	.atomic_update	= sun60i_kms_plane_atomic_update,
+	.atomic_disable	= sun60i_kms_plane_atomic_disable,
+};
+
+static const struct drm_plane_funcs sun60i_kms_plane_funcs = {
+	.update_plane		= drm_atomic_helper_update_plane,
+	.disable_plane		= drm_atomic_helper_disable_plane,
+	.reset			= drm_atomic_helper_plane_reset,
+	.atomic_duplicate_state	= drm_atomic_helper_plane_duplicate_state,
+	.atomic_destroy_state	= drm_atomic_helper_plane_destroy_state,
+};
+
+/*
+ * ---------------------------------------------------------------------------
+ * The CRTC -- TCON_TV1 plus the display engine behind it
+ * ---------------------------------------------------------------------------
+ */
+
+static enum drm_mode_status
+sun60i_kms_crtc_mode_valid(struct drm_crtc *crtc,
+			   const struct drm_display_mode *mode)
+{
+	struct sun60i_kms *kms = crtc_to_kms(crtc);
+
+	/*
+	 * The TCON's register field widths, and only those. The display engine
+	 * is deliberately not consulted: its size fields are two 16-bit halves
+	 * and its pitch register is a full word, so every mode the TCON accepts
+	 * fits the engine by a wide margin. A second check that can never fire
+	 * would be a check nobody can test.
+	 *
+	 * The link's own limit is applied where it belongs, by the DRM core,
+	 * out of the bridge's .mode_valid and the sink's EDID.
+	 */
+	if (sun60i_tcon_tv_kms_check(kms->tcon, mode))
+		return MODE_BAD;
+
+	return MODE_OK;
+}
+
+static int sun60i_kms_crtc_atomic_check(struct drm_crtc *crtc,
+					struct drm_atomic_state *state)
+{
+	struct drm_crtc_state *crtc_state =
+		drm_atomic_get_new_crtc_state(state, crtc);
+
+	if (!crtc_state->active)
+		return 0;
+
+	/*
+	 * A raster with no fetch behind it is not a state this pipe can hold.
+	 * The blender's only enabled pipe is fed by the one channel this plane
+	 * drives, so an active CRTC without it would program a scanout address
+	 * that belongs to nothing -- and the screen would go black with every
+	 * register reading back correct.
+	 */
+	return drm_atomic_helper_check_crtc_primary_plane(crtc_state);
+}
+
+/*
+ * The bits-per-component the sink asked for, or 8.
+ *
+ * ⚠ THIS IS ONE HALF OF A HARDWARE INVARIANT, NOT A PREFERENCE. TCON_TV1's
+ * TV_PIXELDEPTH_MODE_REG and the transmitter's MISC0 must describe the same
+ * pixel depth; the hardware reports a disagreement as SRC0_USER_FIFO_STATUS
+ * != 0, which counts as a mode-programming error.
+ * sun60i_dp_bridge_atomic_enable() reads exactly this field for its own half,
+ * so both sides take the number from one place -- which is what retires the
+ * constant in sun60i-display.h that has held the invariant until now.
+ */
+static u8 sun60i_kms_crtc_bpc(struct sun60i_kms *kms,
+			      struct drm_atomic_state *state)
+{
+	struct drm_connector *connector;
+
+	connector = drm_atomic_get_new_connector_for_encoder(state,
+							     &kms->encoder);
+	if (!connector || !connector->display_info.bpc)
+		return 8;
+
+	return connector->display_info.bpc;
+}
+
+/*
+ * The order is the hardware's: the engine is fetching and the blender is
+ * composing BEFORE the TCON is told to take its data from them, and the
+ * transmitter trains its link after both -- that last step is the bridge's
+ * .atomic_enable, which drm_atomic_helper_commit_modeset_enables() runs after
+ * every CRTC in the state has come up.
+ *
+ * ⚠ THAT ORDER IS A HARDWARE RULE AND NOT A PREFERENCE, and the vendor's driver
+ * is where it is stated out loud: it special-cases the blender's output size
+ * out of its deferred commit path and writes it straight to MMIO, because
+ * otherwise "tcon will think that de is enabled, but bld has no output,
+ * resulting in missing data" (allwinner-bsp, sunxi_de.c:852-858). `drm-a733-display-engine-dram-into-tcon-tv1` commits
+ * by direct store, so BLD_OUTSIZE is already in the register by the time
+ * sun60i_de_kms_enable() returns and no special case is needed -- but only
+ * because the engine is brought up first. Enabling the TCON before the engine
+ * would reproduce exactly the fault that comment describes.
+ *
+ * The scanout address comes out of the ATOMIC STATE rather than from the plane
+ * update that has not happened yet, and that is why this driver's
+ * .atomic_commit_tail is drm_atomic_helper_commit_tail_rpm(): the default tail
+ * commits planes BEFORE modeset enables, and on this hardware a plane
+ * programmed before the CRTC is a write into a register window that is not open
+ * -- it does not fail, it reads back zero like unmapped space (`drm-a733-display-engine-dram-into-tcon-tv1`'s own
+ * measurement, and the defect that cost it a test boot).
+ */
+static void sun60i_kms_crtc_atomic_enable(struct drm_crtc *crtc,
+					  struct drm_atomic_state *state)
+{
+	struct drm_crtc_state *crtc_state =
+		drm_atomic_get_new_crtc_state(state, crtc);
+	struct sun60i_kms *kms = crtc_to_kms(crtc);
+	struct drm_plane_state *plane_state;
+	dma_addr_t addr;
+	int ret;
+
+	plane_state = drm_atomic_get_new_plane_state(state, crtc->primary);
+	if (!plane_state || !plane_state->fb) {
+		drm_err(crtc->dev, "enable with no framebuffer on the primary plane\n");
+		return;
+	}
+
+	addr = drm_fb_dma_get_gem_addr(plane_state->fb, plane_state, 0);
+
+	ret = sun60i_de_kms_enable(kms->de, &crtc_state->adjusted_mode, addr,
+				   plane_state->fb->pitches[0]);
+	if (ret) {
+		drm_err(crtc->dev, "display engine: %d\n", ret);
+		return;
+	}
+
+	ret = sun60i_tcon_tv_kms_enable(kms->tcon, &crtc_state->adjusted_mode,
+					sun60i_kms_crtc_bpc(kms, state));
+	if (ret) {
+		drm_err(crtc->dev, "TCON_TV1: %d\n", ret);
+		sun60i_de_kms_disable(kms->de);
+	}
+}
+
+static void sun60i_kms_crtc_atomic_disable(struct drm_crtc *crtc,
+					   struct drm_atomic_state *state)
+{
+	struct sun60i_kms *kms = crtc_to_kms(crtc);
+
+	/*
+	 * Raster first, then the fetch. The engine must not be reading a buffer
+	 * the atomic helpers are about to hand back while a TCON is still
+	 * asking it for pixels; sun60i_de_kms_disable() waits a frame before it
+	 * asserts the engine's reset for the same reason.
+	 */
+	sun60i_tcon_tv_kms_disable(kms->tcon);
+	sun60i_de_kms_disable(kms->de);
+}
+
+static const struct drm_crtc_helper_funcs sun60i_kms_crtc_helper_funcs = {
+	.mode_valid	= sun60i_kms_crtc_mode_valid,
+	.atomic_check	= sun60i_kms_crtc_atomic_check,
+	.atomic_enable	= sun60i_kms_crtc_atomic_enable,
+	.atomic_disable	= sun60i_kms_crtc_atomic_disable,
+};
+
+/*
+ * No .enable_vblank / .disable_vblank, and no drm_vblank_init() below. That is
+ * a stage boundary, not an oversight -- see the block above sun60i_kms_bind().
+ */
+static const struct drm_crtc_funcs sun60i_kms_crtc_funcs = {
+	.reset			= drm_atomic_helper_crtc_reset,
+	.set_config		= drm_atomic_helper_set_config,
+	.page_flip		= drm_atomic_helper_page_flip,
+	.atomic_duplicate_state	= drm_atomic_helper_crtc_duplicate_state,
+	.atomic_destroy_state	= drm_atomic_helper_crtc_destroy_state,
+};
+
+/*
+ * ---------------------------------------------------------------------------
+ * mode_config and the drm_driver
+ * ---------------------------------------------------------------------------
+ */
+
+static const struct drm_mode_config_funcs sun60i_kms_mode_config_funcs = {
+	/*
+	 * ⛔ drm_gem_fb_create, NEVER drm_gem_fb_create_with_dirty. The file
+	 * header says why, and it is the one line here that decides whether
+	 * the framebuffer test can be run at all.
+	 */
+	.fb_create	= drm_gem_fb_create,
+	.atomic_check	= drm_atomic_helper_check,
+	.atomic_commit	= drm_atomic_helper_commit,
+};
+
+static const struct drm_mode_config_helper_funcs sun60i_kms_mode_config_helpers = {
+	/*
+	 * The _rpm tail, and not for runtime PM. It enables CRTCs BEFORE it
+	 * commits planes, which is the order this hardware requires: the
+	 * engine's channel and blender register windows do not accept a write
+	 * until three de_top words have been set, and those are written as part
+	 * of bringing the engine up. It also calls
+	 * drm_atomic_helper_fake_vblank(), which is what completes a flip on a
+	 * CRTC with no vblank interrupt wired.
+	 */
+	.atomic_commit_tail = drm_atomic_helper_commit_tail_rpm,
+};
+
+DEFINE_DRM_GEM_DMA_FOPS(sun60i_kms_fops);
+
+static const struct drm_driver sun60i_kms_driver = {
+	.driver_features	= DRIVER_GEM | DRIVER_MODESET | DRIVER_ATOMIC,
+	.fops			= &sun60i_kms_fops,
+	.name			= "sun60i-kms",
+	.desc			= "Allwinner A733 display pipe",
+	.major			= 1,
+	.minor			= 0,
+	DRM_GEM_DMA_DRIVER_OPS,
+	DRM_FBDEV_DMA_DRIVER_OPS,
+};
+
+/*
+ * ---------------------------------------------------------------------------
+ * Building the pipe
+ * ---------------------------------------------------------------------------
+ */
+
+static int sun60i_kms_plane_init(struct sun60i_kms *kms,
+				 struct drm_plane **out)
+{
+	struct sun60i_kms_plane *plane;
+
+	plane = drmm_universal_plane_alloc(kms->drm, struct sun60i_kms_plane,
+					   base, 0, &sun60i_kms_plane_funcs,
+					   sun60i_kms_plane_formats,
+					   ARRAY_SIZE(sun60i_kms_plane_formats),
+					   sun60i_kms_plane_modifiers,
+					   DRM_PLANE_TYPE_PRIMARY, NULL);
+	if (IS_ERR(plane))
+		return PTR_ERR(plane);
+
+	plane->kms = kms;
+	drm_plane_helper_add(&plane->base, &sun60i_kms_plane_helper_funcs);
+	*out = &plane->base;
+
+	return 0;
+}
+
+/*
+ * The encoder, the bridge and the connector.
+ *
+ * DRM_MODE_ENCODER_TMDS for a DisplayPort output is not a mistake and not a
+ * shortcut: it is what dw_dp-rockchip.c:97 and analogix_dp both register, and
+ * mainline's own sun4i TCON maps TMDS to channel 1 -- the TV channel, which is
+ * the one TCON_TV1 is.
+ *
+ * DRM_BRIDGE_ATTACH_NO_CONNECTOR is mandatory here rather than preferred, and
+ * the bridge enforces it from its side: hot-plug on this board arrives out of
+ * band, through the Type-C alternate mode calling
+ * drm_connector_oob_hotplug_event(), and only a drm_bridge_connector implements
+ * .oob_hotplug_event and sets connector->fwnode from the bridge's of_node. A
+ * bridge-created connector would compile, probe, and never see a re-plug.
+ */
+static int sun60i_kms_output_init(struct sun60i_kms *kms,
+				  struct device_node *tcon_np)
+{
+	struct drm_device *drm = kms->drm;
+	struct drm_bridge *bridge;
+	int ret;
+
+	/*
+	 * drmm_ and not devm_: the two behave identically for a real bridge, but
+	 * where the graph ends in a PANEL the devm variant creates a panel
+	 * bridge tied to the platform device, which outlives the drm_device
+	 * across a bind/unbind cycle. Tie it to the drm_device that is going to
+	 * use it. (There is no panel on this board -- the point is that the
+	 * lifetime is right whether or not one ever appears.)
+	 */
+	bridge = drmm_of_get_bridge(drm, tcon_np, 1, 0);
+	if (IS_ERR(bridge))
+		return dev_err_probe(drm->dev, PTR_ERR(bridge),
+				     "no bridge on TCON_TV1 output port 1\n");
+
+	ret = drmm_encoder_init(drm, &kms->encoder, NULL,
+				DRM_MODE_ENCODER_TMDS, NULL);
+	if (ret)
+		return ret;
+
+	kms->encoder.possible_crtcs = drm_crtc_mask(&kms->crtc);
+
+	ret = drm_bridge_attach(&kms->encoder, bridge, NULL,
+				DRM_BRIDGE_ATTACH_NO_CONNECTOR);
+	if (ret)
+		return ret;
+
+	kms->connector = drm_bridge_connector_init(drm, &kms->encoder);
+	if (IS_ERR(kms->connector))
+		return PTR_ERR(kms->connector);
+
+	return drm_connector_attach_encoder(kms->connector, &kms->encoder);
+}
+
+static int sun60i_kms_mode_config(struct sun60i_kms *kms)
+{
+	struct drm_device *drm = kms->drm;
+	int ret;
+
+	ret = drmm_mode_config_init(drm);
+	if (ret)
+		return ret;
+
+	drm->mode_config.min_width = 1;
+	drm->mode_config.min_height = 1;
+	drm->mode_config.max_width = SUN60I_KMS_MAX_FB_DIM;
+	drm->mode_config.max_height = SUN60I_KMS_MAX_FB_DIM;
+	drm->mode_config.funcs = &sun60i_kms_mode_config_funcs;
+	drm->mode_config.helper_private = &sun60i_kms_mode_config_helpers;
+
+	return 0;
+}
+
+/*
+ * Walk the topology this driver supports, and refuse anything else by name.
+ *
+ * `allwinner,pipelines` is sun4i-drm's property and is reused verbatim so the
+ * device tree does not have to change on the day the engine moves into that
+ * driver. What is NOT reused is sun4i_drv_add_endpoints()' breadth-first search
+ * over the whole graph: this pipe is one display engine and one TCON, the
+ * search would have exactly one answer, and a generic walk that silently
+ * accepts a topology the rest of this file cannot build is worse than a
+ * refusal that names what it expected.
+ */
+static int sun60i_kms_topology(struct device *dev,
+			       struct device_node **engine_np,
+			       struct device_node **tcon_np)
+{
+	struct device_node *engine, *tcon;
+
+	if (of_count_phandle_with_args(dev->of_node, "allwinner,pipelines",
+				       NULL) != 1) {
+		dev_err(dev, "expected exactly one allwinner,pipelines entry -- this driver builds one CRTC\n");
+		return -EINVAL;
+	}
+
+	engine = of_parse_phandle(dev->of_node, "allwinner,pipelines", 0);
+	if (!engine)
+		return -EINVAL;
+
+	/*
+	 * Port 1 is the engine's output, the same numbering mainline's DE2/DE3/
+	 * DE33 mixer binding requires and the same edge `arm64-dts-a733-display-engine-node-and-de-to-tcon-edge` already describes.
+	 */
+	tcon = of_graph_get_remote_node(engine, 1, 0);
+	if (!tcon) {
+		dev_err(dev, "display engine %pOF has no output endpoint on port 1\n",
+			engine);
+		of_node_put(engine);
+		return -EINVAL;
+	}
+
+	*engine_np = engine;
+	*tcon_np = tcon;
+
+	return 0;
+}
+
+/*
+ * ⚠ ONE ADDRESS SPACE, CHECKED RATHER THAN ASSUMED.
+ *
+ * The framebuffer is allocated by the GEM DMA helpers against the DRM device --
+ * this master, which has no register window of its own -- and it is FETCHED by
+ * the display engine, which is a different device on a different node. With no
+ * IOMMU in the path both dma_addr_t values are plain physical addresses and the
+ * two agree; that is what `drm-a733-display-engine-dram-into-tcon-tv1` measured on 2026-08-19, scanning 1920x1200 from
+ * the physical 0xfe400000.
+ *
+ * The day an IOMMU driver and an `iommus` property arrive for the engine, they
+ * would not arrive for this node, and the address handed to the layer register
+ * would be a physical address where the engine expects an IOVA. The screen
+ * would go black with every register reading back correct -- the failure shape
+ * this pipe has already paid for twice. So the two are compared, once, at bind.
+ */
+static int sun60i_kms_check_dma_domain(struct device *master, struct device *de)
+{
+	if (device_iommu_mapped(master) == device_iommu_mapped(de))
+		return 0;
+
+	dev_err(master,
+		"IOMMU mismatch: this device is %sbehind an IOMMU and the display engine is %sbehind one -- the scanout address would be interpreted in the wrong address space\n",
+		device_iommu_mapped(master) ? "" : "NOT ",
+		device_iommu_mapped(de) ? "" : "NOT ");
+
+	return -EINVAL;
+}
+
+static int sun60i_kms_attach_components(struct sun60i_kms *kms,
+					struct device *master,
+					struct device_node *engine_np,
+					struct device_node *tcon_np)
+{
+	struct platform_device *engine, *tcon;
+	int ret = -ENODEV;
+
+	engine = of_find_device_by_node(engine_np);
+	tcon = of_find_device_by_node(tcon_np);
+	if (!engine || !tcon)
+		goto put;
+
+	kms->de = platform_get_drvdata(engine);
+	kms->tcon = platform_get_drvdata(tcon);
+	if (!kms->de || !kms->tcon) {
+		dev_err(master, "a bound component has no driver data\n");
+		goto put;
+	}
+
+	ret = sun60i_kms_check_dma_domain(master, &engine->dev);
+
+put:
+	if (tcon)
+		put_device(&tcon->dev);
+	if (engine)
+		put_device(&engine->dev);
+
+	return ret;
+}
+
+/*
+ * ⬜ WHY drm_vblank_init() IS NOT CALLED, and it is a decision with an
+ * observable consequence rather than a missing line.
+ *
+ * TCON_TV1 has an interrupt -- INTID 90 = GIC SPI 58, in the device tree since
+ * `arm64-dts-a733-tcon-tv1-and-the-dp-phy-pad-window` -- and nothing in this tree requests it. `drm-a733-tcon-tv1-timing-generator-and-video-source` deliberately writes
+ * TV_GINT0_REG to zero on the stated grounds that "an enabled interrupt with no
+ * handler is not a diagnostic, it is a latch nobody clears". Until that handler
+ * exists there is no vblank to count, and claiming one would be worse than
+ * having none: drm_atomic_helper_wait_for_vblanks() would wait on a counter
+ * that never moves.
+ *
+ * Without drm_vblank_init(), drm_dev_has_vblank() is false, so
+ * drm_atomic_helper_check_modeset() sets every crtc_state->no_vblank and
+ * drm_atomic_helper_fake_vblank() -- called from the _rpm commit tail --
+ * completes each flip event immediately. A page flip therefore returns, and it
+ * returns without any guarantee about where in the frame it landed. That is
+ * exactly what stage 3 buys, and it is why stage 3 is where the tearing test
+ * lives.
+ */
+static int sun60i_kms_bind(struct device *dev)
+{
+	struct device_node *engine_np, *tcon_np;
+	struct drm_plane *primary;
+	struct sun60i_kms *kms;
+	struct drm_device *drm;
+	int ret;
+
+	ret = sun60i_kms_topology(dev, &engine_np, &tcon_np);
+	if (ret)
+		return ret;
+
+	kms = devm_kzalloc(dev, sizeof(*kms), GFP_KERNEL);
+	if (!kms) {
+		ret = -ENOMEM;
+		goto put_nodes;
+	}
+
+	/*
+	 * drm_dev_alloc() rather than devm_drm_dev_alloc(), the same choice
+	 * sun4i_drv.c and every other component master in this subsystem makes:
+	 * a devm allocation is released when the platform device goes away, not
+	 * when the master unbinds, so a bind/unbind cycle would leave the first
+	 * drm_device behind.
+	 */
+	drm = drm_dev_alloc(&sun60i_kms_driver, dev);
+	if (IS_ERR(drm)) {
+		ret = PTR_ERR(drm);
+		goto put_nodes;
+	}
+
+	kms->drm = drm;
+	drm->dev_private = kms;
+
+	ret = sun60i_kms_mode_config(kms);
+	if (ret)
+		goto put_drm;
+
+	ret = component_bind_all(dev, drm);
+	if (ret)
+		goto put_drm;
+
+	/*
+	 * The two driver-private pointers. No long-lived reference is taken on
+	 * either device and none is needed: the component framework holds the
+	 * master and every component together between component_bind_all() and
+	 * component_unbind_all(), which is the whole reason these two blocks are
+	 * components rather than devices this driver looks up on its own.
+	 */
+	ret = sun60i_kms_attach_components(kms, dev, engine_np, tcon_np);
+	if (ret)
+		goto unbind_all;
+
+	ret = sun60i_kms_plane_init(kms, &primary);
+	if (ret)
+		goto unbind_all;
+
+	ret = drmm_crtc_init_with_planes(drm, &kms->crtc, primary, NULL,
+					 &sun60i_kms_crtc_funcs, NULL);
+	if (ret)
+		goto unbind_all;
+
+	drm_crtc_helper_add(&kms->crtc, &sun60i_kms_crtc_helper_funcs);
+
+	ret = sun60i_kms_output_init(kms, tcon_np);
+	if (ret)
+		goto unbind_all;
+
+	drm_mode_config_reset(drm);
+
+	/*
+	 * Any early framebuffer the boot chain left mapped over the same
+	 * memory. There is no simple-framebuffer node in this tree's device
+	 * tree today; this is the line that keeps that true the day one
+	 * appears, and it is what sun4i_drv_bind() does at the same point.
+	 */
+	ret = aperture_remove_all_conflicting_devices(sun60i_kms_driver.name);
+	if (ret)
+		goto unbind_all;
+
+	drm_kms_helper_poll_init(drm);
+
+	ret = drm_dev_register(drm, 0);
+	if (ret)
+		goto finish_poll;
+
+	dev_set_drvdata(dev, drm);
+
+	/*
+	 * THE CALL THIS WHOLE FILE EXISTS FOR. It is what creates /dev/fb0 and,
+	 * with CONFIG_FRAMEBUFFER_CONSOLE, puts the boot log and a login prompt
+	 * on the screen with no userspace involved. Every symbol on the path
+	 * from here to a pixel is already pinned in A733_CONFIGS.
+	 */
+	drm_client_setup(drm, NULL);
+
+	of_node_put(tcon_np);
+	of_node_put(engine_np);
+
+	return 0;
+
+finish_poll:
+	drm_kms_helper_poll_fini(drm);
+unbind_all:
+	component_unbind_all(dev, NULL);
+put_drm:
+	drm_dev_put(drm);
+put_nodes:
+	of_node_put(tcon_np);
+	of_node_put(engine_np);
+
+	return ret;
+}
+
+static void sun60i_kms_unbind(struct device *dev)
+{
+	struct drm_device *drm = dev_get_drvdata(dev);
+
+	dev_set_drvdata(dev, NULL);
+	drm_dev_unregister(drm);
+	drm_kms_helper_poll_fini(drm);
+	drm_atomic_helper_shutdown(drm);
+	component_unbind_all(dev, NULL);
+	drm_dev_put(drm);
+}
+
+static const struct component_master_ops sun60i_kms_master_ops = {
+	.bind	= sun60i_kms_bind,
+	.unbind	= sun60i_kms_unbind,
+};
+
+static int sun60i_kms_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct component_match *match = NULL;
+	struct device_node *engine_np, *tcon_np;
+	int ret;
+
+	/*
+	 * The GEM DMA helpers allocate the scanout buffer against THIS device,
+	 * so this is the mask that decides where the buffer lands. Platform
+	 * devices default to 32 bits already; it is stated because the
+	 * constraint is `drm-a733-display-engine-dram-into-tcon-tv1`'s unprogrammed high-address byte, a choice
+	 * of the far side of the pipe and not a property of this node, and a
+	 * default that changes underneath us would be silent.
+	 */
+	ret = dma_set_mask_and_coherent(dev,
+					DMA_BIT_MASK(SUN60I_KMS_DMA_BITS));
+	if (ret)
+		return dev_err_probe(dev, ret, "32-bit DMA mask\n");
+
+	ret = sun60i_kms_topology(dev, &engine_np, &tcon_np);
+	if (ret)
+		return ret;
+
+	drm_of_component_match_add(dev, &match, component_compare_of, engine_np);
+	drm_of_component_match_add(dev, &match, component_compare_of, tcon_np);
+
+	of_node_put(tcon_np);
+	of_node_put(engine_np);
+
+	return component_master_add_with_match(dev, &sun60i_kms_master_ops,
+					       match);
+}
+
+static void sun60i_kms_remove(struct platform_device *pdev)
+{
+	component_master_del(&pdev->dev, &sun60i_kms_master_ops);
+}
+
+static void sun60i_kms_shutdown(struct platform_device *pdev)
+{
+	struct drm_device *drm = platform_get_drvdata(pdev);
+
+	if (drm)
+		drm_atomic_helper_shutdown(drm);
+}
+
+/*
+ * The master node carries no register window: it is the pipeline, not a block.
+ * That is sun4i-drm's shape (`allwinner,sunXi-...-display-engine` with
+ * `allwinner,pipelines` and no reg) and it is reused so that the day the engine
+ * moves into that driver, this compatible moves into sun4i_drv_of_table and the
+ * device tree does not change.
+ */
+static const struct of_device_id sun60i_kms_of_match[] = {
+	{ .compatible = "allwinner,sun60i-a733-display-engine" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sun60i_kms_of_match);
+
+static struct platform_driver sun60i_kms_platform_driver = {
+	.probe		= sun60i_kms_probe,
+	.remove		= sun60i_kms_remove,
+	.shutdown	= sun60i_kms_shutdown,
+	.driver		= {
+		.name		= "sun60i-a733-kms",
+		.of_match_table	= sun60i_kms_of_match,
+	},
+};
+module_platform_driver(sun60i_kms_platform_driver);
+
+MODULE_DESCRIPTION("Allwinner A733 display pipe (KMS)");
+MODULE_LICENSE("GPL");
