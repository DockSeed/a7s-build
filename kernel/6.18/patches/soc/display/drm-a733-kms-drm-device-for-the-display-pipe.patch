-	sun60i_tcon_tv_program(tcon);
+	sun60i_tcon_tv_program(tcon, vdbist);
 	tcon->enabled = true;
 
 	dev_info(tcon->dev, "scanning %dx%d, %d kHz, htotal %d vtotal %d\n",
@@ -667,6 +685,111 @@ static void sun60i_tcon_tv_disable(struct sun60i_tcon_tv *tcon)
 	tcon->enabled = false;
 }
 
+/*
+ * ---------------------------------------------------------------------------
+ * The KMS half
+ * ---------------------------------------------------------------------------
+ */
+
+/*
+ * Does this mode fit the registers? The bounds are the ones
+ * sun60i_tcon_tv_check_mode() already carries, every one of them a field width
+ * from UM 15.2.10, and this is the same question a modeset asks earlier and
+ * cheaper.
+ *
+ * ⚠ IT IS NOT THE COMPLETE ANSWER, AND THE MISSING TERM HAS A NAME:
+ * PIXEL_MODE. The transmitter may consume more than one pixel per clock, and
+ * when it does, TV_GCTL[5:4] and this TCON's module clock both have to follow
+ * it -- the vendor divides the pixel clock by that factor
+ * (clk_set_rate(mclk, pixel_clk / pixel_mode) in sunxi_tcon_edp_mode_init())
+ * and writes the same factor into GCTL. This tree runs one pixel per clock on
+ * both sides and both are at their reset value, so the invariant holds today
+ * by both halves being untouched -- but a mode list wider than one entry has to
+ * carry the factor through all three places or the raster is wrong by an
+ * integer ratio. Named here because that is where the next reader will look.
+ */
+int sun60i_tcon_tv_kms_check(struct sun60i_tcon_tv *tcon,
+			     const struct drm_display_mode *mode)
+{
+	return sun60i_tcon_tv_check_mode(tcon, mode);
+}
+EXPORT_SYMBOL_GPL(sun60i_tcon_tv_kms_check);
+
+/*
+ * The raster, taking its source from the display engine rather than from the
+ * TCON's own pattern generator. That single argument is the whole difference
+ * between this and the debugfs verb.
+ */
+int sun60i_tcon_tv_kms_enable(struct sun60i_tcon_tv *tcon,
+			      const struct drm_display_mode *mode, u8 bpc)
+{
+	guard(mutex)(&tcon->lock);
+
+	if (!tcon->kms_owned)
+		return -EPERM;
+
+	if (tcon->enabled)
+		return -EBUSY;
+
+	drm_mode_copy(&tcon->mode, mode);
+	tcon->bpc = bpc;
+
+	return sun60i_tcon_tv_enable(tcon, false);
+}
+EXPORT_SYMBOL_GPL(sun60i_tcon_tv_kms_enable);
+
+void sun60i_tcon_tv_kms_disable(struct sun60i_tcon_tv *tcon)
+{
+	guard(mutex)(&tcon->lock);
+
+	if (!tcon->enabled)
+		return;
+
+	sun60i_tcon_tv_disable(tcon);
+}
+EXPORT_SYMBOL_GPL(sun60i_tcon_tv_kms_disable);
+
+/* No hardware work at bind -- the reasoning is at sun60i_de_bind(). */
+static int sun60i_tcon_tv_bind(struct device *dev, struct device *master,
+			       void *data)
+{
+	struct sun60i_tcon_tv *tcon = dev_get_drvdata(dev);
+
+	guard(mutex)(&tcon->lock);
+
+	if (tcon->enabled) {
+		dev_err(dev, "already scanning from debugfs; refusing to hand the raster to a KMS master\n");
+		return -EBUSY;
+	}
+
+	tcon->kms_owned = true;
+
+	return 0;
+}
+
+static void sun60i_tcon_tv_unbind(struct device *dev, struct device *master,
+				  void *data)
+{
+	struct sun60i_tcon_tv *tcon = dev_get_drvdata(dev);
+
+	guard(mutex)(&tcon->lock);
+
+	if (tcon->enabled)
+		sun60i_tcon_tv_disable(tcon);
+
+	tcon->kms_owned = false;
+}
+
+static const struct component_ops sun60i_tcon_tv_component_ops = {
+	.bind	= sun60i_tcon_tv_bind,
+	.unbind	= sun60i_tcon_tv_unbind,
+};
+
+static void sun60i_tcon_tv_component_remove(void *data)
+{
+	component_del(data, &sun60i_tcon_tv_component_ops);
+}
+
 static void sun60i_tcon_tv_teardown(void *data)
 {
 	struct sun60i_tcon_tv *tcon = data;
@@ -786,7 +909,13 @@ static int sun60i_tcon_tv_probe(struct platform_device *pdev)
 
 	dev_info(dev, "A733 TCON_TV1 on %s, idle until a KMS master binds\n", dev_name(dev));
 
-	return 0;
+	/* Last, for the reason sun60i_de_probe() gives. */
+	ret = component_add(dev, &sun60i_tcon_tv_component_ops);
+	if (ret)
+		return dev_err_probe(dev, ret, "component_add\n");
+
+	return devm_add_action_or_reset(dev, sun60i_tcon_tv_component_remove,
+					dev);
 }
 
 static const struct of_device_id sun60i_tcon_tv_of_match[] = {
