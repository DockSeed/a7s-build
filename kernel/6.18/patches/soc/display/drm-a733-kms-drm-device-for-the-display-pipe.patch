-static void sun60i_de_disable(struct sun60i_de *de)
+/*
+ * The order is the one derived from what
+ * depends on what: clocks, then the liveness read, then the RCQ disarmed, then
+ * the control plane, then the datapath, then the arm. That last half is
+ * INFERRED and not measured -- the capture is a snapshot and says nothing about
+ * write order -- and ordering is where bring-up usually fails, so it is named
+ * as inferred rather than presented as known.
+ *
+ * NOTHING HERE TOUCHES THE TCON. TV_SRC_CTL bit 0 stays where `drm-a733-tcon-tv1-timing-generator-and-video-source` left it, and
+ * moving it to 0 (the DE becomes the data source) is a separate,
+ * deliberate act through that driver's own `source` file. That separation IS
+ * the acceptance test: the bars are on the screen from the TCON's own pattern
+ * generator, and one write to another driver replaces them with this one's
+ * framebuffer. A driver that reached across and did it itself would have proven
+ * the two together and neither alone.
+ */
+static int sun60i_de_start(struct sun60i_de *de)
 {
+	int ret;
+
+	ret = sun60i_de_clocks_on(de);
+	if (ret) {
+		dev_err(de->dev, "gates and resets: %d\n", ret);
+		return ret;
+	}
+
+	ret = sun60i_de_check_alive(de);
+	if (ret)
+		goto err_clocks;
+
 	/*
-	 * Layer off, then quiesce, then the clocks, then the memory. The DE has
-	 * to stop fetching before the pages under it go back to CMA, or a buffer
-	 * that now belongs to somebody else is still being read at
-	 * 138 Mpixel/s -- and it has to be given time to finish what is in
-	 * flight before its reset is asserted underneath it.
+	 * FIRST, and the order is the board's, not a preference: nothing in the
+	 * channel or blender windows accepts a write until these three are set,
+	 * and the reset asserted in sun60i_de_clocks_off() clears them again.
 	 */
+	sun60i_de_top_open(de);
+
+	sun60i_de_disarm_rcq(de);
+	sun60i_de_top_setup(de);
+
+	de->commit->begin(de);
+	sun60i_de_channel_quiesce(de);
+	sun60i_de_blender(de);
+	sun60i_de_layer(de);
+	ret = de->commit->arm(de);
+	if (ret) {
+		dev_err(de->dev, "commit (%s): %d\n", de->commit->name, ret);
+		goto err_clocks;
+	}
+
+	/*
+	 * Before any claim of success. The first cut announced "scanning ..."
+	 * over a datapath that had silently refused every write, next to a
+	 * `state` dump that showed the zeros -- intent printed beside the
+	 * evidence against it.
+	 */
+	ret = sun60i_de_verify(de);
+	if (ret)
+		goto err_clocks;
+
+	de->enabled = true;
+	de->layer_on = true;
+
+	dev_info(de->dev,
+		 "scanning %dx%d XRGB8888 from %pad, pitch %u, commit by %s\n",
+		 de->mode.hdisplay, de->mode.vdisplay, &de->fb_dma,
+		 de->fb_pitch, de->commit->name);
+	dev_info(de->dev,
+		 "the TCON still owns the source: clear TV_SRC_CTL bit 0 to show this\n");
+
+	return 0;
+
+err_clocks:
+	sun60i_de_clocks_off(de);
+
+	return ret;
+}
+
+/*
+ * Stop fetching and put the block back to reset, leaving the memory alone.
+ *
+ * Layer off, then quiesce, then the clocks. The DE has to stop fetching before
+ * the pages under it are handed back, or a buffer that now belongs to somebody
+ * else is still being read at 138 Mpixel/s -- and it has to be given time to
+ * finish what is in flight before its reset is asserted underneath it.
+ */
+static void sun60i_de_stop(struct sun60i_de *de)
+{
 	sun60i_de_layer_disable(de);
 	sun60i_de_quiesce(de);
 	sun60i_de_clocks_off(de);
 	de->enabled = false;
 }
 
+static void sun60i_de_disable(struct sun60i_de *de)
+{
+	sun60i_de_stop(de);
+}
+
 struct sun60i_de_reg {
 	const char	*name;
 	u32		off;
@@ -1243,6 +1338,144 @@ static int sun60i_de_state_show(struct seq_file *s, void *unused)
 }
 DEFINE_SHOW_ATTRIBUTE(sun60i_de_state);
 
+/*
+ * ---------------------------------------------------------------------------
+ * The KMS half
+ * ---------------------------------------------------------------------------
+ *
+ * Four entry points for sun60i-kms.ko and nothing else. The scanout memory is
+ * a GEM object the DRM core owns.
+ *
+ * ⚠ THE ADDRESS COMES FROM A DIFFERENT DEVICE, AND THAT IS NOT FREE. The GEM
+ * helpers allocate against the DRM device, this block fetches through its own
+ * bus master, and the two are only interchangeable while neither is behind an
+ * IOMMU -- which is what was measured on 2026-08-19 and what sun60i-kms.c
+ * checks once at bind rather than assuming.
+ */
+int sun60i_de_kms_enable(struct sun60i_de *de,
+			 const struct drm_display_mode *mode,
+			 dma_addr_t scanout, u32 pitch)
+{
+	guard(mutex)(&de->lock);
+
+	if (!de->kms_owned)
+		return -EPERM;
+
+	if (de->enabled)
+		return -EBUSY;
+
+	drm_mode_copy(&de->mode, mode);
+	de->fb_dma = scanout;
+	de->fb_pitch = pitch;
+
+	return sun60i_de_start(de);
+}
+EXPORT_SYMBOL_GPL(sun60i_de_kms_enable);
+
+void sun60i_de_kms_disable(struct sun60i_de *de)
+{
+	guard(mutex)(&de->lock);
+
+	if (!de->enabled)
+		return;
+
+	sun60i_de_stop(de);
+	de->fb_dma = 0;
+	de->fb_pitch = 0;
+}
+EXPORT_SYMBOL_GPL(sun60i_de_kms_disable);
+
+/*
+ * A new scanout address, staged through the same commit path as everything
+ * else. This is the page flip, and what it is NOT is a flip synchronised to
+ * anything: nothing here waits for vblank, because nothing in this tree
+ * services the TCON interrupt yet.
+ *
+ * ⚠ AND THE MISSING GUARD HAS A SHAPE, WHICH IS WORTH MORE THAN "expect
+ * tearing". The vendor does not write the datapath at an arbitrary point in the
+ * frame: it reads the TCON's current line and, if it is outside
+ * [vtotal/4, 3*vtotal/4], arms an hrtimer and waits until it is
+ * (rcq_update_timer_start(), allwinner-bsp sunxi_de.c:665-691), and the TCON
+ * separately derives a per-mode deadline from its own start delay and refuses
+ * an update past it (sunxi_tcon_calc_judge_line(), sunxi_tcon.c:121-150). Two
+ * independent line-window guards on the same write this function does
+ * unguarded. So the risk here is not only a torn line: it is a write that lands
+ * on a frame boundary. Stage 3 owns it, it needs the TCON interrupt first, and
+ * the two functions above are what it should look like.
+ */
+int sun60i_de_kms_scanout(struct sun60i_de *de, dma_addr_t scanout, u32 pitch)
+{
+	guard(mutex)(&de->lock);
+
+	if (!de->enabled)
+		return -ENODEV;
+
+	de->fb_dma = scanout;
+	de->fb_pitch = pitch;
+	sun60i_de_layer_enable(de);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(sun60i_de_kms_scanout);
+
+void sun60i_de_kms_layer_off(struct sun60i_de *de)
+{
+	guard(mutex)(&de->lock);
+
+	if (!de->enabled)
+		return;
+
+	sun60i_de_layer_disable(de);
+}
+EXPORT_SYMBOL_GPL(sun60i_de_kms_layer_off);
+
+/*
+ * The component hooks do no hardware work at all, and that is deliberate: this
+ * driver is started by a modeset, not by a bind, exactly as it is started by a
+ * debugfs write and not by a probe. What bind buys is the ownership handshake
+ * and the framework's guarantee that this device stays bound for as long as the
+ * KMS master holds it -- which is what lets sun60i-kms.c keep a bare pointer to
+ * this struct with no reference of its own.
+ */
+static int sun60i_de_bind(struct device *dev, struct device *master, void *data)
+{
+	struct sun60i_de *de = dev_get_drvdata(dev);
+
+	guard(mutex)(&de->lock);
+
+	if (de->enabled) {
+		dev_err(dev, "already enabled through debugfs; refusing to hand the datapath to a KMS master\n");
+		return -EBUSY;
+	}
+
+	de->kms_owned = true;
+
+	return 0;
+}
+
+static void sun60i_de_unbind(struct device *dev, struct device *master,
+			     void *data)
+{
+	struct sun60i_de *de = dev_get_drvdata(dev);
+
+	guard(mutex)(&de->lock);
+
+	if (de->enabled)
+		sun60i_de_stop(de);
+
+	de->kms_owned = false;
+}
+
+static const struct component_ops sun60i_de_component_ops = {
+	.bind	= sun60i_de_bind,
+	.unbind	= sun60i_de_unbind,
+};
+
+static void sun60i_de_component_remove(void *data)
+{
+	component_del(data, &sun60i_de_component_ops);
+}
