+/*
+ * The output edge of this transmitter in the OF graph. Port 0 is the input from
+ * TCON_TV1; port 1 is the output. The same pair the KMS driver already uses from
+ * the other side -- sun60i-kms.c asks drmm_of_get_bridge(drm, tcon_np, 1, 0) for
+ * the TCON's output -- and the numbers are a driver convention, not a binding.
+ */
+#define SUN60I_DP_OF_PORT_OUT		1
+#define SUN60I_DP_OF_ENDPOINT_OUT	0
+
+/*
+ * Resolve the bridge on the output port, and publish one for the Type-C
+ * receptacle when that is what the graph ends in.
+ *
+ * WHY A BRIDGE FOR A RECEPTACLE AT ALL. A usb-c-connector is not a display
+ * device and has no driver; the DisplayPort lanes leave the SoC and arrive at
+ * the plug with nothing in between (no SBU mux, no
+ * redriver). The bridge exists for exactly one reason -- to be the LAST bridge
