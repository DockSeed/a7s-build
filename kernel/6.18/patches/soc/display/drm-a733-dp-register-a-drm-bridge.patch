+/*
+ * ---------------------------------------------------------------------------
+ * The DRM bridge
+ * ---------------------------------------------------------------------------
+ *
+ * The planned shape: the DE joins sun4i-drm,
+ * the TCON stays ours and gains a CRTC, and the DP becomes a drm_bridge and an
+ * encoder component. This is the bridge. The encoder is not here, and cannot
+ * be: drmm_encoder_init() takes a struct drm_device, and creating one is the
+ * component master's job in the half of Stage 2 that this file does not own.
+ *
+ * WHAT THIS ADDS THAT `drm-allwinner-a733-displayport-aux` DELIBERATELY LEFT OUT. `drm-allwinner-a733-displayport-aux`'s header says the
+ * chardev "is the part that needs the DRM parent" and does not create it.
+ * drm_dp_aux_register() does, so from the first attach this device has a
+ * /dev/drm_dp_auxN that any process can drive. That is a new way into
+ * sun60i_dp_aux_transfer() which does not pass through a debugfs verb, and the
+ * guard at the top of that function is its answer -- see the block there.
+ *
+ * WHY drm_bridge_add() RATHER THAN A BIND CALLBACK. dw_dp-rockchip.c builds its
+ * bridge inside component .bind, where a drm_device already exists; it can,
+ * because the same driver owns both halves. Here the two halves are separate
+ * devices with separate DT nodes, so the bridge has to exist BEFORE the encoder
+ * that will attach it -- which is what drm_bridge_add() is for and what
+ * of_drm_find_bridge()/devm_drm_of_get_bridge() look in. That also keeps the
+ * dependency one-way: this driver never has to know the KMS half exists.
+ *
+ * WHY NOT DRM_BRIDGE_OP_HPD, and this is a measurement, not taste. The op means
+ * "this bridge detects hot-plug and calls drm_bridge_hpd_notify()". This one
+ * cannot: HPD_INPUT_STATE, eDP0 offset 0x0128, absolute 0x05740128, reads zero
+ * on this board while a picture is on the wire -- read on 2026-08-19 against
+ * the VENDOR's live link, so it is the board and not our bring-up.
+ * The pad is not routed to the connector. Claiming
+ * the op would give the connector DRM_CONNECTOR_POLL_HPD, which waits for a
+ * drm_bridge_hpd_notify() that can never come -- a display that never returns
+ * after a re-plug.
+ *
+ * WHERE HPD ACTUALLY COMES FROM, and it is already in the tree. The alternate
+ * mode carries it: drivers/usb/typec/altmodes/displayport.c calls
+ * drm_connector_oob_hotplug_event() on every HPD change, and drm_connector.c's
+ * own kerneldoc names this exact board -- "some USB Type-C setups where the
+ * hardware muxes the DisplayPort data and aux-lines but does not pass the
+ * altmode HPD status bit to the GPU's DP HPD pin". drm_bridge_connector
+ * implements .oob_hotplug_event, sets connector->status from it and then calls
+ * .hpd_notify on every bridge in the chain (drm_bridge_connector.c:135-161), so
+ * the callback below is the far end of a path that already runs on this board
+ * -- typec_displayport.ko is shipped and DRM is pinned in A733_CONFIGS for
+ * exactly that symbol.
+ *
+ * ⬜ ONE LINK IN THAT PATH IS NOT PROVEN AND IS NOT PROVEN BY THIS PATCH.
+ * drm_connector_find_by_fwnode() matches connector->fwnode, which
+ * drm_bridge_connector sets from the LAST bridge's of_node -- our DP node --
+ * while dp_altmode_probe() takes the Type-C port's own fwnode unless the port
+ * carries a `displayport` property pointing elsewhere (displayport.c:800-804).
+ * The two are different nodes, so on this board the event would be dropped. The
+ * property exists in the code and in NO binding: usb-connector.yaml is
+ * `unevaluatedProperties: false` and documents only an `altmodes/displayport`
+ * CHILD NODE, which is not a property and does not satisfy that lookup, and no
+ * DT in the tree uses it. Falsified/closed by one observation once a connector
+ * exists: plug the monitor and watch /sys/class/drm/<card>-DP-1/status. It is
+ * NOT this patch's to fix -- the DT edit belongs with the connector.
+ *
+ * WHY .detect TOUCHES NO REGISTER. With DRM_BRIDGE_OP_DETECT and no HPD op,
+ * drm_bridge_connector sets connector->polled to POLL_CONNECT|POLL_DISCONNECT
+ * (drm_bridge_connector.c:845-848) and the probe helper calls .detect every ten
+ * seconds, for ever, with nothing attached. A .detect that talked on AUX would
+ * therefore reproduce the vendor's own defect -- 7 hardware retries per read
+ * into a powered-down front end, forever instead of only at bind. So .detect
+ * reports state that .hpd_notify recorded, and only .hpd_notify opens the
+ * channel.
+ */
+
+/*
+ * The best payload rate the PHY can carry at the full lane count, in kB/s, or
+ * zero if nothing can be asked.
+ *
+ * This is deliberately NOT sun60i_dp_link_rate_ladder(): that one starts from
+ * the sink's DPCD, and drm_bridge_funcs.mode_valid's kerneldoc forbids looking
+ * at anything but the mode and "configuration-invariant hardware constraints".
+ * The PHY's rate table is such a constraint -- there is exactly one of it, it
+ * does not depend on what is plugged in, and phy_validate() is side-effect free
+ * by construction (phy-sun60i-a733-combophy.c). The sink's own limit is applied
+ * where it belongs, by the DRM core, out of the EDID.
+ */
+static int sun60i_dp_bridge_link_budget(struct sun60i_dp *dp)
+{
+	union phy_configure_opts opts;
+	int best = 0;
+	unsigned int i;
+
+	if (!dp->link_phy)
+		return 0;
+
+	for (i = 0; i < ARRAY_SIZE(sun60i_dp_link_rates); i++) {
+		unsigned int mbps = SUN60I_DP_RATE_TO_MBPS(sun60i_dp_link_rates[i]);
+
+		sun60i_dp_fill_opts(&opts, mbps, SUN60I_DP_MAX_LANES);
+		if (phy_validate(dp->link_phy, PHY_MODE_DP, PHY_SUBMODE_DP,
+				 &opts))
+			continue;
+
+		best = max(best,
+			   drm_dp_max_dprx_data_rate(sun60i_dp_link_rates[i],
+						     SUN60I_DP_MAX_LANES));
+	}
+
+	return best;
+}
+
+static enum drm_mode_status
+sun60i_dp_bridge_mode_valid(struct drm_bridge *bridge,
+			    const struct drm_display_info *info,
+			    const struct drm_display_mode *mode)
+{
+	struct sun60i_dp *dp = bridge_to_dp(bridge);
+	unsigned int bpp = (info && info->bpc ? info->bpc : 8) * 3;
+	unsigned int need;
+	int budget;
+
+	if (mode->clock <= 0)
+		return MODE_CLOCK_LOW;
+
+	/*
+	 * TCON_TV1 refuses an interlaced mode outright and says why
+	 * (sun60i-tcon-tv.c, check_mode): the progressive-only fields are the
+	 * only ones this tree has ever programmed. Answering here as well keeps
+	 * the mode out of the connector's list rather than failing the commit.
+	 */
+	if (mode->flags & DRM_MODE_FLAG_INTERLACE)
+		return MODE_NO_INTERLACE;
+
+	/*
+	 * ⚠ ONE PIXEL CLOCK, AND THE RESTRICTION IS HONEST RATHER THAN
+	 * CONSERVATIVE. `clk-sunxi-ng-a733-video-plls-and-edp-tv-pixel-clock` models PLL_VIDEO1 as real clk_ops with rate
+	 * propagation, and its own header names what it owes: "a SECOND mode.
+	 * Nothing has ever asked this PLL for one" -- a mode whose pixel clock
+	 * is not an integer divisor of a reachable VCO lands on the nearest
+	 * lower rate, and the falsifier it names is SRC0_MVID not computing back
+	 * to the requested clock. Until that measurement exists, a connector
+	 * whose EDID offers a mode list would hand this driver clocks nothing
+	 * has ever produced, and the only thing between that and a silently
+	 * wrong raster is `drm-a733-tcon-tv1-timing-generator-and-video-source`'s readback -- one 1 % check, after the fact.
+	 *
+	 * So the mode list is gated on the one clock this tree has driven, and
+	 * the gate carries the observation that removes it. It sits here rather
+	 * than in the CRTC only because the CRTC does not exist yet; it belongs
+	 * to whoever owns clk_round_rate() on the pixel clock, which is
+	 * TCON_TV1, and it moves there when that half lands.
+	 *
+	 * Closed by: asking PLL_VIDEO1 for a second mode -- 1280x1024 at
+	 * 108 MHz is the one `clk-sunxi-ng-a733-video-plls-and-edp-tv-pixel-clock` names -- and reading SRC0_MVID back. If it
+	 * computes to the requested clock, this test becomes a
+	 * clk_round_rate() tolerance check instead.
+	 */
+	if (mode->clock != sun60i_display_mode_1920x1200.clock)
+		return MODE_CLOCK_RANGE;
+
+	budget = sun60i_dp_bridge_link_budget(dp);
+	if (!budget)
+		return MODE_OK;
+
+	/* kB/s on both sides: mode->clock counts kHz and drm_dp_max_dprx_data_
+	 * rate() returns kB/s, so pixels/s * bytes/pixel is the comparison.
+	 */
+	need = DIV_ROUND_UP((unsigned int)mode->clock * bpp, 8);
+	if (need > (unsigned int)budget)
+		return MODE_CLOCK_HIGH;
+
+	return MODE_OK;
+}
+
+static enum drm_connector_status
+sun60i_dp_bridge_detect(struct drm_bridge *bridge,
+			struct drm_connector *connector)
+{
+	struct sun60i_dp *dp = bridge_to_dp(bridge);
+
+	guard(mutex)(&dp->lock);
+
+	/*
+	 * dpcd_valid, not `enabled`: the AUX channel being powered says this
+	 * driver opened it, the sink's own capability bytes say something
+	 * answered. No sink is a STATE, not an error -- so this
+	 * returns disconnected quietly and logs nothing on the ten-second poll.
+	 */
+	return dp->dpcd_valid ? connector_status_connected
+			      : connector_status_disconnected;
+}
+
+static const struct drm_edid *
+sun60i_dp_bridge_edid_read(struct drm_bridge *bridge,
+			   struct drm_connector *connector)
+{
+	struct sun60i_dp *dp = bridge_to_dp(bridge);
+
+	guard(mutex)(&dp->lock);
+
+	if (!dp->enabled)
+		return NULL;
+
+	/*
+	 * ⬜ THIS MAY RETIRE the earlier two-block EDID reader's CAP, AND THAT IS A CLAIM, NOT A RESULT.
+	 * The earlier two-block EDID reader reads at most two EDID blocks and says so out loud, because this
+	 * core's AUX block sends a ONE-BYTE offset and block 2 onwards needs the
+	 * E-DDC segment pointer -- which the earlier reader's header records as arriving "with
+	 * the display stack instead of being hand-rolled now". This is that
+	 * display stack: drm_edid_read_ddc() writes the segment pointer itself,
+	 * as a separate one-byte i2c write to DDC_SEGMENT_ADDR, which is an
+	 * ordinary transaction for this AUX block.
+	 *
+	 * Untested: the bench sink declares exactly ONE extension block, so it
+	 * cannot tell the two apart. Falsified/confirmed by a sink with three or
+	 * more blocks -- `edid` prints how many it skipped and why, and the
+	 * connector's own EDID is then the comparison. That file stays either
+	 * way; this tree does not delete diagnostics.
+	 */
+	return drm_edid_read_ddc(connector, &dp->aux.ddc);
+}
+
+/*
+ * The far end of the Type-C alternate mode's HPD. This is the ONE place that
+ * opens the AUX channel by itself, and that is the whole rule: the
+ * channel is opened when something has said a sink is there, never at bind and
+ * never on a poll.
+ */
+static void sun60i_dp_bridge_hpd_notify(struct drm_bridge *bridge,
+					enum drm_connector_status status)
+{
+	struct sun60i_dp *dp = bridge_to_dp(bridge);
+	int ret;
+
+	guard(mutex)(&dp->lock);
+
+	if (status != connector_status_connected) {
+		if (dp->enabled)
+			sun60i_dp_aux_disable(dp);
+		return;
+	}
+
+	if (!dp->enabled) {
+		ret = sun60i_dp_aux_enable(dp);
+		if (ret)
+			return;
+	}
+
+	/* Failure is reported by sun60i_dp_link_probe() itself and leaves
+	 * dpcd_valid false, which is what .detect will then answer. Nothing is
+	 * retried here -- the DRM core owns AUX retries.
+	 */
+	sun60i_dp_link_probe(dp);
+}
+
+static void sun60i_dp_bridge_atomic_enable(struct drm_bridge *bridge,
+					   struct drm_atomic_state *state)
+{
+	struct sun60i_dp *dp = bridge_to_dp(bridge);
+	struct drm_connector_state *conn_state;
+	struct drm_crtc_state *crtc_state;
+	struct drm_connector *connector;
+	int ret;
+
+	connector = drm_atomic_get_new_connector_for_encoder(state,
+							     bridge->encoder);
+	if (!connector) {
+		dev_err(dp->dev, "atomic enable with no connector\n");
+		return;
+	}
+
+	conn_state = drm_atomic_get_new_connector_state(state, connector);
+	if (!conn_state || !conn_state->crtc) {
+		dev_err(dp->dev, "atomic enable with no CRTC\n");
+		return;
+	}
+
+	crtc_state = drm_atomic_get_new_crtc_state(state, conn_state->crtc);
+	if (!crtc_state) {
+		dev_err(dp->dev, "atomic enable with no CRTC state\n");
+		return;
+	}
+
+	guard(mutex)(&dp->lock);
+
+	/*
+	 * ⚠ THE INVARIANT sun60i-display.h EXISTS FOR IS NOT CLOSED HERE.
+	 * TCON_TV1 and this transmitter must describe the SAME mode; the
+	 * hardware reports a disagreement as SRC0_USER_FIFO_STATUS != 0,
+	 * flagging a mismatch with the current video mode. From
+	 * here the transmitter takes its mode from the atomic state, which is
+	 * the retirement path that header names -- but the TCON still takes the
+	 * constant until it gains a CRTC, which is the other half of Stage 2.
+	 * Until both read the same atomic state, the invariant is held only by
+	 * .mode_valid and by the constant, and the observable that would catch a
+	 * mismatch is the one the driver already reads and prints.
+	 */
+	drm_mode_copy(&dp->mode, &crtc_state->adjusted_mode);
+	if (connector->display_info.bpc)
+		dp->bpc = connector->display_info.bpc;
+
+	/* Auto on both: the rate ladder asks the sink and the PHY, and the lane
+	 * ladder is the fallback DP 1.4 section 3.5.1.2.1 requires. A modeset must not
+	 * hardcode either -- that is the vendor behaviour `drm-a733-dp-link-training` replaced.
+	 */
+	ret = sun60i_dp_train(dp, 0, 0);
+	if (ret) {
+		/*
+		 * Stopping here is NOT the thing this tree rejected. What was
+		 * rejected is making the VIDEO path refuse a link this driver
+		 * did not train -- sun60i_dp_video_stream_enable() warns
+		 * instead, so that a test script stays usable
+		 * as the A/B arm on the same kernel. That still holds: the
+		 * debugfs verbs reach the video path without coming through
+		 * here. This is our own training returning an error, which
+		 * means the ladder ran out of rungs -- streaming pixels into a
+		 * link that reported itself untrained would produce a black
+		 * screen and no line saying why.
+		 */
+		dev_err(dp->dev, "link training failed: %d\n", ret);
+		return;
+	}
+
+	ret = sun60i_dp_video_configure(dp);
+	if (ret) {
+		dev_err(dp->dev, "video configure failed: %d\n", ret);
+		return;
+	}
+
+	ret = sun60i_dp_video_stream_enable(dp);
+	if (ret)
+		dev_err(dp->dev, "video stream enable failed: %d\n", ret);
+}
+
+static void sun60i_dp_bridge_atomic_disable(struct drm_bridge *bridge,
+					    struct drm_atomic_state *state)
+{
+	struct sun60i_dp *dp = bridge_to_dp(bridge);
+
+	guard(mutex)(&dp->lock);
+
+	/*
+	 * The stream, and deliberately not the link. sun60i_dp_link_release()
+	 * calls phy_exit() on COMB0, which dwc3 also holds; it is refcounted, so
+	 * it would not pull SuperSpeed down -- but a modeset off is not the
+	 * event that should release a PHY the Type-C mux handed us. That is
+	 * .hpd_notify's disconnect, or the driver going away.
+	 */
+	sun60i_dp_video_disable(dp);
+}
+
+static int sun60i_dp_bridge_attach(struct drm_bridge *bridge,
+				   struct drm_encoder *encoder,
+				   enum drm_bridge_attach_flags flags)
+{
+	struct sun60i_dp *dp = bridge_to_dp(bridge);
+	int ret;
+
+	/*
+	 * The legacy path, where the bridge creates its own connector, is
+	 * refused rather than implemented -- and not on style grounds. The
+	 * out-of-band HPD above reaches a connector only through
+	 * drm_bridge_connector, which is what sets connector->fwnode from
+	 * bridge->of_node and implements .oob_hotplug_event. A hand-rolled
+	 * connector here would compile, probe, and silently never see a
+	 * hot-plug on this board.
+	 */
+	if (!(flags & DRM_BRIDGE_ATTACH_NO_CONNECTOR)) {
+		dev_err(dp->dev,
+			"attach without DRM_BRIDGE_ATTACH_NO_CONNECTOR: this bridge needs drm_bridge_connector_init(), because Type-C alt-mode HPD arrives out of band and only that connector receives it\n");
+		return -EINVAL;
+	}
+
+	guard(mutex)(&dp->lock);
+
+	/*
+	 * A user may already have opened AUX through the debugfs verb, in
+	 * which case this driver holds the ddc adapter. Hand it over: it is the
+	 * same struct i2c_adapter, and drm_dp_aux_register() adds it again.
+	 */
+	if (dp->ddc_owner == SUN60I_DP_DDC_DRIVER) {
+		i2c_del_adapter(&dp->aux.ddc);
+		dp->ddc_owner = SUN60I_DP_DDC_NONE;
+	}
+
+	dp->aux.drm_dev = bridge->dev;
+	ret = drm_dp_aux_register(&dp->aux);
+	if (ret) {
+		dev_err(dp->dev, "DP AUX register: %d\n", ret);
+		return ret;
+	}
+
+	dp->ddc_owner = SUN60I_DP_DDC_DRM;
+
+	return 0;
+}
+
+static void sun60i_dp_bridge_detach(struct drm_bridge *bridge)
+{
+	struct sun60i_dp *dp = bridge_to_dp(bridge);
+
+	guard(mutex)(&dp->lock);
+
+	/* Down first, so nothing is left holding a channel whose adapter is
+	 * about to disappear. aux_disable() will not touch the adapter while
+	 * the core owns it.
+	 */
+	if (dp->enabled)
+		sun60i_dp_aux_disable(dp);
+
+	drm_dp_aux_unregister(&dp->aux);
+	dp->aux.drm_dev = NULL;
+	dp->ddc_owner = SUN60I_DP_DDC_NONE;
+}
+
+static const struct drm_bridge_funcs sun60i_dp_bridge_funcs = {
+	/* The three state helpers are what make this bridge atomic at all --
+	 * drm_bridge_is_atomic() tests for .atomic_reset (drm_bridge.c:382), and
+	 * without it the chain would never call .atomic_enable.
+	 */
+	.atomic_reset		= drm_atomic_helper_bridge_reset,
+	.atomic_duplicate_state	= drm_atomic_helper_bridge_duplicate_state,
+	.atomic_destroy_state	= drm_atomic_helper_bridge_destroy_state,
+	.atomic_get_input_bus_fmts = drm_atomic_helper_bridge_propagate_bus_fmt,
+	.attach			= sun60i_dp_bridge_attach,
+	.detach			= sun60i_dp_bridge_detach,
+	.mode_valid		= sun60i_dp_bridge_mode_valid,
+	.detect			= sun60i_dp_bridge_detect,
+	.edid_read		= sun60i_dp_bridge_edid_read,
+	.hpd_notify		= sun60i_dp_bridge_hpd_notify,
+	.atomic_enable		= sun60i_dp_bridge_atomic_enable,
+	.atomic_disable		= sun60i_dp_bridge_atomic_disable,
+};
