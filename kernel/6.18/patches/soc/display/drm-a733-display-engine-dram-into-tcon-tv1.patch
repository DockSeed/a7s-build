diff --git a/drivers/gpu/drm/sun60i/sun60i-de.c b/drivers/gpu/drm/sun60i/sun60i-de.c
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/sun60i/sun60i-de.c
@@ -0,0 +1,1435 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Allwinner A733 (sun60iw2) display engine -- the block that scans DRAM.
+ *
+ * TCON_TV1 (sun60i-tcon-tv.c, `drm-a733-tcon-tv1-timing-generator-and-video-source`) turns a pixel clock into a raster and can
+ * source that raster from its own VDBIST pattern generator. That is why this
+ * SoC had a picture before it had a framebuffer -- and it is also why that
+ * picture could never be a console. TV_SRC_CTL_REG bit 0 has
+ * exactly two settings, the DE providing the data source (0) or the VDBIST
+ * test-pattern generator providing it (1); there is no third source. So every
+ * path from DRAM to the screen on this part runs through the display engine,
+ * and this file is that engine.
+ *
+ * What it does, and deliberately nothing more. One display pipe, one VI
+ * channel, one layer, XRGB8888, the one mode this path has ever driven. The
+ * framebuffer is DMA-coherent memory this driver allocates and paints, so the
+ * fetch path is provable end to end with no KMS device above it -- the shape
+ * `drm-a733-tcon-tv1-timing-generator-and-video-source` used to prove the TCON before there was a CRTC to hang it on.
+ *
+ * Where the values come from, and why none of them carries a manual reference.
+ * A733 UM V0.92 chapter 14.3 "Display Engine" is two pages of prose
+ * (A733 user manual): no register list, no offset table, no field table.
+ * Searched over the whole 2.7 MB UM extract, `GLB_CTL`, `BLD_`, `OVL_`,
+ * `blender` and `RCQ` return zero hits each; the one `mixer` hit is in 14.5 and
+ * describes G2D. Compare TCON_TV, which gets a register chapter with per-bit
+ * tables (15.2.10), or eDP (15.4.7). The DE gets neither.
+ *
+ * So the evidence floor here is one level lower than anywhere else in this
+ * tree, and every value below says which of three things it is:
+ *
+ *   COMPUTED  derived from the mode or from the framebuffer -- arithmetic, and
+ *             the live vendor link agrees with the result;
+ *   CARRIED   copied off a working link and NOT understood;
+ *   INFERRED  the field name and meaning come from code -- mainline's DE33
+ *             model, or the out-of-tree A523/T527 v35x series -- and the live
+ *             A733 capture then confirms the value at that offset.
+ *
+ * A value with none of those tags does not appear in this file.
+ *
+ * The silicon this rests on: the 8 GiB board, vendor stack, live 1920x1200 four-lane
+ * DisplayPort link, read-only through /dev/mem
+ * (an earlier capture, plus a second reading on
+ * 2026-08-19). Its DE identifies itself at 0x05008014 = 0x03520100, i.e. DE
+ * version 0x352 -- the same three digits the vendor DT string
+ * "allwinner,display-engine-v352" and the out-of-tree series' "de352" carry.
+ *
+ * The delivery question, and it is measured.
+ * The v35x DE has a register command queue (RCQ): a DMA engine that walks
+ * 16-byte descriptors in DRAM and copies register blocks into the DE on each
+ * frame-start pulse from the bound TCON. The vendor's live link has one ARMED
+ * -- 118 heads at DRAM 0xffff3fc0, length 0x760 = 118 x 16 exactly -- and the
+ * A523/T527 series states that on this DE generation the datapath latches ONLY
+ * through it, with plain CPU stores landing in a shadow that never takes
+ * effect. If that held here, every datapath register in this file would be the
+ * right CONTENT delivered the wrong WAY, and this driver would be a DMA pool
+ * and a descriptor discipline instead.
+ *
+ * It does not hold. On the 8 GiB board on 2026-08-19, on a fresh vendor boot with the
+ * vendor's driver resident and its DE live, in this order:
+ *
+ *   0. The observer proven first -- monitor confirmed by eye to be showing the
+ *      console shell, not assumed, before any write was made;
+ *   1. devmem 0x05101018 32 0xFC400000  (+4 MiB) -- register holds, and THE
+ *      Screen goes black with the monitor still on and not in standby;
+ *   2. devmem 0x05101018 32 0xFC000000  -- THE SHELL COMES BACK.
+ *
+ * Three states on one register, the return leg included, with the observer's
+ * state established up front. A PLAIN MMIO WRITE TO THE VI LAYER'S SCANOUT
+ * Address reaches the datapath.
+ *
+ * Step 0 matters: a black screen from a monitor that is off is
+ * indistinguishable from a black screen the write caused, so the observer
+ * has to be established before a register is moved, and only a run with the
+ * observer established is evidence.
+ * That discipline is carried into
+ * this driver's acceptance sequence: `fill` writes a colour into the
+ * framebuffer and touches no register, so it proves the observer and the fetch
+ * path in one command -- and it is run before `layer` moves anything.
+ *
+ * Two limits survive the result, and they are why the commit path is still
+ * an indirection rather than inlined:
+ *   1. it proves the VI LAYER'S SCANOUT ADDRESS latches. It does not prove
+ *      every DE register does. If some other block's write appears not to take
+ *      effect, the RCQ is back on the table FOR THAT BLOCK.
+ *   2. the write was made while the VENDOR DRIVER held the device, with the
+ *      queue already armed and the datapath already loaded. A cold-programmed
+ *      DE, whose queue was never armed, is what THIS driver produces and is
+ *      untested. Its check: all eleven registers written, every one reading
+ *      back, screen black.
+ *
+ * So direct MMIO is the REAL implementation, not a placeholder -- and an RCQ
+ * backend still slots in behind the same three calls (begin, stage, arm)
+ * without moving one register value in this file, for whichever block might
+ * turn out to need it.
+ *
+ * The observable this driver owes is not "the registers read back". It is a
+ * framebuffer this driver painted, on the screen, changing when the pixels
+ * change -- and every register of the eleven-register datapath is reported next
+ * to it by debugfs `state`, together with the three blocks whose live state is
+ * a known trap.
+ *
+ * Copyright (c) 2026 DockSeed
+ */
+
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/reset.h>
+#include <linux/seq_file.h>
+
+#include <drm/drm_modes.h>
+
+#include "sun60i-display.h"
+
+/*
+ * The block map inside the DE0 aperture (0x05000000, 4 MiB,
+ * per the A733 user manual -- the aperture is the only DOC
+ * fact in this file). Every sub-block base below is INFERRED from the A523/T527
+ * v35x header's arithmetic and then confirmed by our capture landing on it:
+ * DE_CHN_OFFSET(phy) = 0x100000 + 0x20000*phy, CHN_OVL_OFFSET = 0x1000,
+ * CHN_SCALER_OFFSET = 0x4000, DE_DISP_OFFSET(0) = 0x280000.
+ *
+ * The capture confirms the channel arithmetic independently of the code that
+ * suggested it: seven scaler pages at an exact 0x20000 stride, at slots
+ * {0,1,2,6,7,8,9}, against the UM's feature list of seven blending channels and two
+ * display outputs. Three VI low, four UI from 6.
+ *
+ * Every offset in this file is relative to the DE aperture base, not to one of
+ * the four windows the device tree splits it into. Two reasons, and the second
+ * is the one that matters: the capture, the register map and the vendor's own
+ * addressing all count from 0x05000000, so an offset here can be compared with
+ * a log line by eye -- and the RCQ's descriptor carries exactly this number in
+ * its `reg_offset` word, so an RCQ backend behind the commit ops needs it and a
+ * raw __iomem pointer would have thrown it away. sun60i_de_map() is the one
+ * place the window split exists.
+ */
+#define DE_APERTURE			0x05000000
+#define DE_TOP				0x008000
+/*
+ * The three words that open the rest of the aperture. Without them the
+ * channel window at 0x0510xxxx and the blender at 0x0528xxxx do not accept a
+ * write at all -- they are not merely un-latched, they read back zero exactly
+ * like unmapped address space, while de_top at 0x05008xxx answers normally.
+ *
+ * Shown causally on silicon, the 8 GiB board, 2026-08-19, by raw devmem with
+ * no driver involved:
+ *
+ *   before:  devmem 0x05101000 32 0xFF008403 ; devmem 0x05101000 -> 0x00000000
+ *            (0x05200000, genuinely unmapped, reads 0x00000000 too)
+ *   after writing these three:
+ *            devmem 0x05101000 32 0xFF008403 ; devmem 0x05101000 -> 0xFF008403
+ *            devmem 0x05281000 32 0x00000101 ; devmem 0x05281000 -> 0x00000101
+ *
+ * These three words are non-zero on a working link, which is the evidence that
+ * somebody writes them; a cold block holds zero. A word that a live link holds
+ * and a cold block does not is a write, not a mystery, so all three are
+ * written here and tagged CARRIED. Anything that writes a channel or blender
+ * register without them having been written writes into a window that does
+ * not accept writes.
+ *
+ * VALUES: CARRIED, from the vendor capture.
+ * MEANING: INFERRED, and only as far as the bit shape allows -- 0x00010001 is
+ * the de-assert-reset-plus-gate pattern every sunxi BGR register in this SoC
+ * uses (bit 16 reset, bit 0 gate), and 0x00000011 sets two adjacent gate-shaped
+ * bits. Which sub-blocks each bit covers is NOT known and is not guessed at
+ * here; what IS known is that all three together open the datapath, measured.
+ */
+#define  DE_TOP_ENABLE0			0x0000
+#define   DE_TOP_ENABLE0_VALUE		0x00010001
+#define  DE_TOP_ENABLE1			0x0004
+#define   DE_TOP_ENABLE1_VALUE		0x00010001
+#define  DE_TOP_ENABLE2			0x0008
+#define   DE_TOP_ENABLE2_VALUE		0x00000011
+#define  DE_TOP_DE2TCON_MUX		0x0010
+#define  DE_TOP_VERSION			0x0014
+
+#define DE_MIXER0_TOP			0x008100
+#define  MIXER_GLOBAL_CTL		0x0000
+#define   MIXER_GLOBAL_CTL_RT_EN	BIT(0)
+#define  MIXER_GLOBAL_SIZE		0x0008
+#define  MIXER_GLOBAL_CLK		0x000c
+#define  MIXER_RCQ_CTL			0x0010
+#define  MIXER_RCQ_HEAD_LADDR		0x0014
+#define  MIXER_RCQ_HEAD_HADDR		0x0018
+#define  MIXER_RCQ_HEAD_LEN		0x001c
+
+#define DE_CHN_BASE			0x100000
+#define DE_CHN_STRIDE			0x020000
+#define  DE_CHN_CCSC			0x0800
+#define  DE_CHN_OVL			0x1000
+#define  DE_CHN_VSU			0x4000
+#define  DE_CHN_TFBD			0x5400
+
+#define DE_DISP0			0x280000
+#define  DE_DISP_BLD			0x1000
+
+/*
+ * The VI channel this driver uses, and it is the one the capture proves. Slot 0
+ * decodes as a VI channel under both candidate field maps, and only one of them
+ * explains every non-zero AND every zero word: plane-1/2 pitches clear at
+ * +0x10/+0x14 where a UI layer would carry the framebuffer address, the address
+ * at +0x18 where a UI layer has a fill colour, +0x88 clear where UI_OVL_SIZE
+ * would be, and the size at +0xe8, which is a VI-only register.
+ *
+ * The UI channels' layout is witnessed nowhere in that capture -- slots 6-9
+ * have no layer block programmed -- so this driver does not use one.
+ */
+#define DE_VI0_SLOT			0
+#define DE_BLD_PIPE			0
+
+/*
+ * Four blender register files at a 0x400 stride, all four programmed
+ * identically on the live link, on a board with exactly one display pipe up.
+ * The UM lists two display outputs, so "one per lit output" is not
+ * what these are; the prior art's de_top +0x24 UCH2CORE_MUX ("phys UI chn ->
+ * core/disp mux") suggests a core concept between channels and pipes, which
+ * would fit four. That is INFERRED and this driver does not rely on it: it
+ * writes all four identically, because that is the state a working link
+ * demonstrably holds.
+ */
+#define DE_BLD_STRIDE			0x0400
+#define DE_BLD_INSTANCES		4
+#define  BLD_PIPE_CTL			0x0000
+#define   BLD_PIPE_CTL_EN(p)		BIT(8 + (p))
+#define   BLD_PIPE_CTL_FC_EN(p)		BIT(p)
+#define  BLD_ATTR_FCOLOR(p)		(0x0004 + 0x10 * (p))
+#define  BLD_ATTR_INSIZE(p)		(0x0008 + 0x10 * (p))
+#define  BLD_ATTR_COORD(p)		(0x000c + 0x10 * (p))
+#define  BLD_ROUTE			0x0080
+#define  BLD_PREMULTIPLY		0x0084
+#define  BLD_BKCOLOR			0x0088
+#define  BLD_OUTSIZE			0x008c
+#define  BLD_MODE(p)			(0x0090 + 0x04 * (p))
+
+/* The overlay layer block, layers at a 0x30 stride. Layer 0 only here. */
+#define DE_OVL_LAYER			0
+#define  OVL_LAY_ATTCTL(l)		(0x30 * (l) + 0x0000)
+#define   OVL_ATTCTL_ALPHA		GENMASK(31, 24)
+#define   OVL_ATTCTL_RGB_MODE		BIT(15)
+#define   OVL_ATTCTL_FBFMT		GENMASK(12, 8)
+#define   OVL_ATTCTL_ALPHA_MODE		GENMASK(2, 1)
+#define   OVL_ATTCTL_EN			BIT(0)
+#define  OVL_LAY_MBSIZE(l)		(0x30 * (l) + 0x0004)
+#define  OVL_LAY_MBCOOR(l)		(0x30 * (l) + 0x0008)
+#define  OVL_LAY_PITCH(l, p)		(0x30 * (l) + 0x000c + 4 * (p))
+#define  OVL_LAY_TOP_LADDR(l, p)	(0x30 * (l) + 0x0018 + 4 * (p))
+#define  OVL_VI_OVL_SIZE		0x00e8
+#define OVL_VI_PLANES			3
+
+/*
+ * The three blocks whose live state is a trap rather than a value. Offsets are
+ * INFERRED from the prior art; the words are what our own capture reads.
+ */
+#define DE_CCSC_INSTANCES		8
+#define DE_CCSC_STRIDE			0x0100
+#define  CCSC_CTL			0x0000
+#define  CCSC_CTL_LIVE			0x00000001
+/*
+ * The coefficient matrix. Leaving it at its cold reset value of zero while the
+ * block is enabled gives a black screen with every other register correct (the 8 GiB board).
+ *
+ * The vendor's capture holds THREE non-zero words per CCSC instance besides the
+ * control word, at +0x10, +0x24 and +0x38, all reading 0x00020000. Those three
+ * offsets are not an arbitrary pattern: under a 3-row x 4-word row-major layout
+ * (three coefficients and one constant per row, rows on a 0x10 stride from
+ * +0x10) they are EXACTLY the diagonal --
+ *
+ *     c00 = 0x10 + 0*0x10 + 0*4 = +0x10   ✓ observed non-zero
+ *     c11 = 0x10 + 1*0x10 + 1*4 = +0x24   ✓ observed non-zero
+ *     c22 = 0x10 + 2*0x10 + 2*4 = +0x38   ✓ observed non-zero
+ *
+ * -- and the nine off-diagonal words the same layout predicts are all zero in
+ * that capture. Three hits out of three, with nine matching zeros, on a block
+ * whose name (channel colour-space conversion) says a 3x3 matrix is what it
+ * should contain. THAT IS A UNITY MATRIX, and 0x00020000 is its "1".
+ *
+ * Why that explains a black screen. With CCSC_CTL = 1 -- enabling the block --
+ * and the matrix at its COLD RESET
+ * value, which is zero. An enabled colour-space converter with an all-zero
+ * matrix outputs zero for every input pixel. Every other symptom follows: data
+ * still flows, so the TCON never underflows and never sets lostwarn; the layer,
+ * the blender, the sizes and the scanout address all read back correct; the
+ * framebuffer really does contain red; and no clock change can help, because
+ * the pixels are being multiplied by zero.
+ *
+ * Eight instances read 1 on the vendor's link, which could be read as 1 being
+ * the reset default. The vendor also writes 24 coefficient words, so it
+ * configures this block rather than leaving it alone -- which is evidence that
+ * 1 is the vendor's value, not necessarily the reset value. The A523/T527
+ * series writes ctl = 0 for a linear-RGB layer, and that reading is the more
+ * likely of the two.
+ *
+ * Both are reachable from debugfs `ccsc`, and the board settles it in one
+ * session instead of two: 1 (default) writes the vendor's configuration --
+ * enabled with a unity matrix -- and 0 disables the block the way the prior art
+ * does. HYPOTHESIS, not proof: nothing here has been on a board.
+ */
+#define  CCSC_COEFF_ROW0		0x0010
+#define  CCSC_COEFF_ROW_STRIDE		0x0010
+#define  CCSC_COEFF_UNITY		0x00020000
+#define  CCSC_MATRIX_ROWS		3
+#define  VSU_CTL			0x0000
+#define  VSU_ATTR_OUT_SIZE		0x0040
+#define  TFBD_STATE_WORD		0x0030
+
+/* Values. */
+#define DE_VERSION_A733			0x03520100
+#define DE_SIZE(w, h)			((((h) - 1) << 16) | ((w) - 1))
+#define DE2TCON_MUX_LIVE		0x0000fff5
+#define BLD_COLOR_BLACK			0xff000000
+#define BLD_MODE_SRCOVER		0x03010301
+#define OVL_FBFMT_XRGB8888		4
+#define OVL_ALPHA_MODE_LAYER		1
+#define DE_ALPHA_OPAQUE			0xff
+#define DE_BYTES_PER_PIXEL		4
+
+/*
+ * How long the DE is given to retire what it has in flight, between the layer
+ * being switched off and its clocks being gated with its reset asserted. Two
+ * frame times, computed from the mode rather than picked.
+ *
+ * This is not caution for its own sake. Asserting a bus master's reset in the
+ * middle of an AXI burst is the classic way to wedge an interconnect, and the
+ * memory the layer was reading goes straight back to CMA immediately
+ * afterwards -- so the failure mode without it is a DE still fetching from
+ * pages that now belong to somebody else. The A523/T527 series pays for this
+ * lesson with a patch of its own titled "channel quiesce before stopping".
+ */
+#define DE_QUIESCE_FRAMES		2
+
+struct sun60i_de;
+
+/**
+ * struct sun60i_de_commit - how datapath register values reach the hardware
+ * @name:  what `state` prints, so a result says which path produced it
+ * @begin: start a batch (a no-op for MMIO; an RCQ backend resets its staging)
+ * @stage: deliver one register
+ * @arm:   make the batch take effect, and report whether it did
+ *
+ * The split between "control plane" and "datapath" is not this driver's
+ * invention and it is not cosmetic. The de_top and mixer-top registers latch
+ * directly under every reading of this hardware -- the prior art says so, and
+ * our capture holds live, sensible values in them. The blender and the channel
+ * are the ones the RCQ exists for. So the control plane is written with plain
+ * writel() below and only the datapath goes through this struct: if a block
+ * ever turns out to need the queue, one backend appears here and not one
+ * register value in this file moves.
+ *
+ * MMIO is measured to reach the datapath for the VI layer's scanout address
+ * (see the RCQ block at the top of this file), so this is the real
+ * implementation. The indirection stays for the two limits recorded there: one
+ * register is not every register, and a COLD DE is not the warm one that was
+ * measured. debugfs `layer` is the probe that confirms it on our own path.
+ */
+struct sun60i_de_commit {
+	const char	*name;
+	void		(*begin)(struct sun60i_de *de);
+	void		(*stage)(struct sun60i_de *de, u32 off, u32 val);
+	int		(*arm)(struct sun60i_de *de);
+};
+
+/**
+ * struct sun60i_de_window - one of the four reg windows the DT splits the
+ *                           aperture into
+ * @base: where it is mapped
+ * @off:  its offset from the DE aperture base, derived from the resource
+ * @size: its length
+ */
+struct sun60i_de_window {
+	void __iomem	*base;
+	u32		off;
+	u32		size;
+};
+
+/*
+ * The four windows, in the order and under the names mainline's DE33 mixer
+ * binding uses -- "layers", "top", "display" -- plus "de-top" for the
+ * DE-global page that mainline's model has no window for and this SoC needs,
+ * because DE2TCON_MUX lives there. Each carries the offset it MUST land on, so
+ * a device tree that describes a different decomposition is refused at probe
+ * with the address in the message rather than reading zeros at runtime.
+ *
+ * The minimum sizes are computed from what this driver touches, not picked:
+ * de-top up to the version word, top up to the last RCQ register, layers a
+ * whole channel slot, display the blender's four instances.
+ */
+enum {
+	SUN60I_DE_WIN_DE_TOP,
+	SUN60I_DE_WIN_TOP,
+	SUN60I_DE_WIN_LAYERS,
+	SUN60I_DE_WIN_DISPLAY,
+	SUN60I_DE_WINDOWS,
+};
+
+struct sun60i_de {
+	struct device			*dev;
+	struct sun60i_de_window		win[SUN60I_DE_WINDOWS];
+	struct clk			*bus_clk;
+	struct clk			*mod_clk;
+	struct reset_control		*reset;
+	struct dentry			*dbg;
+	struct mutex			lock;		/* serialises enable/disable */
+	const struct sun60i_de_commit	*commit;
+	bool				enabled;
+	bool				layer_on;
+	bool				ccsc_on;
+	struct drm_display_mode		mode;
+
+	dma_addr_t			fb_dma;
+	u32				fb_pitch;
+	u32				background;
+
+	/*
+	 * What the three trap blocks and the version register read on a COLD DE,
+	 * before this driver wrote anything. No DE reset-state dump exists in
+	 * this tree, so these four words are the first ones taken -- and they
+	 * are what separates "reset default" from "the vendor wrote this" for
+	 * the blocks that decide whether the picture is correct. Reported by
+	 * `state`.
+	 */
+	u32				cold_version;
+	u32				cold_ccsc;
+	u32				cold_vsu;
+	u32				cold_tfbd;
+};
+
+static u32 sun60i_de_chn(unsigned int slot)
+{
+	return DE_CHN_BASE + slot * DE_CHN_STRIDE;
+}
+
+static u32 sun60i_de_bld(unsigned int instance)
+{
+	return DE_DISP0 + DE_DISP_BLD + instance * DE_BLD_STRIDE;
+}
+
+/*
+ * The one place the device tree's window split exists. Every other offset in
+ * this file counts from the DE aperture base, which is what the capture, the
+ * register map and the RCQ descriptor all use.
+ *
+ * A NULL return can only mean a device tree whose windows do not cover an
+ * offset this driver was built to reach, and probe already refuses those -- so
+ * it is a should-not-happen that is still worth naming rather than faulting on.
+ */
+static void __iomem *sun60i_de_map(struct sun60i_de *de, u32 off)
+{
+	unsigned int i;
+
+	for (i = 0; i < SUN60I_DE_WINDOWS; i++) {
+		const struct sun60i_de_window *w = &de->win[i];
+
+		if (off >= w->off && off - w->off < w->size)
+			return w->base + (off - w->off);
+	}
+
+	dev_err_once(de->dev, "DE offset 0x%06x is in no mapped window\n", off);
+
+	return NULL;
+}
+
+/* The control plane. Plain MMIO, never through the commit path -- see above. */
+static void sun60i_de_write(struct sun60i_de *de, u32 off, u32 val)
+{
+	void __iomem *reg = sun60i_de_map(de, off);
+
+	if (reg)
+		writel(val, reg);
+}
+
+static u32 sun60i_de_read(struct sun60i_de *de, u32 off)
+{
+	void __iomem *reg = sun60i_de_map(de, off);
+
+	return reg ? readl(reg) : 0;
+}
+
+static void sun60i_de_mmio_begin(struct sun60i_de *de)
+{
+}
+
+static void sun60i_de_mmio_stage(struct sun60i_de *de, u32 off, u32 val)
+{
+	sun60i_de_write(de, off, val);
+}
+
+static int sun60i_de_mmio_arm(struct sun60i_de *de)
+{
+	/*
+	 * A read from the aperture, to order every store above against the
+	 * TCON's next frame-start. There is nothing to trigger: the writes are
+	 * the commit.
+	 */
+	sun60i_de_read(de, DE_TOP + DE_TOP_VERSION);
+
+	return 0;
+}
+
+static const struct sun60i_de_commit sun60i_de_commit_mmio = {
+	.name	= "direct MMIO",
+	.begin	= sun60i_de_mmio_begin,
+	.stage	= sun60i_de_mmio_stage,
+	.arm	= sun60i_de_mmio_arm,
+};
+
+static void sun60i_de_stage(struct sun60i_de *de, u32 off, u32 val)
+{
+	de->commit->stage(de, off, val);
+}
+
+/*
+ * Reset de-assert first, then the gate -- the order UM 4.1.4.4 prescribes:
+ * release the reset, then enable the gating clock.
+ * The eDP block measured what skipping it costs on this SoC: with the gate set
+ * and the reset still asserted the whole window reads 0x00000000, which is
+ * indistinguishable from a dead block
+ *.
+ *
+ * The module clock rate is not set here, and that is deliberate. DE0_CLK's
+ * source mux offers DEPLL3X/DEPLL4X first, and UM 4.1.4.3
+ * (A733 user manual) advises against changing DEPLL3X, because it also
+ * feeds NSI, the SoC interconnect, at 700 MHz. A
+ * clk_set_rate() here that propagated to that parent would move the fabric
+ * clock under every other block on the chip to suit a display mode.
+ *
+ * This driver is parent-agnostic, because the two candidates are both real.
+ * Measured on the 8 GiB board on 2026-08-19 with the vendor's display engine
+ * genuinely live and a picture on the monitor:
+ *
+ *   PLL_DE_CTRL 0x020022E0 = 0xFD124A00   bit31 SET -- PLL_DE is ON
+ *   DE0_CLK     0x02002A00 = 0x80000000   gate on, mux [26:24] = 000 = DEPLL3X,
+ *                                         FACTOR_M [4:0] = 0 -> M = 1
+ *   DEPLL gates 0x02003928 = 0x00030000   bits 17:16, the DE PLL tap gates
+ *
+ * So the vendor runs the DE from DEPLL3X -- the reset default of that mux --
+ * and not from a PERI0 tap. Decoding 0x??124A00 with the same field map the UM
+ * cross-check below uses: N field 0x4A -> N = 75, M1 = 1, P1 = 3, so over the
+ * 24 MHz PLL_REF the VCO is 1800 MHz and DEPLL3X is 600 MHz. That number is
+ * worth noticing twice: it is also exactly the mod_rate mainline's DE33 config
+ * carries for the H616 (sun8i_mixer.c, sun50i_h616_mixer0_cfg), reached from
+ * the other direction.
+ *
+ * The field map is cross-checked against the UM's own statement rather than
+ * assumed: PLL_DE_CTRL_REG's RESET value 0x40125600 decodes under it as N = 87,
+ * M1 = 1, P1 = 3, i.e. DEPLL3X = 24 x 87 / 3 = 696 MHz -- "696MHz by default",
+ * the UM's words. Same map, two values, both landing on their own documented
+ * or measured number.
+ *
+ * A reading taken on 2026-07-18, on a board whose DE was down, shows PLL_DE off,
+ * as does the PLL of any block that is down. On a live DE the same register
+ * reads enabled; leaving the mux alone does not give a stopped clock.
+ * A reading of an idle block is not evidence about
+ * a running one.
+ *
+ * So the rate is the device tree's decision -- `arm64-dts-a733-display-engine-node-and-de-to-tcon-edge` pins PERI0_480M, the vendor
+ * uses DEPLL3X at 600 MHz, and both clear this mode's floor -- and this driver
+ * assumes NEITHER. It reads the rate back, refuses below the rate the mode
+ * fetches at, and logs what it got, so a board session records which parent was
+ * actually in effect instead of inheriting an assumption.
+ */
+static int sun60i_de_clocks_on(struct sun60i_de *de)
+{
+	unsigned long floor = de->mode.clock * 1000L;
+	unsigned long rate;
+	int ret;
+
+	ret = reset_control_deassert(de->reset);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(de->bus_clk);
+	if (ret)
+		goto err_reset;
+
+	ret = clk_prepare_enable(de->mod_clk);
+	if (ret)
+		goto err_bus;
+
+	rate = clk_get_rate(de->mod_clk);
+	if (rate < floor) {
+		dev_err(de->dev,
+			"module clock is %lu Hz, below the %lu Hz this mode fetches at\n",
+			rate, floor);
+		ret = -EINVAL;
+		goto err_mod;
+	}
+
+	dev_info(de->dev, "module clock %lu Hz (floor %lu Hz)\n", rate, floor);
+
+	return 0;
+
+err_mod:
+	clk_disable_unprepare(de->mod_clk);
+err_bus:
+	clk_disable_unprepare(de->bus_clk);
+err_reset:
+	reset_control_assert(de->reset);
+
+	return ret;
+}
+
+static void sun60i_de_clocks_off(struct sun60i_de *de)
+{
+	clk_disable_unprepare(de->mod_clk);
+	clk_disable_unprepare(de->bus_clk);
+	reset_control_assert(de->reset);
+}
+
+/*
+ * The one cheap liveness check this block offers, and the only register in it
+ * whose expected value is known independently of a capture: three sources agree
+ * that this DE is version 0x352 -- the version word itself, the vendor DT
+ * string "allwinner,display-engine-v352", and the out-of-tree series' own name
+ * for the same IP.
+ *
+ * Four different faults read alike here, and the driver can distinguish none
+ * of them -- so it names all four with their addresses instead of guessing. A
+ * gated block on this SoC answers 0x00000000 without faulting, so a zero is
+ * indistinguishable from a wrong base, from a reset still asserted, and from a
+ * source clock that is not running.
+ *
+ * Nor can clk_get_rate() settle it: a sunxi PLL's recalc computes from its
+ * register fields whether or not PLL_EN is set, so a stopped PLL still reports
+ * a plausible rate and the floor check in sun60i_de_clocks_on() passes. The
+ * rate is therefore printed as evidence, never as a verdict.
+ *
+ * The four addresses below are what a board session needs. A dead raster on
+ * 2026-08-19 (TCON_TV1 with a device tree that withheld a reg window and a
+ * clock) was diagnosed in ten minutes because the driver announced the gap
+ * with the addresses. Two of the four matter only when the parent is a DE PLL
+ * tap, which is what the vendor's own live DE uses -- so they are named either
+ * way rather than omitted on the assumption that the device tree pinned a
+ * PERI0 parent.
+ */
+static int sun60i_de_check_alive(struct sun60i_de *de)
+{
+	de->cold_version = sun60i_de_read(de, DE_TOP + DE_TOP_VERSION);
+	if (de->cold_version == DE_VERSION_A733)
+		return 0;
+
+	dev_err(de->dev,
+		"DE version reads 0x%08x, expected 0x%08x -- the block is not answering\n",
+		de->cold_version, DE_VERSION_A733);
+	dev_err(de->dev,
+		"module clock reports %lu Hz, which does NOT prove it is running -- a stopped PLL still reports its programmed rate\n",
+		clk_get_rate(de->mod_clk));
+	dev_err(de->dev,
+		"read these four: DE0_BGR 0x02002A04 (expect 0x00010001), DE0_CLK 0x02002A00 (bit31 gate, [26:24] mux, [4:0] M)\n");
+	dev_err(de->dev,
+		"and, if that mux selects a DE PLL tap: PLL_DE_CTRL 0x020022E0 (bit31 PLL_EN) and the DE tap gates 0x02003928 (bits 17:16)\n");
+	dev_err(de->dev,
+		"a live vendor DE carries 0x00010001 / 0x80000000 / 0xFD124A00 / 0x00030000; see also /sys/kernel/debug/clk/de0/clk_parent\n");
+
+	return -ENODEV;
+}
+
+/*
+ * The layer's attribute word, in ONE place: sun60i_de_layer() writes it and
+ * sun60i_de_verify() reads it back to prove the window took it, so spelling it
+ * twice would let a fix to one drift silently past the other.
+ *
+ * 0xff008403 on a live vendor link, and it decodes completely with no residue:
+ * global alpha 0xff, RGB_MODE set, FBFMT 4 = XRGB8888, alpha mode 01 = layer,
+ * EN. COMPUTED -- every field comes from the format and full opacity.
+ */
+static u32 sun60i_de_attctl(void)
+{
+	return FIELD_PREP(OVL_ATTCTL_ALPHA, DE_ALPHA_OPAQUE) |
+	       OVL_ATTCTL_RGB_MODE |
+	       FIELD_PREP(OVL_ATTCTL_FBFMT, OVL_FBFMT_XRGB8888) |
+	       FIELD_PREP(OVL_ATTCTL_ALPHA_MODE, OVL_ALPHA_MODE_LAYER) |
+	       OVL_ATTCTL_EN;
+}
+
+/*
+ * Open the datapath aperture.
+ *
+ * The invariant, a rule rather than a step in a sequence:
+ *
+ *     Re-apply after every reset_control_deassert(), BEFORE ANY DATAPATH WRITE.
+ *
+ * Two of these three are the DE's own INNER reset+gate registers -- 0x00010001
+ * is this SoC's de-assert-reset-plus-gate pattern, bit 16 reset and bit 0 gate.
+ * RST_BUS_DE0, which is DE0_BGR bit 16 and this node's own reset, clears them
+ * along with everything else inside the block. Measured: after an
+ * `enable 0` / `enable 1` cycle they read 0x00000000 again, because
+ * sun60i_de_clocks_off() asserts exactly that reset.
+ *
+ * So this is NOT a probe-time one-shot and must never be moved to probe, or to
+ * any other place that runs once. Anything that touches this driver's reset
+ * owns re-running this function afterwards; anything that writes a channel or
+ * blender register without it having run writes into a window that does not
+ * accept writes at all.
+ */
+static void sun60i_de_top_open(struct sun60i_de *de)
+{
+	sun60i_de_write(de, DE_TOP + DE_TOP_ENABLE0, DE_TOP_ENABLE0_VALUE);
+	sun60i_de_write(de, DE_TOP + DE_TOP_ENABLE1, DE_TOP_ENABLE1_VALUE);
+	sun60i_de_write(de, DE_TOP + DE_TOP_ENABLE2, DE_TOP_ENABLE2_VALUE);
+}
+
+/*
+ * Read back two registers this driver has just written, one per datapath
+ * window, and refuse rather than announce success it cannot support.
+ *
+ * A driver may say it is scanning only after something it wrote reads back.
+ * Printing "scanning 1920x1200 XRGB8888 from ..." next to a `state` dump that
+ * is a column of zeros pairs a statement of intent with the evidence
+ * contradicting it, which misleads a board session; this check exists to
+ * catch exactly that.
+ *
+ * The two outcomes are different faults and are reported as such:
+ *   zero          -- the window is not open. The three de_top enables above are
+ *                    the first thing to look at, and their addresses are in the
+ *                    message.
+ *   something else -- the window is open but did not take the value, which is
+ *                    the shadow the RCQ exists for. Nothing about the register
+ *                    CONTENT is wrong in that case; the delivery is.
+ */
+static int sun60i_de_verify(struct sun60i_de *de)
+{
+	u32 ovl = sun60i_de_chn(DE_VI0_SLOT) + DE_CHN_OVL + OVL_LAY_ATTCTL(DE_OVL_LAYER);
+	u32 bld = sun60i_de_bld(0) + BLD_PIPE_CTL;
+	u32 want_bld = BLD_PIPE_CTL_EN(DE_BLD_PIPE) | BLD_PIPE_CTL_FC_EN(DE_BLD_PIPE);
+	u32 want_ovl = sun60i_de_attctl();
+	unsigned int i;
+	const struct {
+		const char	*what;
+		u32		off;
+		u32		want;
+	} check[] = {
+		{ "channel VI0 LAY0_ATTCTL", ovl, want_ovl },
+		{ "blender 0 PIPE_CTL",	     bld, want_bld },
+	};
+
+	for (i = 0; i < ARRAY_SIZE(check); i++) {
+		u32 got = sun60i_de_read(de, check[i].off);
+
+		if (got == check[i].want)
+			continue;
+
+		if (!got) {
+			dev_err(de->dev,
+				"%s at 0x%08x reads 0x00000000 -- this window is NOT OPEN\n",
+				check[i].what, DE_APERTURE + check[i].off);
+			dev_err(de->dev,
+				"the three de_top enables are what open it: 0x05008000, 0x05008004, 0x05008008 (expect 0x00010001, 0x00010001, 0x00000011)\n");
+		} else {
+			dev_err(de->dev,
+				"%s at 0x%08x: wrote 0x%08x, reads 0x%08x -- the window is open but did not take the write\n",
+				check[i].what, DE_APERTURE + check[i].off,
+				check[i].want, got);
+			dev_err(de->dev,
+				"that is the shadow the RCQ exists for; the register CONTENT is not what is wrong\n");
+		}
+
+		return -EIO;
+	}
+
+	return 0;
+}
+
+/*
+ * Disarm the register command queue before anything else touches the datapath.
+ *
+ * This driver commits by CPU store. An RCQ left armed -- by a bootloader, by a
+ * previous kernel, by this driver's own future self -- would walk a descriptor
+ * array in DRAM on every frame-start pulse from the TCON and overwrite the
+ * datapath with whatever that memory now holds, silently, once per frame. The
+ * length goes to zero FIRST, so there is no window in which a walk begins from
+ * a valid length and a half-written pointer.
+ *
+ * On a cold DE all four of these read zero already, so on the intended path
+ * this is four no-op stores. It is here for the path that is not intended.
+ */
+static void sun60i_de_disarm_rcq(struct sun60i_de *de)
+{
+	sun60i_de_write(de, DE_MIXER0_TOP + MIXER_RCQ_HEAD_LEN, 0);
+	sun60i_de_write(de, DE_MIXER0_TOP + MIXER_RCQ_HEAD_LADDR, 0);
+	sun60i_de_write(de, DE_MIXER0_TOP + MIXER_RCQ_HEAD_HADDR, 0);
+	sun60i_de_write(de, DE_MIXER0_TOP + MIXER_RCQ_CTL, 0);
+}
+
+/*
+ * de_top and the mixer-0 top block -- the control plane, four registers.
+ *
+ *   DE2TCON_MUX  0x0000fff5   CARRIED. One nibble per display pipe; disp0 = 5
+ *                             and the other three = 0xf on a board with exactly
+ *                             one pipe up, which is what "route disp0, disable
+ *                             the rest" looks like. WHAT 5 MEANS IS NOT KNOWN:
+ *                             this SoC has four TCONs, so a plain index would
+ *                             make TCON_TV1 = 3. Two readings survive -- a
+ *                             global index in a numbering space wider than this
+ *                             part populates, or an enable bit plus an index
+ *                             ([3:1] = 2 with bit 0 set). This driver writes
+ *                             the word a working link carries and does not
+ *                             pretend to know why it is that word.
+ *   GLOBAL_CTL   BIT(0)       INFERRED -- mainline's SUN8I_MIXER_GLOBAL_CTL
+ *                             RT_EN, the single bit sun8i_mixer_init() writes.
+ *                             Silicon carries exactly 0x00000001.
+ *   GLOBAL_SIZE  from mode    COMPUTED -- ((h-1) << 16) | (w-1), mainline's
+ *                             SUN8I_MIXER_SIZE(). 1920x1200 gives 0x04af077f,
+ *                             which is what silicon carries.
+ *   GLOBAL_CLK   1            INFERRED -- SUN50I_MIXER_GLOBAL_CLK, a DE33-only
+ *                             register mainline writes 1 to. Silicon agrees.
+ *
+ * The negative control that makes the mixer-top identification an
+ * identification rather than a coincidence belongs next to the base: mainline's
+ * DE33 top block is 0x40 bytes, so mixer 1's would begin at 0x05008140 -- and
+ * on a board with one pipe up that entire 0x40 reads zero. The layout predicts
+ * a second block at a specific address and the silicon has it empty for the
+ * right reason.
+ */
+static void sun60i_de_top_setup(struct sun60i_de *de)
+{
+	const struct drm_display_mode *mode = &de->mode;
+	u32 size = DE_SIZE(mode->hdisplay, mode->vdisplay);
+
+	sun60i_de_write(de, DE_TOP + DE_TOP_DE2TCON_MUX, DE2TCON_MUX_LIVE);
+	sun60i_de_write(de, DE_MIXER0_TOP + MIXER_GLOBAL_SIZE, size);
+	sun60i_de_write(de, DE_MIXER0_TOP + MIXER_GLOBAL_CLK, 1);
+	sun60i_de_write(de, DE_MIXER0_TOP + MIXER_GLOBAL_CTL,
+			MIXER_GLOBAL_CTL_RT_EN);
+}
+
+/*
+ * One CCSC instance: the control word, and -- when it is enabled -- the unity
+ * matrix that the control word without it makes lethal. Writing the diagonal
+ * before the enable is deliberate: it means the block is never enabled with a
+ * zero matrix, not even for the width of one frame.
+ *
+ * When disabled, the matrix is written as zeros anyway rather than left alone.
+ * A bypassed block's coefficients do not matter, and a driver that leaves half
+ * a configuration behind when it turns something off is how the next enable
+ * inherits a state nobody chose.
+ */
+static void sun60i_de_ccsc_one(struct sun60i_de *de, u32 base)
+{
+	u32 coeff = de->ccsc_on ? CCSC_COEFF_UNITY : 0;
+	unsigned int row;
+
+	for (row = 0; row < CCSC_MATRIX_ROWS; row++)
+		sun60i_de_stage(de,
+				base + CCSC_COEFF_ROW0 +
+				row * CCSC_COEFF_ROW_STRIDE + row * sizeof(u32),
+				coeff);
+
+	sun60i_de_stage(de, base + CCSC_CTL,
+			de->ccsc_on ? CCSC_CTL_LIVE : 0);
+}
+
+/*
+ * The two per-channel blocks that are non-zero on a live link and sit in the
+ * fetch path, plus the scaler. None of the three can be "left at reset",
+ * because on a cold DE nobody in this tree has ever read what their reset is --
+ * which is why the values are captured into cold_* here before anything is
+ * written, and printed by `state`.
+ *
+ * CCSC (channel colour-space conversion), slot + 0x800, eight instances at a
+ * 0x100 stride. Live: every one of the eight reads 0x00000001, on a board where
+ * exactly ONE layer of ONE channel was fetching -- which is the argument that 1
+ * is this block's reset default rather than something the vendor configured.
+ * The A523 series writes 0 here for a linear-RGB layer; that is for a
+ * different part, and silicon on this part says 1 while producing correct
+ * colour, so this driver writes 1.
+ *   Fails if: wrong colour -- channels swapped, or washed out -- which
+ *   would mean the block is on the path with non-unity coefficients and the
+ *   answer is 0. One line, and cold_ccsc in `state` says which way to go.
+ *
+ * VSU (the per-channel scaler), slot + 0x4000. Live: VSU_CTL and
+ * ATTR_OUT_SIZE both read zero and there is a picture, so a 1:1 unscaled path
+ * costs nothing on a warm DE. The A523 series reports the v35x channel datapath
+ * as ALWAYS overlay -> VSU -> blender with no bypass, and that after
+ * power-gating the DE the filter-coefficient SRAM powers up holding RANDOM
+ * data; its stated reason the vendor never hits this is that Android never
+ * power-gates the DE. Our capture cannot settle it -- the vendor stack never
+ * power-gated it either -- and what it does show is suggestive: slot 0's
+ * coefficient area holds varying unstructured values and slot 6 holds one value
+ * repeated 32 times, and neither looks like a FIR set.
+ *   This driver writes VSU_CTL = 0, the value a working link carries, and does
+ *   NOT invent a unity coefficient table: the VSU register map is prior art
+ *   only, unconfirmed at this offset on this part, and writing dozens of
+ *   unverified words into a block in the fetch path is the guess this tree does
+ *   not make.
+ *   Fails if: a picture that is present but visibly corrupt -- the series
+ *   describes it collapsing to a repeated column. That is the reading which
+ *   turns a six-register channel setup into one that also loads coefficients.
+ *
+ * TFBD (the tiled-framebuffer decoder), slot + 0x5400. Live: 0x00002103 in four
+ * instances at a 0x100 stride -- and it reads that on slot 6, a channel that
+ * was fetching NOTHING, which is the argument that it is an idle value and not
+ * a configuration. This driver does not write it, and the reason is
+ * provenance: the A523 series warns that a stale TFBD "mangles the fetch" and
+ * clears it, but its register map is unconfirmed here, our framebuffer is
+ * linear, and zeroing an unknown block on the strength of another part's
+ * register map is not done. It is READ and reported
+ * instead, so the first run says what a cold TFBD holds.
+ *   Fails if: a fetch that produces tiled or garbage output while every
+ *   register above reads back correctly.
+ */
+static void sun60i_de_channel_quiesce(struct sun60i_de *de)
+{
+	u32 chn = sun60i_de_chn(DE_VI0_SLOT);
+	unsigned int i;
+
+	de->cold_ccsc = sun60i_de_read(de, chn + DE_CHN_CCSC + CCSC_CTL);
+	de->cold_vsu = sun60i_de_read(de, chn + DE_CHN_VSU + VSU_CTL);
+	de->cold_tfbd = sun60i_de_read(de, chn + DE_CHN_TFBD + TFBD_STATE_WORD);
+
+	for (i = 0; i < DE_CCSC_INSTANCES; i++)
+		sun60i_de_ccsc_one(de, chn + DE_CHN_CCSC + i * DE_CCSC_STRIDE);
+
+	sun60i_de_stage(de, chn + DE_CHN_VSU + VSU_CTL, 0);
+	sun60i_de_stage(de, chn + DE_CHN_VSU + VSU_ATTR_OUT_SIZE, 0);
+}
+
+/*
+ * The blender, nine registers per instance times four instances.
+ *
+ *   PIPE_CTL     0x101       COMPUTED -- PIPE_CTL_EN(0) or-ed with FC_EN(0),
+ *                            mainline's two macros and the prior art's
+ *                            SUN55I_BLD_PIPE_EN(0) producing the same word from
+ *                            two directions. Silicon carries 0x00000101.
+ *   FCOLOR(0)                COMPUTED -- AARRGGBB. Opaque black by default,
+ *                            which is mainline's BLEND_COLOR_BLACK and what
+ *                            silicon carries.
+ *   INSIZE(0), COORD(0)      COMPUTED from the mode -- full screen at the
+ *                            origin.
+ *   ROUTE        0           COMPUTED -- four bits per pipe, pipe 0 <- channel
+ *                            0. The zero is the right answer here, not merely
+ *                            an untouched register.
+ *   OUTSIZE                  COMPUTED from the mode.
+ *   BLEND_MODE(0) 0x03010301 CARRIED: mainline's own comment
+ *                            on this constant is "some still unknown magic
+ *                            numbers", and the prior art calls it SRCOVER
+ *                            without explaining it either. The A733 carries the
+ *                            same word verbatim.
+ *
+ * Two registers are written that the live link leaves at zero, and both are
+ * departures this driver owns rather than discovers later. PREMULTIPLY = 0 is
+ * the value either way, and is written so that a bootloader cannot leave it set
+ * for an XRGB8888 layer that has no alpha to premultiply. BKCOLOR = opaque
+ * black is what mainline initialises and the vendor does not; it is invisible
+ * behind a full-screen opaque layer, which is exactly why the vendor can do
+ * without writing it, and it is the first thing that shows the moment a plane is
+ * smaller than the screen. The out-of-tree series later added a patch titled
+ * "black blender background" for that reason.
+ *
+ * BLD_OUTCTL, which mainline places at +0xfc and uses for the interlace bit, is
+ * NOT written -- and that is a disagreement rather than an oversight. The A523
+ * block map puts +0xa0..+0xff in the colour-key region, not in the control
+ * region, so the two candidate names for +0xfc conflict and our capture cannot
+ * choose between them: it reads zero, which is correct under both. This mode is
+ * progressive, so nothing needs it.
+ */
+static void sun60i_de_blender(struct sun60i_de *de)
+{
+	const struct drm_display_mode *mode = &de->mode;
+	u32 size = DE_SIZE(mode->hdisplay, mode->vdisplay);
+	unsigned int i;
+
+	for (i = 0; i < DE_BLD_INSTANCES; i++) {
+		u32 bld = sun60i_de_bld(i);
+
+		sun60i_de_stage(de, bld + BLD_ATTR_FCOLOR(DE_BLD_PIPE),
+				de->background);
+		sun60i_de_stage(de, bld + BLD_ATTR_INSIZE(DE_BLD_PIPE), size);
+		sun60i_de_stage(de, bld + BLD_ATTR_COORD(DE_BLD_PIPE), 0);
+		sun60i_de_stage(de, bld + BLD_ROUTE, 0);
+		sun60i_de_stage(de, bld + BLD_PREMULTIPLY, 0);
+		sun60i_de_stage(de, bld + BLD_BKCOLOR, BLD_COLOR_BLACK);
+		sun60i_de_stage(de, bld + BLD_OUTSIZE, size);
+		sun60i_de_stage(de, bld + BLD_MODE(DE_BLD_PIPE),
+				BLD_MODE_SRCOVER);
+		sun60i_de_stage(de, bld + BLD_PIPE_CTL,
+				BLD_PIPE_CTL_EN(DE_BLD_PIPE) |
+				BLD_PIPE_CTL_FC_EN(DE_BLD_PIPE));
+	}
+}
+
+/*
+ * The layer -- six registers that matter, every one COMPUTED from the mode and
+ * the framebuffer, and the live link's ATTCTL word decodes completely under
+ * them with no residue: 0xff008403 is global alpha 0xff, RGB_MODE set, FBFMT
+ * 4 = XRGB8888, alpha mode 01 = layer, EN.
+ *
+ * The plane-1 and plane-2 pitches and addresses are written as zero rather than
+ * left alone. They are unused for a packed RGB format and the live link has
+ * them clear -- but they are also the four words that tell a VI channel apart
+ * from a UI one, so writing them is what makes "this is a single-plane RGB
+ * layer" a statement the hardware was given rather than one it was assumed to
+ * have kept.
+ *
+ * The layer has high-address bytes, and this driver leaves them at 0.
+ * VI +0xd0..+0xe4 (TOP/BOT_HADDR) carry one byte per layer; a 1 in layer 1's
+ * byte made the DE fetch 4 GiB above its address (sink CRC, 8 GB board,
+ * 2026-09-22). The search that found none read 0x05101080, layer 2's plane-2
+ * address. So probe()'s 32-bit DMA mask is this driver's choice, not the
+ * hardware's: a buffer above 4 GiB is refused, never truncated.
+ *
+ * What that address means is not the same on the vendor's system and on ours.
+ * The vendor runs this path through an IOMMU.
+ *
+ * Measured on the 8 GiB board on 2026-08-19 with the DE live: 5000000.de sits in
+ * iommu_group 0 with the VE and the deinterlacer, sunxi-iommu-v2 at 3900000
+ * comes up with "Default domain type: Translated", and the vendor DT gives
+ * de@5000000 `iommus = <&iommu 8 1>` -- master id 8. The proof that it is a
+ * translation and not an identity map is direct: 0x05101018 reads 0xFC000000
+ * with a picture on the screen, and a PHYSICAL read at 0xFC000000 returns
+ * 0x005E0001 / 0xFE40FB00 / 0x005E0001 at +0/+4/+0x1000 -- structured data, not
+ * pixels, at an address that is inside system RAM (0x40000000-0x23FFFFFFF).
+ *
+ * Two consequences, and the second is this driver's risk, not its bug:
+ *
+ *  1. Scanout addresses in a vendor capture are not comparable to ours. Every
+ *     other register in this file can be diffed against that capture; this one
+ *     cannot, because 0xFC000000 there is an IOVA and whatever this driver
+ *     programs here is not. Do not "fix" a mismatch in this register against
+ *     the capture.
+ *  2. This tree has no IOMMU support: no patch mentions one, no DT node
+ *     exists, no `iommus` property is anywhere in it. The DE's address
+ *     therefore reaches the bus untranslated, which is correct if the IOMMU
+ *     is in bypass or off for this master; that held on the 2026-08-19 run
+ *     but is not verified in general. If it comes up translating with no
+ *     mapping for master 8, the DE fetches from nowhere and the symptom is a
+ *     black screen with every register reading back correctly. So the driver
+ *     does not assume it: it asks device_iommu_mapped() and reports which of
+ *     the two it got, at enable
+ *     and in `state`.
+ *
+ * WHY THE DMA API RATHER THAN A HAND-ROLLED ADDRESS, and it is this exact case:
+ * dma_alloc_coherent() hands back a dma_addr_t, which is a physical address
+ * today and becomes an IOVA automatically on the day an IOMMU node and an
+ * `iommus` property exist -- with no change in this file. A hand-computed
+ * physical address would be silently wrong on that day.
+ *
+ * The `iommus` property is not added speculatively. A phandle to an
+ * IOMMU node with no driver bound leaves this device deferring forever, so it
+ * arrives together with a verified IOMMU driver. Mainline 6.18.36 does
+ * ship drivers/iommu/sun50i-iommu.c; whether it matches this SoC's
+ * sunxi-iommu-v2 is unverified and this file assumes neither way.
+ */
+static void sun60i_de_layer(struct sun60i_de *de)
+{
+	const struct drm_display_mode *mode = &de->mode;
+	u32 ovl = sun60i_de_chn(DE_VI0_SLOT) + DE_CHN_OVL;
+	u32 size = DE_SIZE(mode->hdisplay, mode->vdisplay);
+	unsigned int plane;
+
+	for (plane = 1; plane < OVL_VI_PLANES; plane++) {
+		sun60i_de_stage(de, ovl + OVL_LAY_PITCH(DE_OVL_LAYER, plane), 0);
+		sun60i_de_stage(de, ovl + OVL_LAY_TOP_LADDR(DE_OVL_LAYER, plane), 0);
+	}
+
+	sun60i_de_stage(de, ovl + OVL_LAY_MBSIZE(DE_OVL_LAYER), size);
+	sun60i_de_stage(de, ovl + OVL_LAY_MBCOOR(DE_OVL_LAYER), 0);
+	sun60i_de_stage(de, ovl + OVL_LAY_PITCH(DE_OVL_LAYER, 0), de->fb_pitch);
+	sun60i_de_stage(de, ovl + OVL_LAY_TOP_LADDR(DE_OVL_LAYER, 0),
+			lower_32_bits(de->fb_dma));
+	sun60i_de_stage(de, ovl + OVL_VI_OVL_SIZE, size);
+
+	sun60i_de_stage(de, ovl + OVL_LAY_ATTCTL(DE_OVL_LAYER),
+			sun60i_de_attctl());
+}
+
+static void sun60i_de_layer_disable(struct sun60i_de *de)
+{
+	u32 ovl = sun60i_de_chn(DE_VI0_SLOT) + DE_CHN_OVL;
+
+	de->commit->begin(de);
+	sun60i_de_stage(de, ovl + OVL_LAY_ATTCTL(DE_OVL_LAYER), 0);
+	de->commit->arm(de);
+	de->layer_on = false;
+}
+
+/*
+ * Stage the layer on or off through the commit path, and nothing else.
+ *
+ * Reachable rather than internal because it is this driver's confirmation of
+ * the one thing the vendor-side measurement could not cover: that a CPU store
+ * reaches the datapath of a COLD DE, one this driver programmed itself, whose
+ * RCQ was never armed. With a picture already on the screen and the observer
+ * already proven by `fill` -- which writes no register at all -- a single
+ * datapath register is toggled and the screen either follows or does not.
+ * NOT following, while `state` shows LAY0_ATTCTL reading back exactly as
+ * written, is the shadow the A523/T527 series describes, and it is the result
+ * that puts an RCQ backend behind the three commit ops.
+ *
+ * The order is not optional: prove the observer first, then move a register,
+ * because a screen nobody has confirmed is on cannot falsify
+ * anything.
+ */
+static void sun60i_de_layer_enable(struct sun60i_de *de)
+{
+	de->commit->begin(de);
+	sun60i_de_layer(de);
+	de->commit->arm(de);
+	de->layer_on = true;
+}
+
+/*
+ * mode->clock is in kHz, i.e. pixels per millisecond, so htotal x vtotal over
+ * it is the frame time in milliseconds directly -- 2080 x 1235 / 154000 = 17 ms
+ * rounded up for the one mode this path drives.
+ */
+static void sun60i_de_quiesce(struct sun60i_de *de)
+{
+	const struct drm_display_mode *mode = &de->mode;
+	u32 frame_ms = DIV_ROUND_UP(mode->htotal * mode->vtotal, mode->clock);
+
+	msleep(DE_QUIESCE_FRAMES * frame_ms);
+}
+
+static void sun60i_de_disable(struct sun60i_de *de)
+{
+	/*
+	 * Layer off, then quiesce, then the clocks, then the memory. The DE has
+	 * to stop fetching before the pages under it go back to CMA, or a buffer
+	 * that now belongs to somebody else is still being read at
+	 * 138 Mpixel/s -- and it has to be given time to finish what is in
+	 * flight before its reset is asserted underneath it.
+	 */
+	sun60i_de_layer_disable(de);
+	sun60i_de_quiesce(de);
+	sun60i_de_clocks_off(de);
+	de->enabled = false;
+}
+
+struct sun60i_de_reg {
+	const char	*name;
+	u32		off;
+};
+
+static void sun60i_de_dump(struct seq_file *s, struct sun60i_de *de,
+			   const struct sun60i_de_reg *regs, size_t n)
+{
+	size_t i;
+
+	for (i = 0; i < n; i++)
+		seq_printf(s, "  %-30s 0x%06x : 0x%08x\n", regs[i].name,
+			   regs[i].off, sun60i_de_read(de, regs[i].off));
+}
+
+static int sun60i_de_state_show(struct seq_file *s, void *unused)
+{
+	struct sun60i_de *de = s->private;
+	u32 chn = sun60i_de_chn(DE_VI0_SLOT);
+	u32 ovl = chn + DE_CHN_OVL;
+	u32 bld = sun60i_de_bld(0);
+	const struct sun60i_de_reg control[] = {
+		{ "de_top ENABLE0 (want 0x10001)", DE_TOP + DE_TOP_ENABLE0 },
+		{ "de_top ENABLE1 (want 0x10001)", DE_TOP + DE_TOP_ENABLE1 },
+		{ "de_top ENABLE2 (want 0x11)",	DE_TOP + DE_TOP_ENABLE2 },
+		{ "de_top VERSION",	DE_TOP + DE_TOP_VERSION },
+		{ "de_top DE2TCON_MUX",	DE_TOP + DE_TOP_DE2TCON_MUX },
+		{ "mixer0 GLOBAL_CTL",	DE_MIXER0_TOP + MIXER_GLOBAL_CTL },
+		{ "mixer0 GLOBAL_SIZE",	DE_MIXER0_TOP + MIXER_GLOBAL_SIZE },
+		{ "mixer0 GLOBAL_CLK",	DE_MIXER0_TOP + MIXER_GLOBAL_CLK },
+		{ "mixer0 RCQ_HEAD_LEN", DE_MIXER0_TOP + MIXER_RCQ_HEAD_LEN },
+	};
+	const struct sun60i_de_reg datapath[] = {
+		{ "vi0 LAY0_ATTCTL",	ovl + OVL_LAY_ATTCTL(DE_OVL_LAYER) },
+		{ "vi0 LAY0_MBSIZE",	ovl + OVL_LAY_MBSIZE(DE_OVL_LAYER) },
+		{ "vi0 LAY0_MBCOOR",	ovl + OVL_LAY_MBCOOR(DE_OVL_LAYER) },
+		{ "vi0 LAY0_PITCH0",	ovl + OVL_LAY_PITCH(DE_OVL_LAYER, 0) },
+		{ "vi0 LAY0_TOP_LADDR0", ovl + OVL_LAY_TOP_LADDR(DE_OVL_LAYER, 0) },
+		{ "vi0 OVL_SIZE",	ovl + OVL_VI_OVL_SIZE },
+		{ "bld0 PIPE_CTL",	bld + BLD_PIPE_CTL },
+		{ "bld0 FCOLOR0",	bld + BLD_ATTR_FCOLOR(DE_BLD_PIPE) },
+		{ "bld0 INSIZE0",	bld + BLD_ATTR_INSIZE(DE_BLD_PIPE) },
+		{ "bld0 ROUTE",		bld + BLD_ROUTE },
+		{ "bld0 BKCOLOR",	bld + BLD_BKCOLOR },
+		{ "bld0 OUTSIZE",	bld + BLD_OUTSIZE },
+		{ "bld0 BLEND_MODE0",	bld + BLD_MODE(DE_BLD_PIPE) },
+	};
+	const struct sun60i_de_reg traps[] = {
+		{ "vi0 CCSC_CTL",		chn + DE_CHN_CCSC + CCSC_CTL },
+		{ "vi0 CCSC c00 (want 0x20000)", chn + DE_CHN_CCSC + CCSC_COEFF_ROW0 },
+		{ "vi0 CCSC c11 (want 0x20000)", chn + DE_CHN_CCSC + CCSC_COEFF_ROW0 +
+						 CCSC_COEFF_ROW_STRIDE + 4 },
+		{ "vi0 CCSC c22 (want 0x20000)", chn + DE_CHN_CCSC + CCSC_COEFF_ROW0 +
+						 2 * CCSC_COEFF_ROW_STRIDE + 8 },
+		{ "vi0 VSU_CTL (written 0)",	chn + DE_CHN_VSU + VSU_CTL },
+		{ "vi0 VSU_OUT_SIZE (written 0)", chn + DE_CHN_VSU + VSU_ATTR_OUT_SIZE },
+		{ "vi0 TFBD (not written)",	chn + DE_CHN_TFBD + TFBD_STATE_WORD },
+	};
+
+	guard(mutex)(&de->lock);
+
+	if (!de->enabled)
+		return -ENODEV;
+
+	seq_printf(s, "mode           : %dx%d, %d kHz\n", de->mode.hdisplay,
+		   de->mode.vdisplay, de->mode.clock);
+	seq_printf(s, "module clock   : %lu Hz\n", clk_get_rate(de->mod_clk));
+	seq_printf(s, "scanout        : %pad, pitch %u, XRGB8888\n",
+		   &de->fb_dma, de->fb_pitch);
+	seq_printf(s, "address kind   : %s\n",
+		   device_iommu_mapped(de->dev) ?
+		   "IOVA (behind an IOMMU) -- NOT comparable with a vendor capture" :
+		   "physical (no IOMMU attached) -- a vendor capture's is an IOVA");
+	seq_printf(s, "commit         : %s\n", de->commit->name);
+
+	seq_puts(s, "\ncontrol plane (plain MMIO, latches directly):\n");
+	sun60i_de_dump(s, de, control, ARRAY_SIZE(control));
+	seq_printf(s, "\ndatapath (through the commit path -- %s):\n",
+		   de->commit->name);
+	sun60i_de_dump(s, de, datapath, ARRAY_SIZE(datapath));
+	seq_puts(s, "\nthe three trap blocks:\n");
+	sun60i_de_dump(s, de, traps, ARRAY_SIZE(traps));
+
+	/*
+	 * The cold values are a reading this tree does not otherwise have: no DE
+	 * reset-state dump exists, so until one is taken these four words are
+	 * the only evidence separating "reset default" from "the vendor wrote
+	 * this" for the blocks that decide whether the picture is correct.
+	 */
+	seq_puts(s, "\nread on a COLD DE, before this driver wrote anything:\n");
+	seq_printf(s, "  VERSION 0x%08x  CCSC 0x%08x  VSU_CTL 0x%08x  TFBD 0x%08x\n",
+		   de->cold_version, de->cold_ccsc, de->cold_vsu,
+		   de->cold_tfbd);
+
+	seq_puts(s, "\nRCQ_HEAD_LEN must read 0: this driver commits by CPU store, and an\n");
+	seq_puts(s, "armed queue would reload the datapath from DRAM on every frame-start.\n");
+	seq_puts(s, "\nThe three de_top ENABLE words open the channel and blender windows. With any\n");
+	seq_puts(s, "of them at zero those windows do not accept a write AT ALL and every datapath\n");
+	seq_puts(s, "line above reads 0x00000000 -- which is what unmapped space reads too.\n");
+	seq_printf(s, "\nCCSC is %s. An ENABLED CCSC with a ZERO matrix multiplies every pixel by\n",
+		   de->ccsc_on ? "ENABLED with a unity matrix" : "DISABLED");
+	seq_puts(s, "zero: a black screen with no underflow, no lostwarn, and every other register\n");
+	seq_puts(s, "correct. If the screen is black, read the three coefficients above first, then\n");
+	seq_puts(s, "try `echo 0 > ccsc` -- the two readings of this block are one write apart.\n");
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(sun60i_de_state);
+
+static void sun60i_de_teardown(void *data)
+{
+	struct sun60i_de *de = data;
+
+	debugfs_remove_recursive(de->dbg);
+
+	scoped_guard(mutex, &de->lock)
+		if (de->enabled)
+			sun60i_de_disable(de);
+}
+
+static int sun60i_de_resources(struct device *dev, struct sun60i_de *de)
+{
+	de->bus_clk = devm_clk_get(dev, "bus");
+	if (IS_ERR(de->bus_clk))
+		return dev_err_probe(dev, PTR_ERR(de->bus_clk), "bus clock\n");
+
+	de->mod_clk = devm_clk_get(dev, "mod");
+	if (IS_ERR(de->mod_clk))
+		return dev_err_probe(dev, PTR_ERR(de->mod_clk),
+				     "module clock\n");
+
+	/*
+	 * Unnamed, i.e. index 0 -- the node carries one reset (DE0_BGR bit 16)
+	 * and, if it carries no reset-names, a named lookup against it would
+	 * fail. This keeps working if reset-names is added later.
+	 */
+	de->reset = devm_reset_control_get_exclusive(dev, NULL);
+	if (IS_ERR(de->reset))
+		return dev_err_probe(dev, PTR_ERR(de->reset), "reset\n");
+
+	return 0;
+}
+
+/*
+ * The window table. Each entry names the reg-names string the device tree must
+ * carry, the offset from the DE aperture base that window MUST land on, and
+ * the minimum length this driver needs out of it -- every minimum computed from
+ * what the code below actually touches rather than picked.
+ *
+ * The check is the point. A window at the wrong address does not fault on this
+ * SoC and does not even fail to map; it reads zeros or, worse, someone else's
+ * registers. Refusing at probe with the address in the message turns a device
+ * tree mistake into a line in dmesg instead of a board session.
+ */
+static const struct {
+	const char	*name;
+	u32		off;
+	u32		min_size;
+} sun60i_de_window_map[SUN60I_DE_WINDOWS] = {
+	[SUN60I_DE_WIN_DE_TOP]	= { "de-top",  DE_TOP,
+				    DE_TOP_VERSION + sizeof(u32) },
+	[SUN60I_DE_WIN_TOP]	= { "top",     DE_MIXER0_TOP,
+				    MIXER_RCQ_HEAD_LEN + sizeof(u32) },
+	[SUN60I_DE_WIN_LAYERS]	= { "layers",  DE_CHN_BASE, DE_CHN_STRIDE },
+	[SUN60I_DE_WIN_DISPLAY]	= { "display", DE_DISP0,
+				    DE_DISP_BLD + DE_BLD_INSTANCES * DE_BLD_STRIDE },
+};
+
+static int sun60i_de_map_windows(struct platform_device *pdev,
+				 struct sun60i_de *de)
+{
+	struct device *dev = &pdev->dev;
+	unsigned int i;
+
+	for (i = 0; i < SUN60I_DE_WINDOWS; i++) {
+		const char *name = sun60i_de_window_map[i].name;
+		struct resource *res;
+		void __iomem *base;
+
+		base = devm_platform_ioremap_resource_byname(pdev, name);
+		if (IS_ERR(base))
+			return dev_err_probe(dev, PTR_ERR(base), "reg \"%s\"\n",
+					     name);
+
+		res = platform_get_resource_byname(pdev, IORESOURCE_MEM, name);
+		if (res->start < DE_APERTURE ||
+		    res->start - DE_APERTURE != sun60i_de_window_map[i].off)
+			return dev_err_probe(dev, -EINVAL,
+					     "reg \"%s\" is at %pa, expected 0x%08x\n",
+					     name, &res->start,
+					     DE_APERTURE + sun60i_de_window_map[i].off);
+
+		if (resource_size(res) < sun60i_de_window_map[i].min_size)
+			return dev_err_probe(dev, -EINVAL,
+					     "reg \"%s\" is %llu bytes, this driver reaches %u\n",
+					     name, (u64)resource_size(res),
+					     sun60i_de_window_map[i].min_size);
+
+		de->win[i].base = base;
+		de->win[i].off = sun60i_de_window_map[i].off;
+		de->win[i].size = resource_size(res);
+	}
+
+	return 0;
+}
+
+static int sun60i_de_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct sun60i_de *de;
+	int ret;
+
+	de = devm_kzalloc(dev, sizeof(*de), GFP_KERNEL);
+	if (!de)
+		return -ENOMEM;
+
+	de->dev = dev;
+	de->mode = sun60i_display_mode_1920x1200;
+	de->background = BLD_COLOR_BLACK;
+	de->ccsc_on = true;
+	de->commit = &sun60i_de_commit_mmio;
+	platform_set_drvdata(pdev, de);
+
+	/*
+	 * A driver choice, not a hardware limit: the layer's high-address byte
+	 * (above sun60i_de_layer()) stays 0, so every buffer must sit
+	 * below 4 GiB. Mainline's sun8i mixer also runs with a 32-bit mask,
+	 * although its UI layers have a high-address register.
+	 */
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return dev_err_probe(dev, ret, "32-bit DMA mask\n");
+
+	ret = devm_mutex_init(dev, &de->lock);
+	if (ret)
+		return ret;
+
+	ret = sun60i_de_map_windows(pdev, de);
+	if (ret)
+		return ret;
+
+	ret = sun60i_de_resources(dev, de);
+	if (ret)
+		return ret;
+
+	/*
+	 * Nothing above touched a register and nothing below does either. The DE
+	 * drives pixels into a TCON that may not be scanning, out of a Type-C
+	 * port that may be carrying SuperSpeed -- so it is started deliberately,
+	 * the rule `drm-allwinner-a733-displayport-aux` established for the AUX channel and `drm-a733-tcon-tv1-timing-generator-and-video-source` kept for the
+	 * TCON.
+	 */
+	de->dbg = debugfs_create_dir(dev_name(dev), NULL);
+	ret = devm_add_action_or_reset(dev, sun60i_de_teardown, de);
+	if (ret)
+		return ret;
+
+	debugfs_create_file("state", 0400, de->dbg, de, &sun60i_de_state_fops);
+
+	dev_info(dev, "A733 display engine on %s, idle until a KMS master binds\n",
+		 dev_name(dev));
+
+	return 0;
+}
+
+/*
+ * The compatible is mainline's DE33 mixer naming, and claiming it is
+ * deliberate: this is a stand-in for a sun8i_mixer entry, not a rival to one.
+ * The device tree describes the hardware in the shape that backend will want --
+ * four named windows, an output graph edge -- so when the mixer entry lands,
+ * one patch moves this string from here into sun8i_mixer_of_table and the DT
+ * does not move at all. A second compatible for the same block would have made
+ * that a device tree change as well.
+ *
+ * The compatible is this part's own string, with no "allwinner,sun50i-h616-de33-mixer-0"
+ * fallback. That would bind this hardware to the H616 cfg, whose
+ * .map = {0, 6, 7, 8} gives a different channel base for every channel above
+ * the first than this part's slots {0,1,2} + {6,7,8,9} need. The DE33 *code*
+ * describes this silicon; the H616 *cfg* does not, and a mismatch is silent --
+ * a fallback would probe and fetch from the wrong address.
+ * Reuse the code, not the cfg.
+ */
+static const struct of_device_id sun60i_de_of_match[] = {
+	{ .compatible = "allwinner,sun60i-a733-de-mixer-0" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sun60i_de_of_match);
+
+static struct platform_driver sun60i_de_driver = {
+	.probe	= sun60i_de_probe,
+	.driver	= {
+		.name		= "sun60i-a733-de-mixer",
+		.of_match_table	= sun60i_de_of_match,
+	},
+};
+module_platform_driver(sun60i_de_driver);
+
+MODULE_DESCRIPTION("Allwinner A733 display engine");
+MODULE_LICENSE("GPL");
