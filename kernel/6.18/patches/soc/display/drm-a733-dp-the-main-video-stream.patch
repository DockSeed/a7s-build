+/*
+ * The transfer unit. UM 15.4.5.3 offers an automatic mode (SYMBOLS_PER_TU = 0)
+ * and a manual one. The UM advises the manual mode for boxes that must work
+ * with a wide range of sinks, since the automatic mode may not suit all of
+ * them. A
+ * monitor on a Type-C cable is exactly that, so the count is computed.
+ *
+ * TU_SIZE 64 is the register's own reset value and the top of the range the UM
+ * allows (32..64). ⚠ Changing it means rechecking SRC0_DATA_CONTROL, which is
+ * why sun60i_dp_video_check_data_control() exists and takes the size as an
+ * argument rather than reading a constant.
+ */
+#define TU_SIZE				64
+#define TU_FRAC_UNITS			16
+
+/*
+ * 8b/10b: a lane at R Mb/s on the wire carries R/10 mega-symbols per second and
+ * one payload byte per symbol. Everything below counts bytes per second in kB/s
+ * so that a pixel clock in kHz can be used directly.
+ */
+#define LANE_KBPS_PER_MBPS		100
+
+/* MVID is a measurement, so it is compared with a tolerance, not for equality. */
+#define MVID_TOLERANCE_PERCENT		1
+
