+/*
+ * ---------------------------------------------------------------------------
+ * The main video stream
+ * ---------------------------------------------------------------------------
+ *
+ * What reaches the sink as a picture is the transfer-unit packetisation of
+ * pixels arriving from TCON_TV1, described to the sink by the Main Stream
+ * Attribute packet. Both halves are programmed here, and both are COMPUTED from
+ * the mode, the link rate and the lane count -- UM 15.4.5.3
+ * states the equations, and re-deriving them reproduces, to the digit, what a
+ * live vendor link carries at 1920x1200 over four lanes
+ *:
+ *
+ *   LinkBW      = LINK_BW_SET * 27 * LANE_COUNT_SET   0x0A * 27 * 4 = 1080
+ *   Data Rate   = pixel clock * bpp / 8               154 * 24 / 8  =  462
+ *   TU symbols  = Data Rate / LinkBW * TU_SIZE        462/1080 * 64 = 27.3778
+ *                                                     -> 27 + 6/16 = 0x061B0040
+ *   SYMBOL_COUNT    = (HRES * bpp + 7) / 8            (1920*24+7)/8 = 5760
+ *   USER_DATA_COUNT = (SYMBOL_COUNT + lanes - 1)/lanes  (5760+3)/4  = 1440
+ *
+ * ⚠ THE POINT OF COMPUTING RATHER THAN CARRYING is the lane count. The by-hand
+ * script this transcribes hardcodes the four-lane words, and they are wrong for
+ * two lanes -- which wants 0x0C360040 and 0xB40 -- so two-lane runs that used
+ * those words and looked clean were running an under-programmed transfer
+ * unit. This code cannot make that mistake, because it never sees a constant.
+ */
+
+static void sun60i_dp_video_gates(struct sun60i_dp *dp, bool on)
+{
+	/*
+	 * ⚠ Their absence does not look like a missing clock gate. With them
+	 * shut, fifteen of seventeen main-stream registers read back exactly
+	 * what was written and only MVID and NVID misbehave -- so a driver that
+	 * verifies its own read-backs passes on fifteen and then chases MVID.
+	 * They are opened FIRST here for that reason; the by-hand run opened
+	 * them last and had to re-write NVID afterwards.
+	 *
+	 * VID1_CLK_GATING (bit 4) stays shut: it belongs to the second video
+	 * source, and this is a single-stream link with INPUT_SOURCE_ENABLE at
+	 * bit 0. The vendor writes the same two words, 0x1 and 0x1
+	 * (trilinear_dp14.c:1215-1216).
+	 */
+	writel(on ? LNK_CLK_GATING : 0, dp->pad + PAD_DP_LNK_CLK_CFG);
+	writel(on ? VID0_CLK_GATING : 0, dp->pad + PAD_DP_VID_CLK_CFG);
+}
+
+static u32 sun60i_dp_video_bpc_code(u8 bpc)
+{
+	switch (bpc) {
+	case 6:
+		return MISC0_BPC_6;
+	case 10:
+		return MISC0_BPC_10;
+	case 12:
+		return MISC0_BPC_12;
+	case 16:
+		return MISC0_BPC_16;
+	default:
+		return MISC0_BPC_8;
+	}
+}
+
+/*
+ * The Main Stream Attributes. Every field is the DisplayPort quantity of the
+ * same name, so the mode goes in directly: HSTART and VSTART are measured from
+ * the LEADING EDGE OF SYNC to the first active pixel or line, which is
+ * htotal - hsync_start and vtotal - vsync_start.
+ *
+ * MISC0 bit 0 is left at 0, asynchronous clock mode, deliberately: it is what
+ * makes MVID a measurement of the incoming pixel clock rather than a number we
+ * assert (UM 15.4.5.2). ⚠ The vendor reaches the same setting
+ * only implicitly -- its edp_core->sync_clock is declared, read twice and assigned
+ * nowhere, so kzalloc decides the clocking mode of every link it drives
+ * (trilinear_dp14.c:1274, :1320; sunxi_edp.h:444).
+ *
+ * POLARITY is PVSYNC << 1 | PHSYNC << 0, i.e. a set bit means the mode's sync
+ * pulse is POSITIVE. ⚠ The register table says the opposite: it documents 0
+ * as active high and 1 as active low (15.4.7.46), and then notes that this
+ * sense is inverted relative to the user input port polarities. Silicon
+ * settles it: a live link at a +HSync -VSync mode carries 0x1.
+ * The vendor writes the same expression (trilinear_dp14.c:1424-1425 over
+ * sunxi_drm_intf.c:99,108) and feeds those same two flags to TCON_TV1's
+ * TV_IO_POL, which is why the two blocks cannot describe different modes.
+ * ⬜ One mode; the VSYNC bit has never been exercised set.
+ */
+static void sun60i_dp_video_msa(struct sun60i_dp *dp,
+				const struct drm_display_mode *mode, u8 bpc)
+{
+	u32 polarity = 0;
+
+	if (mode->flags & DRM_MODE_FLAG_PVSYNC)
+		polarity |= MAIN_STREAM_VSYNC_POLARITY;
+	if (mode->flags & DRM_MODE_FLAG_PHSYNC)
+		polarity |= MAIN_STREAM_HSYNC_POLARITY;
+
+	writel(mode->htotal, dp->base + DP_SRC0_MAIN_STREAM_HTOTAL);
+	writel(mode->vtotal, dp->base + DP_SRC0_MAIN_STREAM_VTOTAL);
+	writel(polarity, dp->base + DP_SRC0_MAIN_STREAM_POLARITY);
+	writel(mode->hsync_end - mode->hsync_start,
+	       dp->base + DP_SRC0_MAIN_STREAM_HSWIDTH);
+	writel(mode->vsync_end - mode->vsync_start,
+	       dp->base + DP_SRC0_MAIN_STREAM_VSWIDTH);
+	writel(mode->hdisplay, dp->base + DP_SRC0_MAIN_STREAM_HRES);
+	writel(mode->vdisplay, dp->base + DP_SRC0_MAIN_STREAM_VRES);
+	writel(mode->htotal - mode->hsync_start,
+	       dp->base + DP_SRC0_MAIN_STREAM_HSTART);
+	writel(mode->vtotal - mode->vsync_start,
+	       dp->base + DP_SRC0_MAIN_STREAM_VSTART);
+	writel(FIELD_PREP(MISC0_BIT_DEPTH, sun60i_dp_video_bpc_code(bpc)) |
+	       FIELD_PREP(MISC0_COMPONENT_FORMAT, MISC0_FORMAT_RGB),
+	       dp->base + DP_SRC0_MISC0);
+	writel(0, dp->base + DP_SRC0_MISC1);
+	writel(0, dp->base + DP_SRC0_MAIN_STREAM_INTERLACED);
+	/* One pixel per clock, which is what TV_GCTL_REG's PIXEL_MODE says. */
+	writel(1, dp->base + DP_SRC0_USER_PIXEL_COUNT);
+}
+
+/* Valid data symbols per transfer unit, in sixteenths. */
+static u32 sun60i_dp_video_symbols_x16(const struct drm_display_mode *mode,
+				       u32 bpp, unsigned int rate_mbps,
+				       unsigned int lanes)
+{
+	u64 src_kbps = (u64)mode->clock * bpp / 8;
+	u64 link_kbps = (u64)rate_mbps * lanes * LANE_KBPS_PER_MBPS;
+
+	return div64_u64(src_kbps * TU_SIZE * TU_FRAC_UNITS, link_kbps);
+}
+
+/*
+ * SRC0_DATA_CONTROL is NOT written -- the UM tells integrators to leave this
+ * register alone unless the vendor's support engineers direct otherwise
+ * (15.4.7.42) -- but it is CHECKED, because its reset value sits exactly on the
+ * one constraint the UM does impose: 15.4.5.4 requires DATA_ACCUMULATION_DELAY
+ * to be no smaller than half the TU size, and the reset 0x00002004 is a delay
+ * of 32 against a TU size of 64. Anything that lowers the delay or raises the
+ * TU size breaks it, and the failure would be uneven spacing of the
+ * Blanking Start symbols, not an error.
+ *
+ * The vendor never programs and never reads this register at all
+ * (trilinear_dp14.h:117 is its only occurrence in that tree).
+ */
+static int sun60i_dp_video_check_data_control(struct sun60i_dp *dp, u32 tu_size)
+{
+	u32 val = readl(dp->base + DP_SRC0_DATA_CONTROL);
+	u32 delay = FIELD_GET(DATA_CONTROL_ACCUM_DELAY, val);
+
+	if (delay < tu_size / 2) {
+		dev_err(dp->dev,
+			"DATA_ACCUMULATION_DELAY %u is below half of TU size %u (UM 15.4.5.4)\n",
+			delay, tu_size);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+/*
+ * The secondary-data window, in link symbol clocks. UM 15.4.7.40 gives both a
+ * hard rule -- the value must stay below the horizontal blanking period -- and
+ * a recommended value, the formula Reg = HBLANK_PERIOD /
+ * LINK_SYMBOL_CLOCK_PERIOD * 0.9. For this mode the blanking period is 280
+ * symbols and the recommendation is 252.
+ *
+ * ⚠ THIS IS A DELIBERATE DEPARTURE FROM WHAT A WORKING LINK CARRIES, and it is
+ * the only one in this patch. Both our by-hand run and the vendor write 98, and
+ * 98 is legal -- it satisfies the hard rule. But it is not a carried mystery
+ * either: the vendor computes it as HSTART * (link symbol rate / 2) / pixel
+ * clock (trilinear_dp14.c:889-903), which at this mode is 112 * 135000 / 154000
+ * = 98, from an undocumented formula over the wrong quantity -- HSTART rather
+ * than the blanking period -- with a bare /2. Our own by-hand value was copied
+ * from that live link, so the two agreeing sources are one source.
+ *
+ * This tree's rule is that a value comes from the reference docs, and the
+ * reference doc has an equation. It is computed. Falsified by:
+ * SRC0_USER_FIFO_STATUS or SRC0_USER_FRAMING_STATUS going non-zero, or the
+ * picture going away -- and reverting costs one write on a live link,
+ * `devmem 0x05740808 32 0x62`, with no rebuild.
+ */
+static u32 sun60i_dp_video_secondary_window(const struct drm_display_mode *mode,
+					    unsigned int rate_mbps)
+{
+	u32 hblank = mode->htotal - mode->hdisplay;
+	u64 blank_symbols = div_u64((u64)hblank * rate_mbps * LANE_KBPS_PER_MBPS,
+				    mode->clock);
+	u64 window;
+
+	if (blank_symbols < 2)
+		return 0;
+
+	window = min(div_u64(blank_symbols * 9, 10), blank_symbols - 1);
+
+	return min_t(u32, window, FIELD_MAX(SECONDARY_DATA_WINDOW));
+}
+
+static int sun60i_dp_video_transfer_unit(struct sun60i_dp *dp,
+					 const struct drm_display_mode *mode,
+					 u32 bpp)
+{
+	u32 sym16 = sun60i_dp_video_symbols_x16(mode, bpp, dp->link_rate,
+						dp->link_lanes);
+	u32 symbol_count, data_count;
+	int ret;
+
+	/*
+	 * More valid symbols than a transfer unit can hold means the link
+	 * cannot carry this mode. Refusing here is taken from the vendor driver,
+	 * which checks the same thing in its mode filter
+	 * (trilinear_dp14.c:1783-1826) rather than failing the modeset -- minus
+	 * its off-by-two: its own message says the limit is 62 where its code
+	 * tests 64.
+	 */
+	if (!sym16 || sym16 > TU_SIZE * TU_FRAC_UNITS) {
+		dev_err(dp->dev,
+			"%u.%02u symbols per TU of %u: %u Mb/s over %u lanes cannot carry %d kHz at %u bpp\n",
+			sym16 / TU_FRAC_UNITS,
+			(sym16 % TU_FRAC_UNITS) * 100 / TU_FRAC_UNITS, TU_SIZE,
+			dp->link_rate, dp->link_lanes, mode->clock, bpp);
+		return -EINVAL;
+	}
+
+	ret = sun60i_dp_video_check_data_control(dp, TU_SIZE);
+	if (ret)
+		return ret;
+
+	writel(FIELD_PREP(TU_CONFIG_SIZE, TU_SIZE) |
+	       FIELD_PREP(TU_CONFIG_SYMBOLS, sym16 / TU_FRAC_UNITS) |
+	       FIELD_PREP(TU_CONFIG_FRAC_SYMBOLS, sym16 % TU_FRAC_UNITS),
+	       dp->base + DP_SRC0_TU_CONFIG);
+
+	/*
+	 * 🔴 SRC0_USER_DATA_COUNT is the register that stood between a fully
+	 * trained link and a picture. At its reset value of zero the framing
+	 * logic sends a blanking-start symbol after zero symbols of active
+	 * video, so every line is blank -- and every link observable stays
+	 * perfect: all four lanes CR + EQ + symbol-locked, interlane aligned,
+	 * zero symbol errors, the sink reporting itself in sync, FIFO_STATUS
+	 * clean, and the monitor not even waking from standby. It was found on
+	 * 2026-08-18 by diffing this 4 KiB window against a live vendor link,
+	 * where it was the one register the vendor set and we did not.
+	 */
+	symbol_count = DIV_ROUND_UP(mode->hdisplay * bpp, 8);
+	data_count = DIV_ROUND_UP(symbol_count, dp->link_lanes);
+	if (data_count > (u32)USER_DATA_COUNT_MASK) {
+		dev_err(dp->dev,
+			"%u bytes per line per lane does not fit the 18-bit field\n",
+			data_count);
+		return -EINVAL;
+	}
+	writel(data_count, dp->base + DP_SRC0_USER_DATA_COUNT);
+
+	writel(sun60i_dp_video_secondary_window(mode, dp->link_rate),
+	       dp->base + DP_SRC0_SECONDARY_DATA_WINDOW);
+
+	return 0;
+}
+
+/*
+ * MVID, read and never written. In asynchronous clock mode the register is
+ * read-only and returns what the core itself computes from the input video
+ * clock (15.4.7.55) -- so it is the core measuring what
+ * TCON_TV1 is actually feeding it, one of the few numbers in this driver that
+ * cannot be a register echoing our own write. NVID is read-only in the same
+ * mode and returns the constant 0x8000, which is the scale.
+ *
+ * ⚠ The vendor writes both, unconditionally, before it has computed the
+ * clocking mode (trilinear_dp14.c:1263, :1266), with the comment "// not sure
+ * divide 1000 or 100000, spec seems conflict" sitting above the MVID write. It
+ * then reads MVID back in one place, scales it by 1000 and prints it in sysfs
+ * as the pixel clock (:1638, sunxi_drm_edp.c:1803) -- which on an async link
+ * reports 18 690 kHz for a 154 000 kHz mode. It never compares it to anything.
+ */
+static int sun60i_dp_video_pixel_khz(struct sun60i_dp *dp)
+{
+	u32 mvid = readl(dp->base + DP_SRC0_MVID) & (u32)MVID_MASK;
+
+	return div_u64((u64)mvid * dp->link_rate * LANE_KBPS_PER_MBPS,
+		       NVID_ASYNC_CONSTANT);
+}
+
+static int sun60i_dp_video_check_pixel_clk(struct sun60i_dp *dp)
+{
+	int measured = sun60i_dp_video_pixel_khz(dp);
+	int want = dp->mode.clock;
+	u32 nvid = readl(dp->base + DP_SRC0_NVID) & (u32)MVID_MASK;
+
+	if (nvid != NVID_ASYNC_CONSTANT) {
+		dev_err(dp->dev,
+			"NVID is 0x%x, not the 0x%x asynchronous mode returns\n",
+			nvid, NVID_ASYNC_CONSTANT);
+		return -EIO;
+	}
+
+	if (abs(measured - want) > want / 100 * MVID_TOLERANCE_PERCENT) {
+		dev_err(dp->dev,
+			"the core measures %d kHz on its video input, the mode is %d kHz\n",
+			measured, want);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+/*
+ * Program the stream, but do not start it. Everything here is safe before link
+ * training and has to happen before it: the transfer unit depends on the lane
+ * count and the rate, which is why sun60i_dp_link_configure() has to have run.
+ *
+ * What this deliberately does NOT touch is LINK_BW_SET and LANE_COUNT_SET, for
+ * the reason `drm-a733-dp-configure-the-main-link-phy` gives: those belong with the training pattern sequence and
+ * the matching DPCD writes, and moving one end without the other is the failure
+ * that has already been seen once.
+ */
+static int sun60i_dp_video_configure(struct sun60i_dp *dp)
+{
+	const struct drm_display_mode *mode = &dp->mode;
+	u32 bpp = dp->bpc * 3;
+	int ret;
+
+	if (!dp->enabled) {
+		dev_err(dp->dev, "the AUX channel is down\n");
+		return -ENODEV;
+	}
+
+	if (!dp->pad) {
+		dev_err(dp->dev,
+			"no eDP_REG_PAD window: this node needs a second reg entry at 0x05760000\n");
+		return -ENODEV;
+	}
+
+	if (!dp->link_rate || !dp->link_lanes) {
+		dev_err(dp->dev,
+			"no link rate or lane count yet -- configure the PHY first (write to `link`)\n");
+		return -EINVAL;
+	}
+
+	/* Both are divisors below, and div_u64() by zero is an oops, not an
+	 * error return. The built-in mode cannot be zero today; the mode this
+	 * takes from a connector one day can be anything.
+	 */
+	if (mode->clock <= 0 || mode->htotal <= mode->hdisplay) {
+		dev_err(dp->dev, "mode %dx%d @ %d kHz is not a mode\n",
+			mode->hdisplay, mode->vdisplay, mode->clock);
+		return -EINVAL;
+	}
+
+	sun60i_dp_video_gates(dp, true);
+	sun60i_dp_video_msa(dp, mode, dp->bpc);
+
+	ret = sun60i_dp_video_transfer_unit(dp, mode, bpp);
+	if (ret)
+		goto err_gates;
+
+	/*
+	 * The transmitter output enable must wait until the link output is
+	 * configured, so that the controller does not disturb the PHY while
+	 * it powers up (15.4.7.14); the source enable then starts the
+	 * NO_VIDEO pattern while no video stream is enabled (15.4.7.16),
+	 * which is exactly the state to be in
+	 * while training runs.
+	 */
+	writel(TX_OUTPUT_ENABLE, dp->base + DP_TRANSMITTER_OUTPUT_ENABLE);
+	writel(INPUT_SOURCE_ENABLE_SST, dp->base + DP_INPUT_SOURCE_ENABLE);
+
+	dp->video_configured = true;
+
+	return 0;
+
+err_gates:
+	sun60i_dp_video_gates(dp, false);
+
+	return ret;
+}
+
+/*
+ * Start the stream. This runs AFTER link training: with training cleared and
+ * the stream not enabled the core sends idle and the sink loses the lock it
+ * just gained, which is what happened here on the first successful training,
+ * 2026-08-18.
+ *
+ * The video soft reset before it is the vendor's, and it is right -- but only
+ * on one of its two paths. Its eDP path resets and then enables
+ * (sunxi_drm_edp.c:3750-3752) while its DisplayPort path jumps straight to the
+ * enable with no reset at all (:3994-3999), same IP, same MSA block, two
+ * sequences. And its reset is write-only and never released, because nothing in
+ * that driver ever writes the bit back to zero. SOFT_RESET is documented
+ * write-only and self-clearing in effect (15.4.7.15); this driver writes the
+ * one bit it means and reads nothing back from a write-only register.
+ */
+static int sun60i_dp_video_stream_enable(struct sun60i_dp *dp)
+{
+	int ret;
+
+	if (!dp->enabled || !dp->video_configured) {
+		dev_err(dp->dev,
+			"the stream is not configured yet -- write \"configure\" first\n");
+		return -EINVAL;
+	}
+
+	ret = sun60i_dp_video_check_pixel_clk(dp);
+	if (ret)
+		return ret;
+
+	writel(SOFT_RESET_VIDEO, dp->base + DP_SOFT_RESET);
+	usleep_range(5000, 6000);
+
+	writel(SRC0_ENABLE, dp->base + DP_SRC0_ENABLE);
+	writel(SRC0_STREAM_ENABLE, dp->base + DP_SRC0_STREAM_ENABLE);
+
+	dp->video_on = true;
+	dev_info(dp->dev, "video stream enabled, %d kHz over %u lanes\n",
+		 dp->mode.clock, dp->link_lanes);
+
+	return 0;
+}
+
+static void sun60i_dp_video_disable(struct sun60i_dp *dp)
+{
+	/*
+	 * `enabled`, not just `pad`. Six writes into a block whose reset is
+	 * asserted and whose bus clock is off is what `echo off > video` would
+	 * otherwise do on a driver that was never enabled -- and this file's own
+	 * AUX path establishes the rule: both the gate and the reset are
+	 * required before a single register of this block is reachable,
+	 * measured, not assumed. The call from sun60i_dp_aux_disable() is
+	 * unaffected: it runs while `enabled` is still true.
+	 */
+	if (!dp->enabled || !dp->pad)
+		return;
+
+	/*
+	 * Cleared in the reverse order, including 0x0804 -- the vendor's line
+	 * for that one is commented out (trilinear_dp14.c:914), so its second
+	 * stream stays enabled for the lifetime of the driver once any modeset
+	 * has run.
+	 */
+	writel(0, dp->base + DP_SRC0_STREAM_ENABLE);
+	writel(0, dp->base + DP_SRC0_ENABLE);
+	writel(0, dp->base + DP_INPUT_SOURCE_ENABLE);
+	writel(0, dp->base + DP_TRANSMITTER_OUTPUT_ENABLE);
+	sun60i_dp_video_gates(dp, false);
+
+	dp->video_on = false;
+	dp->video_configured = false;
+}
