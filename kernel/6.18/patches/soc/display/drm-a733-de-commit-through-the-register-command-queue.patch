+/*
+ * THE REGISTER COMMAND QUEUE BACKEND, the default commit path.
+ *
+ * WHY. A datapath register written by CPU store takes effect at once, wherever
+ * the raster is, and a write that lands while the blender is on a plane's own
+ * pixels corrupts the rest of the frame. Measured for the cursor position on
+ * the 6 GiB board (2026-09-30): one COORD1 write per frame is clean at every
+ * line, except 11.3-11.9 us into a line inside the cursor's rows, where the
+ * sink's frame CRC shows 7 and 9 distinct frames for a two-frame sequence;
+ * Xorg's 125 Hz cursor moves hit that slot often enough to be seen.
+ * No CPU timing fixes that:
+ * the slot moves with the cursor, and a write timed to the vertical blank
+ * depends on interrupt latency.
+ *
+ * WHAT THE QUEUE DOES, measured with a test-only patch (drm-a733-de-rcq-probe, not carried) on the
+ * same board and day: after RCQ_CTL bit 0 is set, the engine
+ * copies every head whose dirty word is set from DRAM into its registers,
+ * once, at TCON line 27/28 -- the end of the TCON's vertical blank, where the
+ * engine starts its frame -- whatever line the request was made at (399,
+ * 616, 793, 1232). Bit 0 clears itself within one poll of the copy, the head's dirty word stays as software
+ * left it, and nothing is copied again without a new request. Allwinner's
+ * documents say no more than that the engine supports a register configuration queue
+ * (UM V1.00 p.663, 14.3); the head layout is the vendor driver's
+ * (allwinner-bsp cubie-aiot-v1.4.8, de_base.h struct de_rcq_head), and the
+ * probe is what confirms it.
+ *
+ * HOW. Every datapath register this driver stages lies in one of the blocks
+ * sun60i_de_queue_init() lists. stage() writes a CPU copy of the block and
+ * marks it. arm() then, with interrupts off and GLB_STS busy -- the engine on
+ * an active line -- copies the marked blocks into their DMA shadows, sets
+ * their dirty words and requests one copy. Where the copy sits against busy
+ * is measured (6.18.54-trcq2, on the board): in
+ * all six probe runs bit 0 cleared and the register took the new value in
+ * the poll in which busy rose or up to one poll (~2 us) before it, with the
+ * line field at 0 and FINISH set then or one poll later. So the window is
+ * busy with a line field of at least DE_RCQ_FIRST_LINE -- a line past the
+ * engine's first -- and a request is only made or joined once the previous
+ * one's FINISH has been seen, so no write can meet a copy still running.
+ * If a request is still pending from earlier in the same frame, the new
+ * values go into the same shadows and ride along with it: several commits in
+ * one frame coalesce and the last one wins, and nothing waits. When the
+ * engine is not scanning at all (a modeset brings the DE up before the TCON,
+ * and takes the TCON down first), no pixel can be torn and the blocks are
+ * written by CPU store.
+ *
+ * COMPLETION. A request is complete once GLB_STS RCQ_FINISH is set, or once
+ * a later request has been made (one is made only after the previous one's
+ * RCQ_CTL bit 0 cleared). FINISH, as the vendor uses it, and not bit 0:
+ * bit 0 was seen to clear one poll (2 us) before the register effect.
+ * FINISH is cleared inside the busy window right before each new request,
+ * so a set FINISH belongs to the newest one. sun60i_de_queue_wait() polls exactly that; the KMS half sends a
+ * commit's event after it (sun60i_de_kms_commit_wait()), so a flip completes
+ * when the engine has taken it, not when a vblank passed.
+ *
+ * DIFFERENT FROM THE VENDOR (allwinner-bsp cubie-aiot-v1.4.8, lowlevel_de/
+ * and sunxi_de.c, read for this patch; no code taken):
+ *   - its shadows start at zero and a dirty block sends every register it
+ *     never wrote as 0; here they are seeded from the registers;
+ *   - it requests only while GLB_STS busy is set and spins up to 100 ms for
+ *     it, then returns without having requested and without saying so
+ *     (de_top_set_rcq_update()); here a scanning engine is busy within one
+ *     vertical blank, and an engine that is not is written directly;
+ *   - its atomic_flush waits for FINISH on every commit, cursor moves
+ *     included, so a pointer move can block for a frame; here nothing waits
+ *     except a commit that frees a buffer or carries an event;
+ *   - after FINISH it clears the dirty word of every block, so a block made
+ *     dirty between the request and the clear is lost; here dirty words are
+ *     written only inside the busy window, and a request that completed while
+ *     they were written is made again;
+ *   - on a FINISH timeout it sends the flip event anyway and leaves the
+ *     blocks dirty; here a request that never completes is withdrawn, its
+ *     blocks written by CPU store, and the event goes out after that;
+ *   - its pad head for the 2-alignment is written one past the end of the
+ *     array (sunxi_de.c:363-366); here the count is even by construction.
+ */
+static bool sun60i_de_use_rcq = true;
+
+/* The head, 16 bytes; field layout of the vendor's struct de_rcq_head. */
+struct sun60i_de_rcq_hd {
+	__le32	low_addr;	/* shadow address [31:0] */
+	__le32	dw0;		/* [23:0] length in bytes, [31:24] address [39:32] */
+	__le32	dirty;		/* bit 0: copy this block on the next request */
+	__le32	reg_offset;	/* from the DE aperture base */
+};
+#define DE_RCQ_HD_LEN			GENMASK(23, 0)
+#define DE_RCQ_HD_HADDR			GENMASK(31, 24)
+#define DE_RCQ_HD_DIRTY			BIT(0)
+/* The vendor aligns shadows to 32 bytes ("32 bytes align", de_base.h). */
+#define DE_RCQ_ALIGN			32
+
+/*
+ * The blocks: the blender's attribute and route..mode windows, then per VI
+ * channel (primary, cursor) layer 0 and OVL_SIZE, then the primary channel's
+ * CCSC -- per instance the control word and the 3 x 4 matrix -- and its two
+ * VSU words. An even count, as the vendor requires ("RCQ header block cnt
+ * must be 2 align", sunxi_de.c:336).
+ */
+#define DE_BLD_ATTR_LEN			0x60	/* PIPE_CTL .. pipe 5's COORD */
+#define DE_BLD_ROUTE_LEN		0x24	/* ROUTE .. BLD_MODE(4) */
+#define DE_OVL_LAYER_LEN		0x30	/* one layer at the 0x30 stride */
+#define DE_CCSC_MATRIX_LEN		(CCSC_MATRIX_ROWS * CCSC_COEFF_ROW_STRIDE)
+#define DE_RCQ_BLOCKS			(6 + 2 * DE_CCSC_INSTANCES + 2)
+
+struct sun60i_de_rcq_block {
+	u32	off;	/* from the DE aperture base */
+	u32	len;	/* bytes, a multiple of 4 */
+};
+
+struct sun60i_de_queue {
+	struct sun60i_de_rcq_block	blk[DE_RCQ_BLOCKS];
+	void				*buf;		/* heads, then shadows */
+	dma_addr_t			dma;
+	struct sun60i_de_rcq_hd		*hd;
+	u32				*shadow[DE_RCQ_BLOCKS];	/* what the engine copies */
+	u32				*staged[DE_RCQ_BLOCKS];	/* what stage() writes */
+	DECLARE_BITMAP(marked, DE_RCQ_BLOCKS);
+	unsigned long			gen;		/* requests made */
+	ktime_t				requested;	/* when the last one was */
+	bool				fresh;		/* delivered by the queue since the last wait */
+	bool				awaiting;	/* last request not yet seen FINISHed */
+	/* for `state` */
+	unsigned long			coalesced, direct, late, stale, timeouts;
+	unsigned long			nofinish;
+};
+
+/* The engine's vertical blank is where the copy happens; waits count in it. */
+#define DE_RCQ_POLL_US			1
+#define DE_RCQ_SLEEP_US			250
+#define DE_RCQ_WINDOW_TRIES		3
+#define DE_RCQ_STALE_FRAMES		3
+#define DE_RCQ_MOVE_LINES		2
+#define DE_RCQ_FIRST_LINE		1
+
+static u32 sun60i_de_lines_us(const struct sun60i_de *de, u32 lines)
+{
+	return DIV_ROUND_UP_ULL((u64)lines * de->mode.htotal * USEC_PER_MSEC,
+				de->mode.clock);
+}
+
+static void sun60i_de_queue_add(struct sun60i_de_queue *q, unsigned int *n,
+				u32 off, u32 len)
+{
+	q->blk[*n].off = off;
+	q->blk[*n].len = len;
+	(*n)++;
+}
+
+static void sun60i_de_queue_blocks(struct sun60i_de_queue *q)
+{
+	u32 bld = sun60i_de_bld(0);
+	u32 ccsc = sun60i_de_chn(DE_VI0_SLOT) + DE_CHN_CCSC;
+	u32 vsu = sun60i_de_chn(DE_VI0_SLOT) + DE_CHN_VSU;
+	unsigned int slot, i, n = 0;
+
+	sun60i_de_queue_add(q, &n, bld + BLD_PIPE_CTL, DE_BLD_ATTR_LEN);
+	sun60i_de_queue_add(q, &n, bld + BLD_ROUTE, DE_BLD_ROUTE_LEN);
+	for (slot = DE_VI0_SLOT; slot <= DE_CURSOR_SLOT; slot++) {
+		u32 ovl = sun60i_de_chn(slot) + DE_CHN_OVL;
+
+		sun60i_de_queue_add(q, &n, ovl + OVL_LAY_ATTCTL(DE_OVL_LAYER),
+				    DE_OVL_LAYER_LEN);
+		sun60i_de_queue_add(q, &n, ovl + OVL_VI_OVL_SIZE, sizeof(u32));
+	}
+	for (i = 0; i < DE_CCSC_INSTANCES; i++) {
+		u32 base = ccsc + i * DE_CCSC_STRIDE;
+
+		sun60i_de_queue_add(q, &n, base + CCSC_CTL, sizeof(u32));
+		sun60i_de_queue_add(q, &n, base + CCSC_COEFF_ROW0,
+				    DE_CCSC_MATRIX_LEN);
+	}
+	sun60i_de_queue_add(q, &n, vsu + VSU_CTL, sizeof(u32));
+	sun60i_de_queue_add(q, &n, vsu + VSU_ATTR_OUT_SIZE, sizeof(u32));
+
+	WARN_ON(n != DE_RCQ_BLOCKS);
+}
+
+/*
+ * One coherent page: the heads, then each block's shadow at a 32-byte
+ * boundary, and a CPU copy of the same layout for stage(). Allocated at probe,
+ * because the backend can be chosen at every enable.
+ */
+static int sun60i_de_queue_init(struct sun60i_de *de)
+{
+	struct sun60i_de_queue *q;
+	size_t at = ALIGN(sizeof(*q->hd) * DE_RCQ_BLOCKS, DE_RCQ_ALIGN);
+	u32 *staged;
+	unsigned int i;
+
+	q = devm_kzalloc(de->dev, sizeof(*q), GFP_KERNEL);
+	staged = devm_kzalloc(de->dev, PAGE_SIZE, GFP_KERNEL);
+	if (!q || !staged)
+		return -ENOMEM;
+
+	q->buf = dmam_alloc_coherent(de->dev, PAGE_SIZE, &q->dma, GFP_KERNEL);
+	if (!q->buf)
+		return -ENOMEM;
+
+	sun60i_de_queue_blocks(q);
+	q->hd = q->buf;
+	for (i = 0; i < DE_RCQ_BLOCKS; i++) {
+		dma_addr_t sdma = q->dma + at;
+
+		q->shadow[i] = q->buf + at;
+		q->staged[i] = (void *)staged + at;
+		q->hd[i].low_addr = cpu_to_le32(lower_32_bits(sdma));
+		q->hd[i].dw0 = cpu_to_le32(FIELD_PREP(DE_RCQ_HD_LEN, q->blk[i].len) |
+					   FIELD_PREP(DE_RCQ_HD_HADDR,
+						      upper_32_bits(sdma)));
+		q->hd[i].reg_offset = cpu_to_le32(q->blk[i].off);
+		at = ALIGN(at + q->blk[i].len, DE_RCQ_ALIGN);
+	}
+	if (WARN_ON(at > PAGE_SIZE))
+		return -EINVAL;
+
+	de->queue = q;
+
+	return 0;
+}
+
+/* Write the status back: its set RCQ_FINISH (write-1-to-clear) goes. */
+static void sun60i_de_queue_clear_finish(struct sun60i_de *de)
+{
+	void __iomem *reg = sun60i_de_map(de, DE_MIXER0_TOP + MIXER_GLOBAL_STS);
+
+	writel(readl(reg), reg);
+}
+
+/*
+ * Arm the queue for this enable: shadows and CPU copies start as the
+ * registers are -- called after the control plane is up and the windows are
+ * open -- nothing is dirty, and the head array is pointed at. An armed queue
+ * copies nothing until it is asked (measured on the board).
+ */
+static void sun60i_de_queue_start(struct sun60i_de *de)
+{
+	struct sun60i_de_queue *q = de->queue;
+	unsigned int i, w;
+
+	for (i = 0; i < DE_RCQ_BLOCKS; i++) {
+		for (w = 0; w < q->blk[i].len / sizeof(u32); w++)
+			q->shadow[i][w] = sun60i_de_read(de, q->blk[i].off +
+							 w * sizeof(u32));
+		memcpy(q->staged[i], q->shadow[i], q->blk[i].len);
+		q->hd[i].dirty = 0;
+	}
+	bitmap_zero(q->marked, DE_RCQ_BLOCKS);
+	q->fresh = false;
+	q->awaiting = false;
+	sun60i_de_queue_clear_finish(de);
+
+	/* writel() orders the head stores above before the engine sees them. */
+	sun60i_de_write(de, DE_MIXER0_TOP + MIXER_RCQ_HEAD_LADDR,
+			lower_32_bits(q->dma));
+	sun60i_de_write(de, DE_MIXER0_TOP + MIXER_RCQ_HEAD_HADDR,
+			upper_32_bits(q->dma));
+	sun60i_de_write(de, DE_MIXER0_TOP + MIXER_RCQ_HEAD_LEN,
+			DE_RCQ_BLOCKS * sizeof(*q->hd));
+}
+
+static int sun60i_de_queue_find(const struct sun60i_de_queue *q, u32 off)
+{
+	unsigned int i;
+
+	for (i = 0; i < DE_RCQ_BLOCKS; i++)
+		if (off >= q->blk[i].off && off - q->blk[i].off < q->blk[i].len)
+			return i;
+
+	return -ENOENT;
+}
+
+static void sun60i_de_queue_begin(struct sun60i_de *de)
+{
+}
+
+static void sun60i_de_queue_stage(struct sun60i_de *de, u32 off, u32 val)
+{
+	struct sun60i_de_queue *q = de->queue;
+	int i = sun60i_de_queue_find(q, off);
+
+	/*
+	 * Every offset this driver stages is in a block; one that is not is a
+	 * bug in the block list, delivered the old way and named.
+	 */
+	if (WARN_ONCE(i < 0, "rcq: 0x%06x is in no block\n", off)) {
+		sun60i_de_write(de, off, val);
+		return;
+	}
+
+	q->staged[i][(off - q->blk[i].off) / sizeof(u32)] = val;
+	__set_bit(i, q->marked);
+}
+
+static void __iomem *sun60i_de_queue_reg(struct sun60i_de *de, u32 reg)
+{
+	return sun60i_de_map(de, DE_MIXER0_TOP + reg);
+}
+
+static bool sun60i_de_queue_pending(struct sun60i_de *de)
+{
+	return readl(sun60i_de_queue_reg(de, MIXER_RCQ_CTL)) &
+	       MIXER_RCQ_CTL_UPDATE;
+}
+
+/* RCQ_CTL read-modify-write: the other bits are the vendor's DFS/fifo fields. */
+static void sun60i_de_queue_ctl(struct sun60i_de *de, bool update)
+{
+	void __iomem *reg = sun60i_de_queue_reg(de, MIXER_RCQ_CTL);
+	u32 val = readl(reg) & ~MIXER_RCQ_CTL_UPDATE;
+
+	writel(val | (update ? MIXER_RCQ_CTL_UPDATE : 0), reg);
+}
+
+static void sun60i_de_queue_store_block(struct sun60i_de *de, unsigned int i)
+{
+	struct sun60i_de_queue *q = de->queue;
+	unsigned int w;
+
+	for (w = q->blk[i].len / sizeof(u32); w-- > 0; )
+		sun60i_de_write(de, q->blk[i].off + w * sizeof(u32),
+				q->shadow[i][w]);
+	q->hd[i].dirty = 0;
+}
+
+/*
+ * The engine is not scanning, so nothing is on its way to a pixel and a CPU
+ * store cannot tear. The shadows follow, so they stay what the registers hold.
+ *
+ * Blocks last to first and words last to first: every enable word this driver
+ * writes is the first word of its block, and its block comes after the ones
+ * it enables -- layer ATTCTL after its address and pitch, CCSC_CTL after its
+ * matrix, the blender's PIPE_CTL after both layers -- so each enable lands
+ * last, as the stage order had it (sun60i_de_ccsc_one(), sun60i_de_layer()).
+ */
+static void sun60i_de_queue_store(struct sun60i_de *de)
+{
+	struct sun60i_de_queue *q = de->queue;
+	int i;
+
+	for (i = DE_RCQ_BLOCKS - 1; i >= 0; i--) {
+		if (!test_bit(i, q->marked))
+			continue;
+		memcpy(q->shadow[i], q->staged[i], q->blk[i].len);
+		sun60i_de_queue_store_block(de, i);
+	}
+	bitmap_zero(q->marked, DE_RCQ_BLOCKS);
+	q->direct++;
+}
+
+/*
+ * A request that did not complete: withdrawn, and what it carried written by
+ * CPU store. Reached only when the TCON stopped under a request, or when the
+ * queue does not behave as measured -- both worth a line in the log.
+ */
+static void sun60i_de_queue_withdraw(struct sun60i_de *de)
+{
+	struct sun60i_de_queue *q = de->queue;
+	int i;
+
+	sun60i_de_queue_ctl(de, false);
+	q->awaiting = false;
+	for (i = DE_RCQ_BLOCKS - 1; i >= 0; i--)
+		if (le32_to_cpu(q->hd[i].dirty) & DE_RCQ_HD_DIRTY)
+			sun60i_de_queue_store_block(de, i);
+	q->stale++;
+	dev_warn_ratelimited(de->dev,
+			     "rcq: request %lu not taken in %u frames (GLB_STS 0x%08x), written by CPU store\n",
+			     q->gen, DE_RCQ_STALE_FRAMES,
+			     readl(sun60i_de_queue_reg(de, MIXER_GLOBAL_STS)));
+}
+
+static u32 sun60i_de_frames_us(const struct sun60i_de *de, u32 frames)
+{
+	return sun60i_de_lines_us(de, frames * de->mode.vtotal);
+}
+
+static void sun60i_de_queue_check_stale(struct sun60i_de *de)
+{
+	struct sun60i_de_queue *q = de->queue;
+
+	if (!sun60i_de_queue_pending(de))
+		return;
+	if (ktime_us_delta(ktime_get(), q->requested) <
+	    sun60i_de_frames_us(de, DE_RCQ_STALE_FRAMES))
+		return;
+
+	sun60i_de_queue_withdraw(de);
+}
+
+/* The write window: an active line past the engine's first. */
+static bool sun60i_de_queue_open(u32 sts)
+{
+	return (sts & MIXER_GLOBAL_STS_BUSY) &&
+	       FIELD_GET(MIXER_GLOBAL_STS_LINE, sts) >= DE_RCQ_FIRST_LINE;
+}
+
+/*
+ * Wait for the write window on a scanning engine. A scanning engine reaches
+ * an active line within one vertical blank, vtotal - vdisplay lines (35 for
+ * the 1235-line mode; busy was read clear at TCON lines 1232/1233 and set at
+ * 399..793), so twice that without one means it is not scanning.
+ *
+ * The window alone is not enough: after a display off, a request that never
+ * completed left GLB_STS reading 0x02420110 -- busy set, line 578 -- when it
+ * was read 3 frames later (6 GiB board, 2026-09-30).
+ * A stopped TCON
+ * leaving the engine frozen mid-frame is what that reads as (inferred). So
+ * the status word must also move within DE_RCQ_MOVE_LINES lines, as the line
+ * field does once per line on a scanning engine.
+ */
+static bool sun60i_de_queue_wait_busy(struct sun60i_de *de)
+{
+	void __iomem *reg = sun60i_de_queue_reg(de, MIXER_GLOBAL_STS);
+	u32 blank = de->mode.vtotal - de->mode.vdisplay;
+	u32 sts, s0;
+
+	if (readx_poll_timeout_atomic(readl, reg, sts, sun60i_de_queue_open(sts),
+				      DE_RCQ_POLL_US,
+				      sun60i_de_lines_us(de, 2 * blank)))
+		return false;
+
+	s0 = sts;
+	return !readx_poll_timeout_atomic(readl, reg, sts, sts != s0,
+					  DE_RCQ_POLL_US,
+					  sun60i_de_lines_us(de, DE_RCQ_MOVE_LINES));
+}
+
+/*
+ * Bit 0 has cleared, but the last request's FINISH has not been seen: the copy
+ * may still be running (FINISH came up to one poll, ~2 us, after bit 0 in the
+ * probe runs). Wait for it, at most DE_RCQ_MOVE_LINES lines; a FINISH that
+ * does not come by then (another writer of GLB_STS, the test-only probe) is
+ * counted, and the copy is taken as over.
+ */
+static void sun60i_de_queue_await_finish(struct sun60i_de *de)
+{
+	struct sun60i_de_queue *q = de->queue;
+	u32 sts;
+
+	if (readx_poll_timeout_atomic(readl,
+			sun60i_de_queue_reg(de, MIXER_GLOBAL_STS), sts,
+			sts & MIXER_GLOBAL_STS_RCQ_FINISH, DE_RCQ_POLL_US,
+			sun60i_de_lines_us(de, DE_RCQ_MOVE_LINES)))
+		q->nofinish++;
+	q->awaiting = false;
+}
+
+/* A new request: FINISH cleared first, so a set FINISH is this request's. */
+static void sun60i_de_queue_request(struct sun60i_de *de)
+{
+	struct sun60i_de_queue *q = de->queue;
+
+	sun60i_de_queue_clear_finish(de);
+	sun60i_de_queue_ctl(de, true);
+	WRITE_ONCE(q->gen, q->gen + 1);
+	q->requested = ktime_get();
+	q->awaiting = true;
+}
+
+/*
+ * Shadows, dirty words and the request, inside one busy window with
+ * interrupts off -- a few microseconds, while every copy seen landed at the
+ * first active line. A request still pending takes the new values along. If it
+ * completed while they were written (RCQ_CTL bit 0 clear on the re-read), the
+ * copy may have missed them, so the request is made again; a copy is
+ * idempotent. The second GLB_STS read checks the window held; `late` counts
+ * when it did not.
+ */
+static bool sun60i_de_queue_deliver(struct sun60i_de *de)
+{
+	struct sun60i_de_queue *q = de->queue;
+	void __iomem *sts_reg = sun60i_de_queue_reg(de, MIXER_GLOBAL_STS);
+	unsigned long flags;
+	unsigned int i;
+	bool pending;
+	u32 s0, s1;
+
+	local_irq_save(flags);
+	pending = sun60i_de_queue_pending(de);
+	if (!pending && q->awaiting)
+		sun60i_de_queue_await_finish(de);
+	s0 = readl(sts_reg);
+	if (!sun60i_de_queue_open(s0)) {
+		local_irq_restore(flags);
+		return false;
+	}
+
+	for (i = 0; i < DE_RCQ_BLOCKS; i++) {
+		if (test_bit(i, q->marked)) {
+			memcpy(q->shadow[i], q->staged[i], q->blk[i].len);
+			q->hd[i].dirty = cpu_to_le32(DE_RCQ_HD_DIRTY);
+		} else if (!pending) {
+			q->hd[i].dirty = 0;
+		}
+	}
+
+	/* The MMIO accesses below order the shadow and head stores first. */
+	if (pending && sun60i_de_queue_pending(de))
+		q->coalesced++;
+	else
+		sun60i_de_queue_request(de);
+	s1 = readl(sts_reg);
+	local_irq_restore(flags);
+
+	if (!sun60i_de_queue_open(s1) ||
+	    FIELD_GET(MIXER_GLOBAL_STS_LINE, s1) < FIELD_GET(MIXER_GLOBAL_STS_LINE, s0))
+		q->late++;
+
+	bitmap_zero(q->marked, DE_RCQ_BLOCKS);
+	q->fresh = true;
+
+	return true;
+}
+
+static int sun60i_de_queue_arm(struct sun60i_de *de)
+{
+	struct sun60i_de_queue *q = de->queue;
+	unsigned int tries;
+
+	if (bitmap_empty(q->marked, DE_RCQ_BLOCKS))
+		return 0;
+
+	sun60i_de_queue_check_stale(de);
+
+	for (tries = 0; tries < DE_RCQ_WINDOW_TRIES; tries++) {
+		if (!sun60i_de_queue_wait_busy(de))
+			break;
+		if (sun60i_de_queue_deliver(de))
+			return 0;
+	}
+
+	if (tries == DE_RCQ_WINDOW_TRIES)
+		dev_warn_ratelimited(de->dev,
+				     "rcq: no busy window in %u tries, CPU store\n",
+				     tries);
+
+	sun60i_de_queue_store(de);
+
+	return 0;
+}
+
+static const struct sun60i_de_commit sun60i_de_commit_queue = {
+	.name	= "register command queue",
+	.begin	= sun60i_de_queue_begin,
+	.stage	= sun60i_de_queue_stage,
+	.arm	= sun60i_de_queue_arm,
+};
+
+static bool sun60i_de_queue_done(struct sun60i_de *de, unsigned long gen)
+{
+	return READ_ONCE(de->queue->gen) != gen ||
+	       readl(sun60i_de_queue_reg(de, MIXER_GLOBAL_STS)) &
+	       MIXER_GLOBAL_STS_RCQ_FINISH;
+}
+
+/*
+ * Sleep until request @gen is complete; the caller decides whether it holds
+ * de->lock. -ETIMEDOUT after DE_RCQ_STALE_FRAMES; the caller withdraws.
+ */
+static int sun60i_de_queue_wait(struct sun60i_de *de, unsigned long gen)
+{
+	bool done;
+
+	return read_poll_timeout(sun60i_de_queue_done, done, done,
+				 DE_RCQ_SLEEP_US,
+				 sun60i_de_frames_us(de, DE_RCQ_STALE_FRAMES),
+				 false, de, gen);
+}
+
+/*
+ * With de->lock held: if anything went out through the queue since the last
+ * settle, wait until the engine has taken it. For the paths that are about
+ * to free a buffer the engine may still fetch -- a cursor that changes
+ * buffer or goes off, the layer going off, a stop -- and for start, whose
+ * read-back must see the copied values.
+ */
+static void sun60i_de_settle(struct sun60i_de *de)
+{
+	struct sun60i_de_queue *q = de->queue;
+
+	lockdep_assert_held(&de->lock);
+
+	if (de->commit != &sun60i_de_commit_queue || !q->fresh)
+		return;
+
+	q->fresh = false;
+	if (sun60i_de_queue_wait(de, q->gen)) {
+		q->timeouts++;
+		sun60i_de_queue_withdraw(de);
+	}
+}
