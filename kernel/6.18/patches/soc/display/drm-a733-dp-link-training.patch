+/*
+ * ---------------------------------------------------------------------------
+ * Link training
+ * ---------------------------------------------------------------------------
+ *
+ * The DRM core has no link-training state machine -- it has predicates, adjust
+ * decoders and the two inter-round delays, and every DisplayPort driver in the
+ * tree writes its own loop around them. So this loop calls
+ * drm_dp_clock_recovery_ok(), drm_dp_channel_eq_ok(),
+ * drm_dp_get_adjust_request_voltage/pre_emphasis(),
+ * drm_dp_dpcd_read_link_status() and the two *_delay() helpers, and open-codes
+ * none of them. Its shape follows zynqmp_dp_link_train() and the fallback
+ * ladder follows hibmc_dp_link_training(), the two cleanest of the fourteen.
+ *
+ * ⚠ There IS a drm_dp_link_train() in this tree -- drivers/gpu/drm/tegra/dp.c
+ * -- and it is Tegra-private with no EXPORT_SYMBOL. It is not callable from
+ * here and it does not implement the five-tries rule.
+ */
+
+/* The DisplayPort core's own link registers, UM 15.4.7.1 to 15.4.7.6.
+ *
+ * ⚠ The DP_ prefix is already taken. <drm/display/drm_dp.h> defines
+ * DP_LINK_BW_SET, DP_LANE_COUNT_SET and DP_TRAINING_PATTERN_SET as the DPCD
+ * ADDRESSES 0x100/0x101/0x102, and this driver writes both ends of exactly
+ * those three. Same names, different address space, one compiler error if they
+ * collide and a much worse bug if they merely shadow -- hence DP_TX_.
+ */
+#define DP_TX_LINK_BW_SET		0x0000		/* 15.4.7.1 */
+#define DP_TX_LANE_COUNT_SET		0x0004		/* 15.4.7.2 */
+#define DP_TX_ENHANCED_FRAME_EN		0x0008		/* 15.4.7.3, read-only */
+#define DP_TX_TRAINING_PATTERN_SET	0x000c		/* 15.4.7.4 */
+#define  TX_TRAINING_PATTERN		GENMASK(2, 0)
+#define DP_TX_SCRAMBLING_DISABLE	0x0014		/* 15.4.7.6 */
+#define  TX_SCRAMBLING_DISABLE		BIT(0)
+#define DP_TX_LANE_REMAP_CONTROL	0x002c		/* 15.4.7.11 */
+#define DP_TX_PHY_STATUS		0x0280		/* 15.4.7.38, read-only */
+
+/*
+ * DPCD 0x210.., the DPRX symbol-error counters. mainline names only the LTTPR
+ * copy (DP_SYMBOL_ERROR_COUNT_LANE0_PHY_REPEATER1, 0xf0035) and has no define
+ * for the DPRX pair, so it is spelled out here: two bytes per lane, little
+ * endian, bit 15 = the count is valid.
+ */
+#define SUN60I_DP_SYMBOL_ERROR_COUNT_LANE0	0x210
+#define SUN60I_DP_SYMBOL_ERROR_VALID		BIT(15)
+#define SUN60I_DP_SYMBOL_ERROR_MASK		GENMASK(14, 0)
+
+/* DP 1.4 Table 3-1: four levels each, and their sum may not exceed 3. */
+#define SUN60I_DP_LEVEL_MAX		3
+
+/*
+ * DP 1.4 section 3.5.1.2.2: the clock-recovery sequence "shall not exceed 10
+ * iterations", and the source shall give up if the sink asks for the SAME
+ * voltage swing five times in a row. The vendor makes ONE attempt at maximum
+ * swing and then declares failure, which is why lanes that would have
+ * recovered did not.
+ */
+#define SUN60I_DP_CR_MAX_ROUNDS		10
+#define SUN60I_DP_CR_MAX_SAME_VOLTAGE	5
+
+/* DP 1.4 section 3.5.1.2.3: the channel-equalisation sequence shall not exceed
+ * 5 iterations.
+ */
+#define SUN60I_DP_EQ_MAX_ROUNDS		5
+
+/* The link soft reset is not documented with a settle time; the by-hand
+ * sequence that trained this board waited 100 ms after it and 100 ms after each
+ * training-pattern write before touching the sink. Kept, because that is the
+ * timing the silicon result was obtained with -- shortening it is a change to
+ * test on a board, not a cleanup to make blind.
+ */
+#define SUN60I_DP_TRAIN_SETTLE_MS	100
+
+/* One training attempt's per-lane drive state. */
+struct sun60i_dp_levels {
+	u8	voltage[SUN60I_DP_MAX_LANES];
+	u8	pre[SUN60I_DP_MAX_LANES];
+};
+
+/*
+ * Both ends of the training pattern, source first.
+ *
+ * ⚠ The two encodings agree for patterns 0 to 3 and DIVERGE at TPS4: the core's
+ * TRAINING_PATTERN_SET[2:0] takes 4 (UM 15.4.7.4, "100 = Training pattern 4")
+ * while DPCD 0x102 takes 7 (DP_TRAINING_PATTERN_4). Nothing here selects TPS4 --
+ * this is 8b/10b at HBR -- but a driver that grows 128b/132b must not assume the
+ * two fields are the same field.
+ */
+static int sun60i_dp_train_pattern(struct sun60i_dp *dp, u8 tps)
+{
+	u8 dpcd = tps;
+
+	writel(FIELD_PREP(TX_TRAINING_PATTERN, tps),
+	       dp->base + DP_TX_TRAINING_PATTERN_SET);
+	msleep(SUN60I_DP_TRAIN_SETTLE_MS);
+
+	/* The sink must not descramble while an unscrambled pattern is on the
+	 * wire; TPS1..3 are unscrambled (UM 15.4.7.6 says the same about the
+	 * source-side bit).
+	 */
+	if (tps != DP_TRAINING_PATTERN_DISABLE)
+		dpcd |= DP_LINK_SCRAMBLING_DISABLE;
+
+	return drm_dp_dpcd_write_byte(&dp->aux, DP_TRAINING_PATTERN_SET, dpcd);
+}
+
+/*
+ * Put the requested swing and pre-emphasis on BOTH ends.
+ *
+ * The PHY goes first and the sink second, which is the order the by-hand
+ * sequence used on the run that trained four lanes. What matters more than the
+ * order is that they are the same values: if the source drives one level and
+ * DPCD 0x103 claims another, the sink evaluates its own measurement against the
+ * wrong assumption and its next adjust request is meaningless. The vendor has a
+ * function for this (edp_lane_training_para_reset) and calls it only once, at
+ * the start.
+ */
+static int sun60i_dp_train_levels(struct sun60i_dp *dp,
+				  const struct sun60i_dp_levels *lv)
+{
+	u8 buf[SUN60I_DP_MAX_LANES];
+	union phy_configure_opts opts;
+	unsigned int i;
+	int ret;
+
+	opts = (union phy_configure_opts){
+		.dp = {
+			.lanes	      = dp->link_lanes,
+			.set_voltages = 1,
+		},
+	};
+
+	for (i = 0; i < dp->link_lanes; i++) {
+		opts.dp.voltage[i] = lv->voltage[i];
+		opts.dp.pre[i] = lv->pre[i];
+
+		buf[i] = lv->voltage[i] |
+			 (lv->pre[i] << DP_TRAIN_PRE_EMPHASIS_SHIFT);
+		if (lv->voltage[i] == SUN60I_DP_LEVEL_MAX)
+			buf[i] |= DP_TRAIN_MAX_SWING_REACHED;
+		if (lv->pre[i] == SUN60I_DP_LEVEL_MAX)
+			buf[i] |= DP_TRAIN_MAX_PRE_EMPHASIS_REACHED;
+	}
+
+	ret = phy_configure(dp->link_phy, &opts);
+	if (ret) {
+		/* Checked, not discarded -- and named, because until the PHY
+		 * implements set_voltages this is the failure the whole loop
+		 * dies of and a silent one would look like a bad cable.
+		 */
+		dev_err(dp->dev,
+			"PHY refused the drive levels for %u lanes: %d\n",
+			dp->link_lanes, ret);
+		return ret;
+	}
+
+	return drm_dp_dpcd_write_data(&dp->aux, DP_TRAINING_LANE0_SET, buf,
+				      dp->link_lanes);
+}
+
+/*
+ * Take what each lane asked for. DPCD 0x206 carries lanes 0 and 1 and 0x207
+ * lanes 2 and 3, and on this board they differ -- folding them into one value
+ * leaves lanes short, which an earlier attempt here did.
+ *
+ * Returns true when anything moved. That is what the five-tries rule counts:
+ * DP 1.4 bounds retries at an UNCHANGED request, not iterations in general.
+ */
+static bool sun60i_dp_train_adjust(struct sun60i_dp *dp,
+				   struct sun60i_dp_levels *lv,
+				   const u8 link_status[DP_LINK_STATUS_SIZE])
+{
+	bool changed = false;
+	unsigned int i;
+
+	for (i = 0; i < dp->link_lanes; i++) {
+		u8 v = drm_dp_get_adjust_request_voltage(link_status, i) >>
+		       DP_TRAIN_VOLTAGE_SWING_SHIFT;
+		u8 p = drm_dp_get_adjust_request_pre_emphasis(link_status, i) >>
+		       DP_TRAIN_PRE_EMPHASIS_SHIFT;
+
+		/* Bounded here as well as in the PHY. A sink can encode a
+		 * combination DP 1.4 Table 3-1 forbids -- two 2-bit fields, no
+		 * hardware interlock -- and the vendor puts that pair straight
+		 * into dp_lv_table[sw][pre] with no check at all.
+		 */
+		v = min_t(u8, v, SUN60I_DP_LEVEL_MAX);
+		p = min_t(u8, p, SUN60I_DP_LEVEL_MAX - v);
+
+		if (v != lv->voltage[i] || p != lv->pre[i])
+			changed = true;
+
+		lv->voltage[i] = v;
+		lv->pre[i] = p;
+	}
+
+	return changed;
+}
+
+/* Every active lane is already at the top of the swing range. One more round
+ * would ask for what is already being driven.
+ */
+static bool sun60i_dp_train_at_max_swing(struct sun60i_dp *dp,
+					 const struct sun60i_dp_levels *lv)
+{
+	unsigned int i;
+
+	for (i = 0; i < dp->link_lanes; i++)
+		if (lv->voltage[i] != SUN60I_DP_LEVEL_MAX)
+			return false;
+
+	return true;
+}
+
+/*
+ * Clock recovery, DP 1.4 section 3.5.1.2.2.
+ *
+ * Three exits the vendor does not have: the round bound, the five-attempts-at-
+ * one-level bound, and maximum swing. And one it has but throws away -- the
+ * link-status read. edp_get_link_status()'s return value is discarded at both
+ * of its call sites over a buffer that was zeroed first, so a dead AUX channel
+ * is indistinguishable there from "CR not done" and the driver keeps escalating
+ * the drive level against a sink that is not answering.
+ */
+static int sun60i_dp_train_cr(struct sun60i_dp *dp,
+			      struct sun60i_dp_levels *lv)
+{
+	unsigned int same_voltage = 0;
+	unsigned int round;
+	int ret;
+
+	/* The caller has already put both ends at *lv and taken the link soft
+	 * reset; this starts at the pattern.
+	 */
+	ret = sun60i_dp_train_pattern(dp, DP_TRAINING_PATTERN_1);
+	if (ret)
+		return ret;
+
+	for (round = 1; round <= SUN60I_DP_CR_MAX_ROUNDS; round++) {
+		u8 link_status[DP_LINK_STATUS_SIZE];
+
+		drm_dp_link_train_clock_recovery_delay(&dp->aux, dp->dpcd);
+
+		ret = drm_dp_dpcd_read_link_status(&dp->aux, link_status);
+		if (ret) {
+			dev_err(dp->dev,
+				"CR round %u: link status unreadable: %d\n",
+				round, ret);
+			return ret;
+		}
+
+		if (drm_dp_clock_recovery_ok(link_status, dp->link_lanes)) {
+			dp->train_cr_rounds = round;
+			return 0;
+		}
+
+		if (sun60i_dp_train_at_max_swing(dp, lv)) {
+			dev_dbg(dp->dev,
+				"CR round %u: every lane at maximum swing and still no lock\n",
+				round);
+			return -EIO;
+		}
+
+		if (!sun60i_dp_train_adjust(dp, lv, link_status)) {
+			if (++same_voltage >= SUN60I_DP_CR_MAX_SAME_VOLTAGE) {
+				dev_dbg(dp->dev,
+					"CR round %u: %u attempts at an unchanged drive level\n",
+					round, same_voltage);
+				return -EIO;
+			}
+		} else {
+			same_voltage = 0;
+		}
+
+		ret = sun60i_dp_train_levels(dp, lv);
+		if (ret)
+			return ret;
+	}
+
+	dev_dbg(dp->dev, "CR gave up after %u rounds\n",
+		SUN60I_DP_CR_MAX_ROUNDS);
+
+	return -EIO;
+}
+
+/*
+ * Channel equalisation, DP 1.4 section 3.5.1.2.3.
+ *
+ * TPS3 when the sink offers it, TPS2 otherwise -- asked of the sink through
+ * drm_dp_tps3_supported() rather than hardcoded, although on the bench sink
+ * DPCD 0x0002 bit 6 is clear and it is always TPS2 here.
+ *
+ * ⚠ CR_DONE is re-read every round. The specification requires it and the
+ * vendor omits it: equalisation can knock a lane out of clock recovery, and a
+ * loop that only looks at the EQ bits keeps equalising a lane that has lost its
+ * clock, then reports failure with no idea which of the two happened.
+ *
+ * The two failures return DIFFERENT errno, because the fallback ladder has to
+ * tell them apart: -ENOLINK when clock recovery was lost (a clock problem, so
+ * drop the rate) and -EPROTO when the rounds ran out with CR intact (an
+ * inter-lane problem, which fewer lanes can fix and a lower rate need not).
+ */
+static int sun60i_dp_train_eq(struct sun60i_dp *dp,
+			      struct sun60i_dp_levels *lv)
+{
+	unsigned int round;
+	u8 tps;
+	int ret;
+
+	tps = drm_dp_tps3_supported(dp->dpcd) ? DP_TRAINING_PATTERN_3
+					      : DP_TRAINING_PATTERN_2;
+
+	ret = sun60i_dp_train_pattern(dp, tps);
+	if (ret)
+		return ret;
+
+	for (round = 1; round <= SUN60I_DP_EQ_MAX_ROUNDS; round++) {
+		u8 link_status[DP_LINK_STATUS_SIZE];
+
+		drm_dp_link_train_channel_eq_delay(&dp->aux, dp->dpcd);
+
+		ret = drm_dp_dpcd_read_link_status(&dp->aux, link_status);
+		if (ret) {
+			dev_err(dp->dev,
+				"EQ round %u: link status unreadable: %d\n",
+				round, ret);
+			return ret;
+		}
+
+		if (!drm_dp_clock_recovery_ok(link_status, dp->link_lanes)) {
+			dev_dbg(dp->dev,
+				"EQ round %u: clock recovery was LOST during equalisation\n",
+				round);
+			return -ENOLINK;
+		}
+
+		if (drm_dp_channel_eq_ok(link_status, dp->link_lanes)) {
+			dp->train_eq_rounds = round;
+			return 0;
+		}
+
+		sun60i_dp_train_adjust(dp, lv, link_status);
+		ret = sun60i_dp_train_levels(dp, lv);
+		if (ret)
+			return ret;
+	}
+
+	dev_dbg(dp->dev, "EQ gave up after %u rounds with clock recovery intact\n",
+		SUN60I_DP_EQ_MAX_ROUNDS);
+
+	return -EPROTO;
+}
+
+/* Stop training on both ends and put the scrambler back. Runs on the way out of
+ * a successful attempt AND of a failed one: a sink left in TPS2 with the source
+ * no longer sending it is a state nothing recovers from except another full
+ * training round.
+ */
+static int sun60i_dp_train_stop(struct sun60i_dp *dp)
+{
+	int ret;
+
+	ret = sun60i_dp_train_pattern(dp, DP_TRAINING_PATTERN_DISABLE);
+	writel(0, dp->base + DP_TX_SCRAMBLING_DISABLE);
+
+	return ret;
+}
+
+/*
+ * WHAT THE SINK CONFIRMS, ASKED AFTER THE TRAINING PATTERN IS GONE.
+ *
+ * The check whose absence blocked this patch the first time. On 2026-08-19,
+ * in a test boot, `echo 0 > train` returned 0 and this driver reported
+ * "trained at 2700 Mb/s over 4 lanes" while the sink's own bytes read DPCD
+ * 0x202-0x207 = 00 00 80 00 00 00: no clock recovery, no equalisation, no
+ * interlane alignment, and every symbol-error counter saturated. CR and EQ had
+ * been judged from link status taken DURING training and never asked again once
+ * the pattern was cleared and the scrambler enabled.
+ *
+ * That is a vendor defect this tree must not port, in a
+ * worse form: the vendor discards edp_get_link_status()'s return value, this
+ * discarded the question. A driver's own `trained` flag is not evidence about a
+ * link; only the sink's bytes are.
+ *
+ * Both predicates are the DRM core's and neither is open-coded:
+ * drm_dp_clock_recovery_ok() is DP_LANE_CR_DONE on every active lane, and
+ * drm_dp_channel_eq_ok() is DP_INTERLANE_ALIGN_DONE plus CHANNEL_EQ_DONE and
+ * SYMBOL_LOCKED on every active lane. Together they are the shell instrument's
+ * LANE0_1=0x77 LANE2_3=0x77 ALIGN=0x01 bar expressed in the core's own terms
+ * (the shell script, final check).
+ *
+ * ONE READ, NO RETRY. Looking again after a failed first look would convert
+ * "this link does not hold once training stops" into "it held the second time",
+ * which is the question being asked, not noise to average away.
+ *
+ * ⚠ THE FOURTH NUMBER OF THAT BAR, SINK=0x01, IS DELIBERATELY NOT REQUIRED
+ * HERE, and this is the one place this file departs from the shell instrument.
+ * DPCD 0x205 RECEIVE_PORT_0_STATUS describes the sink's synchronisation to a
+ * received STREAM, not the outcome of link training. Mainline polls it for 1
+ * only after the video stream starts and back to 0 after it stops --
+ * edp_receiver_ready_T7() and _T9(), the eDP stream-on / stream-off timings
+ * (drivers/gpu/drm/amd/display/dc/link/protocols/link_edp_panel_control.c:480
+ * and :455) -- and no DisplayPort driver in this tree gates training on it (the
+ * only other readers of DPCD 0x205 take the DP 2.0 INTRA_HOP bit:
+ * drivers/gpu/drm/i915/display/intel_dp_link_training.c:1109,
+ * .../link/protocols/link_dp_training.c:1037). The shell instrument reads
+ * SINK=0x01 after it has enabled 0x0800/0x0804, not here.
+ *
+ * Requiring it unconditionally at the end of training would therefore fail every
+ * link trained without a modeset behind it, which is every FIRST training this
+ * debugfs verb does. So it is required exactly where it is defined and nowhere
+ * else, which is two places:
+ *
+ *   - here, WHEN A STREAM IS ALREADY RUNNING (dp->video_on) -- the re-training
+ *     case, which is what a KMS driver will do on an IRQ_HPD link-status change,
+ *     and the one case where the bit is meaningful at this point;
+ *   - and in sun60i_dp_video_stream_enable(), once the stream has been started,
+ *     where all four numbers of the instrument's bar are meaningful at once.
+ */
+static int sun60i_dp_train_verify(struct sun60i_dp *dp)
+{
+	u8 link_status[DP_LINK_STATUS_SIZE];
+	int ret;
+
+	/* The same settle the by-hand sequence allows after every write to the
+	 * training-pattern register. Not a retry window: the read below happens
+	 * once.
+	 */
+	msleep(SUN60I_DP_TRAIN_SETTLE_MS);
+
+	ret = drm_dp_dpcd_read_link_status(&dp->aux, link_status);
+	if (ret) {
+		dev_err(dp->dev,
+			"the loop finished but the sink cannot be asked to confirm the link: %d\n",
+			ret);
+		return ret;
+	}
+
+	if (!drm_dp_clock_recovery_ok(link_status, dp->link_lanes)) {
+		dev_err(dp->dev,
+			"the sink does not confirm clock recovery once the training pattern is cleared (DPCD 0x202-0x207 %*ph)\n",
+			DP_LINK_STATUS_SIZE, link_status);
+		return -ENOLINK;
+	}
+
+	if (!drm_dp_channel_eq_ok(link_status, dp->link_lanes)) {
+		dev_err(dp->dev,
+			"the sink does not confirm equalisation, symbol lock and interlane alignment once the training pattern is cleared (DPCD 0x202-0x207 %*ph)\n",
+			DP_LINK_STATUS_SIZE, link_status);
+		return -EPROTO;
+	}
+
+	if (!dp->video_on) {
+		dev_dbg(dp->dev,
+			"link confirmed by the sink; DPCD 0x205 RECEIVE_PORT_0_STATUS is not asked for -- there is no stream yet for the sink to be in sync with\n");
+		return 0;
+	}
+
+	/* A re-training underneath a running stream. Here the fourth number of
+	 * the bar IS defined, so it is required.
+	 */
+	if (!(link_status[DP_SINK_STATUS - DP_LANE0_1_STATUS] &
+	      DP_RECEIVE_PORT_0_STATUS)) {
+		dev_err(dp->dev,
+			"the sink no longer reports itself in sync with the running stream after re-training (DPCD 0x202-0x207 %*ph)\n",
+			DP_LINK_STATUS_SIZE, link_status);
+		return -ENOLINK;
+	}
+
+	return 0;
+}
+
+/*
+ * Tell BOTH ends the same thing about the link they are about to train. The
+ * source's own registers and the sink's DPCD, in one place, because describing
+ * two different links to the two ends is the failure mode recorded earlier
+ * when only LINK_BW_SET moved.
+ */
+static int sun60i_dp_train_configure_ends(struct sun60i_dp *dp)
+{
+	u8 bw = drm_dp_link_rate_to_bw_code(SUN60I_DP_MBPS_TO_RATE(dp->link_rate));
+	u8 lane_count = dp->link_lanes;
+	int ret;
+
+	/* ENHANCED_FRAME_EN (0x0008) is READ-ONLY and reads 1: UM 15.4.7.3,
+	 * the field is hard-wired to 1. So the source is
+	 * in enhanced framing whatever the sink says, and the DPCD bit is not a
+	 * choice -- it is the source describing itself. A sink without
+	 * ENHANCED_FRAME_CAP cannot be framed correctly by this transmitter at
+	 * all, which is worth one line rather than a silent mismatch.
+	 */
+	if (!drm_dp_enhanced_frame_cap(dp->dpcd))
+		dev_warn(dp->dev,
+			 "sink does not advertise enhanced framing (DPCD 0x0002 = 0x%02x) but ENHANCED_FRAME_EN is read-only 1 (0x%08x); the link is framed enhanced regardless\n",
+			 dp->dpcd[DP_MAX_LANE_COUNT],
+			 readl(dp->base + DP_TX_ENHANCED_FRAME_EN));
+	lane_count |= DP_LANE_COUNT_ENHANCED_FRAME_EN;
+
+	writel(bw, dp->base + DP_TX_LINK_BW_SET);
+	writel(dp->link_lanes, dp->base + DP_TX_LANE_COUNT_SET);
+	writel(TX_SCRAMBLING_DISABLE, dp->base + DP_TX_SCRAMBLING_DISABLE);
+
+	ret = drm_dp_dpcd_write_byte(&dp->aux, DP_LINK_BW_SET, bw);
+	if (!ret)
+		ret = drm_dp_dpcd_write_byte(&dp->aux, DP_LANE_COUNT_SET,
+					     lane_count);
+	/* Two bytes the vendor never writes at all. DOWNSPREAD_CTRL is written
+	 * ZERO on purpose: this PHY has no SSC arm in its rate table and
+	 * refuses phy_configure() with ssc set, so telling the sink to expect a
+	 * spread clock would describe a source that does not exist.
+	 */
+	if (!ret)
+		ret = drm_dp_dpcd_write_byte(&dp->aux, DP_DOWNSPREAD_CTRL, 0);
+	if (!ret)
+		ret = drm_dp_dpcd_write_byte(&dp->aux,
+					     DP_MAIN_LINK_CHANNEL_CODING_SET,
+					     DP_SET_ANSI_8B10B);
+	if (ret)
+		dev_err(dp->dev, "sink refused the link configuration: %d\n",
+			ret);
+
+	return ret;
+}
+
+/*
+ * One attempt at one rate and one lane count: configure the PHY, tell both ends
+ * the same thing, then CR and EQ.
+ */
+static int sun60i_dp_train_once(struct sun60i_dp *dp, unsigned int rate_mbps,
+				unsigned int lanes)
+{
+	struct sun60i_dp_levels lv = { };
+	int ret;
+
+	/* The PHY first: LINK_BW_SET and DPCD 0x100 without the PMA behind them
+	 * is exactly the half-move that made every rate other than 2700 Mb/s
+	 * fail -- a rate change is a PHY teardown and rebuild on this part.
+	 */
+	ret = sun60i_dp_link_configure(dp, rate_mbps, lanes);
+	if (ret)
+		return ret;
+
+	ret = sun60i_dp_train_configure_ends(dp);
+	if (ret)
+		return ret;
+
+	/* Both ends at swing 0 / pre 0, BEFORE the link soft reset -- that is
+	 * the order the by-hand sequence used on the run that trained four
+	 * lanes, and the reset does not clear these anyway (it is the DP core's
+	 * link controller; the drive levels live in the SERDES PMA). Ordering
+	 * that has silicon behind it is not rearranged for tidiness.
+	 */
+	ret = sun60i_dp_train_levels(dp, &lv);
+	if (ret)
+		return ret;
+
+	/* After the bandwidth and lane writes, which it does not clear
+	 * (UM 15.4.7.15).
+	 */
+	writel(SOFT_RESET_LINK, dp->base + DP_SOFT_RESET);
+	msleep(SUN60I_DP_TRAIN_SETTLE_MS);
+
+	/* PHY_STATUS is read and printed and NOT gated on, and the reason is in
+	 * the UM: bits 31:0 are a live copy of PHY status signals,
+	 * and the field only defers to a note about whichever PHY is
+	 * actually used (15.4.7.38). There is no such
+	 * application note in this tree, so every bit here is undescribed and a
+	 * ready check built on one would be an invented predicate. The vendor
+	 * declares the register and never reads it; this at least records what
+	 * it says at the moment training starts.
+	 */
+	dev_dbg(dp->dev, "PHY_STATUS before TPS1: 0x%08x\n",
+		readl(dp->base + DP_TX_PHY_STATUS));
+
+	ret = sun60i_dp_train_cr(dp, &lv);
+	if (!ret)
+		ret = sun60i_dp_train_eq(dp, &lv);
+
+	if (sun60i_dp_train_stop(dp) && !ret)
+		ret = -EIO;
+
+	/* The loop's own verdict is not the verdict. Ask the sink again now that
+	 * the training pattern is cleared on both ends and the scrambler is back
+	 * on -- sun60i_dp_train_verify() is what makes "trained" mean something
+	 * the sink also believes.
+	 */
+	if (!ret)
+		ret = sun60i_dp_train_verify(dp);
+
+	return ret;
+}
+
+/*
+ * Train the main link, walking down the rate ladder and then the lane count.
+ *
+ * THE FALLBACK IS THE POINT. The vendor has none: one rate, one lane count, and
+ * a failure is a failure. DP 1.4 section 3.5.1.2.1 requires a source to reduce
+ * the link rate and then the lane count and try again, and this board is the
+ * argument for it -- the four-lane result exists because somebody walked that
+ * ladder by hand.
+ *
+ * Rate before lanes, which is hibmc's order and the one that keeps bandwidth:
+ * four lanes at a lower rate carry more than two lanes at the same rate. When
+ * CR succeeded and only EQ failed, lanes go first instead -- CR proving out
+ * means the clock is fine and the problem is inter-lane, which fewer lanes can
+ * fix and a lower rate need not.
+ *
+ * ⚠ WHAT THIS CANNOT DO TODAY, stated rather than implied: the PHY has exactly
+ * one PMA rate table, 2700 Mb/s. Every other rung is refused by phy_validate()
+ * and never entered, so the rate ladder is one rung long and only the LANE
+ * fallback can actually change anything. That is honest plumbing waiting for a
+ * second table, not working rate fallback.
+ */
+static int sun60i_dp_train(struct sun60i_dp *dp, unsigned int rate_mbps,
+			   unsigned int lanes)
+{
+	unsigned int rungs[ARRAY_SIZE(sun60i_dp_link_rates)];
+	unsigned int nrungs, rung;
+	int ret = -EINVAL;
+
+	if (!dp->enabled) {
+		dev_err(dp->dev, "the AUX channel is down\n");
+		return -ENODEV;
+	}
+
+	if (!dp->link_phy) {
+		dev_err(dp->dev,
+			"no main-link PHY: this node needs phys = <&combophy0> with phy-names \"dp\"\n");
+		return -ENODEV;
+	}
+
+	dp->trained = false;
+	dp->train_attempts = 0;
+	dp->train_cr_rounds = 0;
+	dp->train_eq_rounds = 0;
+
+	ret = sun60i_dp_link_probe(dp);
+	if (ret)
+		return ret;
+
+	if (!lanes)
+		lanes = drm_dp_max_lane_count(dp->dpcd);
+	lanes = min_t(unsigned int, lanes, SUN60I_DP_MAX_LANES);
+	if (!lanes) {
+		dev_err(dp->dev,
+			"sink reports 0 lanes (DPCD 0x0002 = 0x%02x); nothing to train\n",
+			dp->dpcd[DP_MAX_LANE_COUNT]);
+		return -EINVAL;
+	}
+
+	if (rate_mbps) {
+		nrungs = 1;
+		rungs[0] = rate_mbps;
+	} else {
+		nrungs = sun60i_dp_link_rate_ladder(dp, lanes, rungs);
+	}
+
+	for (; lanes; lanes >>= 1) {
+		for (rung = 0; rung < nrungs; rung++) {
+			dp->train_attempts++;
+
+			ret = sun60i_dp_train_once(dp, rungs[rung], lanes);
+			if (!ret) {
+				dev_info(dp->dev,
+					 "link trained: %u Mb/s over %u lanes, CR in %u round(s), EQ in %u\n",
+					 dp->link_rate, dp->link_lanes,
+					 dp->train_cr_rounds,
+					 dp->train_eq_rounds);
+				dp->trained = true;
+				return 0;
+			}
+
+			dev_warn(dp->dev,
+				 "training failed at %u Mb/s over %u lanes: %d\n",
+				 rungs[rung], lanes, ret);
+
+			/* Clock recovery proved out and only equalisation
+			 * failed: the clock is fine and the problem is
+			 * inter-lane, which fewer lanes can fix and a lower rate
+			 * need not. So skip the rest of the rate ladder and drop
+			 * the lane count instead -- hibmc_dp_link_training()
+			 * makes the same distinction
+			 * (drivers/gpu/drm/hisilicon/hibmc/dp/dp_link.c:310-338).
+			 */
+			if (ret == -EPROTO)
+				break;
+		}
+
+		if (lanes == 1)
+			break;
+
+		/* The rungs were validated for the lane count they were built
+		 * with; a PHY may allow a rate at two lanes that it refuses at
+		 * four, so the ladder is rebuilt rather than reused.
+		 */
+		if (!rate_mbps)
+			nrungs = sun60i_dp_link_rate_ladder(dp, lanes >> 1,
+							    rungs);
+	}
+
+	/* Nothing is left half-trained: sun60i_dp_train_once() always stops the
+	 * pattern on both ends, so the sink is not sitting in TPS2 waiting for
+	 * a source that has moved on. What the PHY keeps is whatever it last
+	 * accepted, and `link` reports it.
+	 */
+	return ret;
+}
