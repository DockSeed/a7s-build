  *      so the invariant holds today by neither half being touched. Recorded at
- *      sun60i_tcon_tv_kms_check(), because a mode list wider than one entry has
- *      to carry the factor through three places at once.
+ *      sun60i_tcon_tv_kms_check(), because a mode above TCON_PIXEL_CLK_MAX_KHZ
+ *      would have to carry the factor through three places at once.
  *
  * DIFFERENT ON PURPOSE -- where the vendor driver differs at exactly this
  * layer, and what is done here instead. Reproducing the vendor's
@@ -550,11 +550,18 @@ sun60i_kms_crtc_mode_valid(struct drm_crtc *crtc,
 	struct sun60i_kms *kms = crtc_to_kms(crtc);
 
 	/*
-	 * The TCON's register field widths, and only those. The display engine
-	 * is deliberately not consulted: its size fields are two 16-bit halves
-	 * and its pitch register is a full word, so every mode the TCON accepts
-	 * fits the engine by a wide margin. A second check that can never fire
-	 * would be a check nobody can test.
+	 * The TCON's register field widths, then its pixel clock. The display
+	 * engine is deliberately not consulted: its size fields are two 16-bit
+	 * halves and its pitch register is a full word, so every mode the TCON
+	 * accepts fits the engine by a wide margin. A second check that can
+	 * never fire would be a check nobody can test.
+	 *
+	 * The pixel clock is asked HERE and not in the DisplayPort bridge,
+	 * because the clock is TCON_TV1's: the transmitter measures it
+	 * (SRC0_MVID) but does not make it. The bridge used to refuse every
+	 * clock but 154 MHz, the one rate PLL_VIDEO1 had then been asked for,
+	 * and said the test belonged here once a CRTC existed; the clock
+	 * tree now answers per mode, through clk_round_rate().
 	 *
 	 * The link's own limit is applied where it belongs, by the DRM core,
 	 * out of the bridge's .mode_valid and the sink's EDID.
@@ -562,7 +569,33 @@ sun60i_kms_crtc_mode_valid(struct drm_crtc *crtc,
 	if (sun60i_tcon_tv_kms_check(kms->tcon, mode))
 		return MODE_BAD;
 
-	return MODE_OK;
+	return sun60i_tcon_tv_kms_clock_valid(kms->tcon, mode);
+}
+
+/*
+ * The adjusted mode carries the pixel clock the clock tree will make, not the
+ * one the sink listed; sun60i_tcon_tv_kms_clock_fixup() says why and how. The
+ * atomic helpers call this after every bridge's and encoder's check
+ * (drm_atomic_helper.c, mode_fixup()), so nothing downstream rewrites the
+ * clock again, and each block's .atomic_enable reads adjusted_mode --
+ * sun60i_de_kms_enable() and sun60i_tcon_tv_kms_enable() below,
+ * sun60i_dp_bridge_atomic_enable() in the transmitter.
+ */
+static bool sun60i_kms_crtc_mode_fixup(struct drm_crtc *crtc,
+				       const struct drm_display_mode *mode,
+				       struct drm_display_mode *adjusted_mode)
+{
+	struct sun60i_kms *kms = crtc_to_kms(crtc);
+	int ret;
+
+	ret = sun60i_tcon_tv_kms_clock_fixup(kms->tcon, adjusted_mode);
+	if (ret) {
+		drm_dbg_kms(crtc->dev, "[CRTC:%d:%s] no pixel clock for %d kHz: %d\n",
+			    crtc->base.id, crtc->name, mode->clock, ret);
+		return false;
+	}
+
+	return true;
 }
 
 static int sun60i_kms_crtc_atomic_check(struct drm_crtc *crtc,
@@ -775,6 +808,7 @@ static void sun60i_kms_crtc_atomic_flush(struct drm_crtc *crtc,
 
 static const struct drm_crtc_helper_funcs sun60i_kms_crtc_helper_funcs = {
 	.mode_valid	= sun60i_kms_crtc_mode_valid,
+	.mode_fixup	= sun60i_kms_crtc_mode_fixup,
 	.atomic_check	= sun60i_kms_crtc_atomic_check,
 	.atomic_flush	= sun60i_kms_crtc_atomic_flush,
 	.atomic_enable	= sun60i_kms_crtc_atomic_enable,
