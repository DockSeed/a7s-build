+/*
+ * Can the pixel clock serve this mode? The CRTC's .mode_valid, so the DRM core
+ * asks it for every mode a sink lists, before the mode reaches the connector's
+ * list, and again on every atomic check -- which is why a refusal is a debug
+ * line and not an error. The policy, the tolerance and the ceiling, with their
+ * sources, are at TCON_PIXEL_CLK_TOLERANCE_PER_MILLE.
+ *
+ * clk_round_rate() walks the same routines clk_set_rate() will and touches no
+ * register, so a mode this answers MODE_OK for is one the dividers were asked
+ * about, not one assumed to fit.
+ */
+enum drm_mode_status
+sun60i_tcon_tv_kms_clock_valid(struct sun60i_tcon_tv *tcon,
+			       const struct drm_display_mode *mode)
+{
+	unsigned long want, slack;
+	long got;
+
+	if (mode->clock <= 0)
+		return MODE_CLOCK_LOW;
+
+	if (mode->clock > TCON_PIXEL_CLK_MAX_KHZ) {
+		drm_dev_dbg(tcon->dev, DRM_UT_KMS,
+			    "%dx%d: pixel clock %d kHz is above the %d kHz this pipe has carried\n",
+			    mode->hdisplay, mode->vdisplay, mode->clock,
+			    TCON_PIXEL_CLK_MAX_KHZ);
+		return MODE_CLOCK_HIGH;
+	}
+
+	want = (unsigned long)mode->clock * 1000;
+	got = clk_round_rate(tcon->pixel_clk, want);
+	if (got <= 0) {
+		drm_dev_dbg(tcon->dev, DRM_UT_KMS,
+			    "%dx%d: the clock tree has no rate for %lu Hz: %ld\n",
+			    mode->hdisplay, mode->vdisplay, want, got);
+		return MODE_NOCLOCK;
+	}
+
+	drm_dev_dbg(tcon->dev, DRM_UT_KMS,
+		    "%dx%d: pixel clock %lu Hz asked, %ld Hz made (%+lld ppm)\n",
+		    mode->hdisplay, mode->vdisplay, want, got,
+		    div_s64(((s64)got - (s64)want) * 1000000, want));
+
+	slack = want / 1000 * TCON_PIXEL_CLK_TOLERANCE_PER_MILLE;
+	if ((unsigned long)got < want - slack)
+		return MODE_CLOCK_LOW;
+	if ((unsigned long)got > want + slack)
+		return MODE_CLOCK_HIGH;
+
+	return MODE_OK;
+}
+EXPORT_SYMBOL_GPL(sun60i_tcon_tv_kms_clock_valid);
