diff --git a/drivers/gpu/drm/sun60i/sun60i-tcon-tv.c b/drivers/gpu/drm/sun60i/sun60i-tcon-tv.c
--- a/drivers/gpu/drm/sun60i/sun60i-tcon-tv.c
+++ b/drivers/gpu/drm/sun60i/sun60i-tcon-tv.c
@@ -241,9 +241,64 @@
  */
 #define TV_START_DELAY_GUARD		5
 
-/* The pixel clock must land on the mode, not near it. */
+/*
+ * The readback after clk_set_rate(). Under KMS the mode it checks has already
+ * been through sun60i_tcon_tv_kms_clock_fixup(), so it compares the rate the
+ * clock framework reports against the rate the same framework promised a
+ * moment earlier -- the two agree to under 1 kHz, and 1 % only catches a clock
+ * model that contradicts itself. The debugfs path asks for the built-in mode,
+ * which the dividers hit exactly.
+ */
 #define TCON_PIXEL_CLK_TOLERANCE_PERCENT	1
 
+/*
+ * Which modes the pixel clock can serve, as TCON_TV1's CRTC answers it.
+ *
+ * TOLERANCE: 0.5 %, the figure mainline sunxi display drivers already apply
+ * for the same question -- sun4i_rgb.c (SUN4I_RGB_DOTCLOCK_TOLERANCE_PER_MILLE,
+ * "VESA DMT defines a tolerance of 0.5% on the pixel clock, while the CVT spec
+ * reuses that tolerance in its examples") and sun4i_hdmi_enc.c ("+-0.5%
+ * allowed by HDMI spec"). The comparison is clk_round_rate() against the mode,
+ * as both of those do. On this clock tree it can only err low: every stage of
+ * edp-tv -> video1-pll4x -> pll-video1 rounds to the largest rate that does
+ * not exceed the request (ccu_mp_find_best_with_parent_adj(),
+ * clk_divider_bestdiv(), ccu_nm_find_best()).
+ *
+ * WHAT THE TREE CAN MAKE. PLL_VIDEO1 counts from the 24 MHz REF_PLL, not the
+ * 26 MHz DCXO -- UM V1.00 Table 4-2 "PLL Specifications" lists PLL_VIDEO1's
+ * reference clock as 24MHz (printed page 20). VCO = 24 MHz * N / M1 with
+ * N = 12..255 (PLL_N has a minimum of 11, N = PLL_N + 1) and
+ * M1 = 1..2, inside 1.26..2.52 GHz (Table 4-2); then P0 = 1..8
