+/*
+ * Carry the rate the clock tree will actually make in the adjusted mode, so
+ * every block downstream of the CRTC describes the same pixel clock: this TCON
+ * asks for it in sun60i_tcon_tv_set_pixel_clk(), and the DisplayPort
+ * transmitter computes its transfer unit from it and compares the pixel clock
+ * its core measures (SRC0_MVID) against it. Without this the transmitter would
+ * be told the nominal clock of a mode the dividers made 0.1 % slower, and the
+ * one register that measures the truth would be judged against a number
+ * nobody programmed.
+ *
+ * Rounded UP to the kHz, as rockchip_drm_vop.c's vop_crtc_mode_fixup() does
+ * for its dclk: every stage of this clock tree answers with the largest rate
+ * that does not exceed the request, so asking again for the rounded-up kHz
+ * lands on the same rate instead of on the next one below it -- and the
+ * readback in sun60i_tcon_tv_set_pixel_clk() would catch it if not.
+ *
+ * crtc_clock follows, because drm_mode_set_crtcinfo() copied the nominal clock
+ * into it before this ran and the vblank timestamp constants are computed
+ * from it (drm_calc_timestamping_constants()). It copies clock unchanged for
+ * every mode but frame-packed stereo, which this pipe does not offer.
+ */
+int sun60i_tcon_tv_kms_clock_fixup(struct sun60i_tcon_tv *tcon,
+				   struct drm_display_mode *mode)
+{
+	unsigned long want = (unsigned long)mode->clock * 1000;
+	unsigned long made, khz;
+	long got;
+
+	got = clk_round_rate(tcon->pixel_clk, want);
+	if (got <= 0)
+		return got ? (int)got : -EINVAL;
+
+	made = got;
+	khz = DIV_ROUND_UP(made, 1000);
+	if (made != want)
+		drm_dev_dbg(tcon->dev, DRM_UT_KMS,
+			    "%dx%d: pixel clock %d kHz carried as %lu kHz, the rate the clock tree makes (%lu Hz)\n",
+			    mode->hdisplay, mode->vdisplay, mode->clock, khz,
+			    made);
+
+	mode->clock = khz;
+	mode->crtc_clock = khz;
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(sun60i_tcon_tv_kms_clock_fixup);
