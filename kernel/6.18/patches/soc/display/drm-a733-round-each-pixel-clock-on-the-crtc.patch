diff --git a/drivers/gpu/drm/sun60i/sun60i-dp.c b/drivers/gpu/drm/sun60i/sun60i-dp.c
--- a/drivers/gpu/drm/sun60i/sun60i-dp.c
+++ b/drivers/gpu/drm/sun60i/sun60i-dp.c
@@ -1005,6 +1005,15 @@ static int sun60i_dp_video_transfer_unit(struct sun60i_dp *dp,
  * then reads MVID back in one place, scales it by 1000 and prints it in sysfs
  * as the pixel clock (:1638, sunxi_drm_edp.c:1803) -- which on an async link
  * reports 18 690 kHz for a 154 000 kHz mode. It never compares it to anything.
+ *
+ * WHAT IT IS COMPARED WITH. dp->mode is the CRTC's adjusted mode, whose clock
+ * sun60i_tcon_tv_kms_clock_fixup() has set to the rate the clock tree makes
+ * (rounded up to the kHz) -- not the nominal clock the sink listed, which may
+ * lie up to 0.5 % above it. So MVID is checked against the rate the dividers
+ * were actually set to, and the check is a falsifier of the clock model: the
+ * CCU's own claim against the core's measurement of what arrived. On the
+ * debugfs path dp->mode is the built-in 1920x1200, whose 154 MHz the dividers
+ * hit exactly.
  */
 static int sun60i_dp_video_pixel_khz(struct sun60i_dp *dp)
 {
@@ -1242,9 +1251,12 @@ static int sun60i_dp_video_stream_enable(struct sun60i_dp *dp)
 	if (ret)
 		return ret;
 
+	/* The measured clock rides along, so an ordinary boot log carries the
+	 * MVID reading for whichever mode was set, not only a debugfs read.
+	 */
 	dev_info(dp->dev,
-		 "video stream enabled, %d kHz over %u lanes; the sink reports it in sync (DPCD 0x205)\n",
-		 dp->mode.clock, dp->link_lanes);
+		 "video stream enabled, %d kHz over %u lanes (the core measures %d kHz); the sink reports it in sync (DPCD 0x205)\n",
+		 dp->mode.clock, dp->link_lanes, sun60i_dp_video_pixel_khz(dp));
 
 	return 0;
 }
@@ -2523,31 +2535,20 @@ sun60i_dp_bridge_mode_valid(struct drm_bridge *bridge,
 		return MODE_NO_INTERLACE;
 
 	/*
-	 * ⚠ ONE PIXEL CLOCK, AND THE RESTRICTION IS HONEST RATHER THAN
-	 * CONSERVATIVE. `clk-sunxi-ng-a733-video-plls-and-edp-tv-pixel-clock` models PLL_VIDEO1 as real clk_ops with rate
-	 * propagation, and its own header names what it owes: "a SECOND mode.
-	 * Nothing has ever asked this PLL for one" -- a mode whose pixel clock
-	 * is not an integer divisor of a reachable VCO lands on the nearest
-	 * lower rate, and the falsifier it names is SRC0_MVID not computing back
-	 * to the requested clock. Until that measurement exists, a connector
-	 * whose EDID offers a mode list would hand this driver clocks nothing
-	 * has ever produced, and the only thing between that and a silently
-	 * wrong raster is `drm-a733-tcon-tv1-timing-generator-and-video-source`'s readback -- one 1 % check, after the fact.
+	 * NO PIXEL-CLOCK TEST HERE, deliberately. The clock is TCON_TV1's, and
+	 * its CRTC answers for it -- sun60i_tcon_tv_kms_clock_valid(), a
+	 * clk_round_rate() tolerance check with the reasoning beside it. This
+	 * bridge used to refuse every clock but 154 MHz, because PLL_VIDEO1 had
+	 * never been asked for a second rate and no CRTC existed to ask it, and
+	 * said the test would move once one did; with it went the empty mode
+	 * list a monitor without a 1920x1200 mode got.
 	 *
-	 * So the mode list is gated on the one clock this tree has driven, and
-	 * the gate carries the observation that removes it. It sits here rather
-	 * than in the CRTC only because the CRTC does not exist yet; it belongs
-	 * to whoever owns clk_round_rate() on the pixel clock, which is
-	 * TCON_TV1, and it moves there when that half lands.
-	 *
-	 * Closed by: asking PLL_VIDEO1 for a second mode -- 1280x1024 at
-	 * 108 MHz is the one `clk-sunxi-ng-a733-video-plls-and-edp-tv-pixel-clock` names -- and reading SRC0_MVID back. If it
-	 * computes to the requested clock, this test becomes a
-	 * clk_round_rate() tolerance check instead.
+	 * What stays here is what the transmitter itself limits: interlace
+	 * above, and the link budget below. And what the transmitter measures,
+	 * it still measures: sun60i_dp_video_check_pixel_clk() compares SRC0_MVID
+	 * with the clock the adjusted mode carries, which is the rate the clock
+	 * tree makes, not the one the sink listed.
 	 */
-	if (mode->clock != sun60i_display_mode_1920x1200.clock)
-		return MODE_CLOCK_RANGE;
-
 	budget = sun60i_dp_bridge_link_budget(dp);
 	if (!budget)
 		return MODE_OK;
@@ -2706,16 +2707,16 @@ static void sun60i_dp_bridge_atomic_enable(struct drm_bridge *bridge,
 	guard(mutex)(&dp->lock);
 
 	/*
-	 * ⚠ THE INVARIANT sun60i-display.h EXISTS FOR IS NOT CLOSED HERE.
+	 * THE INVARIANT sun60i-display.h EXISTS FOR, held by one source.
 	 * TCON_TV1 and this transmitter must describe the SAME mode; the
 	 * hardware reports a disagreement as SRC0_USER_FIFO_STATUS != 0,
-	 * flagging a mismatch with the current video mode. From
-	 * here the transmitter takes its mode from the atomic state, which is
-	 * the retirement path that header names -- but the TCON still takes the
-	 * constant until it gains a CRTC, which is the other half of Stage 2.
-	 * Until both read the same atomic state, the invariant is held only by
-	 * .mode_valid and by the constant, and the observable that would catch a
-	 * mismatch is the one the driver already reads and prints.
+	 * flagging a mismatch with the mode in use. Both
+	 * take it from this CRTC state's adjusted_mode -- the TCON through
+	 * sun60i_kms_crtc_atomic_enable() -- and its clock is the rate the clock
+	 * tree makes (sun60i_tcon_tv_kms_clock_fixup()), so the transfer unit
+	 * below and the MVID check are computed from the clock that arrives.
+	 * The constant is left only for the debugfs verbs. The observable that
+	 * would catch a mismatch is the one the driver already reads and prints.
 	 */
 	drm_mode_copy(&dp->mode, &crtc_state->adjusted_mode);
 
diff --git a/drivers/gpu/drm/sun60i/sun60i-kms.c b/drivers/gpu/drm/sun60i/sun60i-kms.c
--- a/drivers/gpu/drm/sun60i/sun60i-kms.c
+++ b/drivers/gpu/drm/sun60i/sun60i-kms.c
@@ -165,8 +165,8 @@
  *      limit (edp_adjust_pixel_mode(), sunxi_drm_edp.c:708-721). ⇒ Both sides
