+			       const struct drm_display_mode *mode);
+int sun60i_tcon_tv_kms_clock_fixup(struct sun60i_tcon_tv *tcon,
+				   struct drm_display_mode *mode);
 int sun60i_tcon_tv_kms_enable(struct sun60i_tcon_tv *tcon,
