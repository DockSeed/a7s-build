+					 * breaks measures the real margin on our silicon.
+					 */
+					reg_dcdc4: dcdc4 {
+						regulator-name = "vdd-gpu";
+						regulator-min-microvolt = <960000>;
+						regulator-max-microvolt = <960000>;
+						regulator-ramp-delay = <1280>;
+						regulator-always-on;
+					};
+
