+static void
+pvr_cmd_buffer_take_dynamic_render(struct pvr_cmd_buffer *const cmd_buffer,
+                                   struct pvr_sub_cmd *const sub_cmd)
+{
+   list_for_each_entry_rev (struct pvr_sub_cmd,
+                            prev,
+                            &cmd_buffer->sub_cmds,
+                            link) {
+      if (prev->type != PVR_SUB_CMD_TYPE_GRAPHICS || !prev->owned ||
+          prev->gfx.dr_info != sub_cmd->gfx.dr_info) {
+         continue;
+      }
+
+      prev->gfx.dr_info = NULL;
+      break;
+   }
+}
