From b2fe73acc94f5a2848faeb236ffe2dd94f5cb7f9 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Louis-Francis=20Ratt=C3=A9-Boulianne?= <lfrb@collabora.com>
Date: Fri, 16 Oct 2026 18:56:28 -0400
Subject: [PATCH] vulkan: initialize swapchain private mutex properly
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The mutex is no longer only needed for Android. The bug was
probably hidden by the fact an unitialized mutex acts as an
unlocked one on Linux, but that's not the case on Windows.

Also, destroy the mutex on vk_device_finish().

Fixes: 710d4780663a ("vulkan: Extend vkGet/SetPrivateDataEXT handling to all platforms")
Backport-to: *

Signed-off-by: Louis-Francis Ratté-Boulianne<lfrb@collabora.com>
Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/46093>
(cherry picked from commit db5503a26f76af5238bb6e706ba5daec2dbf45d2)
Link: https://gitlab.freedesktop.org/mesa/mesa/-/commit/b2fe73acc94f5a2848faeb236ffe2dd94f5cb7f9
[ adapted: dropped .pick_status.json, not in the 26.3.0 tarball or bookkeeping only ]
---
 .pick_status.json              | 2 +-
 src/vulkan/runtime/vk_device.c | 5 +----
 2 files changed, 2 insertions(+), 5 deletions(-)

diff --git a/src/vulkan/runtime/vk_device.c b/src/vulkan/runtime/vk_device.c
index 6955ba3f18fb..5f1bd5eaa07d 100644
--- a/src/vulkan/runtime/vk_device.c
+++ b/src/vulkan/runtime/vk_device.c
@@ -249,10 +249,8 @@ vk_device_init(struct vk_device *device,
       UNREACHABLE("Invalid timeline mode");
    }
 
-#ifdef VK_USE_PLATFORM_ANDROID_KHR
    mtx_init(&device->swapchain_private_mtx, mtx_plain);
    device->swapchain_private = NULL;
-#endif /* VK_USE_PLATFORM_ANDROID_KHR */
 
    simple_mtx_init(&device->trace_mtx, mtx_plain);
 
@@ -330,13 +328,12 @@ vk_device_finish(struct vk_device *device)
    vk_device_memory_report_finish(device);
    vk_memory_trace_finish(device);
 
-#ifdef VK_USE_PLATFORM_ANDROID_KHR
    if (device->swapchain_private) {
       hash_table_foreach(device->swapchain_private, entry)
          util_sparse_array_finish(entry->data);
       ralloc_free(device->swapchain_private);
    }
-#endif /* VK_USE_PLATFORM_ANDROID_KHR */
+   mtx_destroy(&device->swapchain_private_mtx);
 
    simple_mtx_destroy(&device->trace_mtx);
 
-- 
