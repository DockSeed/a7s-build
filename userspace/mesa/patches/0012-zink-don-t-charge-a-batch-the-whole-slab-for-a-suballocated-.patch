 .pick_status.json                     | 2 +-
 src/gallium/drivers/zink/zink_batch.c | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/gallium/drivers/zink/zink_batch.c b/src/gallium/drivers/zink/zink_batch.c
index 67f222e3cfac..ad1093a356cd 100644
--- a/src/gallium/drivers/zink/zink_batch.c
+++ b/src/gallium/drivers/zink/zink_batch.c
@@ -1111,7 +1111,7 @@ batch_reference_resource_move_internal(struct zink_batch_state *bs, struct zink_
    bs->buffer_indices_hashlist[hash] = idx & 0x7fff;
    bs->last_added_obj = res->obj;
    if (!(res->base.b.flags & PIPE_RESOURCE_FLAG_SPARSE)) {
-      bs->resource_size += res->obj->size;
+      bs->resource_size += bo->base.size;
    } else {
       /* Sparse backing pages are not directly referenced by the batch as
        * there can be a lot of them.
