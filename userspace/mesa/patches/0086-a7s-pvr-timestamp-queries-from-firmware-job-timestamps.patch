+static VkResult pvr_write_timestamp(struct pvr_cmd_buffer *cmd_buffer,
+                                    VkQueryPool query_pool,
+                                    uint32_t query)
+{
+   VK_FROM_HANDLE(pvr_query_pool, pool, query_pool);
+   const struct pvr_winsys_job_timestamp timestamp = {
+      .bo = pool->result_buffer->bo->bo,
+      .pre = true,
+      .pre_offset = pool->result_buffer->offset +
+                    (uint64_t)query * pool->result_elem_stride,
+   };
+   struct pvr_suballoc_bo *index_bo;
+   VkResult result;
+
+   result = pvr_arch_cmd_buffer_upload_general(cmd_buffer,
+                                               &query,
+                                               sizeof(query),
+                                               &index_bo);
+   if (result != VK_SUCCESS)
+      return result;
+
+   const struct pvr_query_info query_info = {
+      .type = PVR_QUERY_TYPE_AVAILABILITY_WRITE,
+      .availability_write = {
+         .num_query_indices = 1,
+         .index_bo = index_bo,
+         .num_queries = pool->query_count,
+         .availability_bo = pool->availability_buffer,
+         .timestamp = &timestamp,
+      },
+   };
+
+   result = pvr_arch_cmd_buffer_end_sub_cmd(cmd_buffer);
+   if (result != VK_SUCCESS)
+      return result;
+
+   result =
+      pvr_arch_cmd_buffer_start_sub_cmd(cmd_buffer, PVR_SUB_CMD_TYPE_EVENT);
+   if (result != VK_SUCCESS)
+      return result;
+
+   cmd_buffer->state.current_sub_cmd->event = (struct pvr_sub_cmd_event){
+      .type = PVR_EVENT_TYPE_BARRIER,
+      .barrier = {
+         .wait_for_stage_mask =
+            PVR_PIPELINE_STAGE_ALL_BITS | PVR_PIPELINE_STAGE_QUERY_BIT,
+         .wait_at_stage_mask = PVR_PIPELINE_STAGE_QUERY_BIT,
+      },
+   };
+
+   return pvr_arch_add_query_program(cmd_buffer, &query_info);
+}
+
+VkResult
+PVR_PER_ARCH(cmd_buffer_flush_timestamps)(struct pvr_cmd_buffer *cmd_buffer)
+{
+   struct util_dynarray *const timestamps = &cmd_buffer->state.timestamps;
+   VkResult result = VK_SUCCESS;
+
+   util_dynarray_foreach (timestamps, struct pvr_deferred_timestamp, timestamp) {
+      for (uint32_t i = 0; i < timestamp->query_count; i++) {
+         result = pvr_write_timestamp(cmd_buffer,
+                                      timestamp->query_pool,
+                                      timestamp->query + i);
+         if (result != VK_SUCCESS)
+            break;
+      }
+
+      if (result != VK_SUCCESS)
+         break;
+   }
+
+   util_dynarray_clear(timestamps);
+
+   return result;
+}
+
+static VkResult pvr_write_timestamp_in_render(struct pvr_cmd_buffer *cmd_buffer,
+                                              VkQueryPool query_pool,
+                                              uint32_t query)
+{
+   struct pvr_cmd_buffer_state *state = &cmd_buffer->state;
+   struct pvr_sub_cmd *prev_sub_cmd = state->current_sub_cmd;
+   VkResult result;
+
+   prev_sub_cmd->gfx.empty_cmd = false;
+   prev_sub_cmd->gfx.barrier_store = true;
+
+   result = pvr_write_timestamp(cmd_buffer, query_pool, query);
+   if (result != VK_SUCCESS)
+      return result;
+
+   result =
+      pvr_arch_cmd_buffer_start_sub_cmd(cmd_buffer, PVR_SUB_CMD_TYPE_EVENT);
+   if (result != VK_SUCCESS)
+      return result;
+
+   state->current_sub_cmd->event = (struct pvr_sub_cmd_event){
+      .type = PVR_EVENT_TYPE_BARRIER,
+      .barrier = {
+         .wait_for_stage_mask = PVR_PIPELINE_STAGE_QUERY_BIT,
+         .wait_at_stage_mask = PVR_PIPELINE_STAGE_ALL_GRAPHICS_BITS,
+      },
+   };
+
+   result =
+      pvr_arch_cmd_buffer_start_sub_cmd(cmd_buffer, PVR_SUB_CMD_TYPE_GRAPHICS);
+   if (result != VK_SUCCESS)
+      return result;
+
+   assert(state->current_sub_cmd->gfx.dr_info ==
+          state->render_pass_info.dr_info);
+
+   state->current_sub_cmd->gfx.barrier_load = true;
+   state->current_sub_cmd->gfx.barrier_store = false;
+   state->current_sub_cmd->gfx.empty_cmd = false;
+   state->current_sub_cmd->is_dynamic_render = prev_sub_cmd->is_dynamic_render;
+   state->current_sub_cmd->is_suspend = prev_sub_cmd->is_suspend;
+
+   return VK_SUCCESS;
+}
+
+void PVR_PER_ARCH(CmdWriteTimestamp2)(VkCommandBuffer commandBuffer,
+                                      VkPipelineStageFlags2 stage,
+                                      VkQueryPool queryPool,
+                                      uint32_t query)
+{
+   VK_FROM_HANDLE(pvr_cmd_buffer, cmd_buffer, commandBuffer);
+   struct pvr_cmd_buffer_state *state = &cmd_buffer->state;
+   const struct pvr_sub_cmd *sub_cmd = state->current_sub_cmd;
+
+   PVR_CHECK_COMMAND_BUFFER_BUILDING_STATE(cmd_buffer);
+
+   if (sub_cmd && sub_cmd->owned && sub_cmd->type == PVR_SUB_CMD_TYPE_GRAPHICS &&
+       !sub_cmd->gfx.geom_only) {
+      const uint32_t view_count = pvr_cmd_buffer_state_get_view_count(state);
+
+      if (view_count == 1 && !pvr_cmd_buffer_is_secondary_cont(cmd_buffer)) {
+         pvr_write_timestamp_in_render(cmd_buffer, queryPool, query);
+         return;
+      }
+
+      const struct pvr_deferred_timestamp timestamp = {
+         .query_pool = queryPool,
+         .query = query,
+         .query_count = view_count,
+      };
+
+      util_dynarray_append(&state->timestamps, timestamp);
+      return;
+   }
+
+   pvr_write_timestamp(cmd_buffer, queryPool, query);
+}
