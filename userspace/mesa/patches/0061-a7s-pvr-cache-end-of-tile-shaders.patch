+   struct pvr_eot_cache_key key;
+
+   pvr_eot_cache_key_init(props, &key);
+
+   simple_mtx_lock(&device->usc_cache_mtx);
+   found = pvr_eot_cache_lookup(device, &key);
+   simple_mtx_unlock(&device->usc_cache_mtx);
+
+   if (found)
