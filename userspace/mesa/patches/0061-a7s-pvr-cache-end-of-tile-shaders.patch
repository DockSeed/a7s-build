+static struct pvr_eot_cache_entry *
+pvr_eot_cache_lookup(struct pvr_device *device,
+                     const struct pvr_eot_cache_key *key)
+{
+   struct hash_entry *hash_entry;
+   struct pvr_eot_cache_entry *entry;
+
+   simple_mtx_assert_locked(&device->usc_cache_mtx);
+
+   hash_entry = _mesa_hash_table_search(device->eot_cache, key);
+   if (!hash_entry)
+      return NULL;
+
+   entry = hash_entry->data;
+   entry->refs++;
+   list_del(&entry->link);
+   list_addtail(&entry->link, &device->eot_cache_lru);
+
+   return entry;
+}
+
+static void pvr_eot_cache_insert(struct pvr_device *device,
+                                 struct pvr_eot_cache_entry *entry)
+{
+   simple_mtx_assert_locked(&device->usc_cache_mtx);
+
+   if (device->eot_cache->entries >= PVR_USC_CACHE_MAX_ENTRIES) {
+      list_for_each_entry (struct pvr_eot_cache_entry,
+                           victim,
+                           &device->eot_cache_lru,
+                           link) {
+         if (victim->refs)
+            continue;
+
+         _mesa_hash_table_remove_key(device->eot_cache, &victim->key);
+         list_del(&victim->link);
+         vk_free(&device->vk.alloc, victim);
+         break;
+      }
+   }
+
+   if (device->eot_cache->entries >= PVR_USC_CACHE_MAX_ENTRIES)
+      return;
+
+   if (!_mesa_hash_table_insert(device->eot_cache, &entry->key, entry))
+      return;
+
+   list_addtail(&entry->link, &device->eot_cache_lru);
+   entry->cached = true;
+}
