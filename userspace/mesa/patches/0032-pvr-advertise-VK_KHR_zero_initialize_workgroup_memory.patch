From 1d2a95d203edef0f305d94fcd8a14eac8597dc41 Mon Sep 17 00:00:00 2001
From: Simon Perretta <simon.perretta@imgtec.com>
Date: Fri, 23 Oct 2026 07:36:33 +0100
Subject: [PATCH] pvr: advertise VK_KHR_zero_initialize_workgroup_memory

Signed-off-by: Simon Perretta <simon.perretta@imgtec.com>
Reviewed-by: Radu Costas <radu.costas@imgtec.com>
Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/42747>
Link: https://gitlab.freedesktop.org/mesa/mesa/-/commit/1d2a95d203edef0f305d94fcd8a14eac8597dc41
[ adapted: dropped docs/features.txt, docs/relnotes/new_features.txt, not in the 26.3.0 tarball or bookkeeping only ]
---
 docs/features.txt                            | 2 +-
 docs/relnotes/new_features.txt               | 1 +
 src/imagination/vulkan/pvr_physical_device.c | 3 ++-
 3 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/imagination/vulkan/pvr_physical_device.c b/src/imagination/vulkan/pvr_physical_device.c
index e555e72534df..e26ea14bb941 100644
--- a/src/imagination/vulkan/pvr_physical_device.c
+++ b/src/imagination/vulkan/pvr_physical_device.c
@@ -192,6 +192,7 @@ static void pvr_physical_device_get_supported_extensions(
       .KHR_uniform_buffer_standard_layout = true,
       .KHR_vertex_attribute_divisor = true,
       .KHR_workgroup_memory_explicit_layout = true,
+      .KHR_zero_initialize_workgroup_memory = true,
       .EXT_border_color_swizzle = true,
       .EXT_color_write_enable = true,
       .EXT_custom_border_color = true,
@@ -553,7 +554,7 @@ static void pvr_physical_device_get_supported_features(
       .workgroupMemoryExplicitLayout16BitAccess = false,
 
       /* Vulkan 1.3 / VK_KHR_zero_initialize_workgroup_memory */
-      .shaderZeroInitializeWorkgroupMemory = false,
+      .shaderZeroInitializeWorkgroupMemory = true,
 
       /* VK_EXT_border_color_swizzle */
       .borderColorSwizzle = true,
-- 
