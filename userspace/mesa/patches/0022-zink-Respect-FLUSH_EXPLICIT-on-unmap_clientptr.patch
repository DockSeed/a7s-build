From ee67f018cbc2a8cdfae0529f9649c8caa88a97b1 Mon Sep 17 00:00:00 2001
From: Derek Lesho <dlesho@codeweavers.com>
Date: Tue, 20 Oct 2026 14:23:45 +0200
Subject: [PATCH] zink: Respect FLUSH_EXPLICIT on unmap_clientptr.

(cherry picked from commit c9c16cf18514f619a1f219432385b8827facf463)

Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/45778>
Link: https://gitlab.freedesktop.org/mesa/mesa/-/commit/ee67f018cbc2a8cdfae0529f9649c8caa88a97b1
---
 src/gallium/drivers/zink/zink_resource.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/gallium/drivers/zink/zink_resource.c b/src/gallium/drivers/zink/zink_resource.c
index 07b89a1cfc48..0c53b51d1f13 100644
--- a/src/gallium/drivers/zink/zink_resource.c
+++ b/src/gallium/drivers/zink/zink_resource.c
@@ -3821,7 +3821,7 @@ zink_transfer_unmap_clientptr_range(struct pipe_context *pctx, struct pipe_trans
    struct zink_resource *res = trans->staging_res ? zink_resource(trans->staging_res) :
                                                     zink_resource(trans->base.b.resource);
 
-   if (!res->obj->coherent) {
+   if (!res->obj->coherent && !(trans->base.b.usage & PIPE_MAP_FLUSH_EXPLICIT)) {
       VkMappedMemoryRange range = zink_resource_init_mem_range(screen, res->obj, res->obj->offset, res->obj->size);
       if (VKSCR(FlushMappedMemoryRanges)(screen->dev, 1, &range) != VK_SUCCESS) {
          mesa_loge("ZINK: vkFlushMappedMemoryRanges failed");
-- 
