+static VkResult pvr_check_shared_registers(struct pvr_device *device,
+                                           const pco_data *data,
+                                           mesa_shader_stage stage)
+{
+   unsigned max_shareds;
+
+   switch (stage) {
+   case MESA_SHADER_VERTEX:
+      max_shareds = ROGUE_MAX_VERTEX_SHARED_REGISTERS;
+      break;
+
+   case MESA_SHADER_FRAGMENT:
+      max_shareds = ROGUE_MAX_PIXEL_SHARED_REGISTERS;
+      break;
+
+   case MESA_SHADER_COMPUTE:
+      max_shareds = ROGUE_MAX_COMPUTE_SHARED_REGISTERS;
+      break;
+
+   default:
+      UNREACHABLE("");
+   }
+
+   if (data->common.shareds <= max_shareds)
+      return VK_SUCCESS;
+
+   return vk_errorf(device,
+                    VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                    "%s stage needs %u shared registers, the limit is %u",
+                    _mesa_shader_stage_to_string(stage),
+                    data->common.shareds,
+                    max_shareds);
+}
+
+static void
+pvr_desc_set_load_range(const struct pvr_descriptor_set_layout *set_layout,
+                        const pco_descriptor_set_data *desc_set_data,
+                        unsigned *first_dw_out,
+                        unsigned *count_dw_out)
+{
+   unsigned first = ~0U;
+   unsigned last = 0;
+
+   for (unsigned binding = 0; binding < set_layout->binding_count; ++binding) {
+      const struct pvr_descriptor_set_layout_binding *layout_binding =
+         &set_layout->bindings[binding];
+      const unsigned size =
+         layout_binding->stride * layout_binding->descriptor_count;
+
+      if (!desc_set_data->bindings[binding].used || !size ||
+          layout_binding->offset == ~0)
+         continue;
+
+      first = MIN2(first, layout_binding->offset);
+      last = MAX2(last, layout_binding->offset + size);
+   }
+
+   if (first == ~0U) {
+      *first_dw_out = 0;
+      *count_dw_out = 0;
+      return;
+   }
+
+   assert(!(last % sizeof(uint32_t)));
+
+   *first_dw_out = ROUND_DOWN_TO(first / sizeof(uint32_t), 4);
+   *count_dw_out = last / sizeof(uint32_t) - *first_dw_out;
+}
