+static void pvr_drm_get_timestamp_info(struct pvr_drm_winsys *drm_ws)
+{
+   struct drm_pvr_dev_query_timestamp_info info = { 0 };
+   struct drm_pvr_ioctl_dev_query_args args = {
+      .type = DRM_PVR_DEV_QUERY_TIMESTAMP_INFO_GET,
+      .size = sizeof(info),
+      .pointer = (__u64)&info,
+   };
+
+   if (drmIoctl(drm_ws->base.render_fd, DRM_IOCTL_PVR_DEV_QUERY, &args))
+      return;
+
+   if (info.clock_id != CLOCK_MONOTONIC_RAW || info.valid_bits != 64 ||
+       !info.bo_max_size)
+      return;
+
+   drm_ws->base.features.supports_job_timestamps = true;
+   drm_ws->base.timestamp_bo_max_size = info.bo_max_size;
+}
