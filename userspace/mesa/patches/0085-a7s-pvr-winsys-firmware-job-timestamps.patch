+static void
+pvr_drm_job_timestamp_init(const struct pvr_winsys_job_timestamp *timestamp,
+                           struct drm_pvr_job *job_args)
+{
+   if (!timestamp->bo)
+      return;
+
+   job_args->timestamp_bo_handle = to_pvr_drm_winsys_bo(timestamp->bo)->handle;
+
+   if (timestamp->pre) {
+      job_args->timestamp_flags |= DRM_PVR_SUBMIT_JOB_TIMESTAMP_PRE;
+      job_args->timestamp_pre_offset = timestamp->pre_offset;
+   }
+
+   if (timestamp->post) {
+      job_args->timestamp_flags |= DRM_PVR_SUBMIT_JOB_TIMESTAMP_POST;
+      job_args->timestamp_post_offset = timestamp->post_offset;
+   }
+}
