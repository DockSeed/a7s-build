+static bool
+native_astc_2d_formats_support_3d(struct pipe_screen *screen)
+{
+   for (enum pipe_format f = 0; f < PIPE_FORMAT_COUNT; f++) {
+      const struct util_format_description *desc = util_format_description(f);
+
+      if (!desc || desc->layout != UTIL_FORMAT_LAYOUT_ASTC ||
+          desc->block.depth != 1)
+         continue;
+
+      if (screen->is_format_supported(screen, f, PIPE_TEXTURE_2D, 0, 0,
+                                      PIPE_BIND_SAMPLER_VIEW) &&
+          !screen->is_format_supported(screen, f, PIPE_TEXTURE_3D, 0, 0,
+                                       PIPE_BIND_SAMPLER_VIEW))
+         return false;
+   }
+
+   return true;
+}
