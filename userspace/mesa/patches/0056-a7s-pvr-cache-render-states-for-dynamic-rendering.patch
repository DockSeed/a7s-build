+static struct pvr_render_state *
+pvr_cmd_buffer_find_render_state(struct pvr_cmd_buffer *cmd_buffer,
+                                 const struct pvr_render_state_key *key)
+{
+   if (pvr_cmd_buffer_is_secondary_cont(cmd_buffer))
+      return NULL;
+
+   list_for_each_entry_rev (struct pvr_sub_cmd,
+                            sub_cmd,
+                            &cmd_buffer->sub_cmds,
+                            link) {
+      if (sub_cmd->type != PVR_SUB_CMD_TYPE_GRAPHICS ||
+          !sub_cmd->is_dynamic_render || !sub_cmd->gfx.rstate)
+         continue;
+
+      if (!memcmp(&sub_cmd->gfx.rstate->key, key, sizeof(*key)))
+         return sub_cmd->gfx.rstate;
+   }
+
+   return NULL;
+}
+
+static VkResult pvr_dynamic_render_state_acquire(
+   struct pvr_cmd_buffer *cmd_buffer,
+   const struct pvr_renderpass_hwsetup_render *hw_render,
+   struct pvr_render_state **const rstate_inout)
+{
+   struct pvr_device *device = cmd_buffer->device;
+   struct pvr_render_state *rstate = *rstate_inout;
+   const struct pvr_render_state_key key = {
+      .width = rstate->width,
+      .height = rstate->height,
+      .layers = rstate->layers,
+      .sample_count = hw_render->sample_count,
+      .output_regs_count = hw_render->output_regs_count,
+      .tile_buffers_count = hw_render->tile_buffers_count,
+      .scratch_buffer_size = rstate->scratch_buffer_size,
+   };
+   struct pvr_render_state *cached;
+   VkResult result;
+
+   cached = pvr_cmd_buffer_find_render_state(cmd_buffer, &key);
+   if (cached)
+      pvr_render_state_cache_ref(device, cached);
+   else
+      cached = pvr_render_state_cache_get(device, &key);
+
+   if (cached) {
+      vk_free(&device->vk.alloc, rstate);
+      *rstate_inout = cached;
+      return VK_SUCCESS;
+   }
+
+   result = pvr_arch_render_state_setup(device, NULL, rstate, 1, hw_render);
+   if (result != VK_SUCCESS)
+      return result;
+
+   rstate->key = key;
+   rstate->refs = 1;
+
+   return VK_SUCCESS;
+}
