+#define PVR_CSB_BO_POOL_MAX 256
+
+void pvr_csb_bo_pool_init(struct pvr_device *device)
+{
+   simple_mtx_init(&device->csb_bo_pool_mtx, mtx_plain);
+   list_inithead(&device->csb_bo_pool);
+   device->csb_bo_pool_count = 0;
+}
+
+void pvr_csb_bo_pool_finish(struct pvr_device *device)
+{
+   list_for_each_entry_safe (struct pvr_bo, pvr_bo, &device->csb_bo_pool, link) {
+      list_del(&pvr_bo->link);
+      pvr_bo_free(device, pvr_bo);
+   }
+
+   device->csb_bo_pool_count = 0;
+   simple_mtx_destroy(&device->csb_bo_pool_mtx);
+}
+
+struct pvr_bo *pvr_csb_bo_pool_take(struct pvr_device *device)
+{
+   struct pvr_bo *pvr_bo = NULL;
+
+   simple_mtx_lock(&device->csb_bo_pool_mtx);
+
+   if (!list_is_empty(&device->csb_bo_pool)) {
+      pvr_bo = list_first_entry(&device->csb_bo_pool, struct pvr_bo, link);
+      list_del(&pvr_bo->link);
+      device->csb_bo_pool_count--;
+   }
+
+   simple_mtx_unlock(&device->csb_bo_pool_mtx);
+
+   if (pvr_bo)
+      memset(pvr_bo->bo->map, 0, pvr_bo->bo->size);
+
+   return pvr_bo;
+}
+
+void pvr_csb_bo_release(struct pvr_device *device, struct pvr_bo *pvr_bo)
+{
+   if (!pvr_bo)
+      return;
+
+   simple_mtx_lock(&device->csb_bo_pool_mtx);
+
+   if (device->csb_bo_pool_count < PVR_CSB_BO_POOL_MAX) {
+      list_add(&pvr_bo->link, &device->csb_bo_pool);
+      device->csb_bo_pool_count++;
+      pvr_bo = NULL;
+   }
+
+   simple_mtx_unlock(&device->csb_bo_pool_mtx);
+
+   if (pvr_bo)
+      pvr_bo_free(device, pvr_bo);
+}
