From b2282868d8f0fceb92f9e8ae2052a7d239f816fb Mon Sep 17 00:00:00 2001
From: Mike Blumenkrantz <michael.blumenkrantz@gmail.com>
Date: Wed, 21 Oct 2026 13:54:00 -0400
Subject: [PATCH] zink: use EXT_pipeline_robustness on drivers where it matters

this should improve perf

Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/45499>
Link: https://gitlab.freedesktop.org/mesa/mesa/-/commit/b2282868d8f0fceb92f9e8ae2052a7d239f816fb
---
 src/gallium/drivers/zink/zink_device_info.py |  4 +++
 src/gallium/drivers/zink/zink_pipeline.c     | 33 +++++++++++++++++---
 src/gallium/drivers/zink/zink_pipeline.h     |  2 +-
 src/gallium/drivers/zink/zink_program.c      |  7 ++++-
 src/gallium/drivers/zink/zink_program.h      |  4 +++
 src/gallium/drivers/zink/zink_screen.c       | 16 ++++++++++
 src/gallium/drivers/zink/zink_types.h        |  3 ++
 7 files changed, 63 insertions(+), 6 deletions(-)

diff --git a/src/gallium/drivers/zink/zink_device_info.py b/src/gallium/drivers/zink/zink_device_info.py
index 87d94a81050d..bc9e97c094e9 100644
--- a/src/gallium/drivers/zink/zink_device_info.py
+++ b/src/gallium/drivers/zink/zink_device_info.py
@@ -155,6 +155,10 @@ EXTENSIONS = [
     Extension("VK_EXT_pci_bus_info",
               alias="pci",
               properties=True),
+    Extension("VK_EXT_pipeline_robustness",
+              alias="pipeline_rb",
+              features=True,
+              properties=True),
     Extension("VK_EXT_memory_budget"),
     Extension("VK_EXT_memory_priority", alias="memprio", features=True),
     Extension("VK_EXT_pageable_device_local_memory", alias="mempage", features=True),
diff --git a/src/gallium/drivers/zink/zink_pipeline.c b/src/gallium/drivers/zink/zink_pipeline.c
index 9f73abe9eb9d..51eff5c4b53e 100644
--- a/src/gallium/drivers/zink/zink_pipeline.c
+++ b/src/gallium/drivers/zink/zink_pipeline.c
@@ -38,6 +38,20 @@
 
 #define GFX_INPUT_MESH 32
 
+static VkPipelineRobustnessCreateInfo
+pipeline_robustness_info(const struct zink_screen *screen)
+{
+   return (VkPipelineRobustnessCreateInfo){
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_ROBUSTNESS_CREATE_INFO,
+      .storageBuffers = VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_ROBUST_BUFFER_ACCESS,
+      .uniformBuffers = VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_ROBUST_BUFFER_ACCESS,
+      .vertexInputs = VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_ROBUST_BUFFER_ACCESS,
+      .images = screen->robustness & ZINK_ROBUSTNESS_IMAGE2 ?
+                VK_PIPELINE_ROBUSTNESS_IMAGE_BEHAVIOR_ROBUST_IMAGE_ACCESS_2 :
+                VK_PIPELINE_ROBUSTNESS_IMAGE_BEHAVIOR_ROBUST_IMAGE_ACCESS,
+   };
+}
+
 VkPipeline
 zink_create_gfx_pipeline(struct zink_screen *screen,
                          struct zink_gfx_program *prog,
@@ -390,6 +404,7 @@ zink_create_gfx_pipeline(struct zink_screen *screen,
 
    VkPipelineShaderStageCreateInfo shader_stages[MESA_SHADER_MESH_STAGES];
    VkShaderModuleCreateInfo smci[MESA_SHADER_MESH_STAGES] = {0};
+   VkPipelineRobustnessCreateInfo rb = pipeline_robustness_info(screen);
    uint32_t num_stages = 0;
    for (int i = 0; i < MESA_SHADER_MESH_STAGES; ++i) {
       if (!(prog->stages_present & BITFIELD_BIT(i)))
@@ -399,10 +414,13 @@ zink_create_gfx_pipeline(struct zink_screen *screen,
       stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
       stage.stage = mesa_to_vk_shader_stage(i);
       stage.pName = "main";
+      if (prog->robust)
+         stage.pNext = &rb;
       if (objs[i].mod) {
          stage.module = objs[i].mod;
       } else {
          smci[i].sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
+         smci[i].pNext = stage.pNext;
          stage.pNext = &smci[i];
          smci[i].codeSize = objs[i].spirv->num_words * sizeof(uint32_t);
          smci[i].pCode = objs[i].spirv->words;
@@ -438,11 +456,14 @@ zink_create_compute_pipeline(struct zink_screen *screen, struct zink_compute_pro
    if (zink_descriptor_mode == ZINK_DESCRIPTOR_MODE_DB)
       pci.flags |= VK_PIPELINE_CREATE_DESCRIPTOR_BUFFER_BIT_EXT;
 
+   VkPipelineRobustnessCreateInfo rb = pipeline_robustness_info(screen);
    VkPipelineShaderStageCreateInfo stage = {0};
    stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
    stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
    stage.module = comp->curr->obj.mod;
    stage.pName = "main";
+   if (comp->robust)
+      stage.pNext = &rb;
 
    VkSpecializationInfo sinfo = {0};
    VkSpecializationMapEntry me[4];
@@ -486,6 +507,7 @@ zink_create_compute_pipeline(struct zink_screen *screen, struct zink_compute_pro
    /* pin the subgroup size whenever the driver can't tell us on compute kernels. */
    VkPipelineShaderStageRequiredSubgroupSizeCreateInfo subInfo = {
       .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_REQUIRED_SUBGROUP_SIZE_CREATE_INFO,
+      .pNext = stage.pNext
    };
    if (comp->shader->info.stage == MESA_SHADER_KERNEL &&
        screen->info.feats13.subgroupSizeControl &&
@@ -745,7 +767,7 @@ zink_create_mesh_pipeline_input(struct zink_screen *screen)
 }
 
 static VkPipeline
-create_gfx_pipeline_library(struct zink_screen *screen, struct zink_shader_object *objs, unsigned stage_mask, VkPipelineLayout layout, VkPipelineCache pipeline_cache)
+create_gfx_pipeline_library(struct zink_screen *screen, struct zink_shader_object *objs, unsigned stage_mask, VkPipelineLayout layout, VkPipelineCache pipeline_cache, bool robust)
 {
    assert(screen->info.have_EXT_extended_dynamic_state && screen->info.have_EXT_extended_dynamic_state2);
    VkPipelineRenderingCreateInfo rendering_info;
@@ -847,6 +869,7 @@ create_gfx_pipeline_library(struct zink_screen *screen, struct zink_shader_objec
       tdci.domainOrigin = VK_TESSELLATION_DOMAIN_ORIGIN_LOWER_LEFT;
    }
 
+   VkPipelineRobustnessCreateInfo rb = pipeline_robustness_info(screen);
    VkPipelineShaderStageCreateInfo shader_stages[MESA_SHADER_MESH_STAGES];
    uint32_t num_stages = 0;
    for (int i = 0; i < MESA_SHADER_MESH_STAGES; ++i) {
@@ -858,6 +881,8 @@ create_gfx_pipeline_library(struct zink_screen *screen, struct zink_shader_objec
       stage.stage = mesa_to_vk_shader_stage(i);
       stage.module = objs[i].mod;
       stage.pName = "main";
+      if (robust)
+         stage.pNext = &rb;
       shader_stages[num_stages++] = stage;
    }
    assert(num_stages > 0);
@@ -888,15 +913,15 @@ VkPipeline
 zink_create_gfx_pipeline_library(struct zink_screen *screen, struct zink_gfx_program *prog)
 {
    u_rwlock_wrlock(&prog->base.pipeline_cache_lock);
-   VkPipeline pipeline = create_gfx_pipeline_library(screen, prog->objs, prog->stages_present, prog->base.layout, prog->base.pipeline_cache);
+   VkPipeline pipeline = create_gfx_pipeline_library(screen, prog->objs, prog->stages_present, prog->base.layout, prog->base.pipeline_cache, prog->robust);
    u_rwlock_wrunlock(&prog->base.pipeline_cache_lock);
    return pipeline;
 }
 
 VkPipeline
-zink_create_gfx_pipeline_separate(struct zink_screen *screen, struct zink_shader_object *objs, VkPipelineLayout layout, mesa_shader_stage stage)
+zink_create_gfx_pipeline_separate(struct zink_screen *screen, struct zink_shader_object *objs, VkPipelineLayout layout, mesa_shader_stage stage, bool robust)
 {
-   return create_gfx_pipeline_library(screen, objs, BITFIELD_BIT(stage), layout, VK_NULL_HANDLE);
+   return create_gfx_pipeline_library(screen, objs, BITFIELD_BIT(stage), layout, VK_NULL_HANDLE, robust);
 }
 
 VkPipeline
diff --git a/src/gallium/drivers/zink/zink_pipeline.h b/src/gallium/drivers/zink/zink_pipeline.h
index 7b050f15efba..b0d1a66fb6f0 100644
--- a/src/gallium/drivers/zink/zink_pipeline.h
+++ b/src/gallium/drivers/zink/zink_pipeline.h
@@ -64,7 +64,7 @@ zink_create_gfx_pipeline_output(struct zink_screen *screen, struct zink_gfx_pipe
 VkPipeline
 zink_create_gfx_pipeline_combined(struct zink_screen *screen, struct zink_gfx_program *prog, VkPipeline input, VkPipeline *library, unsigned libcount, VkPipeline output, bool optimized, bool testonly);
 VkPipeline
-zink_create_gfx_pipeline_separate(struct zink_screen *screen, struct zink_shader_object *objs, VkPipelineLayout layout, mesa_shader_stage stage);
+zink_create_gfx_pipeline_separate(struct zink_screen *screen, struct zink_shader_object *objs, VkPipelineLayout layout, mesa_shader_stage stage, bool robust);
 #ifdef __cplusplus
 }
 #endif
diff --git a/src/gallium/drivers/zink/zink_program.c b/src/gallium/drivers/zink/zink_program.c
index 27a845d66834..201de6acdf13 100644
--- a/src/gallium/drivers/zink/zink_program.c
+++ b/src/gallium/drivers/zink/zink_program.c
@@ -1294,6 +1294,8 @@ gfx_program_create(struct zink_context *ctx,
    prog->gfx_hash = gfx_hash;
    prog->base.removed = true;
    prog->optimal_keys = screen->optimal_keys;
+   if (ctx->flags & PIPE_CONTEXT_ROBUST_BUFFER_ACCESS)
+      prog->robust = screen->info.have_EXT_pipeline_robustness;
 
    for (int i = is_mesh ? MESA_SHADER_FRAGMENT : 0; i < (is_mesh ? MESA_SHADER_MESH_STAGES : MESA_SHADER_STAGES); ++i) {
       util_dynarray_init(&prog->shader_cache[i][0][0], prog->base.ralloc_ctx);
@@ -2602,7 +2604,7 @@ precompile_separate_shader(struct zink_shader *zs, struct zink_screen *screen)
    if (!screen->info.have_EXT_shader_object) {
       struct zink_shader_object objs[MESA_SHADER_MESH_STAGES] = {0};
       objs[zs->info.stage].mod = zs->precompile.obj.mod;
-      zs->precompile.gpl = zink_create_gfx_pipeline_separate(screen, objs, zs->precompile.layout, zs->info.stage);
+      zs->precompile.gpl = zink_create_gfx_pipeline_separate(screen, objs, zs->precompile.layout, zs->info.stage, zs->robust);
    }
 }
 
@@ -2634,6 +2636,7 @@ void *
 zink_create_gfx_shader_state(struct pipe_context *pctx, const struct pipe_shader_state *shader)
 {
    struct zink_screen *screen = zink_screen(pctx->screen);
+   struct zink_context *ctx = zink_context(pctx);
    nir_shader *nir;
    if (shader->type != PIPE_SHADER_IR_NIR)
       nir = zink_tgsi_to_nir(pctx->screen, shader->tokens);
@@ -2644,6 +2647,8 @@ zink_create_gfx_shader_state(struct pipe_context *pctx, const struct pipe_shader
       zink_descriptor_util_init_fbfetch(zink_context(pctx));
 
    struct zink_shader *zs = zink_shader_create(zink_screen(pctx->screen), nir);
+   if (ctx->flags & PIPE_CONTEXT_ROBUST_BUFFER_ACCESS)
+      zs->robust = screen->info.have_EXT_pipeline_robustness;
    if (zink_debug & ZINK_DEBUG_NOBGC)
       gfx_shader_init_job(zs, screen, 0);
    else
diff --git a/src/gallium/drivers/zink/zink_program.h b/src/gallium/drivers/zink/zink_program.h
index 5d48b7eec5c4..feea3d533ad4 100644
--- a/src/gallium/drivers/zink/zink_program.h
+++ b/src/gallium/drivers/zink/zink_program.h
@@ -432,6 +432,8 @@ zink_can_use_shader_objects(const struct zink_context *ctx)
           !ctx->gfx_stages[MESA_SHADER_FRAGMENT]->info.fs.uses_sample_shading &&
           /* TODO: maybe someday shader objects + viewmask */
           !ctx->gfx_stages[MESA_SHADER_VERTEX]->info.view_mask &&
+          /* shader objects not compatible with pipeline robustness */
+          (!(ctx->flags & PIPE_CONTEXT_ROBUST_BUFFER_ACCESS) || !zink_screen(ctx->base.screen)->info.have_EXT_pipeline_robustness) &&
           !ctx->gfx_pipeline_state.force_persample_interp &&
           !ctx->gfx_pipeline_state.min_samples &&
           !ctx->is_generated_gs_bound;
@@ -461,6 +463,8 @@ zink_can_use_shader_objects_mesh(const struct zink_context *ctx)
           !ctx->gfx_stages[MESA_SHADER_FRAGMENT]->info.fs.uses_sample_shading &&
           /* TODO: maybe someday shader objects + viewmask */
           !ctx->gfx_stages[MESA_SHADER_MESH]->info.view_mask &&
+          /* shader objects not compatible with pipeline robustness */
+          (!(ctx->flags & PIPE_CONTEXT_ROBUST_BUFFER_ACCESS) || !zink_screen(ctx->base.screen)->info.have_EXT_pipeline_robustness) &&
           !ctx->gfx_pipeline_state.force_persample_interp &&
           !ctx->gfx_pipeline_state.min_samples &&
           !ctx->fb_state.viewmask;
diff --git a/src/gallium/drivers/zink/zink_screen.c b/src/gallium/drivers/zink/zink_screen.c
index e641e7e11f4f..9ba498213f70 100644
--- a/src/gallium/drivers/zink/zink_screen.c
+++ b/src/gallium/drivers/zink/zink_screen.c
@@ -3441,6 +3441,22 @@ disable_features(struct zink_screen *screen)
       screen->robustness |= ZINK_ROBUSTNESS_IMAGE;
    if (screen->info.rb2_feats.robustImageAccess2)
       screen->robustness |= ZINK_ROBUSTNESS_IMAGE2;
+
+   /* GL doesn't require this behavior */
+   screen->info.rb2_feats.robustBufferAccess2 = false;
+   if (screen->info.have_EXT_pipeline_robustness &&
+       (screen->info.pipeline_rb_props.defaultRobustnessStorageBuffers == VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_DISABLED ||
+        screen->info.pipeline_rb_props.defaultRobustnessUniformBuffers == VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_DISABLED ||
+        screen->info.pipeline_rb_props.defaultRobustnessVertexInputs == VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_DISABLED ||
+        screen->info.pipeline_rb_props.defaultRobustnessImages == VK_PIPELINE_ROBUSTNESS_IMAGE_BEHAVIOR_DISABLED)) {
+      /* possibly switch to pipeline robustness here */
+      screen->info.feats.features.robustBufferAccess = false;
+      screen->info.rb_image_feats.robustImageAccess = false;
+      screen->info.rb2_feats.robustImageAccess2 = false;
+      screen->info.feats13.robustImageAccess = false;
+   } else {
+      screen->info.have_EXT_pipeline_robustness = false;
+   }
 }
 
 static void
diff --git a/src/gallium/drivers/zink/zink_types.h b/src/gallium/drivers/zink/zink_types.h
index f6634eaf1311..e9b67ee78987 100644
--- a/src/gallium/drivers/zink/zink_types.h
+++ b/src/gallium/drivers/zink/zink_types.h
@@ -883,6 +883,7 @@ struct zink_shader {
    bool has_uniforms;
    bool has_edgeflags;
    bool needs_inlining;
+   bool robust; //from a robust context
    struct spirv_shader *spirv;
 
    struct {
@@ -1196,6 +1197,7 @@ struct zink_gfx_program {
    bool needs_inlining; // whether this program requires some uniforms to be inlined
    bool has_edgeflags;
    bool optimal_keys;
+   bool robust;
 
    /* separable */
    struct zink_gfx_program *full_prog;
@@ -1215,6 +1217,7 @@ struct zink_compute_program {
    bool use_local_size;
    bool has_variable_shared_mem;
    bool uses_bindless;
+   bool robust;
 
    unsigned scratch_size;
 
-- 
