+static nir_mem_access_size_align
+mem_access_size_align_cb(nir_intrinsic_op intrin,
+                         uint8_t bytes,
+                         uint8_t bit_size,
+                         uint32_t align_mul,
+                         uint32_t align_offset,
+                         UNUSED bool offset_is_const,
+                         UNUSED enum gl_access_qualifier access,
+                         UNUSED const void *cb_data)
+{
+   uint32_t align = nir_combined_align(align_mul, align_offset);
+   bool is_store = !nir_intrinsic_infos[intrin].has_dest;
+   unsigned num_components = bytes / 4;
+
+   if (bit_size != 32 || align < 4 || !nir_num_components_valid(num_components)) {
+      if (is_store)
+         num_components = align < 4 ? 1 : CLAMP(bytes / 4, 1, 4);
+      else
+         num_components = MIN2(DIV_ROUND_UP(bytes, 4), 4);
+   }
+
+   return (nir_mem_access_size_align){
+      .num_components = num_components,
+      .bit_size = 32,
+      .align = 4,
+      .shift = nir_mem_access_shift_method_scalar,
+   };
+}
