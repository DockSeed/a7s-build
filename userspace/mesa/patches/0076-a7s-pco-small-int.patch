+static inline bool is_small_bit_size(unsigned bit_size)
+{
+   return bit_size == 8 || bit_size == 16;
+}
+
+static unsigned lower_alu_bit_size(const nir_alu_instr *alu)
+{
+   const nir_op_info *info = &nir_op_infos[alu->op];
+
+   if (info->is_conversion || nir_op_is_vec_or_mov(alu->op))
+      return 0;
+
+   if (!nir_alu_type_get_type_size(info->output_type) &&
+       is_small_bit_size(alu->def.bit_size)) {
+      return 32;
+   }
+
+   for (unsigned s = 0; s < info->num_inputs; ++s) {
+      if (!nir_alu_type_get_type_size(info->input_types[s]) &&
+          is_small_bit_size(nir_src_bit_size(alu->src[s].src))) {
+         return 32;
+      }
+   }
+
+   return 0;
+}
+
+static unsigned lower_intrinsic_bit_size(const nir_intrinsic_instr *intr)
+{
+   switch (intr->intrinsic) {
+   case nir_intrinsic_read_invocation:
+   case nir_intrinsic_read_first_invocation:
+   case nir_intrinsic_shuffle:
+   case nir_intrinsic_shuffle_xor:
+   case nir_intrinsic_shuffle_up:
+   case nir_intrinsic_shuffle_down:
+   case nir_intrinsic_quad_broadcast:
+   case nir_intrinsic_quad_swap_horizontal:
+   case nir_intrinsic_quad_swap_vertical:
+   case nir_intrinsic_quad_swap_diagonal:
+   case nir_intrinsic_reduce:
+   case nir_intrinsic_inclusive_scan:
+   case nir_intrinsic_exclusive_scan:
+      return is_small_bit_size(intr->def.bit_size) ? 32 : 0;
+
+   default:
+      break;
+   }
+
+   return 0;
+}
+
+static unsigned lower_bit_size_cb(const nir_instr *instr, UNUSED void *data)
+{
+   switch (instr->type) {
+   case nir_instr_type_alu:
+      return lower_alu_bit_size(nir_instr_as_alu(instr));
+
+   case nir_instr_type_intrinsic:
+      return lower_intrinsic_bit_size(nir_instr_as_intrinsic(instr));
+
+   default:
+      break;
+   }
+
+   return 0;
+}
