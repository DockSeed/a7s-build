+static VkResult pvr_queue_sync_get(struct pvr_queue *queue,
+                                   struct vk_sync **const sync_out)
+{
+   if (queue->free_sync_count) {
+      *sync_out = queue->free_syncs[--queue->free_sync_count];
+      return VK_SUCCESS;
+   }
+
+   return vk_sync_create(&queue->device->vk,
+                         &queue->device->pdevice->ws->syncobj_type,
+                         0U,
+                         0UL,
+                         sync_out);
+}
+
+static void pvr_queue_sync_put(struct pvr_queue *queue, struct vk_sync *sync)
+{
+   if (queue->free_sync_count < ARRAY_SIZE(queue->free_syncs)) {
+      queue->free_syncs[queue->free_sync_count++] = sync;
+      return;
+   }
+
+   vk_sync_destroy(&queue->device->vk, sync);
+}
