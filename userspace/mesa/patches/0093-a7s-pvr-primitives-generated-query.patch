+static VkResult pvr_xfb_primgen_program_upload(struct pvr_cmd_buffer *cmd_buffer,
+                                               pdsc_program *program,
+                                               struct pvr_program_info *info)
+{
+   const struct pvr_device_info *dev_info =
+      &cmd_buffer->device->pdevice->dev_info;
+   const uint32_t cache_line_size = pvr_get_slc_cache_line_size(dev_info);
+   VkResult result;
+
+   result = pvr_arch_cmd_buffer_upload_pds(
+      cmd_buffer,
+      pdsc_program_data(program),
+      pdsc_program_data_size(program) / sizeof(uint32_t),
+      ROGUE_TA_STATE_STREAM_OUT1_PDS_DATA_SIZE_UNIT_SIZE,
+      pdsc_program_code(program),
+      pdsc_program_code_size(program) / sizeof(uint32_t),
+      ROGUE_TA_STATE_STREAM_OUT1_PDS_DATA_SIZE_UNIT_SIZE,
+      cache_line_size,
+      &info->pds_program);
+   if (result != VK_SUCCESS)
+      pvr_cmd_buffer_set_error_unwarned(cmd_buffer, result);
+
+   return result;
+}
