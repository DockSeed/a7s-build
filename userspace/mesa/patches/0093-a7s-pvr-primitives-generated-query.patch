+static VkResult
+pvr_xfb_primgen_main_program_generate(struct pvr_cmd_buffer *cmd_buffer)
+{
+   struct pvr_program_info *info =
+      &cmd_buffer->state.xfb_state.pds_primgen_main_program;
+   pdsc_program *program;
+   VkResult result;
+
+   program = pdsc_xfb_main_runtime_gen(NULL, 0, 0, NULL, true);
+   info->temp_size = pdsc_program_temps_used(program);
+
+   result = pvr_xfb_primgen_program_upload(cmd_buffer, program, info);
+
+   ralloc_free(program);
+
+   return result;
+}
+
+static VkResult
+pvr_xfb_primgen_streamout_update(struct pvr_cmd_buffer *cmd_buffer)
+{
+   struct pvr_cmd_buffer_xfb_state *xfb_state = &cmd_buffer->state.xfb_state;
+   const struct pvr_graphics_pipeline *pipeline =
+      cmd_buffer->state.gfx_pipeline;
+   struct pvr_xfb_program_input xfb_config = { 0 };
+   VkResult result;
+
+   if (!xfb_state->is_active || !pipeline ||
+       !pipeline->shader_state.xfb_shader_state.varying_count) {
+      return VK_SUCCESS;
+   }
+
+   result = pvr_create_xfb_streamout_program_config(cmd_buffer, &xfb_config);
+   if (result != VK_SUCCESS)
+      return result;
+
+   result = pvr_xfb_main_program_upload(cmd_buffer, &xfb_config);
+
+   pvr_destroy_xfb_program_input(&cmd_buffer->device->vk.alloc, &xfb_config);
+
+   return result;
+}
