+static struct pdsc_st32_src0
+pvr_xfb_primgen_st32_src0(const pdsc_program *program,
+                          uint8_t ref_id,
+                          pvr_dev_addr_t addr)
+{
+   return (struct pdsc_st32_src0){
+      .cmode = PDSC_CMODE_ST_WRITE_THROUGH,
+      .slcmode = PDSC_SLC_MODE_ST_WRITE_THROUGH,
+      .ccpri = 0,
+      .ccslc = PDSC_CCSLC_LD_NORMAL,
+      .ccmcu = PDSC_CCMCU_LD_NORMAL,
+      .count4 = 1,
+      .src = pdsc_load_ref(program, ref_id),
+      .dstadd = addr.addr,
+   };
+}
+
+static pvr_dev_addr_t
+pvr_xfb_primgen_result_addr(const struct pvr_cmd_buffer_state *state)
+{
+   const struct pvr_query_pool *pool =
+      state->query_pools[PVR_QUERY_POOL_INDEX_PRIMGEN];
+   const uint32_t query_idx =
+      state->query_pool_indices[PVR_QUERY_POOL_INDEX_PRIMGEN];
+
+   return PVR_DEV_ADDR_OFFSET(pool->result_buffer->dev_addr,
+                              pool->result_elem_stride * query_idx);
+}
+
+static pvr_dev_addr_t
+pvr_xfb_primgen_availability_addr(const struct pvr_cmd_buffer_state *state)
+{
+   const struct pvr_query_pool *pool =
+      state->query_pools[PVR_QUERY_POOL_INDEX_PRIMGEN];
+   const uint32_t query_idx =
+      state->query_pool_indices[PVR_QUERY_POOL_INDEX_PRIMGEN];
+
+   return PVR_DEV_ADDR_OFFSET(pool->availability_buffer->dev_addr,
+                              query_idx * sizeof(uint32_t));
+}
+
+static VkResult pvr_xfb_primgen_emit(struct pvr_cmd_buffer *cmd_buffer,
+                                     pdsc_program *program,
+                                     unsigned num_patches,
+                                     const pdsc_patch *patches,
+                                     struct pvr_program_info *info)
+{
+   VkResult result;
+
+   info->temp_size = pdsc_program_temps_used(program);
+
+   assert(num_patches < pdsc_program_data_size(program));
+   pdsc_patch_program(program, num_patches, patches, NULL);
+
+   result = pvr_xfb_primgen_program_upload(cmd_buffer, program, info);
+
+   ralloc_free(program);
+
+   if (result != VK_SUCCESS)
+      return result;
+
+   return pvr_arch_emit_xfb_sync_state(cmd_buffer, info);
+}
+
+static VkResult pvr_xfb_primgen_begin_emit(struct pvr_cmd_buffer *cmd_buffer)
+{
+   const struct pvr_cmd_buffer_state *state = &cmd_buffer->state;
+   pdsc_program *program = pdsc_precomp_xfb_primgen_begin_variant(NULL, 0);
+
+   pdsc_finalize_program(program);
+
+   const struct pdsc_st32_src0 result_st_src0 =
+      pvr_xfb_primgen_st32_src0(program,
+                                PVR_XFB_PRIMGEN_BEGIN_REF_ID_RESULT_ST_SRC0,
+                                pvr_xfb_primgen_result_addr(state));
+   const struct pdsc_st32_src0 availability_st_src0 = pvr_xfb_primgen_st32_src0(
+      program,
+      PVR_XFB_PRIMGEN_BEGIN_REF_ID_AVAILABILITY_ST_SRC0,
+      pvr_xfb_primgen_availability_addr(state));
+
+   const pdsc_patch patches[] = {
+      { .patch_id = PVR_XFB_PRIMGEN_BEGIN_PATCH_ID_RESULT_ST_SRC0,
+        .value = pdsc_st32_src0_pack(program, &result_st_src0) },
+      { .patch_id = PVR_XFB_PRIMGEN_BEGIN_PATCH_ID_AVAILABILITY_ST_SRC0,
+        .value = pdsc_st32_src0_pack(program, &availability_st_src0) },
+   };
+
+   return pvr_xfb_primgen_emit(cmd_buffer,
+                               program,
+                               ARRAY_SIZE(patches),
+                               patches,
+                               &cmd_buffer->state.xfb_state
+                                   .pds_primgen_begin_program);
+}
+
+static VkResult pvr_xfb_primgen_init_emit(struct pvr_cmd_buffer *cmd_buffer)
+{
+   const uint32_t dummy[4] = { 0 };
+   struct pvr_suballoc_bo *dummy_bo;
+   pdsc_program *program;
+   VkResult result;
+
+   result = pvr_arch_cmd_buffer_upload_general(cmd_buffer,
+                                               dummy,
+                                               sizeof(dummy),
+                                               &dummy_bo);
+   if (result != VK_SUCCESS)
+      return result;
+
+   program = pdsc_precomp_xfb_primgen_init_variant(NULL, 0);
+   pdsc_finalize_program(program);
+
+   const struct pdsc_stm_src0 stm_src0 = {
+      .ptemp_prim_needed_written =
+         pdsc_ref_ptemp64(PVR_XFB_PRIMGEN_PTEMP_SRC1),
+      .ptemp_address = pdsc_ref_ptemp64(PVR_XFB_PRIMGEN_PTEMP_SRC0),
+      .address = dummy_bo->dev_addr.addr,
+   };
+   const struct pdsc_stm_src3 stm_src3 = {
+      .primtype = PDSC_PRIMTYPE_POINT,
+      .vosize = 1,
+      .eop = true,
+      .limit = dummy_bo->dev_addr.addr,
+   };
+
+   const pdsc_patch patches[] = {
+      { .patch_id = PVR_XFB_PRIMGEN_INIT_PATCH_ID_STM_SRC0,
+        .value = pdsc_stm_src0_pack(program, &stm_src0) },
+      { .patch_id = PVR_XFB_PRIMGEN_INIT_PATCH_ID_STM_SRC3,
+        .value = pdsc_stm_src3_pack(program, &stm_src3) },
+   };
+
+   return pvr_xfb_primgen_emit(cmd_buffer,
+                               program,
+                               ARRAY_SIZE(patches),
+                               patches,
+                               &cmd_buffer->state.xfb_state
+                                   .pds_primgen_init_program);
+}
+
+static VkResult pvr_xfb_primgen_end_emit(struct pvr_cmd_buffer *cmd_buffer,
+                                         bool accumulate,
+                                         bool available)
+{
+   const struct pvr_cmd_buffer_state *state = &cmd_buffer->state;
+   const pvr_dev_addr_t result_addr = pvr_xfb_primgen_result_addr(state);
+   pdsc_program *program = pdsc_precomp_xfb_primgen_end_variant(NULL, 0);
+
+   pdsc_finalize_program(program);
+
+   const struct pdsc_ld64_src0 result_ld_src0 = {
+      .slcmode = PDSC_SLC_MODE_LD_CACHED,
+      .ccpri = 0,
+      .ccslc = PDSC_CCSLC_LD_NORMAL,
+      .ccmcu = PDSC_CCMCU_LD_NORMAL,
+      .dest = pdsc_load_ref(program, PVR_XFB_PRIMGEN_END_REF_ID_RESULT_LD_DEST),
+      .cmode = PDSC_CMODE_LD_CACHED,
+      .count8 = 1,
+      .srcadd = result_addr.addr,
+   };
+   const struct pdsc_st32_src0 result_st_src0 =
+      pvr_xfb_primgen_st32_src0(program,
+                                PVR_XFB_PRIMGEN_END_REF_ID_RESULT_ST_SRC0,
+                                result_addr);
+   const struct pdsc_st32_src0 availability_st_src0 =
+      pvr_xfb_primgen_st32_src0(program,
+                                PVR_XFB_PRIMGEN_END_REF_ID_AVAILABILITY_ST_SRC0,
+                                pvr_xfb_primgen_availability_addr(state));
+
+   const pdsc_patch patches[] = {
+      { .patch_id = PVR_XFB_PRIMGEN_END_PATCH_ID_RESULT_LD_SRC0,
+        .value = accumulate ? pdsc_ld64_src0_pack(program, &result_ld_src0)
+                            : 0 },
+      { .patch_id = PVR_XFB_PRIMGEN_END_PATCH_ID_RESULT_ST_SRC0,
+        .value = accumulate ? pdsc_st32_src0_pack(program, &result_st_src0)
+                            : 0 },
+      { .patch_id = PVR_XFB_PRIMGEN_END_PATCH_ID_AVAILABILITY_ST_SRC0,
+        .value = available
+                    ? pdsc_st32_src0_pack(program, &availability_st_src0)
+                    : 0 },
+   };
+
+   return pvr_xfb_primgen_emit(cmd_buffer,
+                               program,
+                               ARRAY_SIZE(patches),
+                               patches,
+                               &cmd_buffer->state.xfb_state
+                                   .pds_primgen_end_program);
+}
+
+static struct pvr_sub_cmd_gfx *
+pvr_xfb_primgen_gfx_sub_cmd(struct pvr_cmd_buffer *cmd_buffer)
+{
+   struct pvr_sub_cmd *sub_cmd = cmd_buffer->state.current_sub_cmd;
+
+   if (!sub_cmd || sub_cmd->type != PVR_SUB_CMD_TYPE_GRAPHICS)
+      return NULL;
+
+   return &sub_cmd->gfx;
+}
+
+static uint32_t
+pvr_xfb_primgen_view_count(const struct pvr_sub_cmd_gfx *gfx_sub_cmd)
+{
+   if (!gfx_sub_cmd)
+      return 1;
+
+   return MAX2(util_bitcount(gfx_sub_cmd->view_mask), 1);
+}
+
+static VkResult
+pvr_xfb_primgen_multiview_reset(struct pvr_cmd_buffer *cmd_buffer,
+                                struct pvr_query_pool *pool,
+                                uint32_t query_idx,
+                                uint32_t view_count)
+{
+   struct pvr_cmd_buffer_state *state = &cmd_buffer->state;
+   struct pvr_sub_cmd *prev_sub_cmd = state->current_sub_cmd;
+   VkResult result;
+
+   assert(prev_sub_cmd && prev_sub_cmd->type == PVR_SUB_CMD_TYPE_GRAPHICS);
+
+   const struct pvr_query_info query_info = {
+      .type = PVR_QUERY_TYPE_RESET_QUERY_POOL,
+      .is_dynamic_render = prev_sub_cmd->is_dynamic_render,
+      .is_suspend = prev_sub_cmd->is_suspend,
+      .reset_query_pool = {
+         .query_pool = pvr_query_pool_to_handle(pool),
+         .first_query = query_idx,
+         .query_count = view_count,
+      },
+   };
+
+   prev_sub_cmd->gfx.empty_cmd = false;
+   prev_sub_cmd->gfx.barrier_store = true;
+
+   result =
+      pvr_arch_cmd_buffer_start_sub_cmd(cmd_buffer, PVR_SUB_CMD_TYPE_EVENT);
+   if (result != VK_SUCCESS)
+      return result;
+
+   state->current_sub_cmd->event = (struct pvr_sub_cmd_event){
+      .type = PVR_EVENT_TYPE_BARRIER,
+      .barrier = {
+         .wait_for_stage_mask = PVR_PIPELINE_STAGE_ALL_GRAPHICS_BITS,
+         .wait_at_stage_mask = PVR_PIPELINE_STAGE_QUERY_BIT,
+      },
+   };
+
+   result = pvr_arch_add_query_program(cmd_buffer, &query_info);
+   if (result != VK_SUCCESS)
+      return result;
+
+   result =
+      pvr_arch_cmd_buffer_start_sub_cmd(cmd_buffer, PVR_SUB_CMD_TYPE_EVENT);
+   if (result != VK_SUCCESS)
+      return result;
+
+   state->current_sub_cmd->event = (struct pvr_sub_cmd_event){
+      .type = PVR_EVENT_TYPE_BARRIER,
+      .barrier = {
+         .wait_for_stage_mask = PVR_PIPELINE_STAGE_QUERY_BIT,
+         .wait_at_stage_mask = PVR_PIPELINE_STAGE_ALL_GRAPHICS_BITS,
+      },
+   };
+
+   result =
+      pvr_arch_cmd_buffer_start_sub_cmd(cmd_buffer, PVR_SUB_CMD_TYPE_GRAPHICS);
+   if (result != VK_SUCCESS)
+      return result;
+
+   state->current_sub_cmd->gfx.barrier_load = true;
+   state->current_sub_cmd->gfx.barrier_store = false;
+   state->current_sub_cmd->gfx.empty_cmd = false;
+
+   state->current_sub_cmd->is_dynamic_render = prev_sub_cmd->is_dynamic_render;
+   state->current_sub_cmd->is_suspend = prev_sub_cmd->is_suspend;
+
+   return VK_SUCCESS;
+}
+
+VkResult PVR_PER_ARCH(xfb_primgen_validate)(struct pvr_cmd_buffer *cmd_buffer)
+{
+   struct pvr_sub_cmd_gfx *gfx_sub_cmd;
+   VkResult result;
+
+   if (!cmd_buffer->state.query_pools[PVR_QUERY_POOL_INDEX_PRIMGEN])
+      return VK_SUCCESS;
+
+   gfx_sub_cmd = pvr_xfb_primgen_gfx_sub_cmd(cmd_buffer);
+   if (!gfx_sub_cmd || gfx_sub_cmd->primgen_counting)
+      return VK_SUCCESS;
+
+   result = pvr_xfb_primgen_init_emit(cmd_buffer);
+   if (result != VK_SUCCESS)
+      return result;
+
+   gfx_sub_cmd->primgen_counting = true;
+
+   pvr_arch_set_xfb_main_program_ppp_state(cmd_buffer);
+
+   return VK_SUCCESS;
+}
+
+VkResult PVR_PER_ARCH(xfb_primgen_flush)(struct pvr_cmd_buffer *cmd_buffer)
+{
+   struct pvr_sub_cmd_gfx *gfx_sub_cmd = pvr_xfb_primgen_gfx_sub_cmd(cmd_buffer);
+
+   if (!gfx_sub_cmd || !gfx_sub_cmd->primgen_counting)
+      return VK_SUCCESS;
+
+   gfx_sub_cmd->primgen_counting = false;
+
+   if (!cmd_buffer->state.query_pools[PVR_QUERY_POOL_INDEX_PRIMGEN])
+      return VK_SUCCESS;
+
+   return pvr_xfb_primgen_end_emit(cmd_buffer, true, false);
+}
+
+void PVR_PER_ARCH(xfb_primgen_query_begin)(struct pvr_cmd_buffer *cmd_buffer,
+                                           struct pvr_query_pool *pool,
+                                           uint32_t query_idx)
+{
+   struct pvr_cmd_buffer_state *state = &cmd_buffer->state;
+   struct pvr_sub_cmd_gfx *gfx_sub_cmd = pvr_xfb_primgen_gfx_sub_cmd(cmd_buffer);
+   const uint32_t view_count = pvr_xfb_primgen_view_count(gfx_sub_cmd);
+   VkResult result;
+
+   if (view_count > 1) {
+      result = pvr_xfb_primgen_multiview_reset(cmd_buffer,
+                                               pool,
+                                               query_idx,
+                                               view_count);
+      if (result != VK_SUCCESS)
+         return;
+   }
+
+   state->query_pool_indices[PVR_QUERY_POOL_INDEX_PRIMGEN] = query_idx;
+   state->query_pools[PVR_QUERY_POOL_INDEX_PRIMGEN] = pool;
+
+   if (view_count == 1) {
+      result = pvr_xfb_primgen_begin_emit(cmd_buffer);
+      if (result != VK_SUCCESS)
+         return;
+   }
+
+   gfx_sub_cmd = pvr_xfb_primgen_gfx_sub_cmd(cmd_buffer);
+   if (gfx_sub_cmd)
+      gfx_sub_cmd->primgen_counting = false;
+
+   result = pvr_xfb_primgen_main_program_generate(cmd_buffer);
+   if (result != VK_SUCCESS)
+      return;
+
+   result = pvr_xfb_primgen_streamout_update(cmd_buffer);
+   if (result != VK_SUCCESS)
+      return;
+
+   pvr_arch_set_xfb_main_program_ppp_state(cmd_buffer);
+}
+
+void PVR_PER_ARCH(xfb_primgen_query_end)(struct pvr_cmd_buffer *cmd_buffer,
+                                         struct pvr_query_pool *pool,
+                                         uint32_t query_idx)
+{
+   struct pvr_cmd_buffer_state *state = &cmd_buffer->state;
+   struct pvr_sub_cmd_gfx *gfx_sub_cmd = pvr_xfb_primgen_gfx_sub_cmd(cmd_buffer);
+   const bool accumulate = gfx_sub_cmd && gfx_sub_cmd->primgen_counting;
+   const uint32_t view_count = pvr_xfb_primgen_view_count(gfx_sub_cmd);
+   VkResult result;
+
+   assert(state->query_pools[PVR_QUERY_POOL_INDEX_PRIMGEN] == pool);
+   assert(state->query_pool_indices[PVR_QUERY_POOL_INDEX_PRIMGEN] ==
+          query_idx);
+
+   if (gfx_sub_cmd)
+      gfx_sub_cmd->primgen_counting = false;
+
+   result = pvr_xfb_primgen_end_emit(cmd_buffer, accumulate, view_count == 1);
+
+   state->query_pools[PVR_QUERY_POOL_INDEX_PRIMGEN] = NULL;
+
+   if (result != VK_SUCCESS)
+      return;
+
+   if (view_count > 1) {
+      const struct pvr_deferred_timestamp availability = {
+         .query_pool = pvr_query_pool_to_handle(pool),
+         .query = query_idx,
+         .query_count = view_count,
+         .availability_only = true,
+      };
+
+      util_dynarray_append(&state->timestamps, availability);
+   }
+
+   result = pvr_xfb_primgen_streamout_update(cmd_buffer);
+   if (result != VK_SUCCESS)
+      return;
+
    pvr_arch_set_xfb_main_program_ppp_state(cmd_buffer);
 }
