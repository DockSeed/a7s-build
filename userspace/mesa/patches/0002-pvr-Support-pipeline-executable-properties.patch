       pvr_fragment_state_save(gfx_pipeline, *fs);
       fragment_state->is_passthrough = build_fs_passthrough;
 
-      if (pCreateInfo->flags & VK_PIPELINE_CREATE_CAPTURE_STATISTICS_BIT_KHR) {
+      if (pCreateInfo->flags & VK_PIPELINE_CREATE_CAPTURE_STATISTICS_BIT_KHR ||
