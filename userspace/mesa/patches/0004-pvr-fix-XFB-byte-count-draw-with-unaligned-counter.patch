From 2110d11ed001bf237cceed7c18fd29c42a192394 Mon Sep 17 00:00:00 2001
From: Ashish Chauhan <ashish.chauhan@imgtec.com>
Date: Thu, 15 Oct 2026 19:36:04 +0100
Subject: [PATCH] pvr: fix XFB byte-count draw with unaligned counter offsets

Select the counter dword in the program so unaligned
counterBufferOffset values read the right value. Also patch
-counterOffset explicitly and skip the divide for vertexStride == 1.

Fixes: cf7c43d4dce0 ("pvr, pdsc: add xfb_vertex_count program interface and wiring")
Signed-off-by: Ashish Chauhan <ashish.chauhan@imgtec.com>
Reviewed-by: Simon Perretta <simon.perretta@imgtec.com>
Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/45632>
(cherry picked from commit c2713c9474f0fc64da3a4307a9decde7122a7b85)

Conflicts:
	src/imagination/ci/axe-1-16m-fails.txt
Link: https://gitlab.freedesktop.org/mesa/mesa/-/commit/2110d11ed001bf237cceed7c18fd29c42a192394
[ adapted: dropped .pick_status.json, not in the 26.3.0 tarball or bookkeeping only ]
---
 .pick_status.json                             |  2 +-
 src/imagination/ci/bxs-4-64-fails.txt         |  6 --
 src/imagination/common/pvr_iface.h            |  6 ++
 .../pdsc/programs/pdsc_xfb_vertex_count.h     | 65 +++++++++++++------
 src/imagination/vulkan/pvr_arch_cmd_buffer.c  | 17 +++--
 5 files changed, 65 insertions(+), 31 deletions(-)

diff --git a/src/imagination/ci/bxs-4-64-fails.txt b/src/imagination/ci/bxs-4-64-fails.txt
index 9f0dc59d7d06..e7eca5f215fa 100644
--- a/src/imagination/ci/bxs-4-64-fails.txt
+++ b/src/imagination/ci/bxs-4-64-fails.txt
@@ -1,10 +1,4 @@
 # xfb
 dEQP-VK.transform_feedback.primitive_restart.dynamic_primitive_restart_dynamic_primitive_topology,Fail
 dEQP-VK.transform_feedback.primitive_restart.static_primitive_restart_dynamic_primitive_topology,Fail
-dEQP-VK.transform_feedback.simple.draw_indirect_counter_buffer_offset_16,Fail
-dEQP-VK.transform_feedback.simple.draw_indirect_counter_buffer_offset_244,Fail
-dEQP-VK.transform_feedback.simple.draw_indirect_counter_buffer_offset_508,Fail
-dEQP-VK.transform_feedback.simple.draw_indirect_multiview_counter_buffer_offset_16,Fail
-dEQP-VK.transform_feedback.simple.draw_indirect_multiview_counter_buffer_offset_244,Fail
-dEQP-VK.transform_feedback.simple.draw_indirect_multiview_counter_buffer_offset_508,Fail
 dEQP-VK.transform_feedback.simple.max_output_components_64,Crash
diff --git a/src/imagination/common/pvr_iface.h b/src/imagination/common/pvr_iface.h
index ce1ef4c513f3..f0a2fc47e1ca 100644
--- a/src/imagination/common/pvr_iface.h
+++ b/src/imagination/common/pvr_iface.h
@@ -297,6 +297,12 @@ enum pvr_xfb_vertex_count_patch_id {
 
    /** Patch ID for output count buffer store source 0 */
    PVR_XFB_VERTEX_COUNT_PATCH_ID_OUTPUT_COUNT_BUFFER_ST_SRC0,
+
+   /** Patch ID for counter dword select within the 16-byte aligned load */
+   PVR_XFB_VERTEX_COUNT_PATCH_ID_COUNTER_DWORD_SELECT,
+
+   /** Patch ID for divide enable (0 when vertex stride == 1) */
+   PVR_XFB_VERTEX_COUNT_PATCH_ID_DIVIDE_ENABLE,
 };
 
 /* PDSC XFB vertex count reference IDs */
diff --git a/src/imagination/pdsc/programs/pdsc_xfb_vertex_count.h b/src/imagination/pdsc/programs/pdsc_xfb_vertex_count.h
index 010a22a334df..280a019369aa 100644
--- a/src/imagination/pdsc/programs/pdsc_xfb_vertex_count.h
+++ b/src/imagination/pdsc/programs/pdsc_xfb_vertex_count.h
@@ -13,11 +13,14 @@ pdsc_xfb_vertex_count_gen(void *mem_ctx, enum pdsc_feature features)
 {
    pdsc_program *p = pdsc_program_create(mem_ctx, features, "xfb_vertex_count");
 
+   /* Patched with -counterOffset (64-bit two's complement); added, not
+    * subtracted.
+    */
    ALLOC_CONST64(p,
                  counter_offset,
                  PVR_XFB_VERTEX_COUNT_PATCH_ID_NEGATIVE_COUNTER_OFFSET);
    /* Reciprocal of vertex_stride patched as ceil(2^32 / stride) by the CPU.
-    * Used in the MAD-based multiply-high division below.
+    * Unused when stride == 1 (it would not fit in 32 bits).
     */
    ALLOC_CONST32(p,
                  vertex_stride_recip,
@@ -28,14 +31,28 @@ pdsc_xfb_vertex_count_gen(void *mem_ctx, enum pdsc_feature features)
    ALLOC_CONST32(p,
                  first_instance,
                  PVR_XFB_VERTEX_COUNT_PATCH_ID_FIRST_INSTANCE);
+   ALLOC_CONST64(p,
+                 dword_select,
+                 PVR_XFB_VERTEX_COUNT_PATCH_ID_COUNTER_DWORD_SELECT);
+   ALLOC_CONST64(p, divide_enable, PVR_XFB_VERTEX_COUNT_PATCH_ID_DIVIDE_ENABLE);
 
    ALLOC_TEMP64(p, tzero);
    pdsc_limm(p, pdsc_ref_lo32(tzero), pdsc_ref_imm(0));
    pdsc_limm(p, pdsc_ref_hi32(tzero), pdsc_ref_imm(0));
 
-   ALLOC_TEMP64_ARRAY(p, counter_buffer_value, 1);
-   ALLOC_TEMP32_ARRAY(p, draw_params, 4);
+   ALLOC_TEMP64(p, sel);
+   ALLOC_TEMP64(p, byte_count);
    ALLOC_TEMP64(p, working_temp);
+   ALLOC_TEMP32_ARRAY(p, draw_params, 4);
+
+   /* 16-byte aligned load of the 16 bytes containing the 32-bit counter. */
+   ALLOC_TEMP64_ARRAY(p, counter_buffer_value, 2);
+   const pdsc_ref cb_words[] = {
+      pdsc_ref_lo32(pdsc_ref_elem64(counter_buffer_value, 0)),
+      pdsc_ref_hi32(pdsc_ref_elem64(counter_buffer_value, 0)),
+      pdsc_ref_lo32(pdsc_ref_elem64(counter_buffer_value, 1)),
+      pdsc_ref_hi32(pdsc_ref_elem64(counter_buffer_value, 1)),
+   };
 
    pdsc_ld(p,
            counter_buffer_value,
@@ -44,30 +61,38 @@ pdsc_xfb_vertex_count_gen(void *mem_ctx, enum pdsc_feature features)
            false);
    pdsc_wdf(p);
 
-   pdsc_cmp(p, tzero, counter_offset, .cop = PDSC_COP_NE);
-   pdsc_setc(p, PDSC_PRED_P0);
-   pdsc_add64(p,
-              counter_buffer_value,
-              counter_buffer_value,
-              counter_offset,
-              .cc = true,
-              .sna = true);
+   /* Pick the counter dword. */
+   pdsc_mov64(p, sel, dword_select);
+   pdsc_limm(p, pdsc_ref_lo32(byte_count), pdsc_ref_imm(0));
+   pdsc_limm(p, pdsc_ref_hi32(byte_count), pdsc_ref_imm(0));
 
-   pdsc_mov32(p,
-              pdsc_ref_elem32(draw_params, 0),
-              pdsc_ref_lo32(counter_buffer_value));
+   for (uint32_t i = 0; i < ARRAY_SIZE(cb_words); i++) {
+      pdsc_cmp(p, sel, pdsc_ref_imm(i), .cop = PDSC_COP_EQ);
+      pdsc_setc(p, PDSC_PRED_P0);
+      pdsc_mov32(p, pdsc_ref_lo32(byte_count), cb_words[i], .cc = true);
+   }
+
+   /* byte_count += -counterOffset */
+   pdsc_add64(p, byte_count, byte_count, counter_offset);
+
+   pdsc_mov32(p, pdsc_ref_elem32(draw_params, 0), pdsc_ref_lo32(byte_count));
 
-   /* Divide draw_params[0] (byte count) by vertex_stride using magic-number
-    * multiply: floor(n / stride) = hi32(n * ceil(2^32 / stride)).
-    * pdsc_idiv is not a real HW instruction; use MAD + hi32 instead.
-    * (same pattern as pdsc_xfb_end.h counter-stride multiplication)
+   /* Divide by vertex_stride using magic-number multiply:
+    * floor(n / stride) = hi32(n * ceil(2^32 / stride)).
+    * Skipped for stride == 1, where n is already the vertex count.
     */
+   pdsc_cmp(p, tzero, divide_enable, .cop = PDSC_COP_NE);
+   pdsc_setc(p, PDSC_PRED_P0);
    pdsc_mad(p,
             working_temp,
             pdsc_ref_elem32(draw_params, 0),
             vertex_stride_recip,
-            tzero);
-   pdsc_mov32(p, pdsc_ref_elem32(draw_params, 0), pdsc_ref_hi32(working_temp));
+            tzero,
+            .cc = true);
+   pdsc_mov32(p,
+              pdsc_ref_elem32(draw_params, 0),
+              pdsc_ref_hi32(working_temp),
+              .cc = true);
 
    pdsc_mov32(p, pdsc_ref_elem32(draw_params, 1), instance_count);
    pdsc_limm(p, pdsc_ref_elem32(draw_params, 2), pdsc_ref_imm(0));
diff --git a/src/imagination/vulkan/pvr_arch_cmd_buffer.c b/src/imagination/vulkan/pvr_arch_cmd_buffer.c
index a71128bc0674..64db280c6ead 100644
--- a/src/imagination/vulkan/pvr_arch_cmd_buffer.c
+++ b/src/imagination/vulkan/pvr_arch_cmd_buffer.c
@@ -9409,6 +9409,12 @@ pvr_update_indirect_draw_byte_count_ext(struct pvr_cmd_buffer *cmd_buffer,
    pdsc_program **draw_program;
    VkResult result;
 
+   const pvr_dev_addr_t counter_addr =
+      PVR_DEV_ADDR_OFFSET(counter_buffer->dev_addr, counter_buffer_offset);
+
+   /* PDS LD needs 16-byte alignment; select the dword in the program. */
+   const uint32_t dword_select = (counter_addr.addr & 0xF) / sizeof(uint32_t);
+
    struct pvr_pds_xfb_draw_program_input input = {
       .first_instance = first_instance,
       .instance_count = instance_count,
@@ -9416,8 +9422,7 @@ pvr_update_indirect_draw_byte_count_ext(struct pvr_cmd_buffer *cmd_buffer,
       .vertex_stride = vertex_stride,
       .data = {
          .counter_buffer_addr =
-            PVR_DEV_ADDR_OFFSET(counter_buffer->dev_addr,
-                                counter_buffer_offset),
+            PVR_DEV_ADDR(counter_addr.addr & ~UINT64_C(0xF)),
          .output_count_buffer_addr =
             xfb_shader_state->indirect_byte_count->dev_addr,
       },
@@ -9437,7 +9442,7 @@ pvr_update_indirect_draw_byte_count_ext(struct pvr_cmd_buffer *cmd_buffer,
       .dest = pdsc_load_ref(*draw_program,
                             PVR_XFB_VERTEX_COUNT_REF_ID_COUNTER_BUFFER_LD_DEST),
       .cmode = PDSC_CMODE_LD_CACHED,
-      .count8 = 1, /* the 64-bit byte counter */
+      .count8 = 2, /* 16 aligned bytes containing the 32-bit counter */
       .srcadd = input.data.counter_buffer_addr.addr,
    };
 
@@ -9456,7 +9461,7 @@ pvr_update_indirect_draw_byte_count_ext(struct pvr_cmd_buffer *cmd_buffer,
 
    pdsc_patch patches[] = {
       { .patch_id = PVR_XFB_VERTEX_COUNT_PATCH_ID_NEGATIVE_COUNTER_OFFSET,
-        .value = input.counter_offset },
+        .value = (uint64_t)(-(int64_t)input.counter_offset) },
       /* Reciprocal for magic-number multiply division in the pdsc program.
        * GPU computes: vertex_count = hi32(byte_count * recip).
        */
@@ -9474,6 +9479,10 @@ pvr_update_indirect_draw_byte_count_ext(struct pvr_cmd_buffer *cmd_buffer,
       { .patch_id = PVR_XFB_VERTEX_COUNT_PATCH_ID_OUTPUT_COUNT_BUFFER_ST_SRC0,
         .value =
            pdsc_st32_src0_pack(*draw_program, &output_count_buffer_st_src0) },
+      { .patch_id = PVR_XFB_VERTEX_COUNT_PATCH_ID_COUNTER_DWORD_SELECT,
+        .value = dword_select },
+      { .patch_id = PVR_XFB_VERTEX_COUNT_PATCH_ID_DIVIDE_ENABLE,
+        .value = input.vertex_stride > 1 },
    };
 
    assert(ARRAY_SIZE(patches) < pdsc_program_data_size(*draw_program));
